  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "T-SNE",
      "source_hash": 9321520336795551045,
      "context_hash": 3034251467444077525,
      "translation": "T-SNE",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:29:57.623683Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Это гораздо более сложный нелинейный алгоритм.",
      "source_hash": 12171440841630335583,
      "context_hash": 1310127641520748080,
      "translation": "이것은 훨씬 더 복잡한 비선형 알고리즘입니다.",
      "glossary_snapshot": {
        "алгоритм": "알고리즘"
      },
      "translated_at": "2026-10-27T15:29:59.305427Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "Он очень крут для визуализации данных, и работает только с переводом в 2D и 3D.",
      "source_hash": 8973995695146773287,
      "context_hash": 6449608699317846279,
      "translation": "이 알고리즘은 데이터 시각화에 매우 뛰어나며, 2D와 3D로의 변환에서만 동작합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:29:59.305427Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "Внутри там происходит что-то физическое - элементы будто разлетаются, причем чем дальше они друг от друга, тем сильнее они друг друга оттакливают.",
      "source_hash": 5249538450045661752,
      "context_hash": 15340087553086062685,
      "translation": "내부에서는 일종의 물리적인 과정이 일어납니다. 원소들이 마치 흩어지듯 퍼져 나가는데, 서로 멀리 떨어져 있을수록 더 강하게 서로를 밀어냅니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:01.191384Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "![](../img/tsne-sample.png)",
      "source_hash": 275519154227421403,
      "context_hash": 12847494066438389767,
      "translation": "![](../img/tsne-sample.png)",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:29:59.408300Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "Плюсы t-SNE",
      "source_hash": 8876619098109758212,
      "context_hash": 15072817493816299718,
      "translation": "t-SNE의 장점",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:00.114184Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "отлично визуализирует (2D, 3D) данные",
      "source_hash": 7118810149622967200,
      "context_hash": 867529291579681423,
      "translation": "(2D, 3D) 데이터를 훌륭하게 시각화합니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:04.788162Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:0",
      "source": "физически разносит разные точки дальше друг от друга",
      "source_hash": 2892224845397689243,
      "context_hash": 16879968339599869721,
      "translation": "서로 다른 점들을 물리적으로 서로 더 멀리 떨어뜨립니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:05.740862Z",
      "issues": []
    },
    {
      "id": "section:0/block:7/seg:0",
      "source": "сильно разные точки не могут в конце оказаться рядом",
      "source_hash": 9724266498417084886,
      "context_hash": 1930754076227672536,
      "translation": "크게 다른 점들은 결국 서로 가까이 위치할 수 없습니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:04.807621Z",
      "issues": []
    },
    {
      "id": "section:0/block:8/seg:0",
      "source": "Недостатки t-SNE",
      "source_hash": 11267342785542830102,
      "context_hash": 2099489611945451080,
      "translation": "t-SNE의 단점",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:04.580522Z",
      "issues": []
    },
    {
      "id": "section:0/block:9/seg:0",
      "source": "недетерминированность, результат меняется при каждом запуске",
      "source_hash": 1266096360906021065,
      "context_hash": 15816314169239950958,
      "translation": "비결정성, 실행할 때마다 결과가 달라집니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:05.215364Z",
      "issues": []
    },
    {
      "id": "section:0/block:10/seg:0",
      "source": "координаты ничего не значат сами по себе",
      "source_hash": 1560280460953125650,
      "context_hash": 16031130376663649391,
      "translation": "좌표 자체는 아무런 의미가 없습니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:07.860420Z",
      "issues": []
    },
    {
      "id": "section:0/block:11/seg:0",
      "source": "нельзя легко добавить новые данные",
      "source_hash": 12682880486732054699,
      "context_hash": 8177414983293373068,
      "translation": "새로운 데이터를 쉽게 추가할 수 없습니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:10.688469Z",
      "issues": []
    },
    {
      "id": "section:0/block:12/seg:0",
      "source": "долго работает",
      "source_hash": 12781748396496672089,
      "context_hash": 6414795019978186831,
      "translation": "실행 시간이 오래 걸립니다",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:30:09.912822Z",
      "issues": []
    },
    {
      "id": "section:0/block:13/seg:0",
      "source": "уменьшает только до 2 и 3 размерности",
      "source_hash": 16740676285374036239,
      "context_hash": 11245957159720500107,
      "translation": "2차원과 3차원으로만 축소합니다",
