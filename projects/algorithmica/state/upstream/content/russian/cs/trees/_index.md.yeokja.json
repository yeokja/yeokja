  "version": 1,
  "source_hash": 6351491228460341415,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Корневые деревья",
      "source_hash": 495912093121040389,
      "context_hash": 9374454779641399191,
      "translation": "루트 트리",
      "glossary_snapshot": {
        "деревья": "트리"
      },
      "translated_at": "2026-10-27T14:51:00.416195Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Дерево называется *корневым*, если оно ориентировано, и из какой-то вершины (называемой *корнем*) можно попасть во все остальные.",
      "source_hash": 16121780985275069687,
      "context_hash": 25741159588790369,
      "translation": "트리가 방향 그래프이고 어떤 정점(*루트*라고 부릅니다)에서 나머지 모든 정점으로 갈 수 있으면, 그 트리를 *루트 트리*라고 합니다.",
      "glossary_snapshot": {
        "дерево": "트리"
      },
      "translated_at": "2026-10-27T14:51:02.118691Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "Примеры корневых деревьев:",
      "source_hash": 14937110278894078267,
      "context_hash": 17773115868219662763,
      "translation": "루트 트리의 예는 다음과 같습니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T14:51:01.863005Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "наследование классов в языках программирования (если множественное наследование запрещено),",
      "source_hash": 11908645527221487732,
      "context_hash": 3402457633462215008,
      "translation": "프로그래밍 언어에서의 클래스 상속(다중 상속이 금지된 경우),",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T14:51:04.071816Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "дерево факторизации числа на простые (в общем случае не уникальное),",
      "source_hash": 3119578352659269674,
      "context_hash": 1432346826855707744,
      "translation": "수의 소인수분해 트리(일반적으로 유일하지 않음),",
      "glossary_snapshot": {
        "дерево": "트리",
        "факторизации": "소인수분해"
      },
      "translated_at": "2026-10-27T14:51:05.975056Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "иерархия в какой-нибудь организации,",
      "source_hash": 8095394814271264723,
      "context_hash": 3334064035424926978,
      "translation": "어떤 조직의 위계 구조,",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T14:51:04.597500Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:0",
      "source": "дерево парсинга математичеких выражений.",
      "source_hash": 12059755786705715132,
      "context_hash": 690939972924798056,
      "translation": "수학 식의 파싱 트리.",
      "glossary_snapshot": {
        "дерево": "트리"
      },
      "translated_at": "2026-10-27T14:51:06.468049Z",
      "issues": []
    },
    {
      "id": "section:0/block:7/seg:0",
      "source": "Задачи на корневые деревья весьма бесполезны в реальной жизни, но зато очень интересны с алгоритмической точки зрения, и поэтому часто встречаются на олимпиадах по программированию.",
      "source_hash": 2266494205419594373,
      "context_hash": 2566590663784447670,
      "translation": "루트 트리에 관한 문제는 실생활에서는 거의 쓸모가 없지만, 알고리즘 관점에서는 매우 흥미롭기 때문에 프로그래밍 올림피아드에 자주 출제됩니다.",
      "glossary_snapshot": {
        "деревья": "트리"
      },
      "translated_at": "2026-10-27T14:35:48.719699Z",
      "issues": []
    }
  ]
}