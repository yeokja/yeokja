      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "3)$(A \\\\cdot c)^T = A^T \\\\cdot c$",
      "source_hash": 8313467801457940944,
      "context_hash": 4960612411895188000,
      "translation": "3)$(A \\\\cdot c)^T = A^T \\\\cdot c$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:33.964186Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Умножение",
