      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "1)$(A^T)^T = A$",
      "source_hash": 17473458209250808769,
      "context_hash": 12175868597767436642,
      "translation": "1)$(A^T)^T = A$",
      "glossary_snapshot": {},
