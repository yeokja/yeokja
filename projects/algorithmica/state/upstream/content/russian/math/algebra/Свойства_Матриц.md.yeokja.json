    {
      "id": "section:0/block:0/seg:0",
      "source": "Сложение",
      "source_hash": 16323783607464072960,
      "context_hash": 2916162774468715364,
      "translation": "덧셈",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:15.651915Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "1\\) Коммутативность $A + B = B + A$",
      "source_hash": 13628245662049166380,
      "context_hash": 10729733355490052094,
      "translation": "1\\) 교환법칙 $A + B = B + A$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:16.969317Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "2\\) Ассоциативность $(A + B) + C = A + (B + C)$",
      "source_hash": 14587007076380430122,
      "context_hash": 3864550006421487262,
      "translation": "2\\) 결합법칙 $(A + B) + C = A + (B + C)$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:20.121971Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "3\\) $A + 0 = A$, нулевая матрица - матрица заполненная нулями, того же размера, что и $A$",
      "source_hash": 15359442805857608944,
      "context_hash": 6414558315111192085,
      "translation": "3\\) $A + 0 = A$, 영행렬은 0으로 채워진 행렬로, $A$와 같은 크기입니다",
      "glossary_snapshot": {
        "матрица": "행렬"
      },
      "translated_at": "2026-10-27T15:02:20.281646Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "4\\) $(-A) + A = 0$",
      "source_hash": 14492070020849980292,
      "context_hash": 17115168417394958215,
      "translation": "4\\) $(-A) + A = 0$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:22.155528Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Умножение на число",
      "source_hash": 16882305823553138874,
      "context_hash": 534182436728007777,
      "translation": "스칼라 곱셈",
      "glossary_snapshot": {
        "умножение": "곱셈"
      },
      "translated_at": "2026-10-27T15:02:21.746663Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "1\\) $\\\\lambda(A + B) = A \\\\cdot \\\\lambda + B \\\\cdot \\\\lambda$",
      "source_hash": 239259974450105981,
      "context_hash": 15075981995726484316,
      "translation": "1\\) $\\\\lambda(A + B) = A \\\\cdot \\\\lambda + B \\\\cdot \\\\lambda$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:25.939057Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "2\\) $(\\\\lambda + \\\\mu) \\\\cdot A = \\\\lambda \\\\cdot A + \\\\mu \\\\cdot B$",
      "source_hash": 4360556799525244525,
      "context_hash": 2894938691352009241,
      "translation": "2\\) $(\\\\lambda + \\\\mu) \\\\cdot A = \\\\lambda \\\\cdot A + \\\\mu \\\\cdot B$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:27.799182Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "3\\) $(\\\\lambda \\\\cdot \\\\mu) \\\\cdot A = \\\\lambda\\\\cdot (\\\\mu \\\\cdot A);$",
      "source_hash": 4950225079322045870,
      "context_hash": 8490468303019392439,
      "translation": "3\\) $(\\\\lambda \\\\cdot \\\\mu) \\\\cdot A = \\\\lambda\\\\cdot (\\\\mu \\\\cdot A);$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:24.761414Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "4\\) $A \\\\cdot 1 = A$",
      "source_hash": 13539205546643099995,
      "context_hash": 12678319090818072433,
      "translation": "4\\) $A \\\\cdot 1 = A$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:26.625690Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
