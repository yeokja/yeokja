      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "2)$(A + B)^T = A^T + B^T$",
      "source_hash": 18438258954800854072,
      "context_hash": 6315954962223711665,
      "translation": "2)$(A + B)^T = A^T + B^T$",
      "glossary_snapshot": {},
