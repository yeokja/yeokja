    {
      "id": "section:3/block:1/seg:0",
      "source": "1)$A \\\\cdot (B + C) = A \\\\cdot B + A \\\\cdot C$",
      "source_hash": 7317455216261505458,
      "context_hash": 4869438578457726336,
      "translation": "1)$A \\\\cdot (B + C) = A \\\\cdot B + A \\\\cdot C$",
      "glossary_snapshot": {},
