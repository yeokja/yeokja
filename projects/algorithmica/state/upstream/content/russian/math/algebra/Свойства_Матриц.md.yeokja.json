      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "2)$(A \\\\cdot B) \\\\cdot C = A \\\\cdot (B \\\\cdot C)$",
      "source_hash": 14281597760395944727,
      "context_hash": 17598148453849030201,
      "translation": "2)$(A \\\\cdot B) \\\\cdot C = A \\\\cdot (B \\\\cdot C)$",
      "glossary_snapshot": {},
      "translated_at": "2026-10-27T15:02:35.988808Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "3)$A \\\\cdot B \\\\neq B \\\\cdot A$",
