      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "This book is organized as career guides, durable principles, long-range strategies, practical tactics, and reusable concepts.",
      "source_hash": 15370129180079490906,
      "context_hash": 11572261821752863477,
      "translation": "이 책은 커리어 가이드, 오래가는 원칙, 장기 전략, 실용적인 전술, 재사용 가능한 개념으로 구성되어 있습니다.",
      "glossary_snapshot": {
        "Career Guides": "커리어 가이드"
      },
      "translated_at": "2026-10-29T17:03:19.831463Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "Read it from start to finish, or jump directly to the section that matches your next career decision.",
      "source_hash": 15134830019760182455,
      "context_hash": 5407970233705178077,
      "translation": "처음부터 끝까지 읽어도 되고, 다음 경력 결정에 맞는 섹션으로 바로 건너뛰어도 됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-29T16:34:31.024199Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Open Sourced August 18, 2026",
