  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "GPT-2 in One Function",
      "source_hash": 4400167506568168214,
      "context_hash": 10896578975586457786,
      "translation": "하나의 함수로 구현한 GPT-2",
      "glossary_snapshot": {},
      "translated_at": "2026-10-17T13:13:01.493481Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "GPT-2 is not a complicated model, in fact we can code golf it down into a single Python function using nothing more than numpy.",
      "source_hash": 8034731181001062484,
      "context_hash": 715346753341267214,
      "translation": "GPT-2는 복잡한 모델이 아닙니다. 실제로 numpy만 사용해서 코드 골프를 하듯 하나의 Python 함수로 줄일 수 있습니다.",
      "glossary_snapshot": {
        "NumPy": "NumPy",
        "Python": "Python",
        "code": "코드",
        "model": "모델"
      },
      "translated_at": "2026-10-17T13:13:01.493482Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "This is everything inlined in a single function, the layernorm, attention, mlp, token and position embeddings, and the final logits in 70 lines of code if you don't count whitespace.",
      "source_hash": 7777292659540085380,
      "context_hash": 2290546592825347055,
      "translation": "레이어 정규화(layernorm), 어텐션, MLP, 토큰 임베딩과 위치 임베딩, 최종 로짓까지 모든 것이 하나의 함수 안에 인라인되어 있으며, 공백을 세지 않으면 70줄짜리 코드입니다.",
      "glossary_snapshot": {
        "attention": "어텐션",
        "code": "코드",
        "logits": "로짓",
        "position embeddings": "위치 임베딩"
      },
      "translated_at": "2026-10-17T13:13:01.493482Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "Of course, here I'm cheating a little bit because we have a helper module to load the weights into a dataclass `ModelParams`, but the logic for the forward pass is all contained within this single function.",
      "source_hash": 16590496250210988589,
      "context_hash": 9333732880195876076,
      "translation": "물론 여기서는 가중치를 데이터클래스 `ModelParams`로 불러오는 헬퍼 모듈이 있으므로 약간 속임수를 쓰고 있지만, 순방향 패스의 로직은 모두 이 하나의 함수 안에 담겨 있습니다.",
      "glossary_snapshot": {
        "dataclass": "데이터클래스",
        "forward pass": "순방향 패스",
        "module": "모듈"
      },
      "translated_at": "2026-10-17T13:13:01.493482Z",
      "issues": []
    },
    {
