      "issues": []
    },
    {
      "id": "section:9/block:3/seg:0",
      "source": "Will emit the following:",
      "source_hash": 18232797269590960113,
      "context_hash": 1848089269621227033,
      "translation": "다음과 같이 출력됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T01:08:34.212553Z",
      "issues": []
    },
    {
      "id": "section:10/block:0/seg:0",
      "source": "Debugging borrowcheck",
      "source_hash": 13574488477952812066,
      "context_hash": 7064822751940359281,
      "translation": "빌림 검사(borrowcheck) 디버깅하기",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T01:08:34.212553Z",
      "issues": []
    },
    {
      "id": "section:10/block:1/seg:0",
      "source": "Debugging the borrow checker has [its own chapter](borrow-check/debugging.md).",
      "source_hash": 11224269861360010854,
      "context_hash": 14770303456705522995,
      "translation": "빌림 검사기 디버깅에는 [별도의 장](borrow-check/debugging.md)이 있습니다.",
