      "issues": []
    },
    {
      "id": "section:8/block:12/seg:0",
      "source": "Dumps the [hidden type of each opaque types][opaq] in the crate.",
      "source_hash": 10800646635070854386,
      "context_hash": 10163731463147796230,
      "translation": "크레이트 내 [불투명 타입 각각의 숨겨진 타입][opaq]을 덤프합니다.",
      "glossary_snapshot": {
        "crate": "크레이트"
      },
