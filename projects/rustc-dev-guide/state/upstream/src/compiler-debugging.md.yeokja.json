      "issues": []
    },
    {
      "id": "section:8/block:14/seg:0",
      "source": "Dumps implied bounds of an item.",
      "source_hash": 544824339232949845,
      "context_hash": 4628494070878175073,
      "translation": "아이템의 암시적 바운드를 덤프합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T01:16:51.785574Z",
      "issues": []
    },
    {
      "id": "section:8/block:14/seg:1",
      "source": "More precisely, the [`inferred_outlives_of`] an item.",
      "source_hash": 8384085590403179348,
      "context_hash": 12670812699970788539,
      "translation": "더 정확히는, 아이템의 [`inferred_outlives_of`]입니다.",
      "glossary_snapshot": {},
