      "issues": []
    },
    {
      "id": "section:9/block:1/seg:1",
      "source": "For example:",
      "source_hash": 4114854479619665730,
      "context_hash": 482238899775036330,
      "translation": "예를 들면:",
      "glossary_snapshot": {},
