    {
      "id": "section:0/block:1/seg:0",
      "source": "The WebAssembly ecosystem often gives talks about functionality and features of WebAssembly components.",
      "source_hash": 15667249608550138473,
      "context_hash": 1656347231197382853,
      "translation": "WebAssembly 생태계에서는 WebAssembly 컴포넌트의 기능과 특징에 관한 발표가 자주 이루어집니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T09:56:50.104015Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "This page is a non-exhaustive list of some of the best talks and videos related to the component model.",
      "source_hash": 15588140147873652871,
      "context_hash": 100593821479272764,
      "translation": "이 페이지는 컴포넌트 모델과 관련된 훌륭한 발표와 동영상 중 일부를 모아 둔 목록이며, 모든 자료를 망라하지는 않습니다.",
      "glossary_snapshot": {
        "component model": "컴포넌트 모델"
      },
      "translated_at": "2026-09-25T09:56:50.104015Z",
      "issues": []
    },
