  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Using WIT resources",
      "source_hash": 42833055560478194,
      "context_hash": 5272981863721230008,
      "translation": "WIT 리소스 사용하기",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T05:49:54.925730Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "This section contains language-specific guides on how to use [WIT][docs-wit] resources.",
      "source_hash": 13317393721074963334,
      "context_hash": 8183270000881311266,
      "translation": "이 섹션에서는 [WIT][docs-wit] 리소스를 사용하는 방법에 대한 언어별 가이드를 다룹니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T05:49:54.925730Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "Resources represent functionality that is implemented only on one side of a component boundary, for example in another component or in the underlying platform/host.",
      "source_hash": 6342872073825440220,
      "context_hash": 9408651848819145652,
      "translation": "리소스는 컴포넌트 경계의 한쪽에서만 구현된 기능을 나타내며, 예를 들어 다른 컴포넌트나 기반 플랫폼/호스트에서 구현됩니다.",
      "glossary_snapshot": {
        "component": "컴포넌트"
      },
      "translated_at": "2026-09-12T05:49:54.925730Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "An example of a resource:",
      "source_hash": 13733338431524493600,
      "context_hash": 11325412041662913544,
      "translation": "리소스의 예시:",
      "glossary_snapshot": {
        "resource": "리소스"
      },
      "translated_at": "2026-09-12T05:49:54.925730Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "Hosts or Components implementing the stack-based calculator above do share the *resource* (the `stack-calculator` entity) with components that `import` that functionality, but do *not* share the actual implementation.",
      "source_hash": 6145912704283929389,
      "context_hash": 2906669292604902224,
      "translation": "위의 스택 기반 계산기를 구현하는 호스트나 컴포넌트는 그 기능을 `import`하는 컴포넌트와 *리소스*(`stack-calculator` 엔티티)를 공유하지만, 실제 구현은 공유하지 *않습니다*.",
      "glossary_snapshot": {
        "resource": "리소스"
      },
      "translated_at": "2026-09-12T05:49:54.925731Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:1",
      "source": "All calls to `stack-calculator` resources resolve inside the component that `export`ed the functionality.",
      "source_hash": 9049912037226007110,
      "context_hash": 1477507199830137663,
      "translation": "`stack-calculator` 리소스에 대한 모든 호출은 해당 기능을 `export`한 컴포넌트 내부에서 처리됩니다.",
      "glossary_snapshot": {
        "component": "컴포넌트"
      },
      "translated_at": "2026-09-12T05:49:54.925731Z",
      "issues": []
    },
    {
