  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Review Changes Since",
      "source_hash": 12567998003510704100,
      "context_hash": 18069105510481224363,
      "translation": "리뷰 이후 변경 사항",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:44:28.528755Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "This feature will automatically adjust the body of a GitHub review to include a link to view the changes that happened since the review.",
      "source_hash": 6077341009456413876,
      "context_hash": 8025268917620955995,
      "translation": "이 기능은 GitHub 리뷰 본문을 자동으로 수정하여 리뷰 이후 발생한 변경 사항을 확인할 수 있는 링크를 추가합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Usage",
      "source_hash": 8769925957682373409,
      "context_hash": 15264062300289671718,
      "translation": "사용법",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "When creating a pull request review, the bot will automatically append at the end of the review body a link to view the changes that happened since the review.",
      "source_hash": 4253763317242178551,
      "context_hash": 9385859031228025378,
      "translation": "풀 리퀘스트 리뷰를 작성하면 봇이 리뷰 본문 끝에 리뷰 이후 발생한 변경 사항을 확인할 수 있는 링크를 자동으로 덧붙입니다.",
      "glossary_snapshot": {
        "pull request": "풀 리퀘스트"
      },
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 1821818787898806125,
      "translation": "설정",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "This feature is [enabled by default](https://github.com/rust-lang/triagebot/blob/master/rust-lang.triagebot.toml) in the rust-lang organization.",
      "source_hash": 13354010520095514819,
      "context_hash": 15378260687847309584,
      "translation": "이 기능은 rust-lang 조직에서 [기본적으로 활성화되어 있습니다](https://github.com/rust-lang/triagebot/blob/master/rust-lang.triagebot.toml).",
      "glossary_snapshot": {
        "Rust": "Rust"
      },
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "This feature is enabled on a repository by having a `[review-changes-since]` table in `triagebot.toml`:",
      "source_hash": 9113763620793902444,
      "context_hash": 15377673583775337586,
      "translation": "저장소의 `triagebot.toml`에 `[review-changes-since]` 테이블이 있으면 해당 저장소에서 이 기능이 활성화됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Implementation",
      "source_hash": 14188291987651099077,
      "context_hash": 10022219999867325026,
      "translation": "구현",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:44:28.528756Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "See [`src/handlers/review_changes_since.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/review_changes_since.rs).",
      "source_hash": 17580702569501117563,
      "context_hash": 5801226501789644448,
      "translation": "[`src/handlers/review_changes_since.rs`](https://github.com/rust-lang/triagebot/blob/HEAD/src/handlers/review_changes_since.rs)를 참고하십시오.",
      "glossary_snapshot": {},
