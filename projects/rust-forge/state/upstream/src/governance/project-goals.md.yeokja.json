  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Project goals",
      "source_hash": 4177551413087481540,
      "context_hash": 17276621436332105427,
      "translation": "프로젝트 목표",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247619Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Introduction",
      "source_hash": 17143975622463353612,
      "context_hash": 9146798797999052084,
      "translation": "소개",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247620Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Project goals is a program we run to help people from inside or outside the project proposing medium to big changes by providing resources and help.",
      "source_hash": 16416069932574114329,
      "context_hash": 11571231918258369450,
      "translation": "프로젝트 목표는 중대형 변경을 제안하는 프로젝트 내외부의 사람들에게 자원과 도움을 제공하기 위해 저희가 운영하는 프로그램입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247621Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Having a goal can help find some funding: the Project [lists the goals that are looking for funding](https://goals.rust-lang.org/2026/funding.html), and the funding team and [RCN] are also places where potential funding partners can look for goals of interest to them.",
      "source_hash": 13135060163446077616,
      "context_hash": 9939934965957697569,
      "translation": "목표를 세우면 자금 지원을 받는 데 도움이 될 수 있습니다. 프로젝트는 [자금 지원을 찾고 있는 목표 목록](https://goals.rust-lang.org/2026/funding.html)을 제공하며, 자금 지원 팀과 [RCN]도 잠재적 자금 지원 파트너가 관심 있는 목표를 찾아볼 수 있는 곳입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247621Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "This page only provides a quick overview; full documentation is available at [this link][goals-docs].",
      "source_hash": 1562868972613724927,
      "context_hash": 10207423791915790117,
      "translation": "이 페이지는 간단한 개요만 제공합니다. 전체 문서는 [이 링크][goals-docs]에서 확인할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247621Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Structure and coordination",
      "source_hash": 7693560269715726508,
      "context_hash": 12178189527362797304,
      "translation": "구조 및 조율",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247621Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Get in contact with the [goals team] on [Zulip][zulip-t-goals].",
      "source_hash": 2405917669536889364,
      "context_hash": 3499442318806855622,
      "translation": "[Zulip][zulip-t-goals]에서 [목표 팀][goals team]에 연락하십시오.",
      "glossary_snapshot": {
        "Zulip": "Zulip"
      },
      "translated_at": "2026-09-25T04:57:34.247621Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Project goal proposals are tracked on [GitHub][goals-issue-tracker].",
      "source_hash": 14987109907797995802,
      "context_hash": 7474384814070573234,
      "translation": "프로젝트 목표 제안은 [GitHub][goals-issue-tracker]에서 추적됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247623Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Funding",
      "source_hash": 13414439751467210145,
      "context_hash": 13935996613695259957,
      "translation": "자금 지원",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247623Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Project goal proponents can ask to apply for funding.",
      "source_hash": 13313059374694410571,
      "context_hash": 10149021763657277683,
      "translation": "프로젝트 목표 제안자는 자금 지원 신청을 요청할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247623Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "See [documentation][goals-funding] for more information.",
      "source_hash": 6021352031833391312,
      "context_hash": 73101647907027935,
      "translation": "자세한 내용은 [문서][goals-funding]를 참조하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:57:34.247623Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "For more informations about how to get funding, get in contact with the [funding team] on [Zulip][zulip-t-funding].",
      "source_hash": 12923932893405936759,
      "context_hash": 1968007698948183531,
      "translation": "자금 지원을 받는 방법에 대한 자세한 내용은 [Zulip][zulip-t-funding]에서 [자금 지원 팀][funding team]에 연락하십시오.",
      "glossary_snapshot": {
        "Zulip": "Zulip"
      },
      "translated_at": "2026-09-25T04:57:34.247623Z",
      "issues": []
    }
  ]
}