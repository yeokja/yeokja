    {
      "id": "section:0/block:1/seg:0",
      "source": "Rust used to have an official server on Discord.",
      "source_hash": 5741203929261579333,
      "context_hash": 18186993237729232520,
      "translation": "Rust는 예전에 Discord에서 공식 서버를 운영했습니다.",
      "glossary_snapshot": {
        "Rust": "Rust"
      },
      "translated_at": "2026-09-24T12:02:27.555428Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "It has been shut down and is read-only now in favor of Zulip.",
      "source_hash": 844732066463233150,
      "context_hash": 2812655825549653826,
      "translation": "이 서버는 Zulip으로 옮기면서 운영이 종료되었고, 지금은 읽기 전용으로 남아 있습니다.",
      "glossary_snapshot": {
        "Zulip": "Zulip"
      },
      "translated_at": "2026-09-24T12:02:27.555428Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "The read-only view can be accessed via [https://discord.gg/rust-lang](https://discord.gg/rust-lang).",
      "source_hash": 8587926730928067587,
      "context_hash": 17549203670453453095,
      "translation": "읽기 전용 화면은 [https://discord.gg/rust-lang](https://discord.gg/rust-lang)에서 볼 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T12:02:27.555428Z",
