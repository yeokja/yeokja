{
  "version": 1,
  "source_hash": 17782210181297912833,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Review Policy",
      "source_hash": 5721968268182630609,
      "context_hash": 1689311900951879621,
      "translation": "리뷰 정책",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T12:11:12.068643Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "The rustdoc team follows the same review policy as the compiler team.",
      "source_hash": 6116014424202357953,
      "context_hash": 12118293642605949816,
      "translation": "rustdoc 팀은 컴파일러 팀과 동일한 리뷰 정책을 따릅니다.",
      "glossary_snapshot": {
        "compiler team": "컴파일러 팀",
        "rustdoc": "rustdoc"
      },
      "translated_at": "2026-09-24T12:11:12.068644Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "Take a look at [their chapter](../compiler/reviews.md) about it.",
      "source_hash": 11474098485074520453,
      "context_hash": 1068815946705653336,
      "translation": "이에 관해서는 [컴파일러 팀의 해당 장](../compiler/reviews.md)을 참고하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T12:11:12.068645Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "In addition, it's important to note that:",
      "source_hash": 1284487699805307099,
      "context_hash": 6947468939501804882,
      "translation": "이에 더해 다음 사항에 유의하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T12:11:12.068645Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "Anyone is welcome to provide their input as code review, even if you aren't a member of the rustdoc team.",
      "source_hash": 8595177814926070489,
      "context_hash": 15616997223928857868,
      "translation": "rustdoc 팀 구성원이 아니더라도 누구나 코드 리뷰로 의견을 제시할 수 있습니다.",
      "glossary_snapshot": {
        "rustdoc": "rustdoc"
      },
      "translated_at": "2026-09-24T12:11:12.068645Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "Only team members can approve pull requests for being merged.",
      "source_hash": 4411682636119037807,
      "context_hash": 18016381957904533051,
      "translation": "풀 리퀘스트의 병합은 팀 구성원만 승인할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T12:11:12.068645Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "New features are usually subject to more in depth review and might need to go through an RFC or an FCP.",
      "source_hash": 11188589047471964922,
      "context_hash": 10926819145062950771,
      "translation": "새로운 기능은 보통 더 심도 있는 리뷰를 거치며, RFC나 FCP를 거쳐야 할 수도 있습니다.",
      "glossary_snapshot": {
        "FCP": "FCP",
        "RFC": "RFC"
      },
      "translated_at": "2026-09-24T12:11:12.068646Z",
      "issues": []
    }
  ]
}