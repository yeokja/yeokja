    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "3.14 lifespan",
      "source_hash": 22611144504536066,
      "context_hash": 2254110085639522371,
      "translation": "3.14 수명",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:41:37.123424Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "Python 3.14 will receive bugfix updates approximately every two months for approximately 24 months.",
      "source_hash": 7906547099742111070,
      "context_hash": 1730282787858696012,
      "translation": "Python 3.14는 약 24개월 동안 대략 2개월마다 버그 수정 업데이트를 받습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:41:37.123424Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:1",
      "source": "Around the time of the release of 3.16.0 final, the final 3.14 bugfix update will be released.",
      "source_hash": 11959145195361154929,
      "context_hash": 508976397048712540,
      "translation": "3.16.0 최종 버전이 릴리스될 무렵 마지막 3.14 버그 수정 업데이트가 릴리스됩니다.",
      "glossary_snapshot": {},
