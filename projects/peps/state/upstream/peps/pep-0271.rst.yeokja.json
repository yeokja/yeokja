  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Prefixing sys.path by command line option",
      "source_hash": 4918028215794667795,
      "context_hash": 16530898886277989957,
      "translation": "명령줄 옵션으로 sys.path 앞에 경로 추가하기",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925889Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Abstract",
      "source_hash": 14205428931693966264,
      "context_hash": 15510160547060774600,
      "translation": "초록",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925889Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "At present, setting the ``PYTHONPATH`` environment variable is the only method for defining additional Python module search directories.",
      "source_hash": 17932681398574571645,
      "context_hash": 3388939174956251529,
      "translation": "현재 추가 Python 모듈 검색 디렉터리를 정의하는 유일한 방법은 ``PYTHONPATH`` 환경 변수를 설정하는 것입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925889Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "This PEP introduces the '-P' valued option to the python command as an alternative to ``PYTHONPATH``.",
      "source_hash": 4025352644650445843,
      "context_hash": 11778381791301415882,
      "translation": "이 PEP는 ``PYTHONPATH``\\ 의 대안으로 python 명령에 값을 받는 '-P' 옵션을 도입합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925890Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Rationale",
      "source_hash": 18339363210720796208,
      "context_hash": 10694294141570584612,
      "translation": "근거",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925890Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "On Unix",
      "source_hash": 9060009018109669042,
      "context_hash": 7148221275977534320,
      "translation": "Unix에서",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925890Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "will be equivalent to",
      "source_hash": 16927771978073059663,
      "context_hash": 16535095090447917696,
      "translation": "다음과 동일합니다",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925890Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "On Windows 2K",
      "source_hash": 14277408048799054204,
      "context_hash": 2024287099820916094,
      "translation": "Windows 2K에서",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925890Z",
      "issues": []
    },
    {
      "id": "section:2/block:7/seg:0",
      "source": "will (almost) be equivalent to",
      "source_hash": 1970771828658095612,
      "context_hash": 5725040124694297135,
      "translation": "다음과 (거의) 동일합니다",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925890Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Other Information",
      "source_hash": 17532575135030469418,
      "context_hash": 15283050193160034609,
      "translation": "기타 정보",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925891Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "This option is equivalent to the 'java -classpath' option.",
      "source_hash": 4246971261768029144,
      "context_hash": 13592831023957667364,
      "translation": "이 옵션은 'java -classpath' 옵션과 동일합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925891Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "When to use this option",
      "source_hash": 705158751300737306,
      "context_hash": 14538751354312803064,
      "translation": "이 옵션을 사용해야 하는 경우",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925891Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "This option is intended to ease and make more robust the use of Python in test or build scripts, for instance.",
      "source_hash": 1071995289970160442,
      "context_hash": 17577977837606499047,
      "translation": "이 옵션은 예를 들어 테스트 스크립트나 빌드 스크립트에서 Python을 더 쉽고 안정적으로 사용할 수 있도록 하기 위한 것입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925891Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Reference Implementation",
      "source_hash": 9294161050860502574,
      "context_hash": 16194607031683546403,
      "translation": "참조 구현",
      "glossary_snapshot": {
        "reference implementation": "참조 구현"
      },
      "translated_at": "2026-09-23T12:20:24.925891Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "A patch implementing this is available from SourceForge",
      "source_hash": 12077612711502658879,
      "context_hash": 14209102329422341658,
      "translation": "이를 구현한 패치는 SourceForge에서 받을 수 있습니다",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T12:20:24.925891Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "with the patch discussion at",
      "source_hash": 12543652270386235675,
      "context_hash": 12870435293580431251,
      "translation": "패치에 관한 논의는 다음에서 볼 수 있습니다",
      "glossary_snapshot": {},
