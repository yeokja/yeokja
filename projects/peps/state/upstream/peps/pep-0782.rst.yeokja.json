      "issues": []
    },
    {
      "id": "section:6/block:2/seg:0",
      "source": "High-level API",
      "source_hash": 3602040129982452913,
      "context_hash": 10523902193860286181,
      "translation": "고수준 API",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T05:04:31.958348Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
