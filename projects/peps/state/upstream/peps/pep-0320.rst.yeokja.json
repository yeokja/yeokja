      "glossary_snapshot": {},
      "translated_at": "2026-09-23T13:10:17.341930Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Deprecate and/or remove the modules listed in :pep:`4` (``posixfile``, ``gopherlib``, ``pre``, ``others``)",
      "source_hash": 17164685784026630037,
