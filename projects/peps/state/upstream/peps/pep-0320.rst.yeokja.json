      "translated_at": "2026-09-23T13:10:17.341931Z",
      "issues": []
    },
    {
      "id": "section:6/block:2/seg:0",
      "source": "Documentation: complete the distribution and installation manuals.",
      "source_hash": 1450224149549706667,
      "context_hash": 13081671071653095400,
      "translation": "문서: 배포 및 설치 매뉴얼을 완성합니다.",
