      "glossary_snapshot": {},
      "translated_at": "2026-09-12T05:46:56.138387Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:1",
      "source": "Follow the installation instructions from the [MoonBit download page](https://www.moonbitlang.com/download).",
      "source_hash": 2370402994296310397,
      "context_hash": 13063114244106661573,
      "translation": "[MoonBit 다운로드 페이지](https://www.moonbitlang.com/download)의 설치 안내를 따르십시오.",
      "glossary_snapshot": {},
