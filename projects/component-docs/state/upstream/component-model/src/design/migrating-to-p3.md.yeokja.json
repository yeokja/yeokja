      "source_hash": 996151861343917442,
      "context_hash": 16566406564795430817,
      "translation": "WASI 0.3 (컴포넌트 모델)",
      "glossary_snapshot": {
        "component model": "컴포넌트 모델",
        "component": "컴포넌트"
      },
      "translated_at": "2026-09-12T05:49:02.431242Z",
      "issues": []
    },
