      "translated_at": "2026-10-17T13:03:00.633100Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "Codes are stable identifiers.",
      "source_hash": 9982270014135690102,
      "context_hash": 8510658857160860370,
