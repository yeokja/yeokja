      "issues": []
    },
    {
      "id": "section:0/block:1/seg:2",
      "source": "Messages and secondary labels add context about the source program.",
      "source_hash": 14488495139484341798,
      "context_hash": 11011918339768134520,
      "translation": "메시지와 보조 레이블은 소스 프로그램에 대한 맥락을 덧붙입니다.",
