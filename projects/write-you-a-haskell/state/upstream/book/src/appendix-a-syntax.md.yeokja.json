    {
      "id": "section:4/block:0/seg:0",
      "source": "Patterns and Types",
      "source_hash": 17612726800752720531,
      "context_hash": 8881635768613334669,
      "translation": "패턴과 타입",
      "glossary_snapshot": {
        "patterns": "패턴",
        "types": "타입"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:0",
      "source": "Pattern variables are distinct within a pattern vector.",
      "source_hash": 14337422490692154599,
      "context_hash": 210598033858141063,
      "translation": "하나의 패턴 벡터 안에서 패턴 변수는 서로 달라야 합니다.",
      "glossary_snapshot": {
        "pattern": "패턴",
        "pattern vector": "패턴 벡터",
        "variables": "변수"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:1",
      "source": "Omitted record fields mean wildcards.",
      "source_hash": 10540814058766952753,
      "context_hash": 8938981848591050390,
      "translation": "생략된 레코드 필드는 와일드카드를 뜻합니다.",
      "glossary_snapshot": {
        "record fields": "레코드 필드",
        "wildcards": "와일드카드"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:2",
      "source": "Constructors in patterns must be saturated.",
      "source_hash": 15952454323339038802,
      "context_hash": 15661815803121291252,
      "translation": "패턴 안의 생성자는 포화되어 있어야 합니다.",
      "glossary_snapshot": {
        "constructors": "생성자",
        "patterns": "패턴",
        "saturated": "포화"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:3",
      "source": "Type synonyms must be fully applied and acyclic.",
      "source_hash": 17653511475704127907,
      "context_hash": 18368427541645587781,
      "translation": "타입 동의어는 완전히 적용되어야 하며 순환해서는 안 됩니다.",
      "glossary_snapshot": {
        "synonyms": "동의어",
        "type": "타입"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:4",
      "source": "There is no explicit `forall`, kind annotation, lazy pattern, qualified name, or user-defined infix constructor.",
      "source_hash": 14541224454105843546,
      "context_hash": 5326509282237237335,
      "translation": "명시적 `forall`, 카인드 표기, 지연 패턴, 한정된 이름, 사용자 정의 중위 생성자는 없습니다.",
      "glossary_snapshot": {
        "annotation": "표기",
        "constructor": "생성자",
        "infix": "중위",
        "pattern": "패턴"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Lexical Structure and Layout",
      "source_hash": 16253209537227050942,
      "context_hash": 6756723139421576963,
      "translation": "어휘 구조와 레이아웃",
      "glossary_snapshot": {
        "layout": "레이아웃"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Identifiers are ASCII: `varid` matches `[a-z_][A-Za-z0-9_']*` and `conid` matches `[A-Z][A-Za-z0-9_']*`. `_` alone is a wildcard.",
      "source_hash": 15128698678023849559,
      "context_hash": 11792622811657308693,
      "translation": "식별자는 ASCII로 이루어집니다. `varid`는 `[a-z_][A-Za-z0-9_']*`에, `conid`는 `[A-Z][A-Za-z0-9_']*`에 대응합니다. `_` 하나만 있으면 와일드카드입니다.",
      "glossary_snapshot": {
        "wildcard": "와일드카드"
      },
      "translated_at": "2026-10-17T13:02:19.429807Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "Reserved words are:",
      "source_hash": 1737054126512717545,
      "context_hash": 12337182057964379878,
      "translation": "예약어는 다음과 같습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "An operator is a maximal run of the following symbol characters, excluding the reserved operators below.",
      "source_hash": 13763017623372990381,
      "context_hash": 1125836849015070102,
      "translation": "연산자는 아래의 예약 연산자를 제외하고, 다음 기호 문자들이 최대한 길게 이어진 것입니다.",
      "glossary_snapshot": {
        "operator": "연산자",
        "operators": "연산자"
      },
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:1",
      "source": "User-defined operators cannot begin with `:`.",
      "source_hash": 11232011603538494084,
      "context_hash": 2868705776793005806,
      "translation": "사용자 정의 연산자는 `:`로 시작할 수 없습니다.",
      "glossary_snapshot": {
        "operators": "연산자"
      },
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
      "source": "Integer literals are decimal or `0x` hexadecimal, with underscore separators.",
      "source_hash": 11354447350125732573,
      "context_hash": 9410400462656657764,
      "translation": "정수 리터럴은 10진수 또는 `0x` 16진수이며, 밑줄을 구분자로 쓸 수 있습니다.",
      "glossary_snapshot": {
        "integer literals": "정수 리터럴",
        "separators": "구분자"
      },
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:1",
      "source": "Double literals contain a decimal point or an exponent, as in `1.5`, `1e10`, and `2.5e-3`.",
      "source_hash": 13650986200428002284,
      "context_hash": 8607685735412523966,
      "translation": "Double 리터럴은 `1.5`, `1e10`, `2.5e-3`처럼 소수점이나 지수를 포함합니다.",
      "glossary_snapshot": {
        "literals": "리터럴"
      },
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:2",
      "source": "Signs are syntax outside the literal token.",
      "source_hash": 13115213153009966932,
      "context_hash": 15456012804117245949,
      "translation": "부호는 리터럴 토큰 바깥에 있는 구문입니다.",
      "glossary_snapshot": {
        "literal": "리터럴",
        "syntax": "구문",
        "token": "토큰"
      },
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:3",
      "source": "Character literals contain one Unicode scalar in single quotes.",
      "source_hash": 12277845843926413691,
      "context_hash": 10696741675045396043,
      "translation": "문자 리터럴은 작은따옴표 안에 유니코드 스칼라 하나를 담습니다.",
      "glossary_snapshot": {
        "Unicode scalar": "유니코드 스칼라",
        "literals": "리터럴"
      },
      "translated_at": "2026-10-17T13:02:19.429808Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:4",
      "source": "Strings contain Unicode text in double quotes.",
      "source_hash": 5641558048215019073,
      "context_hash": 14202369386016766515,
      "translation": "문자열은 큰따옴표 안에 유니코드 텍스트를 담습니다.",
      "glossary_snapshot": {
        "Unicode": "유니코드",
        "strings": "문자열"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:5",
      "source": "Both support `\\n`, `\\t`, `\\\\`, `\\'`, `\\\"`, `\\0`, and `\\u{…}` escapes. `literal` ranges over integer, double, character, and string tokens.",
      "source_hash": 9493283821646329037,
      "context_hash": 696644887716001082,
      "translation": "둘 다 `\\n`, `\\t`, `\\\\`, `\\'`, `\\\"`, `\\0`, `\\u{…}` 이스케이프를 지원합니다. `literal`은 정수, Double, 문자, 문자열 토큰을 아우릅니다.",
      "glossary_snapshot": {
        "string": "문자열",
        "tokens": "토큰"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:6/seg:0",
      "source": "Line comments start with `--` followed by a nonsymbol character. `-->` is an operator.",
      "source_hash": 11105879546147564092,
      "context_hash": 15815017797446930279,
      "translation": "줄 주석은 `--` 뒤에 기호가 아닌 문자가 오면 시작됩니다. `-->`는 연산자입니다.",
      "glossary_snapshot": {
        "operator": "연산자"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:6/seg:1",
      "source": "Block comments use `{-` and `-}` and may nest.",
      "source_hash": 10096143623013239793,
      "context_hash": 9861567843525821278,
      "translation": "블록 주석은 `{-`와 `-}`를 사용하며 중첩될 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:0",
      "source": "Before layout, adjacency distinguishes projection dots.",
      "source_hash": 2243421412454581497,
      "context_hash": 11911239926851553353,
      "translation": "레이아웃 처리 전에, 인접 여부로 프로젝션 점을 구별합니다.",
      "glossary_snapshot": {
        "layout": "레이아웃",
        "projection": "프로젝션"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:1",
      "source": "A dot immediately after a variable, closing delimiter, or literal, and immediately before a `varid`, is `PROJ`.",
      "source_hash": 7315587338501951239,
      "context_hash": 2060077551272564541,
      "translation": "변수, 닫는 구분자, 리터럴 바로 뒤에 있으면서 `varid` 바로 앞에 있는 점은 `PROJ`입니다.",
      "glossary_snapshot": {
        "delimiter": "구분자",
        "literal": "리터럴",
        "variable": "변수"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:2",
      "source": "Immediately after `(` and before a `varid`, it is `PROJ_SECTION`.",
      "source_hash": 16282159945795249084,
      "context_hash": 1930420623053419193,
      "translation": "`(` 바로 뒤이면서 `varid` 앞에 있으면 `PROJ_SECTION`입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:3",
      "source": "Otherwise it is an ordinary operator.",
      "source_hash": 7723648475329669065,
      "context_hash": 9900651415079915958,
      "translation": "그 밖의 경우에는 일반 연산자입니다.",
      "glossary_snapshot": {
        "operator": "연산자"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:4",
      "source": "Consequently `f.g` projects a field, while `f . g` composes functions.",
      "source_hash": 10071348109545286659,
      "context_hash": 1266652163191549984,
      "translation": "따라서 `f.g`는 필드를 프로젝션하고, `f . g`는 함수를 합성합니다.",
      "glossary_snapshot": {
        "field": "필드",
        "functions": "함수"
      },
      "translated_at": "2026-10-17T13:02:19.429809Z",
      "issues": []
    },
    {
      "id": "section:5/block:8/seg:0",
      "source": "Layout inserts braces after `let`, `where`, `of`, and `do`, and around an unbraced file.",
      "source_hash": 375101597439287920,
      "context_hash": 17722704921626210969,
      "translation": "레이아웃은 `let`, `where`, `of`, `do` 뒤와 중괄호가 없는 파일 전체 둘레에 중괄호를 삽입합니다.",
      "glossary_snapshot": {
        "layout": "레이아웃"
      },
      "translated_at": "2026-10-17T13:01:43.063386Z",
      "issues": []
    },
    {
      "id": "section:5/block:8/seg:1",
      "source": "Equal indentation separates declarations or statements.",
      "source_hash": 4178640290391185770,
      "context_hash": 1843888292593366754,
      "translation": "들여쓰기가 같으면 선언이나 문장이 서로 구분됩니다.",
      "glossary_snapshot": {
        "declarations": "선언"
      },
      "translated_at": "2026-10-17T13:01:43.063386Z",
      "issues": []
    },
    {
      "id": "section:5/block:8/seg:2",
      "source": "Dedentation closes blocks.",
      "source_hash": 16067011617223778719,
      "context_hash": 630098027819632712,
      "translation": "들여쓰기가 줄어들면 블록이 닫힙니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-17T13:01:43.063387Z",
      "issues": []
    },
    {
      "id": "section:5/block:8/seg:3",
      "source": "Explicit braces take precedence, and `in` closes an implicit `let` block even on the same line. [Chapter 8](ch08-layout.md#see-the-invisible-delimiters) shows the inserted tokens directly.",
      "source_hash": 17172931372211214209,
      "context_hash": 7202756924871123961,
      "translation": "명시적인 중괄호가 우선순위를 가지며, `in`은 같은 줄에 있더라도 암묵적인 `let` 블록을 닫습니다. [8장](ch08-layout.md#see-the-invisible-delimiters)에서 삽입된 토큰을 직접 보여 줍니다.",
      "glossary_snapshot": {
        "Chapter": "장",
        "Explicit braces": "명시적인 중괄호",
        "precedence": "우선순위",
        "tokens": "토큰"
      },
      "translated_at": "2026-10-17T13:01:43.063387Z",
      "issues": []
    },
    {
      "id": "section:5/block:8/seg:4",
      "source": "The Haskell Report gives the underlying lexical and layout conventions [@haskell2010].",
      "source_hash": 1616042233430183925,
      "context_hash": 2651320026554476507,
      "translation": "Haskell Report는 그 바탕이 되는 어휘 규칙과 레이아웃 규칙을 제시합니다 [@haskell2010].",
      "glossary_snapshot": {
        "Haskell Report": "Haskell Report",
