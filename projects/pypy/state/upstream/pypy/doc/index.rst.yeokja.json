  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Welcome to PyPy's documentation!",
      "source_hash": 18264216971349425278,
      "context_hash": 63542534314626261,
      "translation": "PyPy 문서에 오신 것을 환영합니다!",
      "glossary_snapshot": {
        "PyPy": "PyPy"
      },
      "translated_at": "2026-09-24T03:22:14.336848Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Welcome to the documentation for PyPy, a fast_, compliant alternative implementation of the Python_ language.",
      "source_hash": 12421099059684174387,
      "context_hash": 16390298918312780264,
      "translation": "빠르고(fast_) 호환성을 갖춘 Python_ 언어의 대안 구현체인 PyPy의 문서에 오신 것을 환영합니다.",
      "glossary_snapshot": {
        "PyPy": "PyPy"
      },
      "translated_at": "2026-09-25T06:23:23.385914Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "If you want to find out more about what PyPy is, have a look at our :doc:`introduction` or consult the `PyPy website`_.",
      "source_hash": 3667798594144106163,
      "context_hash": 727750001158055675,
      "translation": "PyPy가 무엇인지 더 알아보고 싶으시다면 :doc:`introduction`\\ 을 살펴보시거나 `PyPy website`_\\ 를 참고하십시오.",
      "glossary_snapshot": {
        "PyPy": "PyPy"
      },
      "translated_at": "2026-09-25T06:23:23.387358Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "If you're interested in trying PyPy out, check out the :doc:`installation instructions <install>`.",
      "source_hash": 6035118392054208746,
      "context_hash": 10364929767772530357,
      "translation": "PyPy를 사용해 보고 싶으시다면 :doc:`설치 안내 <install>`\\ 를 확인하십시오.",
      "glossary_snapshot": {
        "PyPy": "PyPy"
      },
      "translated_at": "2026-09-25T06:23:23.388243Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "If you want to help develop PyPy, please have a look at :doc:`contributing <contributing>` and at the repo on https://github.com/pypy/pypy and get in touch (:ref:`contact`)!",
      "source_hash": 17086999464446068451,
      "context_hash": 5956572330990687927,
      "translation": "PyPy 개발에 참여하고 싶으시다면 :doc:`기여하기 <contributing>` 문서와 https://github.com/pypy/pypy 저장소를 살펴보신 뒤 연락해 주십시오(:ref:`contact`)!",
      "glossary_snapshot": {
        "PyPy": "PyPy"
      },
      "translated_at": "2026-09-25T06:23:41.867529Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "All of the documentation and source code is available under the MIT license, unless otherwise specified.",
      "source_hash": 17195483176370406450,
      "context_hash": 579620151129952342,
      "translation": "별도로 명시되지 않는 한, 모든 문서와 소스 코드는 MIT 라이선스로 제공됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T06:23:41.868060Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:1",
      "source": "Consult :source:`LICENSE`.",
      "source_hash": 8818691730583972167,
      "context_hash": 4630562208466256364,
