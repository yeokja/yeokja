    {
      "id": "section:0/block:0/seg:0",
      "source": "IBM Mainframe S390X",
      "source_hash": 15842214046315496211,
      "context_hash": 12574346675285264521,
      "translation": "IBM 메인프레임 S390X",
      "glossary_snapshot": {},
      "translated_at": "2026-09-23T22:41:22.386570Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Our JIT implements the 64 bit version of the IBM Mainframe called s390x.",
      "source_hash": 4983202752073798977,
      "context_hash": 6088987616177902602,
      "translation": "저희 JIT는 s390x라고 불리는 IBM 메인프레임의 64비트 버전을 구현합니다.",
      "glossary_snapshot": {
        "JIT": "JIT"
      },
      "translated_at": "2026-09-25T04:56:30.665431Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "Note that this architecture is big endian.",
      "source_hash": 9015917301184098444,
      "context_hash": 15955090233432160236,
      "translation": "이 아키텍처는 빅 엔디언(big endian)이라는 점에 유의하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T04:56:30.665433Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
