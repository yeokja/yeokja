      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "With the Nix ecosystem, you can:",
      "source_hash": 8486408038155686986,
      "context_hash": 10441646050444118635,
      "translation": "Nix 생태계를 사용하면 다음을 할 수 있습니다:",
      "glossary_snapshot": {
        "Nix": "Nix"
      },
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "{ref}`Reproducible development environments <ad-hoc-envs>`.",
      "source_hash": 18274798706350776931,
      "context_hash": 1339535226367619334,
      "translation": "{ref}`재현 가능한 개발 환경 <ad-hoc-envs>`.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Easy installation of software over URLs.",
      "source_hash": 9352118652215357836,
      "context_hash": 9539287323949731398,
      "translation": "URL을 통한 손쉬운 소프트웨어 설치.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "Easy transfer of software environments between computers.",
      "source_hash": 1818676499379760533,
      "context_hash": 17194709744889975473,
      "translation": "컴퓨터 간 소프트웨어 환경의 손쉬운 전송.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "{ref}`Declarative specification of Linux machines <deploy-nixos-using-terraform>`.",
      "source_hash": 3070893661167642733,
      "context_hash": 15193882730075742101,
