      "source_hash": 4078244797180121683,
      "context_hash": 17351470946418773771,
      "translation": "소프트웨어 감사 가능성에 대한 강력한 지원.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754567Z",
      "issues": []
    },
    {
