      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:9/seg:0",
      "source": "{ref}`Transparent build caching using binary caches <github-actions>`.",
      "source_hash": 6464855645430619481,
      "context_hash": 14112063957023172067,
