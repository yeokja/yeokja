      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
      "source": "{ref}`Reproducible integration testing using virtual machines <integration-testing-vms>`.",
      "source_hash": 9650099513700690114,
      "context_hash": 8220546714117535018,
      "translation": "{ref}`가상 머신을 이용한 재현 가능한 통합 테스트 <integration-testing-vms>`.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:7/seg:0",
      "source": "Avoidance of version conflicts with already installed software.",
      "source_hash": 14393758179331527507,
      "context_hash": 12990138347798496490,
      "translation": "이미 설치된 소프트웨어와의 버전 충돌 회피.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:16:57.754566Z",
      "issues": []
    },
    {
      "id": "section:2/block:8/seg:0",
