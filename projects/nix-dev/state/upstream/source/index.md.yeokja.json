      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "nix.dev is the home of official documentation for the Nix ecosystem.",
      "source_hash": 2057739661370551297,
      "context_hash": 12310156705606703988,
      "translation": "nix.dev는 Nix 생태계 공식 문서의 본거지입니다.",
      "glossary_snapshot": {
        "Nix": "Nix"
      },
      "translated_at": "2026-09-08T15:16:57.754564Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "It is maintained by the [Nix documentation team](https://nixos.org/community/teams/documentation).",
      "source_hash": 15618307257664718516,
      "context_hash": 86916440347862222,
      "translation": "[Nix 문서 팀](https://nixos.org/community/teams/documentation)이 관리하고 있습니다.",
      "glossary_snapshot": {
        "documentation team": "문서 팀",
        "Nix": "Nix"
      },
      "translated_at": "2026-09-08T15:16:57.754564Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "If you're new here, {ref}`install Nix <install-nix>` and begin your journey with our tutorial series!",
