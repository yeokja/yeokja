    {
      "id": "section:2/block:1/seg:0",
      "source": "[NixOS Wiki](https://wiki.nixos.org/) is a collection of NixOS user guides, configuration examples, and troubleshooting tips.",
      "source_hash": 8787411084148164905,
      "context_hash": 9932827079967568249,
      "translation": "[NixOS 위키](https://wiki.nixos.org/)는 NixOS 사용자 가이드, 설정 예제, 문제 해결 팁을 모아 놓은 것입니다.",
      "glossary_snapshot": {
        "configuration": "설정",
        "guides": "가이드",
        "NixOS": "NixOS"
      },
      "translated_at": "2026-09-08T15:17:23.348231Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "It is meant to be complementary to the NixOS reference manual.",
      "source_hash": 6355574075649630091,
      "context_hash": 2289302115047657442,
      "translation": "이는 NixOS 참조 매뉴얼을 보완하기 위한 것입니다.",
      "glossary_snapshot": {
        "NixOS": "NixOS",
        "reference manual": "참조 매뉴얼"
      },
      "translated_at": "2026-09-08T15:17:23.348231Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "It is collectively edited by the NixOS user community.",
      "source_hash": 15604040710302687141,
      "context_hash": 13701792268293040920,
      "translation": "이는 NixOS 사용자 커뮤니티가 공동으로 편집합니다.",
      "glossary_snapshot": {
        "NixOS": "NixOS"
      },
      "translated_at": "2026-09-08T15:17:23.348232Z",
      "issues": []
    },
