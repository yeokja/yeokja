    {
      "id": "section:1/block:16/seg:0",
      "source": "Add links to definitions, commands, options, etc. where only the name is mentioned",
      "source_hash": 11028269978237913597,
      "context_hash": 6423731741104029516,
      "translation": "이름만 언급된 정의, 명령, 옵션 등에 링크를 추가합니다",
