      "context_hash": 14676055799373499447,
      "translation": "문서 팀이 편집자로서 nix.dev를 유지 관리합니다.",
      "glossary_snapshot": {
        "documentation team": "문서 팀",
        "Nix": "Nix"
      },
      "translated_at": "2026-09-08T15:17:02.425222Z",
