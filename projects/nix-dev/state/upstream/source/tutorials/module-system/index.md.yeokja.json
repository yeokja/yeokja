      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:17:57.877272Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "This is a very long tutorial.",
      "source_hash": 15309670073105000211,
      "context_hash": 13286987717984978481,
      "translation": "이것은 매우 긴 튜토리얼입니다.",
      "glossary_snapshot": {
        "tutorial": "튜토리얼"
