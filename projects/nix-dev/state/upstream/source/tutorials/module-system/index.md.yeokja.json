  "segments": [
    {
      "id": "section:1/block:0/seg:0",
      "source": "Module system",
      "source_hash": 5306925073747173039,
      "context_hash": 17981494429951018625,
      "translation": "모듈 시스템",
      "glossary_snapshot": {
        "module": "모듈",
        "module system": "모듈 시스템"
      },
      "translated_at": "2026-09-08T15:17:57.877263Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Much of the power in Nixpkgs and NixOS comes from the module system.",
      "source_hash": 17819024164458107574,
      "context_hash": 6811927966532600185,
      "translation": "Nixpkgs와 NixOS의 힘 대부분은 모듈 시스템에서 나옵니다.",
      "glossary_snapshot": {
        "module": "모듈",
        "Nixpkgs": "Nixpkgs",
        "NixOS": "NixOS",
        "module system": "모듈 시스템"
      },
      "translated_at": "2026-09-08T15:17:57.877265Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "The module system is a Nix language library that enables you to",
      "source_hash": 16625972286159683776,
      "context_hash": 17946983976604189078,
      "translation": "모듈 시스템은 다음을 가능하게 하는 Nix 언어 라이브러리입니다.",
      "glossary_snapshot": {
        "module system": "모듈 시스템",
        "Nix": "Nix",
        "Nix language": "Nix 언어",
        "module": "모듈"
      },
      "translated_at": "2026-09-08T15:17:57.877267Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "Declare one attribute set using many separate Nix expressions.",
      "source_hash": 13153176026126647926,
      "context_hash": 11803107389574092526,
      "translation": "여러 개의 분리된 Nix 표현식을 사용하여 하나의 속성 집합을 선언합니다.",
      "glossary_snapshot": {
        "Nix": "Nix",
        "attribute set": "속성 집합",
        "attribute": "속성",
        "Nix expressions": "Nix 표현식"
      },
      "translated_at": "2026-09-08T15:17:57.877268Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "Imposes type constraints on values in that attribute set.",
      "source_hash": 3229809032934338536,
      "context_hash": 14552097410377154096,
      "translation": "해당 속성 집합의 값에 타입 제약을 부과합니다.",
      "glossary_snapshot": {
        "attribute set": "속성 집합",
        "attribute": "속성"
      },
      "translated_at": "2026-09-08T15:17:57.877268Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Define values for the same attribute in different Nix expressions and merge these values automatically according to their type.",
      "source_hash": 17684257603493778752,
      "context_hash": 14381799698956444788,
      "translation": "서로 다른 Nix 표현식에서 동일한 속성에 대한 값을 정의하고, 이 값들을 타입에 따라 자동으로 병합합니다.",
      "glossary_snapshot": {
        "Nix expressions": "Nix 표현식",
        "Nix": "Nix",
        "attribute": "속성"
      },
      "translated_at": "2026-09-08T15:17:57.877269Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "These Nix expressions are called modules and must have a particular structure.",
      "source_hash": 5048011289846301239,
      "context_hash": 4408766816994515503,
      "translation": "이러한 Nix 표현식을 모듈이라고 하며, 특정한 구조를 가져야 합니다.",
      "glossary_snapshot": {
        "Nix expressions": "Nix 표현식",
        "Nix": "Nix",
        "modules": "모듈"
      },
      "translated_at": "2026-09-08T15:17:57.877270Z",
      "issues": []
    },
    {
      "id": "section:1/block:7/seg:0",
      "source": "In this tutorial series you'll learn",
      "source_hash": 16727848018209904092,
      "context_hash": 13556421314267110839,
      "translation": "이 튜토리얼 시리즈에서는 다음을 배웁니다.",
      "glossary_snapshot": {
        "tutorial": "튜토리얼"
      },
      "translated_at": "2026-09-08T15:17:57.877270Z",
      "issues": []
    },
    {
      "id": "section:1/block:8/seg:0",
      "source": "What a module is and how to create one.",
      "source_hash": 12821082321772368060,
      "context_hash": 8662505133707878629,
      "translation": "모듈이란 무엇이고 어떻게 만드는지.",
      "glossary_snapshot": {
        "module": "모듈"
      },
      "translated_at": "2026-09-08T15:17:57.877270Z",
      "issues": []
    },
    {
      "id": "section:1/block:9/seg:0",
      "source": "What options are and how to declare them.",
      "source_hash": 14841739868228805841,
      "context_hash": 14188711405598929276,
      "translation": "옵션이란 무엇이고 어떻게 선언하는지.",
      "glossary_snapshot": {
        "options": "옵션"
      },
      "translated_at": "2026-09-08T15:17:57.877270Z",
      "issues": []
    },
    {
      "id": "section:1/block:10/seg:0",
      "source": "How to express dependencies between modules.",
      "source_hash": 1502297576903342529,
      "context_hash": 753642967792352221,
      "translation": "모듈 간의 의존성을 표현하는 방법.",
      "glossary_snapshot": {
        "dependencies": "의존성",
        "modules": "모듈"
      },
      "translated_at": "2026-09-08T15:17:57.877271Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "What do you need?",
      "source_hash": 4047784872726102973,
      "context_hash": 6566749568614072708,
      "translation": "무엇이 필요합니까?",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:17:57.877272Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Familiarity with data types and general programming concepts",
      "source_hash": 8849536889992621179,
      "context_hash": 2338961609493860646,
      "translation": "데이터 타입 및 일반적인 프로그래밍 개념에 대한 이해",
      "glossary_snapshot": {
        "concepts": "개념"
      },
      "translated_at": "2026-09-08T15:17:57.877272Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "A {ref}`Nix installation <install-nix>` to run the examples",
      "source_hash": 15381065243486219804,
      "context_hash": 4581663272813645118,
      "translation": "예제를 실행하기 위한 {ref}`Nix 설치 <install-nix>`",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:17:57.877272Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Intermediate proficiency in reading and writing the {ref}`Nix language <reading-nix-language>`",
      "source_hash": 11512429534426498236,
      "context_hash": 2650038387200008835,
      "translation": "{ref}`Nix 언어 <reading-nix-language>`를 읽고 쓰는 중급 수준의 능숙도",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T15:17:57.877272Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "How long will it take?",
      "source_hash": 9488368744995369773,
      "context_hash": 1779204152483820031,
