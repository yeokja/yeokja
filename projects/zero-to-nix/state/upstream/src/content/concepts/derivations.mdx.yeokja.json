      "source_hash": 10419209558970396246,
      "context_hash": 527611751951799772,
      "translation": "[Go]용 [`buildGoModule`][buildgomodule]",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T10:53:05.291686Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "[`buildRustPackage`][buildrustpackage] for [Rust]",
      "source_hash": 9741386300829866114,
      "context_hash": 17008771161664205869,
      "translation": "[Rust]용 [`buildRustPackage`][buildrustpackage]",
      "glossary_snapshot": {},
      "translated_at": "2026-09-25T10:53:05.291686Z",
