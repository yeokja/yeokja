    },
    {
      "id": "section:6/block:5/seg:0",
      "source": "You're likely to encounter many more in the Nix ecosystem.",
      "source_hash": 10199889722066571010,
      "context_hash": 2360710381417429160,
      "translation": "Nix 생태계에서 이보다 훨씬 더 많은 것들을 접하게 될 가능성이 큽니다.",
      "glossary_snapshot": {
