  "segments": [
    {
      "id": "section:0/block:1/seg:0",
      "source": "Sandboxing",
      "source_hash": 2043859425010582890,
      "context_hash": 14895582302805005944,
      "translation": "샌드박싱",
      "glossary_snapshot": {
        "sandboxing": "샌드박싱"
      },
      "translated_at": "2026-09-08T14:56:19.892339Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "Isolating the Nix build process from everything else on your system",
      "source_hash": 14663855613761155430,
      "context_hash": 378546187722464396,
      "translation": "Nix 빌드 프로세스를 시스템의 다른 모든 것으로부터 격리하기",
      "glossary_snapshot": {
        "Nix": "Nix"
      },
      "translated_at": "2026-09-08T14:56:19.892339Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "Whenever Nix builds anything, it _sandboxes_ that process from everything else on the host system.",
      "source_hash": 2857576765552095001,
      "context_hash": 18011756427161188536,
      "translation": "Nix는 무언가를 빌드할 때마다, 해당 프로세스를 호스트 시스템의 다른 모든 것으로부터 *샌드박싱*합니다.",
      "glossary_snapshot": {
        "Nix": "Nix"
      },
      "translated_at": "2026-09-08T14:56:19.892340Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:1",
      "source": "Nix builds are sandboxed for a variety of reasons:",
      "source_hash": 16053002006079268508,
      "context_hash": 3763748357790237682,
      "translation": "Nix 빌드가 샌드박스되는 데는 다양한 이유가 있습니다:",
      "glossary_snapshot": {
        "Nix": "Nix",
        "sandboxed": "샌드박스"
      },
      "translated_at": "2026-09-08T14:56:19.892340Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "The ensure [reproducibility].",
      "source_hash": 16430822490830138999,
      "context_hash": 6501292976264524399,
      "translation": "[재현성][reproducibility]을 보장하기 위해서입니다.",
      "glossary_snapshot": {
        "reproducibility": "재현성"
      },
      "translated_at": "2026-09-08T14:56:19.892340Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:1",
      "source": "Sandboxing ensures that no system state on the host machine affects the build outcomes.",
      "source_hash": 17491499400975807072,
      "context_hash": 1502222453408602826,
      "translation": "샌드박싱은 호스트 머신의 어떤 시스템 상태도 빌드 결과에 영향을 미치지 않도록 보장합니다.",
      "glossary_snapshot": {
        "sandboxing": "샌드박싱"
      },
      "translated_at": "2026-09-08T14:56:19.892340Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "To maintain strict [provenance].",
      "source_hash": 1262375314550454057,
      "context_hash": 17567402302146089682,
      "translation": "엄격한 [출처][provenance]를 유지하기 위해서입니다.",
      "glossary_snapshot": {
        "provenance": "출처"
      },
      "translated_at": "2026-09-08T14:56:19.892340Z",
      "issues": []
    }
  ]
}
