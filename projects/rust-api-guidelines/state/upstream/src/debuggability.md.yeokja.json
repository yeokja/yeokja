      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "`Debug` representation is never empty (C-DEBUG-NONEMPTY)",
      "source_hash": 14133034840271214779,
      "context_hash": 2349534702786170612,
      "translation": "`Debug` 표현은 결코 비어 있지 않습니다 (C-DEBUG-NONEMPTY)",
