      "issues": []
    },
    {
      "id": "section:0/block:14/seg:0",
      "source": "Arc sine.",
      "source_hash": 9044560044646418231,
      "context_hash": 881932834443649346,
      "translation": "아크 사인.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:14/seg:1",
      "source": "Returns an angle whose sine is x.",
      "source_hash": 15457190669279535509,
      "context_hash": 14691035748119223112,
      "translation": "사인 값이 x인 각도를 반환합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:14/seg:2",
      "source": "The range of values returned by this function is [−π/2, π/2] Results are undefined if ∣x∣ > 1.",
      "source_hash": 7277983281898438561,
      "context_hash": 10333917509692891273,
      "translation": "이 함수가 반환하는 값의 범위는 [−π/2, π/2]입니다. ∣x∣ > 1이면 결과는 정의되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:15/seg:0",
      "source": "Arc cosine.",
      "source_hash": 13577417148868066394,
      "context_hash": 15465190893674362515,
      "translation": "아크 코사인.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:15/seg:1",
      "source": "Returns an angle whose cosine is x.",
      "source_hash": 3070602773431462624,
      "context_hash": 14721393297720568327,
      "translation": "코사인 값이 x인 각도를 반환합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:15/seg:2",
      "source": "The range of values returned by this function is [0, π].",
      "source_hash": 5355348921682322222,
      "context_hash": 643996328687345587,
      "translation": "이 함수가 반환하는 값의 범위는 [0, π]입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:15/seg:3",
      "source": "Results are undefined if ∣x∣ > 1.",
      "source_hash": 693016201425789280,
      "context_hash": 16581043660908548574,
      "translation": "∣x∣ > 1이면 결과는 정의되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:16/seg:0",
      "source": "Arc tangent.",
      "source_hash": 1569251819145682011,
      "context_hash": 13287904317962622699,
      "translation": "아크 탄젠트.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:16/seg:1",
      "source": "Returns an angle whose tangent is y/x.",
      "source_hash": 14980827419340696432,
      "context_hash": 513179998807190925,
      "translation": "탄젠트 값이 y/x인 각도를 반환합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489269Z",
      "issues": []
    },
    {
      "id": "section:0/block:16/seg:2",
      "source": "The signs of x and y are used to determine what quadrant the angle is in.",
      "source_hash": 2883304882274963107,
      "context_hash": 15695795005689419842,
      "translation": "x와 y의 부호는 각도가 어느 사분면에 있는지를 결정하는 데 사용됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:16/seg:3",
      "source": "The range of values returned by this function is [−π,π].",
      "source_hash": 1066750326254131131,
      "context_hash": 14626019483380135699,
      "translation": "이 함수가 반환하는 값의 범위는 [−π,π]입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:16/seg:4",
      "source": "Results are undefined if x and y are both 0.",
      "source_hash": 8326843321414089294,
      "context_hash": 597266440433311911,
      "translation": "x와 y가 모두 0이면 결과는 정의되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:17/seg:0",
      "source": "Arc hyperbolic cosine; returns the non-negative inverse of cosh.",
      "source_hash": 16818440754496731439,
      "context_hash": 2599920350635092546,
      "translation": "아크 하이퍼볼릭 코사인; cosh의 음이 아닌 역함수 값을 반환합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:17/seg:1",
      "source": "Results are undefined if x < 1.",
      "source_hash": 12570905689263508509,
      "context_hash": 15920811312653924166,
      "translation": "x < 1이면 결과는 정의되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:18/seg:0",
      "source": "Arc hyperbolic tangent; returns the inverse of tanh.",
      "source_hash": 4820338781491554328,
      "context_hash": 811182683626663040,
      "translation": "아크 하이퍼볼릭 탄젠트; tanh의 역함수 값을 반환합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:18/seg:1",
      "source": "Results are undefined if ∣x∣≥1.",
      "source_hash": 6032404862538117241,
      "context_hash": 6965742066054781312,
      "translation": "∣x∣≥1이면 결과는 정의되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:26.489270Z",
      "issues": []
    },
    {
      "id": "section:0/block:19/seg:0",
      "source": "Returns x raised to the y power, i.e., x",
      "source_hash": 5811899844603836168,
      "context_hash": 11047555726920265179,
      "translation": "x를 y 제곱한 값, 즉 x",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:24.737257Z",
      "issues": []
    },
    {
