      "issues": []
    },
    {
      "id": "section:0/block:21/seg:1",
      "source": "Results are undefined if x < 0.",
      "source_hash": 479740567935751092,
      "context_hash": 12091813627677524697,
      "translation": "x < 0이면 결과는 정의되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-12T07:06:24.737259Z",
      "issues": []
    },
    {
      "id": "section:0/block:21/seg:2",
