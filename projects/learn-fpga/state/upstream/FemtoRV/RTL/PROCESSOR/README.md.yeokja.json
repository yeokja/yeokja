    {
      "id": "section:0/block:0/seg:0",
      "source": "FemtoRV processor collection",
      "source_hash": 15093562208784882204,
      "context_hash": 845977688568218363,
      "translation": "FemtoRV 프로세서 모음",
      "glossary_snapshot": {
        "FemtoRV": "FemtoRV"
      },
      "translated_at": "2026-09-24T12:07:46.497869Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "FemtoRV is a collection of small and understandable RISC-V processors.",
      "source_hash": 12982997759586300025,
      "context_hash": 949836270817770749,
      "translation": "FemtoRV는 작고 이해하기 쉬운 RISC-V 프로세서의 모음입니다.",
      "glossary_snapshot": {
        "RISC-V": "RISC-V",
        "FemtoRV": "FemtoRV"
      },
      "translated_at": "2026-09-24T12:07:46.497869Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "See this table to choose the most suitable one for your project!",
      "source_hash": 7887032236772430377,
      "context_hash": 5904127179033785459,
      "translation": "이 표를 보고 여러분의 프로젝트에 가장 적합한 것을 고르십시오!",
      "glossary_snapshot": {},
      "translated_at": "2026-09-24T12:07:46.497870Z",
      "issues": []
    },
