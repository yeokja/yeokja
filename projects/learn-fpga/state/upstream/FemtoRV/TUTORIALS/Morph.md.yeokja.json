    {
      "id": "section:2/block:1/seg:0",
      "source": "Pipelined with branch prediction",
      "source_hash": 15817333279882719122,
      "context_hash": 11668445305471173982,
      "translation": "분기 예측을 포함한 파이프라인 구조입니다",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T00:54:43.978396Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
