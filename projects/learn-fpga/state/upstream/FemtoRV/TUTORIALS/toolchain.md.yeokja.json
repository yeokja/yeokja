      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Note that instructions are different, depending on the family of your FPGA:",
      "source_hash": 6190942734763792381,
      "context_hash": 11686632071144748637,
      "translation": "FPGA 계열에 따라 안내가 다르다는 점에 유의하십시오.",
      "glossary_snapshot": {
        "FPGA": "FPGA"
