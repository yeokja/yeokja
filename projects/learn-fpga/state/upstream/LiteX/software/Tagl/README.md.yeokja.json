      "context_hash": 1025326289093308546,
      "translation": "그런 다음 다음 키를 사용해 시각화를 조작할 수 있습니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-09-08T00:55:29.156801Z",
      "issues": []
    },
