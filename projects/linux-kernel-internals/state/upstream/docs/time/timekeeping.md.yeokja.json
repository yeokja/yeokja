    {
      "id": "section:0/block:1/seg:0",
      "source": "How the kernel tracks time: TSC, HPET, clocksources, and NTP",
      "source_hash": 987997630161418391,
      "context_hash": 6528913179489608115,
      "translation": "커널이 시간을 추적하는 방법: TSC, HPET, clocksource, NTP",
      "glossary_snapshot": {
        "Clocksources": "clocksource",
        "NTP": "NTP",
        "TSC": "TSC",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:40:03.472148Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Two abstractions: clocksource and clockevent",
      "source_hash": 13597008624827333751,
      "context_hash": 8847575392466615453,
      "translation": "두 가지 추상화: clocksource와 clockevent",
      "glossary_snapshot": {
        "clocksource": "clocksource"
      },
      "translated_at": "2026-11-14T22:40:03.472148Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "The kernel splits time hardware into two roles:",
      "source_hash": 6908876112746862373,
      "context_hash": 5690087878726480385,
      "translation": "커널은 시간 하드웨어를 두 가지 역할로 나눕니다:",
      "glossary_snapshot": {
        "hardware": "하드웨어",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:40:03.472148Z",
      "issues": []
    },
    {
