    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "The timekeeper holds the current time state and is updated on every tick and NTP adjustment:",
      "source_hash": 12318096209709025927,
      "context_hash": 10808039570429022078,
      "translation": "timekeeper는 현재 시간 상태를 보관하며, 매 틱과 NTP 조정 시마다 갱신됩니다:",
      "glossary_snapshot": {
        "NTP": "NTP"
      },
      "translated_at": "2026-11-14T22:40:03.472150Z",
      "issues": []
    },
