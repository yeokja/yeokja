      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "POSIX timer APIs",
      "source_hash": 3156884761628533444,
      "context_hash": 11740599037297846377,
      "translation": "POSIX 타이머 API",
      "glossary_snapshot": {
