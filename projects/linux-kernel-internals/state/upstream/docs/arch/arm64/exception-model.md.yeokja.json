    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Syscall entry (SVC)",
      "source_hash": 12765685374350956189,
      "context_hash": 6111702110619755402,
      "translation": "시스템 콜 진입(SVC)",
      "glossary_snapshot": {
        "syscall entry": "시스템 콜 진입"
      },
      "translated_at": "2026-11-14T21:48:58.029764Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "On ARM64, system calls use the `SVC #0` instruction (Supervisor Call):",
      "source_hash": 14588601524095175466,
      "context_hash": 3696964676171985658,
      "translation": "ARM64에서 시스템 콜은 `SVC #0` 명령어(Supervisor Call)를 사용합니다:",
      "glossary_snapshot": {
        "system call": "시스템 콜"
      },
      "translated_at": "2026-11-14T21:48:58.029765Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "The kernel SVC handler:",
      "source_hash": 13739650675075365597,
      "context_hash": 8727857451102014357,
      "translation": "커널 SVC 핸들러:",
      "glossary_snapshot": {
        "handler": "핸들러",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T21:48:58.029765Z",
      "issues": []
    },
    {
      "id": "section:5/block:6/seg:0",
      "source": "The syscall number is in `x8`, arguments in `x0-x5`, and the return value goes into `x0`.",
      "source_hash": 7033670943203288284,
      "context_hash": 12972682942976283779,
      "translation": "시스템 콜 번호는 `x8`에, 인자는 `x0-x5`에 들어 있으며, 반환값은 `x0`에 들어갑니다.",
      "glossary_snapshot": {
        "syscall number": "시스템 콜 번호"
      },
      "translated_at": "2026-11-14T21:48:58.029765Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "GIC: Generic Interrupt Controller",
      "source_hash": 1103198414083378256,
      "context_hash": 15346409773464361746,
      "translation": "GIC: Generic Interrupt Controller(범용 인터럽트 컨트롤러)",
      "glossary_snapshot": {
