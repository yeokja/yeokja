    },
    {
      "id": "section:6/block:7/seg:0",
      "source": "IPIs on ARM64",
      "source_hash": 16148998591304892498,
      "context_hash": 686211984267556984,
      "translation": "ARM64의 IPI",
      "glossary_snapshot": {
        "IPI": "IPI"
      },
      "translated_at": "2026-11-14T21:48:58.029766Z",
      "issues": []
    },
    {
      "id": "section:6/block:8/seg:0",
      "source": "ARM64 IPIs (for TLB shootdown, function calls, rescheduling) use GIC SGIs:",
