      "context_hash": 16566465051200738862,
      "translation": "MMU가 활성화되기 전에 커널은 다음을 매핑하는 최소한의 페이지 테이블을 생성합니다:",
      "glossary_snapshot": {
        "MMU": "MMU",
        "page table": "페이지 테이블"
      },
      "translated_at": "2026-11-14T21:58:09.459893Z",
      "issues": []
    },
