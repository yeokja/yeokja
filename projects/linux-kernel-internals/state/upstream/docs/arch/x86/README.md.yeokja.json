  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "x86-64 Architecture",
      "source_hash": 11992029222539605361,
      "context_hash": 14023884022246850896,
      "translation": "x86-64 아키텍처",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:59:49.012290Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Real mode, protected mode, long mode — and everything the kernel does to keep it all running",
      "source_hash": 6283111273604350699,
      "context_hash": 1603460310160793831,
      "translation": "리얼 모드, 보호 모드, 롱 모드 — 그리고 이 모든 것을 계속 동작하게 하기 위해 커널이 하는 모든 일",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T21:59:49.012291Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why x86-64 internals matter",
      "source_hash": 1744479330788039724,
      "context_hash": 9347074930152747734,
      "translation": "x86-64 내부 구조가 중요한 이유",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:59:49.012291Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "x86-64 is the architecture that runs the overwhelming majority of Linux servers, desktops, and cloud infrastructure.",
      "source_hash": 15844924614092611711,
      "context_hash": 10488130240627997097,
      "translation": "x86-64는 Linux 서버, 데스크톱, 클라우드 인프라의 압도적 다수를 구동하는 아키텍처입니다.",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T21:59:49.012291Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Understanding its internals is essential for:",
      "source_hash": 8662513652633660140,
      "context_hash": 11593825831382530836,
      "translation": "그 내부 구조를 이해하는 것은 다음과 같은 사람들에게 필수적입니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:59:49.012291Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Kernel developers** debugging crashes — reading oops output requires knowing how exceptions are delivered, what `CR2` contains, and how `pt_regs` is laid out on the stack",
      "source_hash": 16946254195754807677,
      "context_hash": 10040195926312322740,
      "translation": "크래시를 디버깅하는 **커널 개발자** — oops 출력을 읽으려면 예외가 어떻게 전달되는지, `CR2`에 무엇이 들어 있는지, `pt_regs`가 스택에 어떻게 배치되는지 알아야 합니다",
      "glossary_snapshot": {
        "kernel": "커널",
        "oops": "oops"
      },
      "translated_at": "2026-11-14T21:59:49.012291Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Performance engineers** diagnosing regressions — KPTI CR3 switching costs, PCID invalidation overhead, and TSC drift are x86-specific phenomena",
      "source_hash": 13692313397114090731,
      "context_hash": 4965290364764689679,
      "translation": "회귀를 진단하는 **성능 엔지니어** — KPTI CR3 전환 비용, PCID 무효화 오버헤드, TSC 드리프트는 x86 고유의 현상입니다",
      "glossary_snapshot": {
        "KPTI": "KPTI",
        "PCID": "PCID",
        "TSC": "TSC",
        "overhead": "오버헤드",
        "regressions": "회귀"
      },
      "translated_at": "2026-11-14T21:59:49.012291Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Security researchers** understanding mitigations — Spectre, Meltdown, and their fixes are deeply architecture-specific",
      "source_hash": 17656580711850515086,
      "context_hash": 207408396496092715,
      "translation": "완화 기법을 이해하려는 **보안 연구자** — Spectre, Meltdown과 그 수정 사항은 아키텍처에 깊이 의존합니다",
      "glossary_snapshot": {
        "Meltdown": "Meltdown",
        "Spectre": "Spectre"
      },
      "translated_at": "2026-11-14T21:59:49.012318Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Systems programmers** building OS-adjacent tools — vDSO, seccomp BPF, and ptrace all depend on how SYSCALL and SYSRET work",
      "source_hash": 7887699252595198408,
      "context_hash": 2835154265655793865,
      "translation": "**시스템 프로그래머**: OS에 가까운 도구를 만들 때 — vDSO, seccomp BPF, ptrace는 모두 시스템 콜 명령어인 SYSCALL과 SYSRET의 동작 방식에 의존합니다",
      "glossary_snapshot": {
        "BPF": "BPF",
        "ptrace": "ptrace",
        "seccomp": "seccomp",
        "syscall": "시스템 콜",
        "vDSO": "vDSO"
      },
      "translated_at": "2026-11-14T21:59:49.012319Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "The x86-64 architecture carries 40 years of backward compatibility — from real mode BIOS boot, through protected mode, to 64-bit long mode.",
      "source_hash": 11420659320635534511,
      "context_hash": 6343218603496974512,
      "translation": "x86-64 아키텍처는 리얼 모드 BIOS 부팅부터 보호 모드를 거쳐 64비트 롱 모드에 이르기까지 40년에 걸친 하위 호환성을 짊어지고 있습니다.",
      "glossary_snapshot": {
        "bit": "비트"
      },
      "translated_at": "2026-11-14T21:59:49.012319Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:1",
      "source": "The kernel must navigate all of these modes during boot and then maintain the long-mode invariants that user processes rely on.",
      "source_hash": 2264227762287045612,
      "context_hash": 5985376686660688024,
      "translation": "커널은 부팅 중에 이 모든 모드를 거쳐 가야 하며, 그 후에는 사용자 프로세스가 의존하는 롱 모드 불변 조건을 유지해야 합니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "processes": "프로세스"
      },
      "translated_at": "2026-11-14T21:59:49.012319Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Mode transitions at boot",
      "source_hash": 7890379089428226746,
      "context_hash": 1766268155925959552,
      "translation": "부팅 시 모드 전환",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:59:49.012320Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "UEFI boot skips the real mode steps entirely — the firmware hands off to the kernel's EFI stub already in protected mode (32-bit) or directly in long mode (64-bit), depending on the firmware bitness.",
      "source_hash": 2654514920897709852,
      "context_hash": 14782677836897454907,
      "translation": "UEFI 부팅은 리얼 모드 단계를 완전히 건너뜁니다 — 펌웨어는 펌웨어 비트 수에 따라 이미 보호 모드(32비트)이거나 곧바로 롱 모드(64비트)인 상태에서 커널의 EFI stub으로 제어를 넘깁니다.",
      "glossary_snapshot": {
        "bit": "비트",
        "firmware": "펌웨어",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T21:59:49.012320Z",
      "issues": []
    },
