{
  "version": 1,
  "source_hash": 8059476132236534258,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Understanding /proc/diskstats",
      "source_hash": 8595060281074221378,
      "context_hash": 4730416373550661110,
      "translation": "/proc/diskstats 이해하기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580174Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "A field-by-field guide to reading and interpreting Linux block device statistics",
      "source_hash": 1366594580147561939,
      "context_hash": 6843191908868536219,
      "translation": "Linux 블록 디바이스 통계를 읽고 해석하기 위한 필드별 가이드",
      "glossary_snapshot": {
        "Linux": "Linux",
        "block device": "블록 디바이스"
      },
      "translated_at": "2026-11-14T22:42:38.580176Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What `/proc/diskstats` tells you",
      "source_hash": 7380891807275132591,
      "context_hash": 5086337966774900538,
      "translation": "`/proc/diskstats`가 알려 주는 정보",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580176Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "`/proc/diskstats` exposes per-block-device I/O counters maintained by the kernel's block layer.",
      "source_hash": 7034498152395439921,
      "context_hash": 5844508193803901872,
      "translation": "`/proc/diskstats`는 커널의 블록 계층이 관리하는 블록 디바이스별 I/O 카운터를 노출합니다.",
      "glossary_snapshot": {
        "block layer": "블록 계층",
        "device": "디바이스",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:42:38.580177Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Every I/O request that passes through `blk-mq` is counted here — reads, writes, discards, flushes, queue time, and service time.",
      "source_hash": 10412627163662199529,
      "context_hash": 4732596572274146660,
      "translation": "`blk-mq`를 거치는 모든 I/O 요청이 여기에 집계됩니다 — 읽기, 쓰기, discard, flush, 큐 대기 시간, 서비스 시간이 포함됩니다.",
      "glossary_snapshot": {
        "queue": "큐"
      },
      "translated_at": "2026-11-14T22:42:38.580178Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "The counters are cumulative since boot.",
      "source_hash": 13130294740000062877,
      "context_hash": 7504574375901970452,
      "translation": "카운터는 부팅 이후 누적된 값입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580179Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:1",
      "source": "To get rates, take the delta between two readings.",
      "source_hash": 6394791832611387349,
      "context_hash": 17327957769616754525,
      "translation": "속도를 구하려면 두 번 읽은 값의 차이를 계산하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580179Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Field reference",
      "source_hash": 6713396171683754658,
      "context_hash": 15652590863190447671,
      "translation": "필드 참조",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580179Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Fields 4–7: Reads",
      "source_hash": 11428938255795116696,
      "context_hash": 2193989593307703197,
      "translation": "필드 4–7: 읽기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580179Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Field 4: `reads_completed`",
      "source_hash": 4525622250376375642,
      "context_hash": 17059227776518404685,
      "translation": "필드 4: `reads_completed`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580179Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "The number of read I/Os that completed successfully.",
      "source_hash": 14295256011071394824,
      "context_hash": 8499521206415302916,
      "translation": "성공적으로 완료된 읽기 I/O의 수입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580179Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:1",
      "source": "This includes I/Os that were satisfied from the device (not from a higher-level cache).",
      "source_hash": 12770357222685052950,
      "context_hash": 10185672749929671699,
      "translation": "여기에는 (상위 수준 캐시가 아니라) 디바이스에서 처리된 I/O가 포함됩니다.",
      "glossary_snapshot": {
        "cache": "캐시",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:38.580180Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:2",
      "source": "Does **not** include reads merged into an existing queued request before they were issued (those are counted in field 5).",
      "source_hash": 18229494691117867067,
      "context_hash": 14370346519731809270,
      "translation": "발행되기 전에 이미 큐에 있던 요청에 병합된 읽기는 포함하지 **않습니다**(이러한 읽기는 필드 5에 집계됩니다).",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580180Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "Field 5: `reads_merged`",
      "source_hash": 16965365263435932717,
      "context_hash": 11987982655100305938,
      "translation": "필드 5: `reads_merged`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580180Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "The number of read requests that were merged with an adjacent in-flight request before being issued to the device.",
      "source_hash": 2749269174337307755,
      "context_hash": 7861675745727550113,
      "translation": "디바이스에 발행되기 전에 인접한 처리 중(in-flight) 요청과 병합된 읽기 요청의 수입니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:38.580180Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:1",
      "source": "Two reads for adjacent sectors can be merged into one larger read, reducing IOPS at the device level.",
      "source_hash": 12185427866685509458,
      "context_hash": 12771236031046939714,
      "translation": "인접한 섹터에 대한 두 읽기는 하나의 더 큰 읽기로 병합될 수 있으며, 이를 통해 디바이스 수준의 IOPS가 줄어듭니다.",
      "glossary_snapshot": {
        "IOPS": "IOPS",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:38.580181Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "A high merge ratio indicates good I/O locality and an efficient I/O scheduler.",
      "source_hash": 137983680888912241,
      "context_hash": 11726929732968089155,
      "translation": "병합 비율이 높으면 I/O 지역성이 좋고 I/O 스케줄러가 효율적이라는 뜻입니다.",
      "glossary_snapshot": {
        "locality": "지역성",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T22:42:38.580181Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:1",
      "source": "A low ratio (close to 0) is normal for NVMe with `none` scheduler or for purely random workloads.",
      "source_hash": 12926845617053920480,
      "context_hash": 6799657421238862277,
      "translation": "비율이 낮은 것(0에 가까운 것)은 `none` 스케줄러를 사용하는 NVMe나 순수한 랜덤 워크로드에서는 정상입니다.",
      "glossary_snapshot": {
        "NVMe": "NVMe",
        "scheduler": "스케줄러",
        "workloads": "워크로드"
      },
      "translated_at": "2026-11-14T22:42:38.580181Z",
      "issues": []
    },
    {
      "id": "section:3/block:8/seg:0",
      "source": "Field 6: `sectors_read`",
      "source_hash": 16305512437693790609,
      "context_hash": 14629380746191091807,
      "translation": "필드 6: `sectors_read`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580181Z",
      "issues": []
    },
    {
      "id": "section:3/block:9/seg:0",
      "source": "Total sectors (512 bytes each) read.",
      "source_hash": 16248131624940045848,
      "context_hash": 8319235881441013698,
      "translation": "읽은 섹터(각 512바이트)의 총수입니다.",
      "glossary_snapshot": {
        "bytes": "바이트"
      },
      "translated_at": "2026-11-14T22:42:38.580182Z",
      "issues": []
    },
    {
      "id": "section:3/block:9/seg:1",
      "source": "Divide by 2048 for megabytes, or use:",
      "source_hash": 5842589924319322823,
      "context_hash": 3472282666205455036,
      "translation": "메가바이트로 환산하려면 2048로 나누거나 다음을 사용하십시오:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580182Z",
      "issues": []
    },
    {
      "id": "section:3/block:11/seg:0",
      "source": "Field 7: `ms_reading`",
      "source_hash": 1099064945790899262,
      "context_hash": 4467634918372544295,
      "translation": "필드 7: `ms_reading`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580182Z",
      "issues": []
    },
    {
      "id": "section:3/block:12/seg:0",
      "source": "Total milliseconds spent in read I/Os.",
      "source_hash": 2289947439856651535,
      "context_hash": 11401498594733046001,
      "translation": "읽기 I/O에 소요된 총 밀리초입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580182Z",
      "issues": []
    },
    {
      "id": "section:3/block:12/seg:1",
      "source": "This is the sum of the duration of each read request from when it was issued to the device until it completed.",
      "source_hash": 15708160614122007084,
      "context_hash": 4663242861598193363,
      "translation": "각 읽기 요청이 디바이스에 발행된 시점부터 완료될 때까지 걸린 시간의 합계입니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:38.580182Z",
      "issues": []
    },
    {
      "id": "section:3/block:14/seg:0",
      "source": "If `ms_reading / reads_completed` is much higher than the device's rated latency (e.g., 10ms on an NVMe that should do 0.1ms), I/Os are spending time queued in the scheduler before reaching the device, or the device is under heavy contention.",
      "source_hash": 4007756160152526914,
      "context_hash": 16547691065691717184,
      "translation": "`ms_reading / reads_completed`가 디바이스의 정격 지연 시간보다 훨씬 높다면(예: 0.1ms여야 하는 NVMe에서 10ms), I/O가 디바이스에 도달하기 전에 스케줄러의 큐에서 대기하며 시간을 보내고 있거나 디바이스에 심한 경합이 발생하고 있는 것입니다.",
      "glossary_snapshot": {
        "NVMe": "NVMe",
        "contention": "경합",
        "device": "디바이스",
        "latency": "지연 시간",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T22:42:38.580183Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Fields 8–11: Writes",
      "source_hash": 13813452727309187800,
      "context_hash": 5093695110259809677,
      "translation": "필드 8–11: 쓰기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580183Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "The write fields mirror the read fields:",
      "source_hash": 647382988853912832,
      "context_hash": 13965516446951005765,
      "translation": "쓰기 필드는 읽기 필드와 같은 구조입니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580183Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:0",
      "source": "**Field 8** (`writes_completed`): writes finished successfully",
      "source_hash": 7031434092251277858,
      "context_hash": 580755828739718664,
      "translation": "**필드 8**(`writes_completed`): 성공적으로 완료된 쓰기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580183Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "**Field 9** (`writes_merged`): writes merged before issue",
      "source_hash": 17913798861092846976,
      "context_hash": 3612407584987559446,
      "translation": "**필드 9**(`writes_merged`): 발행 전에 병합된 쓰기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580183Z",
      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "**Field 10** (`sectors_written`): sectors written (× 512 bytes)",
      "source_hash": 331426873074671160,
      "context_hash": 16319755803250799117,
      "translation": "**필드 10**(`sectors_written`): 기록된 섹터(× 512바이트)",
      "glossary_snapshot": {
        "bytes": "바이트"
      },
      "translated_at": "2026-11-14T22:42:38.580183Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "**Field 11** (`ms_writing`): total ms spent in write I/Os",
      "source_hash": 2116402653343776536,
      "context_hash": 2564636381584205557,
      "translation": "**필드 11**(`ms_writing`): 쓰기 I/O에 소요된 총 ms",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:38.580184Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:0",
      "source": "**Write latency vs read latency**: on HDDs and SSDs, writes are often faster than reads at the device level because of write caching.",
      "source_hash": 13107134524072148430,
      "context_hash": 3499089151094174029,
      "translation": "**쓰기 지연 시간과 읽기 지연 시간**: HDD와 SSD에서는 쓰기 캐싱 때문에 디바이스 수준에서 쓰기가 읽기보다 빠른 경우가 많습니다.",
      "glossary_snapshot": {
        "HDDs": "HDD",
        "SSDs": "SSD",
        "device": "디바이스",
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:42:45.080022Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:1",
      "source": "But writes with `fsync()` are slower because they must flush the device cache — the `ms_writing` counter includes the flush wait.",
      "source_hash": 13602289227467695900,
      "context_hash": 12420647874012167797,
      "translation": "그러나 `fsync()`를 동반한 쓰기는 디바이스 캐시를 플러시해야 하므로 더 느립니다. `ms_writing` 카운터에는 플러시 대기 시간이 포함됩니다.",
      "glossary_snapshot": {
        "cache": "캐시",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080023Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Field 12: `ios_in_progress`",
      "source_hash": 13848726790553071956,
      "context_hash": 16788717492202291436,
      "translation": "필드 12: `ios_in_progress`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080023Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The number of I/Os currently in flight to the device — submitted to the driver but not yet completed.",
      "source_hash": 5910783457741033162,
      "context_hash": 9968785892155492227,
      "translation": "현재 디바이스로 처리 중인(in flight) I/O의 수로, 드라이버에 제출되었지만 아직 완료되지 않은 I/O를 가리킵니다.",
      "glossary_snapshot": {
        "device": "디바이스",
        "driver": "드라이버"
      },
      "translated_at": "2026-11-14T22:42:45.080024Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "This is a **snapshot** (not cumulative), reflecting the instantaneous queue depth.",
      "source_hash": 4984055982149133092,
      "context_hash": 7804774968883640352,
      "translation": "이 값은 누적값이 아닌 **스냅숏**이며, 순간적인 큐 깊이를 반영합니다.",
      "glossary_snapshot": {
        "queue depth": "큐 깊이"
      },
      "translated_at": "2026-11-14T22:42:45.080024Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "**Interpreting `ios_in_progress`:**",
      "source_hash": 14113850017922085176,
      "context_hash": 1641662321057107936,
      "translation": "**`ios_in_progress` 해석:**",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080024Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "Consistently 0: the device is idle or I/O is very bursty (you're sampling between bursts).",
      "source_hash": 9380052854401623500,
      "context_hash": 1831318814618674833,
      "translation": "계속 0인 경우: 디바이스가 유휴 상태이거나 I/O가 매우 버스트성입니다(버스트 사이에 샘플링하고 있는 것입니다).",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080024Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
      "source": "1–8: light load, device is not saturated.",
      "source_hash": 16148698912686203506,
      "context_hash": 10926730650636689787,
      "translation": "1–8: 부하가 가벼우며 디바이스가 포화되지 않았습니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080025Z",
      "issues": []
    },
    {
      "id": "section:5/block:6/seg:0",
      "source": "Near `nr_requests` (default 1023 for NVMe): device is saturated; new I/Os queue in the software layer.",
      "source_hash": 1138841420433975359,
      "context_hash": 9691561236860002917,
      "translation": "`nr_requests`(NVMe의 기본값은 1023)에 가까움: 디바이스가 포화되어 새 I/O가 소프트웨어 계층에서 큐에 대기합니다.",
      "glossary_snapshot": {
        "NVMe": "NVMe",
        "device": "디바이스",
        "queue": "큐"
      },
      "translated_at": "2026-11-14T23:32:27.786189Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:0",
      "source": "0 while `%util` is high in `iostat`: `iostat` uses field 13 (`ms_doing_io`) for `%util`, not field 12.",
      "source_hash": 3678399870955629446,
      "context_hash": 11844189418313086393,
      "translation": "`iostat`에서 `%util`이 높은데 0인 경우: `iostat`는 `%util`에 필드 12가 아니라 필드 13(`ms_doing_io`)을 사용합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080025Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:1",
      "source": "The device may be processing I/Os faster than they can be sampled.",
      "source_hash": 16557381685630689683,
      "context_hash": 10212532192030889604,
      "translation": "디바이스가 샘플링 속도보다 빠르게 I/O를 처리하고 있을 수 있습니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080025Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Field 13: `ms_doing_io`",
      "source_hash": 11832196016019876083,
      "context_hash": 11525670363007933495,
      "translation": "필드 13: `ms_doing_io`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080025Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "Total milliseconds during which at least one I/O was in progress.",
      "source_hash": 15517152092048406485,
      "context_hash": 5690994507714621733,
      "translation": "하나 이상의 I/O가 진행 중이었던 시간의 총합(밀리초)입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080025Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:1",
      "source": "This is the raw input to `iostat`'s `%util` metric:",
      "source_hash": 16529366376595140759,
      "context_hash": 10588027815499599205,
      "translation": "이 값은 `iostat`의 `%util` 지표의 원시 입력값입니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080026Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "`%util` reaching 100% means the device had at least one I/O in flight for the entire measurement interval — the device was never idle.",
      "source_hash": 4498066299803097152,
      "context_hash": 13381680554721963269,
      "translation": "`%util`이 100%에 도달했다는 것은 측정 구간 전체 동안 디바이스에 처리 중인 I/O가 하나 이상 있었다는 뜻이며, 디바이스가 한 번도 유휴 상태가 아니었음을 의미합니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080026Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:1",
      "source": "For HDDs, this indicates saturation.",
      "source_hash": 8129020691051308027,
      "context_hash": 4444021320974968114,
      "translation": "HDD에서는 이것이 포화를 나타냅니다.",
      "glossary_snapshot": {
        "HDDs": "HDD"
      },
      "translated_at": "2026-11-14T22:42:45.080026Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:2",
      "source": "For NVMe, 100% `%util` is normal and does not indicate saturation (NVMe can handle many parallel I/Os at 100% utilization).",
      "source_hash": 15703768110258975747,
      "context_hash": 15185976126233486334,
      "translation": "NVMe에서는 100% `%util`이 정상이며 포화를 나타내지 않습니다(NVMe는 100% 사용률에서도 다수의 병렬 I/O를 처리할 수 있습니다).",
      "glossary_snapshot": {
        "NVMe": "NVMe"
      },
      "translated_at": "2026-11-14T22:42:45.080027Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Field 14: `ms_weighted_io` (weighted time in I/Os)",
      "source_hash": 11475422487224080094,
      "context_hash": 6420889789638402203,
      "translation": "필드 14: `ms_weighted_io`(I/O 가중 시간)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080027Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "This field increments by `(current_ios_in_progress × elapsed_ms)` each time a BIO is queued or completed.",
      "source_hash": 16309590116780477243,
      "context_hash": 3622506611783378789,
      "translation": "이 필드는 BIO가 큐에 들어가거나 완료될 때마다 `(current_ios_in_progress × elapsed_ms)`만큼 증가합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080027Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:1",
      "source": "It is the queue-depth-weighted time — the integral of queue depth over time.",
      "source_hash": 91221566773230778,
      "context_hash": 12068088845032468234,
      "translation": "이는 큐 깊이로 가중한 시간, 즉 시간에 대한 큐 깊이의 적분값입니다.",
      "glossary_snapshot": {
        "queue": "큐",
        "queue depth": "큐 깊이"
      },
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "This is used by `iostat` to compute `aqu-sz` (average queue size):",
      "source_hash": 16552627751548626301,
      "context_hash": 4169078471415460733,
      "translation": "`iostat`는 이 값을 사용하여 `aqu-sz`(평균 큐 크기)를 계산합니다:",
      "glossary_snapshot": {
        "queue": "큐"
      },
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:7/block:5/seg:0",
      "source": "A high `aqu-sz` with low `await` is fine (NVMe servicing a large parallel queue efficiently).",
      "source_hash": 3234048475608375965,
      "context_hash": 5748739584492676651,
      "translation": "`aqu-sz`가 높고 `await`가 낮은 것은 문제가 없습니다(NVMe가 큰 병렬 큐를 효율적으로 처리하고 있는 것입니다).",
      "glossary_snapshot": {
        "NVMe": "NVMe",
        "queue": "큐"
      },
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:7/block:5/seg:1",
      "source": "A high `aqu-sz` with high `await` indicates the device cannot keep up with the queue — genuine saturation.",
      "source_hash": 6228405097729225105,
      "context_hash": 2760064315832620411,
      "translation": "`aqu-sz`와 `await`가 모두 높으면 디바이스가 큐를 따라잡지 못하고 있음을 나타내며, 이는 실제 포화 상태입니다.",
      "glossary_snapshot": {
        "device": "디바이스",
        "queue": "큐"
      },
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:8/block:0/seg:0",
      "source": "Fields 15–18: Discards (kernel 4.18+)",
      "source_hash": 5520862589750418173,
      "context_hash": 6129161909821686412,
      "translation": "필드 15–18: Discard(커널 4.18+)",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:8/block:1/seg:0",
      "source": "Discards (TRIM/UNMAP) notify the device of freed space, allowing SSDs to garbage-collect unused blocks in advance.",
      "source_hash": 16638086097465528964,
      "context_hash": 14138073568632370942,
      "translation": "Discard(TRIM/UNMAP)는 해제된 공간을 디바이스에 알려 SSD가 사용되지 않는 블록을 미리 가비지 컬렉션할 수 있게 합니다.",
      "glossary_snapshot": {
        "SSDs": "SSD",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:8/block:1/seg:1",
      "source": "The discard fields mirror the read/write structure:",
      "source_hash": 6330935738961338759,
      "context_hash": 13192244820951878192,
      "translation": "discard 필드는 읽기/쓰기 구조와 동일한 형태입니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:8/block:2/seg:0",
      "source": "**Field 15** (`discards_completed`): discard operations completed",
      "source_hash": 12457573440556713808,
      "context_hash": 8348214187038779232,
      "translation": "**필드 15**(`discards_completed`): 완료된 discard 연산 수",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080028Z",
      "issues": []
    },
    {
      "id": "section:8/block:3/seg:0",
      "source": "**Field 16** (`discards_merged`): discards merged (rare in practice)",
      "source_hash": 13019597835335559305,
      "context_hash": 17335222620677517374,
      "translation": "**필드 16**(`discards_merged`): 병합된 discard 수(실제로는 드묾)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080029Z",
      "issues": []
    },
    {
      "id": "section:8/block:4/seg:0",
      "source": "**Field 17** (`sectors_discarded`): sectors discarded",
      "source_hash": 12933022944519216800,
      "context_hash": 15028448720272708398,
      "translation": "**필드 17**(`sectors_discarded`): discard된 섹터 수",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080029Z",
      "issues": []
    },
    {
      "id": "section:8/block:5/seg:0",
      "source": "**Field 18** (`ms_discarding`): ms spent processing discards",
      "source_hash": 17658309233965613499,
      "context_hash": 12067586028707184991,
      "translation": "**필드 18**(`ms_discarding`): discard 처리에 소요된 시간(ms)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080029Z",
      "issues": []
    },
    {
      "id": "section:8/block:7/seg:0",
      "source": "High discard rates indicate active space reclamation — expected on systems that delete and recreate large files (containers, databases rotating logs).",
      "source_hash": 411630000519057608,
      "context_hash": 11273283372101475511,
      "translation": "discard 비율이 높으면 공간 회수가 활발히 일어나고 있음을 나타내며, 이는 큰 파일을 삭제하고 다시 생성하는 시스템(컨테이너, 로그를 순환시키는 데이터베이스)에서 예상되는 현상입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:45.080029Z",
      "issues": []
    },
    {
      "id": "section:8/block:7/seg:1",
      "source": "Very high discard rates can cause SSD write amplification if the device's garbage collector is overwhelmed.",
      "source_hash": 1494697688771329910,
      "context_hash": 1324272093166257837,
      "translation": "discard 비율이 매우 높으면 디바이스의 가비지 컬렉터가 감당하지 못할 경우 SSD 쓰기 증폭(write amplification)을 일으킬 수 있습니다.",
      "glossary_snapshot": {
        "SSD": "SSD",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:42:45.080029Z",
      "issues": []
    },
    {
      "id": "section:9/block:0/seg:0",
      "source": "Fields 19–20: Flush requests (kernel 5.5+)",
      "source_hash": 649280883196873167,
      "context_hash": 15122086115633421869,
      "translation": "필드 19–20: 플러시 요청 (커널 5.5+)",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:42:37.655705Z",
      "issues": []
    },
    {
      "id": "section:9/block:1/seg:0",
      "source": "Flush requests send a cache-flush command (`REQ_PREFLUSH` or `REQ_FUA`) to the device, telling it to commit write-cached data to persistent media.",
      "source_hash": 13753001567479038066,
      "context_hash": 2158126810902880665,
      "translation": "플러시 요청은 디바이스에 캐시 플러시 명령(`REQ_PREFLUSH` 또는 `REQ_FUA`)을 보내 쓰기 캐시에 있는 데이터를 영구 매체에 기록하도록 지시합니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T23:32:27.786191Z",
      "issues": []
    },
    {
      "id": "section:9/block:1/seg:1",
      "source": "These are generated by journaling filesystems before journal commits and by explicit `fsync()` calls.",
      "source_hash": 16804599827900182109,
      "context_hash": 9631512566382374644,
      "translation": "이 요청은 저널링 파일시스템이 저널 커밋 전에 생성하며, 명시적인 `fsync()` 호출로도 생성됩니다.",
      "glossary_snapshot": {
        "journal commits": "저널 커밋"
      },
      "translated_at": "2026-11-14T23:32:27.786191Z",
      "issues": []
    },
    {
      "id": "section:9/block:2/seg:0",
      "source": "**Field 19** (`flush_requests`): flush commands completed",
      "source_hash": 77595144353779399,
      "context_hash": 7423198780162375008,
      "translation": "**필드 19** (`flush_requests`): 완료된 플러시 명령 수",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655707Z",
      "issues": []
    },
    {
      "id": "section:9/block:3/seg:0",
      "source": "**Field 20** (`ms_flushing`): total ms spent in flush operations",
      "source_hash": 4806334097620861170,
      "context_hash": 2491077050157408593,
      "translation": "**필드 20** (`ms_flushing`): 플러시 작업에 소요된 총 시간(ms)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655707Z",
      "issues": []
    },
    {
      "id": "section:9/block:5/seg:0",
      "source": "**Why flush latency matters for databases:**",
      "source_hash": 15375795751083289052,
      "context_hash": 2511664190118523448,
      "translation": "**데이터베이스에서 플러시 지연 시간이 중요한 이유:**",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:42:37.655707Z",
      "issues": []
    },
    {
      "id": "section:9/block:6/seg:0",
      "source": "Each `fsync()` or `fdatasync()` on a file that has dirty data triggers at least one flush command.",
      "source_hash": 9171869664387732823,
      "context_hash": 802567484293065528,
      "translation": "dirty 데이터가 있는 파일에 대한 `fsync()` 또는 `fdatasync()` 호출은 각각 최소 한 번의 플러시 명령을 발생시킵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655707Z",
      "issues": []
    },
    {
      "id": "section:9/block:6/seg:1",
      "source": "The flush latency directly bounds the maximum transaction rate:",
      "source_hash": 3692296045600407879,
      "context_hash": 14509159897888251982,
      "translation": "플러시 지연 시간은 최대 트랜잭션 처리율의 상한을 직접 결정합니다:",
      "glossary_snapshot": {
        "latency": "지연 시간",
        "transaction": "트랜잭션"
      },
      "translated_at": "2026-11-14T22:42:37.655708Z",
      "issues": []
    },
    {
      "id": "section:9/block:8/seg:0",
      "source": "Monitoring `ms_flushing / flush_requests` gives the actual flush latency on your storage.",
      "source_hash": 9500516811643316799,
      "context_hash": 18010036721421079660,
      "translation": "`ms_flushing / flush_requests`를 모니터링하면 사용 중인 스토리지의 실제 플러시 지연 시간을 알 수 있습니다.",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:42:37.655708Z",
      "issues": []
    },
    {
      "id": "section:10/block:0/seg:0",
      "source": "Practical analysis recipes",
      "source_hash": 6555399450149293852,
      "context_hash": 8684194591058363555,
      "translation": "실전 분석 레시피",
      "glossary_snapshot": {
        "analysis": "분석"
      },
      "translated_at": "2026-11-14T22:42:37.655708Z",
      "issues": []
    },
    {
      "id": "section:10/block:1/seg:0",
      "source": "Detect a saturated device",
      "source_hash": 17040119821956025215,
      "context_hash": 4807301230998613900,
      "translation": "포화된 디바이스 감지",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T23:32:27.786193Z",
      "issues": []
    },
    {
      "id": "section:10/block:3/seg:0",
      "source": "Find the device with the highest write latency",
      "source_hash": 4894439262655917777,
      "context_hash": 12236744134562113691,
      "translation": "쓰기 지연 시간이 가장 긴 디바이스 찾기",
      "glossary_snapshot": {
        "device": "디바이스",
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:32:27.786194Z",
      "issues": []
    },
    {
      "id": "section:10/block:5/seg:0",
      "source": "Watch flush activity during a database checkpoint",
      "source_hash": 7114305173830919433,
      "context_hash": 13355257154102197111,
      "translation": "데이터베이스 체크포인트 중 플러시 활동 관찰",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655709Z",
      "issues": []
    },
    {
      "id": "section:11/block:0/seg:0",
      "source": "Relationship to `iostat` output",
      "source_hash": 2302226484358644001,
      "context_hash": 7414866563999930251,
      "translation": "`iostat` 출력과의 관계",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655709Z",
      "issues": []
    },
    {
      "id": "section:11/block:1/seg:0",
      "source": "`iostat -x` column",
      "source_hash": 7697414092549978341,
      "context_hash": 16817835749662828967,
      "translation": "`iostat -x` 열",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655709Z",
      "issues": []
    },
    {
      "id": "section:11/block:2/seg:0",
      "source": "`/proc/diskstats` derivation",
      "source_hash": 9159278609467839437,
      "context_hash": 2697470148179334426,
      "translation": "`/proc/diskstats` 산출식",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:42:37.655710Z",
      "issues": []
