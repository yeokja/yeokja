      "source_hash": 10297370716460296357,
      "context_hash": 14430675053234470775,
      "translation": "**`/proc/<pid>/wchan` 읽기:**",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:49.101658Z",
      "issues": []
    },
