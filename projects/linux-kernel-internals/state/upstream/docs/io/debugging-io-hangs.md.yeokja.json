      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "What the process is waiting for",
      "source_hash": 14024876735135600536,
      "context_hash": 5477264151562024806,
      "translation": "프로세스가 기다리는 대상",
      "glossary_snapshot": {
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:34:49.101659Z",
      "issues": []
    },
