  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Direct I/O",
      "source_hash": 11794348522071249701,
      "context_hash": 5865066336457724779,
      "translation": "Direct I/O",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:50.436032Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "O_DIRECT: bypassing the page cache for predictable I/O latency",
      "source_hash": 4731801564524718085,
      "context_hash": 17797555669148840360,
      "translation": "O_DIRECT: 예측 가능한 I/O 지연 시간을 위한 페이지 캐시 우회",
      "glossary_snapshot": {
        "latency": "지연 시간",
        "page cache": "페이지 캐시"
      },
      "translated_at": "2026-11-14T22:34:50.436033Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What O_DIRECT does",
      "source_hash": 6136010032823537907,
      "context_hash": 17844906527535575219,
      "translation": "O_DIRECT의 역할",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:50.436033Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "By default, `read()` and `write()` go through the **page cache** — the kernel reads disk data into DRAM pages and serves reads from there.",
      "source_hash": 11470593337795792051,
      "context_hash": 2627070469281432527,
      "translation": "기본적으로 `read()`와 `write()`는 **페이지 캐시**를 거칩니다. 커널은 디스크 데이터를 DRAM 페이지로 읽어 들이고 읽기 요청을 그곳에서 처리합니다.",
      "glossary_snapshot": {
        "DRAM": "DRAM",
        "kernel": "커널",
        "page cache": "페이지 캐시"
      },
      "translated_at": "2026-11-14T22:34:50.436033Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Writes go to dirty pages, which are flushed asynchronously.",
      "source_hash": 10248448161765394448,
      "context_hash": 2580710199295233465,
      "translation": "쓰기는 dirty 페이지에 기록되며, 이 페이지는 비동기적으로 플러시됩니다.",
      "glossary_snapshot": {
        "dirty page": "dirty 페이지"
      },
      "translated_at": "2026-11-14T22:34:50.436034Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "O_DIRECT bypasses the page cache:",
      "source_hash": 16312700655257644728,
      "context_hash": 6683021497940484350,
      "translation": "O_DIRECT는 페이지 캐시를 우회합니다:",
      "glossary_snapshot": {
        "page cache": "페이지 캐시"
      },
      "translated_at": "2026-11-14T22:34:50.436034Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Why use O_DIRECT?",
      "source_hash": 5546554336931015428,
      "context_hash": 7480379135855832061,
      "translation": "O_DIRECT를 사용하는 이유",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:50.436035Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "**Databases (PostgreSQL, MySQL InnoDB, Oracle)**: Databases implement their own buffer pool.",
      "source_hash": 12117695352870697788,
      "context_hash": 3779058057150970202,
      "translation": "**데이터베이스(PostgreSQL, MySQL InnoDB, Oracle)**: 데이터베이스는 자체 버퍼 풀을 구현합니다.",
      "glossary_snapshot": {
        "PostgreSQL": "PostgreSQL",
        "buffer pool": "버퍼 풀"
      },
      "translated_at": "2026-11-14T22:34:50.436035Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "Routing I/O through both the database buffer and the OS page cache wastes DRAM.",
      "source_hash": 6778278967700213365,
      "context_hash": 5247701369581320848,
      "translation": "I/O를 데이터베이스 버퍼와 OS 페이지 캐시 양쪽에 모두 거치게 하면 DRAM이 낭비됩니다.",
      "glossary_snapshot": {
        "DRAM": "DRAM",
        "page cache": "페이지 캐시"
      },
      "translated_at": "2026-11-14T22:34:50.436035Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:2",
      "source": "O_DIRECT gives the database full control:",
      "source_hash": 3497391189270434700,
      "context_hash": 6379232864034620071,
      "translation": "O_DIRECT는 데이터베이스에 완전한 제어권을 줍니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:50.436036Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "**Predictable latency**: Page cache writeback can cause surprising latency spikes when dirty pages are flushed.",
      "source_hash": 2082377552416033840,
      "context_hash": 17972718854076689430,
      "translation": "**예측 가능한 지연 시간**: 페이지 캐시 writeback은 dirty 페이지가 플러시될 때 예상치 못한 지연 시간 급증을 일으킬 수 있습니다.",
      "glossary_snapshot": {
        "dirty page": "dirty 페이지",
        "latency": "지연 시간",
        "latency spike": "지연 시간 급증",
        "page cache": "페이지 캐시",
        "writeback": "writeback"
      },
      "translated_at": "2026-11-14T22:34:50.436036Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:1",
      "source": "O_DIRECT writes complete when the data reaches the drive.",
      "source_hash": 15253150658053606286,
      "context_hash": 53169081950888854,
      "translation": "O_DIRECT 쓰기는 데이터가 드라이브에 도달하면 완료됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:50.436036Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "**NUMA-aware memory**: O_DIRECT allows passing NUMA-local buffers to the kernel, avoiding cache effects across NUMA nodes.",
      "source_hash": 16481925404063861039,
      "context_hash": 8579290853259149159,
      "translation": "**NUMA 인식 메모리**: O_DIRECT를 사용하면 NUMA 로컬 버퍼를 커널에 전달할 수 있어 NUMA 노드 간의 캐시 효과를 피할 수 있습니다.",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "NUMA node": "NUMA 노드"
      },
      "translated_at": "2026-11-14T22:34:50.436037Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Alignment requirements",
      "source_hash": 10165607667892558370,
      "context_hash": 16740554622586971163,
      "translation": "정렬 요구 사항",
      "glossary_snapshot": {
        "alignment": "정렬"
      },
      "translated_at": "2026-11-14T22:34:50.436037Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "O_DIRECT has strict alignment requirements.",
      "source_hash": 10907863837246197960,
      "context_hash": 13350804787097243237,
      "translation": "O_DIRECT에는 엄격한 정렬 요구 사항이 있습니다.",
