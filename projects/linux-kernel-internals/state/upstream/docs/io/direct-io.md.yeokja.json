      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "Violating them returns `EINVAL`:",
      "source_hash": 3387780674990569587,
      "context_hash": 11310188376179098559,
      "translation": "이를 위반하면 `EINVAL`이 반환됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:34:50.436037Z",
      "issues": []
    },
