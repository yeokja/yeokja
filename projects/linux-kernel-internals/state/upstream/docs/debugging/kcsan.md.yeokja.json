  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "KCSAN: Kernel Concurrency Sanitizer",
      "source_hash": 6980623429248404971,
      "context_hash": 11432627758158172801,
      "translation": "KCSAN: Kernel Concurrency Sanitizer",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679434Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Data race detection using watchpoints and the Linux Kernel Memory Model",
      "source_hash": 1458131330678766542,
      "context_hash": 912739079544222515,
      "translation": "watchpoint와 Linux Kernel Memory Model을 이용한 데이터 레이스 탐지",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:21:39.679434Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What is a data race?",
      "source_hash": 13339696745733635443,
      "context_hash": 12373331692944376667,
      "translation": "데이터 레이스란 무엇인가",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679434Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "A **data race** occurs when two threads access the same memory location concurrently, at least one access is a write, and there's no synchronization between them:",
      "source_hash": 11860101780432860612,
      "context_hash": 15113181896109872855,
      "translation": "**데이터 레이스**(data race)는 두 스레드가 같은 메모리 위치에 동시에 접근하고, 그중 적어도 하나의 접근이 쓰기이며, 둘 사이에 동기화가 없을 때 발생합니다.",
      "glossary_snapshot": {
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "Data races are undefined behavior in C11 and cause subtle bugs — compilers can miscompile racing code in unexpected ways, and hardware CPUs may reorder or coalesce the accesses.",
      "source_hash": 18284404061469113335,
      "context_hash": 757727659491830639,
      "translation": "데이터 레이스는 C11에서 정의되지 않은 동작(undefined behavior)이며 미묘한 버그를 일으킵니다 — 컴파일러는 레이스가 있는 코드를 예상치 못한 방식으로 잘못 컴파일할 수 있고, 하드웨어 CPU는 접근 순서를 바꾸거나 여러 접근을 하나로 합칠 수 있습니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "How KCSAN works",
      "source_hash": 11210288856792544125,
      "context_hash": 15300292349644407340,
      "translation": "KCSAN의 동작 방식",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "KCSAN uses **software watchpoints** to detect racing accesses:",
      "source_hash": 1761170843001431512,
      "context_hash": 12880100920972949154,
      "translation": "KCSAN은 레이스가 발생하는 접근을 탐지하기 위해 **소프트웨어 watchpoint**를 사용합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "This is a probabilistic approach — not all races are detected, but it finds real races in practice without false positives (compared to shadow memory approaches).",
      "source_hash": 6948311721665345965,
      "context_hash": 17925004898159607681,
      "translation": "이는 확률적인 접근 방식입니다 — 모든 레이스가 탐지되지는 않지만, (shadow memory 방식과 비교해) 오탐(false positive) 없이 실제 레이스를 실용적으로 찾아냅니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 9382449527831060291,
      "translation": "설정",
      "glossary_snapshot": {
        "Configuration": "설정"
      },
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Reading KCSAN reports",
      "source_hash": 9052653662928010137,
      "context_hash": 4851972196923565389,
      "translation": "KCSAN 보고서 읽기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:0",
      "source": "Key fields:",
      "source_hash": 7927735245171797670,
      "context_hash": 11005225063018525970,
      "translation": "주요 필드:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "**read/write**: which operation triggered the watchpoint",
      "source_hash": 4715822693635736312,
      "context_hash": 12391300536742729998,
      "translation": "**read/write**: watchpoint를 발동시킨 연산",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "**address**: the racing memory location",
      "source_hash": 14753993921601013865,
      "context_hash": 13133651845855282307,
      "translation": "**address**: 레이스가 발생한 메모리 위치",
      "glossary_snapshot": {
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "**value changed**: shows the write that caused the race",
      "source_hash": 798553305711463609,
      "context_hash": 7097147777902986750,
      "translation": "**value changed**: 레이스를 일으킨 쓰기를 보여 줌",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:0",
      "source": "**two call stacks**: one for each racing access",
      "source_hash": 14917864682962507549,
      "context_hash": 4142076701713458411,
      "translation": "**두 개의 콜 스택**: 레이스가 발생한 각 접근마다 하나씩",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Annotation: intentional benign races",
      "source_hash": 5326163948425516200,
      "context_hash": 5645258877647338245,
      "translation": "어노테이션: 의도적인 무해한 레이스",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Some kernel code intentionally reads a variable without synchronization as a hint/optimization.",
      "source_hash": 4605553639590894339,
      "context_hash": 8024443695325094062,
      "translation": "일부 커널 코드는 힌트나 최적화를 위해 의도적으로 동기화 없이 변수를 읽습니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:21:39.679435Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "These must be annotated to silence KCSAN:",
      "source_hash": 5120950241709819761,
      "context_hash": 14544980794005502535,
      "translation": "이러한 코드는 KCSAN이 보고하지 않도록 어노테이션을 달아야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679436Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Atomic operations and KCSAN",
      "source_hash": 15353602188024389362,
      "context_hash": 16213329485883032243,
      "translation": "원자적 연산과 KCSAN",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679436Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "Atomic operations are not races:",
      "source_hash": 6798315771372423481,
      "context_hash": 17067561984767397188,
      "translation": "원자적 연산은 레이스가 아닙니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:21:39.679436Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Linux Kernel Memory Model (LKMM)",
      "source_hash": 16493121503538246444,
      "context_hash": 4736987927552501814,
      "translation": "Linux Kernel Memory Model (LKMM)",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:21:39.679436Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "KCSAN is designed to enforce the **Linux Kernel Memory Model**, which defines the formal semantics of concurrent kernel code:",
      "source_hash": 6022990910693720190,
      "context_hash": 3481996197418631421,
      "translation": "KCSAN은 동시성 커널 코드의 형식적 의미론을 정의하는 **Linux Kernel Memory Model**을 강제하도록 설계되었습니다.",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:21:39.679436Z",
      "issues": []
    },
    {
