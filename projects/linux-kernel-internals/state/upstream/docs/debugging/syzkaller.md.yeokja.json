    {
      "id": "section:6/block:0/seg:0",
      "source": "Reproducing crashes",
      "source_hash": 14767773233224496961,
      "context_hash": 15744689496106380509,
      "translation": "크래시 재현",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:46:57.422472Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "When syzkaller finds a crash, it generates a **reproducer**:",
      "source_hash": 11333460201077623977,
      "context_hash": 9302603822567300641,
      "translation": "syzkaller는 크래시를 발견하면 **재현기**(reproducer)를 생성합니다:",
      "glossary_snapshot": {
        "syzkaller": "syzkaller"
      },
      "translated_at": "2026-11-14T22:46:57.422472Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
