      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why Btrfs?",
      "source_hash": 12464397687370334434,
      "context_hash": 1272288152159522156,
      "translation": "왜 Btrfs인가",
      "glossary_snapshot": {
        "btrfs": "btrfs"
      },
      "translated_at": "2026-11-14T22:50:14.112146Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Btrfs (B-tree filesystem) was designed to address limitations of ext4:",
      "source_hash": 6314440211317372872,
      "context_hash": 2176521282547843300,
      "translation": "Btrfs(B-tree filesystem)는 ext4의 한계를 해결하기 위해 설계되었습니다.",
      "glossary_snapshot": {
        "B-tree": "B-tree",
        "btrfs": "btrfs"
      },
      "translated_at": "2026-11-14T22:50:14.112146Z",
      "issues": []
    },
