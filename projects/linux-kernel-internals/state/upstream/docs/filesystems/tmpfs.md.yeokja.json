    {
      "id": "section:0/block:1/seg:0",
      "source": "Memory-backed filesystems with no persistent storage",
      "source_hash": 1217245078661848790,
      "context_hash": 5665981299434254847,
      "translation": "영구 저장소가 없는 메모리 기반 파일시스템",
