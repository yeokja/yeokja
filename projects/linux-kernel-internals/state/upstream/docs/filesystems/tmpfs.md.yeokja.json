    {
      "id": "section:4/block:0/seg:0",
      "source": "devtmpfs: /dev filesystem",
      "source_hash": 16684318057380407027,
      "context_hash": 15163384287445630981,
      "translation": "devtmpfs: /dev 파일시스템",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:49:56.248399Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "devtmpfs is a special tmpfs populated by the kernel with device nodes before udev runs:",
      "source_hash": 7442386534715618954,
      "context_hash": 2590591607897199027,
      "translation": "devtmpfs는 udev가 실행되기 전에 커널이 디바이스 노드로 채워 두는 특수한 tmpfs입니다:",
      "glossary_snapshot": {
        "device": "디바이스",
        "kernel": "커널",
        "nodes": "노드",
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T21:49:56.248399Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "tmpfs and Linux's /proc, /sys",
      "source_hash": 15868524523835978485,
      "context_hash": 15430052986478646499,
      "translation": "tmpfs와 Linux의 /proc, /sys",
      "glossary_snapshot": {
        "Linux's": "Linux",
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T21:49:56.248400Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Both `/proc` and `/sys` are special pseudo-filesystems built on the same infrastructure:",
      "source_hash": 4501656107239136331,
      "context_hash": 9511710702216124251,
      "translation": "`/proc`과 `/sys`는 모두 동일한 인프라 위에 구축된 특수한 의사 파일시스템(pseudo-filesystem)입니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:49:56.248400Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "These filesystems don't use backing storage — reads synthesize data from kernel data structures; writes trigger kernel operations.",
      "source_hash": 6646571407412660124,
      "context_hash": 15964676720644390130,
      "translation": "이러한 파일 시스템은 백킹 스토리지(backing storage)를 사용하지 않습니다. 읽기는 커널 자료 구조로부터 데이터를 합성하고, 쓰기는 커널 동작을 일으킵니다.",
      "glossary_snapshot": {
        "data structures": "자료 구조"
      },
      "translated_at": "2026-11-14T23:26:43.258271Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Volatile mounts: tmpfs in container use",
      "source_hash": 16931768159323352730,
      "context_hash": 10690396904381843262,
      "translation": "휘발성 마운트: 컨테이너에서의 tmpfs 사용",
      "glossary_snapshot": {
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T21:49:56.248401Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "Containers use tmpfs for writable layers and ephemeral storage:",
      "source_hash": 17642099477126199634,
      "context_hash": 10873955154949398669,
      "translation": "컨테이너는 쓰기 가능한 레이어와 임시 스토리지에 tmpfs를 사용합니다:",
      "glossary_snapshot": {
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T21:49:56.248401Z",
      "issues": []
    },
