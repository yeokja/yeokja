      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What tmpfs is",
      "source_hash": 15919784225979281677,
      "context_hash": 12806544011491800447,
      "translation": "tmpfs란 무엇인가",
      "glossary_snapshot": {
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T22:04:09.309574Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "tmpfs is a filesystem that lives entirely in RAM (and optionally swap).",
      "source_hash": 909764632967241380,
      "context_hash": 11851958196631548661,
      "translation": "tmpfs는 전적으로 RAM(그리고 선택적으로 스왑)에 존재하는 파일시스템입니다.",
      "glossary_snapshot": {
        "RAM": "RAM",
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T22:04:09.309575Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "It's backed by the page cache — each file's data is anonymous memory, evictable to swap under memory pressure [(kernel docs)](https://www.kernel.org/doc/html/latest/filesystems/tmpfs.html).",
      "source_hash": 12428551214776144424,
      "context_hash": 6135429252678615408,
      "translation": "tmpfs는 페이지 캐시를 기반으로 합니다. 각 파일의 데이터는 익명 메모리이며, 메모리 압박 시 스왑으로 축출될 수 있습니다 [(커널 문서)](https://www.kernel.org/doc/html/latest/filesystems/tmpfs.html).",
      "glossary_snapshot": {
        "Kernel docs": "커널 문서",
        "anonymous memory": "익명 메모리",
        "memory": "메모리",
        "page cache": "페이지 캐시"
      },
      "translated_at": "2026-11-14T22:04:09.309575Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "The current implementation was created by Christoph Rohland around 2001, replacing the older shm filesystem.",
      "source_hash": 13192379642911938529,
      "context_hash": 11511667496426509727,
      "translation": "현재 구현은 2001년경 Christoph Rohland가 만들었으며, 이전의 shm 파일시스템을 대체했습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:04:09.309575Z",
      "issues": []
    },
