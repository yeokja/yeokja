    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "tmpfs is built on top of `shmem` (shared memory) subsystem:",
      "source_hash": 3233572170579209183,
      "context_hash": 8040592081646047825,
      "translation": "tmpfs는 `shmem`(공유 메모리) 서브시스템 위에 구축됩니다:",
      "glossary_snapshot": {
        "shared memory": "공유 메모리",
        "subsystem": "서브시스템",
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T22:04:09.309577Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "shmem inode",
