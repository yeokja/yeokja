      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "ext4 delays block allocation until actual writeback:",
      "source_hash": 847143876121700300,
      "context_hash": 5753925467134807412,
      "translation": "ext4는 실제 writeback이 일어날 때까지 블록 할당을 미룹니다:",
      "glossary_snapshot": {
        "writeback": "writeback"
      },
      "translated_at": "2026-11-14T21:48:49.954734Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "Benefits:",
      "source_hash": 16157224011853046347,
      "context_hash": 13341652605211132232,
