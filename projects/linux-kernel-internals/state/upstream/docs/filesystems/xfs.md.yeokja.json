  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "XFS: High-Performance Journaling Filesystem",
      "source_hash": 1706662746199464045,
      "context_hash": 18330555486689862042,
      "translation": "XFS: 고성능 저널링 파일시스템",
      "glossary_snapshot": {
        "XFS": "XFS"
      },
      "translated_at": "2026-11-14T22:04:18.080094Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Allocation groups, B-tree index structures, delayed allocation, and online repair",
      "source_hash": 16626906234403687935,
      "context_hash": 2930145111608003440,
      "translation": "할당 그룹, B-tree 인덱스 구조, 지연 할당, 온라인 복구",
      "glossary_snapshot": {
        "B-tree": "B-tree"
      },
      "translated_at": "2026-11-14T22:04:18.080095Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why XFS?",
      "source_hash": 407466190216195802,
      "context_hash": 8571692592115195576,
      "translation": "XFS를 사용하는 이유",
      "glossary_snapshot": {
        "XFS": "XFS"
      },
      "translated_at": "2026-11-14T22:04:18.080096Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "XFS was originally developed at SGI for IRIX in 1993, then ported to Linux by Steve Lord and the SGI team; it was merged into the mainline kernel in Linux 2.5.36 (2002).",
      "source_hash": 14960620447930214130,
      "context_hash": 1972538880804026175,
      "translation": "XFS는 원래 1993년 SGI에서 IRIX용으로 개발되었으며, 이후 Steve Lord와 SGI 팀이 Linux로 이식했습니다. Linux 2.5.36(2002)에서 메인라인 커널에 병합되었습니다.",
      "glossary_snapshot": {
        "Linux": "Linux",
        "XFS": "XFS",
        "kernel": "커널",
        "mainline": "메인라인"
      },
      "translated_at": "2026-11-14T22:04:18.080096Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "It excels at:",
      "source_hash": 13590262172488185187,
      "context_hash": 10207935300394549664,
      "translation": "XFS가 특히 뛰어난 부분은 다음과 같습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:04:18.080097Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Large files and filesystems**: up to 8 EiB volumes, 8 EiB files",
      "source_hash": 11039181793430610507,
      "context_hash": 2123014778678844799,
      "translation": "**대용량 파일 및 파일시스템**: 최대 8 EiB 볼륨, 8 EiB 파일",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:04:18.080097Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**High concurrency**: per-allocation-group locking, minimal global contention",
      "source_hash": 15940435352977678783,
      "context_hash": 11528843168909648480,
      "translation": "**높은 동시성**: 할당 그룹(allocation group)별 잠금, 최소화된 전역 경합",
      "glossary_snapshot": {
        "contention": "경합"
      },
      "translated_at": "2026-11-14T22:04:18.080097Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Metadata performance**: B-tree indexes for extents, inodes, and free space",
      "source_hash": 7541948911270834162,
      "context_hash": 6660330191157180585,
      "translation": "**메타데이터 성능**: extent, inode, 여유 공간에 대한 B-tree 인덱스",
      "glossary_snapshot": {
        "B-tree": "B-tree",
        "inode": "inode",
        "metadata": "메타데이터"
      },
      "translated_at": "2026-11-14T22:04:18.080097Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Online operations**: defrag, grow, and repair while mounted",
      "source_hash": 12102673673457321365,
      "context_hash": 3646253304028188503,
      "translation": "**온라인 작업**: 마운트된 상태에서의 조각 모음, 확장, 복구",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:04:18.080097Z",
      "issues": []
    },
    {
