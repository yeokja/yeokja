      "context_hash": 17470366052476736480,
      "translation": "성능",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:50:22.609081Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
