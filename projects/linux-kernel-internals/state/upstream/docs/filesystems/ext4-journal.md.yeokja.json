{
  "version": 1,
  "source_hash": 1199427466210266424,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "ext4 Journaling and Crash Recovery",
      "source_hash": 7589142344594673129,
      "context_hash": 18154697280146553681,
      "translation": "ext4 저널링과 크래시 복구",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:50:22.609077Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "JBD2 transaction lifecycle: how ext4 survives power failures",
      "source_hash": 8882655582674066171,
      "context_hash": 9291894364894047833,
      "translation": "JBD2 트랜잭션 생명주기: ext4가 전원 장애에서 살아남는 방법",
      "glossary_snapshot": {
        "transaction": "트랜잭션"
      },
      "translated_at": "2026-11-14T22:50:22.609079Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why journaling?",
      "source_hash": 10904465921284828880,
      "context_hash": 5489236610782375278,
      "translation": "저널링이 필요한 이유",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:50:22.609079Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Without journaling, a power failure mid-write can leave the filesystem in an inconsistent state:",
      "source_hash": 14676545534135793462,
      "context_hash": 16077306336654917603,
      "translation": "저널링이 없으면 쓰기 도중 전원 장애가 발생할 때 파일시스템이 일관성 없는 상태로 남을 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:50:22.609080Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "With journaling, changes are written to the **journal** (a circular log) first.",
      "source_hash": 17490528126253444721,
      "context_hash": 14862108198912089162,
      "translation": "저널링을 사용하면 변경 사항이 먼저 **저널**(순환 로그)에 기록됩니다.",
      "glossary_snapshot": {
        "journal": "저널"
      },
      "translated_at": "2026-11-14T22:50:22.609080Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:1",
      "source": "After crash, the kernel replays the journal in seconds.",
      "source_hash": 10881702722058480649,
      "context_hash": 5049222184545829014,
      "translation": "크래시 후 커널은 몇 초 안에 저널을 재생(replay)합니다.",
      "glossary_snapshot": {
        "journal": "저널",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:50:22.609080Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "ext4 journal modes",
      "source_hash": 13029296332637767831,
      "context_hash": 18092779429878544145,
      "translation": "ext4 저널 모드",
