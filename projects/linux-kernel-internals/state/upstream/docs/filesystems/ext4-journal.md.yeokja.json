      "source_hash": 5462542718754512371,
      "context_hash": 14933703776904877133,
      "translation": "내구성",
      "glossary_snapshot": {
        "durability": "내구성"
      },
      "translated_at": "2026-11-14T22:50:22.609081Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
