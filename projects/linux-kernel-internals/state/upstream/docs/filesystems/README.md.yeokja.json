    {
      "id": "section:1/block:25/seg:0",
      "source": "\"The filesystem writes files to disk\"",
      "source_hash": 1781876410595090476,
      "context_hash": 5999101134395059245,
      "translation": "\"파일시스템은 파일을 디스크에 기록한다\"",
