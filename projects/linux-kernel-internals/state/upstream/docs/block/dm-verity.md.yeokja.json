  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Device Mapper: dm-verity and Integrity Checking",
      "source_hash": 5836792907473007809,
      "context_hash": 3285382124405277067,
      "translation": "Device Mapper: dm-verity와 무결성 검사",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421227Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Merkle tree verification of block device data for Android and ChromeOS",
      "source_hash": 6024741878234898487,
      "context_hash": 199971303049402041,
      "translation": "Android와 ChromeOS를 위한 블록 디바이스 데이터의 Merkle 트리 검증",
      "glossary_snapshot": {
        "Android": "Android",
        "block device": "블록 디바이스"
      },
      "translated_at": "2026-11-14T21:50:17.421227Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What is dm-verity?",
      "source_hash": 948334263440122021,
      "context_hash": 5813389859921257731,
      "translation": "dm-verity란 무엇입니까?",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "dm-verity provides **transparent integrity checking** of a block device using a Merkle (hash) tree.",
      "source_hash": 6090607413181263444,
      "context_hash": 2391645473438436557,
      "translation": "dm-verity는 Merkle(해시) 트리를 사용하여 블록 디바이스의 **투명한 무결성 검사**를 제공합니다.",
      "glossary_snapshot": {
        "block device": "블록 디바이스"
      },
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Every read is verified against pre-computed hashes.",
      "source_hash": 9357497183027369385,
      "context_hash": 7721329821983069487,
      "translation": "모든 읽기는 미리 계산된 해시와 대조하여 검증됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "If data is tampered with, the kernel returns an error or panics.",
      "source_hash": 12775405888866088789,
      "context_hash": 17126411277082323766,
      "translation": "데이터가 변조되면 커널은 오류를 반환하거나 패닉을 일으킵니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "panics": "패닉"
      },
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Used by:",
      "source_hash": 17245916408538583258,
      "context_hash": 9391742297060503441,
      "translation": "사용처:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Android**: verifying the read-only system partition",
      "source_hash": 694734004977630327,
      "context_hash": 8801577368633861259,
      "translation": "**Android**: 읽기 전용 시스템 파티션 검증",
      "glossary_snapshot": {
        "Android": "Android"
      },
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**ChromeOS**: verified boot for rootfs",
      "source_hash": 12063425237543613411,
      "context_hash": 11207823348953650208,
      "translation": "**ChromeOS**: rootfs의 검증된 부팅(verified boot)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Linux distributions**: immutable root filesystem with integrity",
      "source_hash": 5605886562221493932,
      "context_hash": 16905736557514742873,
      "translation": "**Linux 배포판**: 무결성을 갖춘 불변 루트 파일시스템",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Merkle tree structure",
      "source_hash": 7437581919546289307,
      "context_hash": 4984875201800910951,
      "translation": "Merkle 트리 구조",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "The root hash is stored outside the block device (in the kernel command line, TPM, or signed partition table).",
      "source_hash": 1947107951757095460,
      "context_hash": 4766039387553141726,
      "translation": "루트 해시는 블록 디바이스 외부(커널 명령줄, TPM 또는 서명된 파티션 테이블)에 저장됩니다.",
      "glossary_snapshot": {
        "block device": "블록 디바이스",
        "command line": "명령줄",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "dm-verity on-disk layout",
      "source_hash": 10360246334479400516,
      "context_hash": 6975453573350640911,
      "translation": "dm-verity 온디스크 레이아웃",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "The hash tree can be on the same device (after the data) or on a separate device.",
      "source_hash": 8835347290059060631,
      "context_hash": 4491137905865265089,
      "translation": "해시 트리는 같은 디바이스(데이터 뒤)에 두거나 별도의 디바이스에 둘 수 있습니다.",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T21:50:17.421228Z",
      "issues": []
    },
    {
