      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "The NVMe driver hooks into the block layer's `blk-mq` (multi-queue) framework:",
      "source_hash": 10606243405920344138,
      "context_hash": 16665769882191478524,
      "translation": "NVMe 드라이버는 블록 계층의 `blk-mq`(multi-queue, 다중 큐) 프레임워크에 훅으로 연결됩니다:",
      "glossary_snapshot": {
        "NVMe": "NVMe",
        "block layer": "블록 계층",
        "hooks": "훅",
        "queue": "큐"
      },
      "translated_at": "2026-11-14T23:25:18.724965Z",
      "issues": []
    },
    {
