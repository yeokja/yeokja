    {
      "id": "section:6/block:4/seg:0",
      "source": "Workers not bound to specific CPUs — work runs anywhere",
      "source_hash": 2426761751468013488,
      "context_hash": 17846366288585591628,
      "translation": "특정 CPU에 바인딩되지 않은 워커 — 작업이 어느 CPU에서나 실행됨",
      "glossary_snapshot": {
