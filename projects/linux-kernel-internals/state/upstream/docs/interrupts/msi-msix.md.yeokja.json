  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "MSI and MSI-X: PCIe Message-Signaled Interrupts",
      "source_hash": 5000004343403337217,
      "context_hash": 12662146663164188566,
      "translation": "MSI와 MSI-X: PCIe 메시지 신호 인터럽트",
      "glossary_snapshot": {
        "MSI": "MSI",
        "MSI-X": "MSI-X",
        "PCIe": "PCIe",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:36.260126Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Replacing legacy INTx with per-queue interrupt vectors for NVMe, NIC, and GPU",
      "source_hash": 9763496556618140971,
      "context_hash": 17506005601518518767,
      "translation": "NVMe, NIC, GPU를 위해 레거시 INTx를 큐별 인터럽트 벡터로 대체",
      "glossary_snapshot": {
        "GPU": "GPU",
        "NIC": "NIC",
        "NVMe": "NVMe",
        "interrupt": "인터럽트",
        "queue": "큐"
      },
      "translated_at": "2026-11-14T22:33:36.260128Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why MSI-X?",
      "source_hash": 15753327449942236562,
      "context_hash": 4872321297847660493,
      "translation": "왜 MSI-X인가?",
      "glossary_snapshot": {
        "MSI-X": "MSI-X"
      },
      "translated_at": "2026-11-14T22:33:36.260128Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Legacy PCI interrupts (INTx, INTA-INTD) have fundamental limitations:",
      "source_hash": 15458978250441372773,
      "context_hash": 16652169416196533456,
      "translation": "레거시 PCI 인터럽트(INTx, INTA-INTD)에는 근본적인 한계가 있습니다:",
      "glossary_snapshot": {
        "PCI": "PCI",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:36.260128Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Shared**: multiple devices share one IRQ line → spurious interrupts, no isolation",
      "source_hash": 4375662306235347132,
      "context_hash": 13255654490467569190,
      "translation": "**Shared**: 여러 디바이스가 하나의 IRQ 라인을 공유 → 스퓨리어스(spurious) 인터럽트, 격리 불가",
      "glossary_snapshot": {
        "IRQ": "IRQ",
        "device": "디바이스",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T23:25:12.460180Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Level-triggered**: interrupt line held until acknowledged → cannot miss (line stays asserted until cleared); edge-triggered interrupts can be missed if the transition occurs while masked",
      "source_hash": 7290218092190929049,
      "context_hash": 7752848112604773664,
      "translation": "**레벨 트리거**: 인터럽트 라인이 확인(acknowledge)될 때까지 유지됩니다 → 놓칠 수 없습니다(라인이 해제될 때까지 어서트 상태로 유지됨). 엣지 트리거 인터럽트는 마스크된 동안 전환이 일어나면 놓칠 수 있습니다",
      "glossary_snapshot": {
        "interrupt": "인터럽트",
        "interrupts": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:36.260129Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Limited**: only 4 lines per PCI bus",
      "source_hash": 14475150203831983792,
      "context_hash": 16522366724735325733,
      "translation": "**제한적**: PCI 버스당 라인이 4개뿐입니다",
      "glossary_snapshot": {
        "PCI": "PCI"
      },
      "translated_at": "2026-11-14T22:33:36.260129Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "MSI (Message-Signaled Interrupts) support was added to Linux in 2.6.8 (2004) by Tom Long Nguyen (Intel) and solves these by using memory writes instead of dedicated wires:",
      "source_hash": 7107457680164582161,
      "context_hash": 11217278389975093858,
      "translation": "MSI(Message-Signaled Interrupts, 메시지 신호 인터럽트) 지원은 2004년 Linux 2.6.8에서 Tom Long Nguyen(Intel)이 추가했으며, 전용 배선 대신 메모리 쓰기를 사용하여 이러한 문제를 해결합니다.",
      "glossary_snapshot": {
        "Intel": "Intel",
        "Linux": "Linux",
        "MSI": "MSI",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:36.260130Z",
      "issues": []
    },
    {
      "id": "section:1/block:7/seg:0",
      "source": "**MSI-X** extends MSI to 2048 vectors per device (vs 32 for MSI), and each vector can have independent affinity.",
      "source_hash": 326993412032270605,
      "context_hash": 1799163575721077244,
      "translation": "**MSI-X**는 MSI를 디바이스당 2048개 벡터(MSI는 32개)로 확장하며, 각 벡터는 독립적인 어피니티를 가질 수 있습니다.",
      "glossary_snapshot": {
        "MSI": "MSI",
        "MSI-X": "MSI-X",
        "affinity": "어피니티",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T23:25:12.460182Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "MSI capability structure",
      "source_hash": 1164385712111612195,
      "context_hash": 9935009267075901421,
      "translation": "MSI capability 구조체",
      "glossary_snapshot": {
        "MSI": "MSI"
      },
      "translated_at": "2026-11-14T22:33:36.260130Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "MSI-X table",
      "source_hash": 17879210476970590237,
      "context_hash": 2208499173254650979,
      "translation": "MSI-X 테이블",
      "glossary_snapshot": {
        "MSI-X": "MSI-X"
      },
      "translated_at": "2026-11-14T22:33:36.260130Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "MSI-X uses a table in one of the device's BARs:",
      "source_hash": 10020770647255723208,
      "context_hash": 11132802423641846879,
      "translation": "MSI-X는 디바이스의 BAR 중 하나에 있는 테이블을 사용합니다:",
      "glossary_snapshot": {
        "MSI-X": "MSI-X",
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T23:25:12.460183Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Linux kernel: requesting MSI-X vectors",
      "source_hash": 6892523304679910168,
      "context_hash": 12094581382179681685,
      "translation": "Linux 커널: MSI-X 벡터 요청",
      "glossary_snapshot": {
        "Linux": "Linux",
        "MSI-X": "MSI-X"
      },
      "translated_at": "2026-11-14T22:33:36.260131Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Per-vector IRQ affinity",
      "source_hash": 8850436722869988473,
      "context_hash": 12770652620686158351,
      "translation": "벡터별 IRQ 어피니티",
      "glossary_snapshot": {
        "IRQ": "IRQ",
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T22:33:36.260131Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "With MSI-X, each vector can be pinned to a different CPU:",
      "source_hash": 17921140906624042578,
      "context_hash": 11052589808415979739,
      "translation": "MSI-X를 사용하면 각 벡터를 서로 다른 CPU에 고정할 수 있습니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "MSI-X": "MSI-X"
      },
      "translated_at": "2026-11-14T22:33:36.260131Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Interrupt coalescing",
      "source_hash": 13137308033592297403,
      "context_hash": 12422777820021785436,
      "translation": "인터럽트 병합(coalescing)",
      "glossary_snapshot": {
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:36.260131Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "To reduce interrupt rate (and CPU overhead), drivers aggregate multiple completions:",
      "source_hash": 111684048760226841,
      "context_hash": 5934704036822608187,
      "translation": "인터럽트 발생 빈도(및 CPU 오버헤드)를 줄이기 위해 드라이버는 여러 완료(completion)를 모아서 처리합니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "drivers": "드라이버",
        "interrupt": "인터럽트",
        "overhead": "오버헤드"
      },
      "translated_at": "2026-11-14T22:33:36.260131Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
