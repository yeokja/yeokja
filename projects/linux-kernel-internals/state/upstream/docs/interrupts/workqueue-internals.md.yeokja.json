    {
      "id": "section:0/block:1/seg:0",
      "source": "cmwq architecture, worker pools, work item lifecycle, and NUMA affinity",
      "source_hash": 16317115726036690819,
      "context_hash": 11181153515979699335,
      "translation": "cmwq 아키텍처, worker 풀, work item 생명주기, NUMA 어피니티",
      "glossary_snapshot": {
