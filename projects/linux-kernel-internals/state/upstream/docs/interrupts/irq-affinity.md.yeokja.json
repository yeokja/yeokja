    {
      "id": "section:0/block:1/seg:0",
      "source": "Controlling which CPUs handle interrupts for performance and latency",
      "source_hash": 11216463830723381093,
      "context_hash": 12209795195901702853,
      "translation": "성능과 지연 시간을 위해 어떤 CPU가 인터럽트를 처리할지 제어하기",
      "glossary_snapshot": {
        "CPU": "CPU",
        "interrupt": "인터럽트",
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:33:34.280764Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why IRQ affinity matters",
      "source_hash": 15686901587274121691,
      "context_hash": 5542858438575257959,
      "translation": "IRQ 어피니티가 중요한 이유",
      "glossary_snapshot": {
        "IRQ": "IRQ",
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:29:43.088878Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "By default, the kernel distributes interrupts across CPUs automatically (`irqbalance` daemon).",
      "source_hash": 7704174994691272376,
      "context_hash": 15457607968399281750,
      "translation": "기본적으로 커널은 인터럽트를 CPU들에 자동으로 분산합니다(`irqbalance` 데몬).",
      "glossary_snapshot": {
        "CPU": "CPU",
        "daemon": "데몬",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:34.280764Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "For latency-sensitive or high-throughput workloads, manual affinity control lets you:",
      "source_hash": 12280891114967863985,
      "context_hash": 14485327600049953121,
      "translation": "지연 시간에 민감하거나 높은 처리량이 필요한 워크로드에서는 어피니티를 수동으로 제어하여 다음을 할 수 있습니다:",
      "glossary_snapshot": {
        "affinity": "어피니티",
        "latency": "지연 시간",
        "throughput": "처리량",
        "workload": "워크로드"
      },
      "translated_at": "2026-11-14T23:29:43.088878Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Dedicate CPUs to specific network queues (one queue per CPU)",
      "source_hash": 10914243172448509620,
      "context_hash": 11953846281814117348,
      "translation": "특정 네트워크 큐에 CPU 전용 할당(CPU당 큐 하나)",
      "glossary_snapshot": {
        "CPU": "CPU",
        "CPUs": "CPU",
        "queue": "큐",
        "queues": "큐"
      },
      "translated_at": "2026-11-14T22:33:34.280765Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "Isolate real-time tasks from interrupt storms",
      "source_hash": 7552445175761710744,
      "context_hash": 15552499022863004665,
      "translation": "인터럽트 폭주(interrupt storm)로부터 실시간 태스크 격리",
      "glossary_snapshot": {
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:33:34.280765Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "Colocate IRQ handling with the NUMA node that owns the memory",
      "source_hash": 14778859072940302772,
      "context_hash": 17488707709062882454,
      "translation": "메모리를 소유한 NUMA 노드와 같은 위치에서 IRQ 처리",
      "glossary_snapshot": {
        "IRQ": "IRQ",
        "NUMA node": "NUMA 노드",
        "memory": "메모리"
