    {
      "id": "section:3/block:5/seg:0",
      "source": "Most scheduler code uses `this_rq()` — the runqueue for the currently executing CPU.",
      "source_hash": 5860967147743801452,
      "context_hash": 1759018001088568180,
      "translation": "대부분의 스케줄러 코드는 현재 실행 중인 CPU의 런큐인 `this_rq()`를 사용합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "runqueue": "런큐",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T23:01:45.012397Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:1",
      "source": "Accessing another CPU's runqueue requires holding that CPU's `rq->__lock`.",
      "source_hash": 8390164116413050533,
      "context_hash": 13755616076769957450,
      "translation": "다른 CPU의 런큐에 접근하려면 해당 CPU의 `rq->__lock`을 잡고 있어야 합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "runqueue": "런큐"
      },
      "translated_at": "2026-11-14T23:01:45.012397Z",
      "issues": []
    },
