  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Linux Preemption Model",
      "source_hash": 1383648280388454462,
      "context_hash": 4948564086376545391,
      "translation": "Linux 선점 모델",
      "glossary_snapshot": {
        "Linux": "Linux",
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110341Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "When can the kernel be preempted?",
      "source_hash": 15399733569183216006,
      "context_hash": 2421112311725707631,
      "translation": "커널은 언제 선점될 수 있습니까?",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:02:15.110342Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "Voluntary, full, and PREEMPT_RT",
      "source_hash": 17156726316524672931,
      "context_hash": 16566645256447027664,
      "translation": "자발적 선점, 완전 선점, PREEMPT_RT",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110342Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What is preemption?",
      "source_hash": 6399128313569749867,
      "context_hash": 14819573415705901317,
      "translation": "선점이란 무엇입니까?",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110342Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "**Preemption** means stopping the currently running task to run a higher-priority task.",
      "source_hash": 18084977516693971722,
      "context_hash": 16767668039763703467,
      "translation": "**선점**(preemption)이란 현재 실행 중인 태스크를 멈추고 우선순위가 더 높은 태스크를 실행하는 것을 말합니다.",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110342Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Linux has several preemption models, selected at build time via Kconfig:",
      "source_hash": 12294466884783109073,
      "context_hash": 15620085186321196987,
      "translation": "Linux에는 여러 선점 모델이 있으며, 빌드 시점에 Kconfig로 선택합니다.",
      "glossary_snapshot": {
        "Kconfig": "Kconfig",
        "Linux": "Linux",
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110342Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "The model affects **latency** (how quickly high-priority tasks run) vs **throughput** (overall system efficiency).",
      "source_hash": 1127329372598524136,
      "context_hash": 15260382465952093182,
      "translation": "선점 모델은 **지연 시간**(우선순위가 높은 태스크가 얼마나 빨리 실행되는지)과 **처리량**(시스템 전체의 효율) 사이의 균형에 영향을 줍니다.",
      "glossary_snapshot": {
        "latency": "지연 시간",
        "throughput": "처리량"
      },
      "translated_at": "2026-11-14T23:02:15.110343Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "preempt_count: the preemption gate",
      "source_hash": 17629864548069415915,
      "context_hash": 18335909157166202192,
      "translation": "preempt_count: 선점의 관문",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110343Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Every task has a `preempt_count` field in its thread_info.",
      "source_hash": 7621171194221124395,
      "context_hash": 1985052327163813976,
      "translation": "모든 태스크는 자신의 thread_info에 `preempt_count` 필드를 가지고 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110343Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "Preemption is disabled when this is nonzero:",
      "source_hash": 6679181073288311674,
      "context_hash": 10406552698164870402,
      "translation": "이 값이 0이 아니면 선점이 비활성화됩니다.",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110343Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "preempt_count contexts",
      "source_hash": 2760452034864647025,
      "context_hash": 18076997453541711221,
      "translation": "preempt_count 컨텍스트",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110343Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "CONFIG_PREEMPT_NONE: server model",
      "source_hash": 8204352144208815831,
      "context_hash": 18048033557654225229,
      "translation": "CONFIG_PREEMPT_NONE: 서버 모델",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110344Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "No preemption except at explicit `schedule()` calls.",
      "source_hash": 13726016378406635505,
      "context_hash": 3891437886059622003,
      "translation": "명시적인 `schedule()` 호출 지점 외에는 선점이 일어나지 않습니다.",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110344Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "A kernel code path runs until it voluntarily yields:",
      "source_hash": 5075325167666886212,
      "context_hash": 14154082368596234234,
      "translation": "커널 코드 경로는 스스로 CPU를 양보할 때까지 계속 실행됩니다.",
      "glossary_snapshot": {
        "code path": "코드 경로",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:02:15.110344Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "**Latency**: milliseconds to seconds (if kernel path is long) **Throughput**: highest (no unnecessary context switches) **Use case**: servers, batch workloads (HPC, databases)",
      "source_hash": 14646502735317686956,
      "context_hash": 15753985771348284567,
      "translation": "**지연 시간**: 수 밀리초에서 수 초(커널 경로가 긴 경우) **처리량**: 가장 높음(불필요한 컨텍스트 스위치 없음) **사용 사례**: 서버, 배치 워크로드(HPC, 데이터베이스)",
      "glossary_snapshot": {
        "context switch": "컨텍스트 스위치",
        "latency": "지연 시간",
        "throughput": "처리량",
        "workload": "워크로드"
      },
      "translated_at": "2026-11-14T23:02:15.110344Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "CONFIG_PREEMPT_VOLUNTARY: desktop model",
      "source_hash": 2539148451971310591,
      "context_hash": 6818702391884337900,
      "translation": "CONFIG_PREEMPT_VOLUNTARY: 데스크톱 모델",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110344Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Adds explicit preemption points (`might_sleep()`, `cond_resched()`) at strategic locations in long kernel loops:",
      "source_hash": 11997597354282196625,
      "context_hash": 3444951613307361629,
      "translation": "긴 커널 루프의 전략적인 위치에 명시적인 선점 지점(`might_sleep()`, `cond_resched()`)을 추가합니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110344Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "`cond_resched()` checks `TIF_NEED_RESCHED` and calls `schedule()` if set — but only if preemption is not disabled (`preempt_count == 0`).",
      "source_hash": 12768268973081362449,
      "context_hash": 17797368527175070515,
      "translation": "`cond_resched()`는 `TIF_NEED_RESCHED`를 확인하여 설정되어 있으면 `schedule()`를 호출합니다. 단, 선점이 비활성화되지 않은 경우(`preempt_count == 0`)에만 그렇게 합니다.",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110345Z",
      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "**Latency**: tens of milliseconds **Use case**: desktop systems",
      "source_hash": 12208934346747711993,
      "context_hash": 7267390671543145213,
      "translation": "**지연 시간**: 수십 밀리초 **사용 사례**: 데스크톱 시스템",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:02:15.110345Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "CONFIG_PREEMPT: full preemption",
      "source_hash": 10837112273531183001,
      "context_hash": 13652135803189037308,
      "translation": "CONFIG_PREEMPT: 완전 선점",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110345Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The kernel can be preempted at any point where `preempt_count == 0`, not just at explicit yield points.",
      "source_hash": 175912410236803637,
      "context_hash": 6004431343692880127,
      "translation": "커널은 명시적인 양보 지점뿐 아니라 `preempt_count == 0`인 모든 지점에서 선점될 수 있습니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:02:15.110345Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "When `TIF_NEED_RESCHED` is set, the task is preempted at the next preemption window:",
      "source_hash": 14012279148158414351,
      "context_hash": 5897021394059834977,
      "translation": "`TIF_NEED_RESCHED`가 설정되면 태스크는 다음 선점 가능 구간에서 선점됩니다.",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T23:02:15.110345Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "**Latency**: hundreds of microseconds **Use case**: desktop, embedded, audio systems",
      "source_hash": 3212500430045622638,
      "context_hash": 7117170155395218541,
      "translation": "**지연 시간**: 수백 마이크로초 **사용 사례**: 데스크톱, 임베디드, 오디오 시스템",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:02:15.110346Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "CONFIG_PREEMPT_RT: real-time",
      "source_hash": 16904826814684478135,
      "context_hash": 4573673341957485987,
      "translation": "CONFIG_PREEMPT_RT: 실시간",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110346Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "PREEMPT_RT (fully merged in 6.12 for all architectures — [merge commit `baeb9a7d8b60`](https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=baeb9a7d8b60b021d907127509c44507539c15e5), [LWN](https://lwn.net/Articles/989212/)) converts almost all spinlocks to sleeping mutexes, allowing preemption even while holding a \"spinlock\":",
      "source_hash": 7215495886185367189,
      "context_hash": 15636162466253987310,
      "translation": "PREEMPT_RT(6.12에서 모든 아키텍처에 대해 완전히 병합됨 — [병합 커밋 `baeb9a7d8b60`](https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=baeb9a7d8b60b021d907127509c44507539c15e5), [LWN](https://lwn.net/Articles/989212/))는 거의 모든 스핀락을 슬립 가능한 뮤텍스로 변환하여, \"스핀락\"을 잡고 있는 동안에도 선점을 허용합니다.",
      "glossary_snapshot": {
        "LWN": "LWN",
        "mutex": "뮤텍스",
        "preemption": "선점",
        "spinlock": "스핀락"
      },
      "translated_at": "2026-11-14T23:02:15.110346Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "What changes in PREEMPT_RT",
      "source_hash": 17057725861643004140,
      "context_hash": 3548022426889564696,
      "translation": "PREEMPT_RT에서 달라지는 점",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110346Z",
      "issues": []
    },
    {
      "id": "section:6/block:5/seg:0",
      "source": "Priority inversion prevention",
      "source_hash": 4605213769817939862,
      "context_hash": 26056288940594047,
      "translation": "우선순위 역전 방지",
      "glossary_snapshot": {
        "Priority Inversion": "우선순위 역전"
      },
      "translated_at": "2026-11-14T23:02:15.110346Z",
      "issues": []
    },
    {
      "id": "section:6/block:6/seg:0",
      "source": "PREEMPT_RT enables the **priority inheritance** mechanism for RT mutexes:",
      "source_hash": 16479590860792530231,
      "context_hash": 10810371220494730565,
      "translation": "PREEMPT_RT는 RT 뮤텍스에 대해 **우선순위 상속**(priority inheritance) 메커니즘을 활성화합니다.",
      "glossary_snapshot": {
        "mutex": "뮤텍스"
      },
      "translated_at": "2026-11-14T23:02:15.110346Z",
      "issues": []
    },
    {
      "id": "section:6/block:8/seg:0",
      "source": "See [Priority Inversion and PI Mutexes](pi-mutexes.md) for details.",
      "source_hash": 3392202346537866095,
      "context_hash": 1336634952451455012,
      "translation": "자세한 내용은 [우선순위 역전과 PI 뮤텍스](pi-mutexes.md)를 참조하십시오.",
      "glossary_snapshot": {
        "Priority Inversion": "우선순위 역전",
        "mutex": "뮤텍스"
      },
      "translated_at": "2026-11-14T23:02:15.110347Z",
      "issues": []
    },
    {
      "id": "section:6/block:9/seg:0",
      "source": "PREEMPT_RT latency",
      "source_hash": 14359614139780354466,
      "context_hash": 11091355939856233367,
      "translation": "PREEMPT_RT 지연 시간",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:02:15.110347Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "preempt_disable in practice",
      "source_hash": 17829679233354551844,
      "context_hash": 6574175840173044762,
      "translation": "실제 preempt_disable 사용",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:15.110347Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "Spinlocks implicitly disable preemption",
      "source_hash": 14704157286612967849,
      "context_hash": 18039190508905872536,
      "translation": "스핀락의 암묵적인 선점 비활성화",
      "glossary_snapshot": {
        "preemption": "선점",
        "spinlock": "스핀락"
      },
      "translated_at": "2026-11-14T23:02:15.110347Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "Per-CPU operations require preemption disabled",
      "source_hash": 12157265348853767015,
      "context_hash": 590051210958952831,
      "translation": "Per-CPU 연산에는 선점 비활성화가 필요함",
      "glossary_snapshot": {
        "CPU": "CPU",
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T22:12:51.433249Z",
      "issues": []
    },
    {
      "id": "section:7/block:5/seg:0",
