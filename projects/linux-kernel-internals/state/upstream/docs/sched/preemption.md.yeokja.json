      "issues": []
    },
    {
      "id": "section:8/block:0/seg:0",
      "source": "might_sleep: debugging sleeping in atomic context",
      "source_hash": 1937084226206870932,
      "context_hash": 5493300489322994042,
      "translation": "might_sleep: atomic 컨텍스트에서의 sleep 디버깅",
