  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "CPU Affinity",
      "source_hash": 1706710377580016645,
      "context_hash": 18099170598232235972,
      "translation": "CPU 어피니티(CPU Affinity)",
      "glossary_snapshot": {
        "CPU": "CPU",
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:06:45.324038Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Per-task CPU pinning: sched_setaffinity() and how it interacts with cpusets",
      "source_hash": 3322413411969201779,
      "context_hash": 6737638231072578696,
      "translation": "태스크별 CPU 고정: sched_setaffinity()와 cpuset과의 상호작용",
      "glossary_snapshot": {
        "CPU": "CPU",
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324040Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What CPU affinity controls",
      "source_hash": 13808823985570038274,
      "context_hash": 15308547221484996779,
      "translation": "CPU 어피니티가 제어하는 것",
      "glossary_snapshot": {
        "CPU": "CPU",
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:06:45.324040Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "CPU affinity lets a task (or an admin) restrict which CPUs a specific task may run on.",
      "source_hash": 891657027885331999,
      "context_hash": 7753993737694860514,
      "translation": "CPU 어피니티를 사용하면 태스크(또는 관리자)가 특정 태스크가 실행될 수 있는 CPU를 제한할 수 있습니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "CPUs": "CPU",
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:06:45.324041Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Unlike cpuset — which applies to an entire cgroup — affinity is **per-task**.",
      "source_hash": 1792249606260470292,
      "context_hash": 12122161252796027135,
      "translation": "cgroup 전체에 적용되는 cpuset과 달리, 어피니티는 **태스크별**로 적용됩니다.",
      "glossary_snapshot": {
        "affinity": "어피니티",
        "cgroup": "cgroup",
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324041Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Common uses:",
      "source_hash": 13514442608924486836,
      "context_hash": 2772097550987032580,
      "translation": "일반적인 용도:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:45.324042Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Cache locality**: Pin a task to CPUs sharing an L3 cache",
      "source_hash": 9407742989980015104,
      "context_hash": 5601421481906032251,
      "translation": "**캐시 지역성**: L3 캐시를 공유하는 CPU에 태스크 고정",
      "glossary_snapshot": {
        "CPU": "CPU",
        "locality": "지역성"
      },
      "translated_at": "2026-11-14T23:06:45.324042Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Interrupt binding**: Keep a task on the same CPU as the NIC interrupt it processes",
      "source_hash": 8364118751771248066,
      "context_hash": 15177170469978455843,
      "translation": "**인터럽트 바인딩**: 태스크가 처리하는 NIC 인터럽트와 같은 CPU에 태스크 유지",
      "glossary_snapshot": {
        "CPU": "CPU",
        "NIC": "NIC",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T23:06:45.324043Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Benchmarking**: Eliminate CPU-to-CPU variation by pinning to one core",
      "source_hash": 8747397321293325721,
      "context_hash": 2283482940227989842,
      "translation": "**벤치마킹**: 하나의 코어에 고정하여 CPU 간 편차 제거",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:06:45.324043Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "**Real-time**: Reserve cores for latency-sensitive tasks",
      "source_hash": 7916532586106850868,
      "context_hash": 13366777678318616625,
      "translation": "**실시간**: 지연 시간에 민감한 태스크를 위한 코어 예약",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:06:45.324043Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "The syscall",
      "source_hash": 3153174159417637581,
      "context_hash": 5859697097720641576,
      "translation": "시스템 콜",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T23:06:45.324043Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "From the command line:",
      "source_hash": 10133706569772148090,
      "context_hash": 8054969258029113124,
      "translation": "명령줄에서:",
      "glossary_snapshot": {
        "command line": "명령줄"
      },
      "translated_at": "2026-11-14T23:06:45.324044Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Kernel implementation",
      "source_hash": 289839300155434675,
      "context_hash": 1214775582621480183,
      "translation": "커널 구현",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:06:45.324044Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "The syscall path",
      "source_hash": 9130702006290936139,
      "context_hash": 6047930490146847334,
      "translation": "시스템 콜 경로",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T23:06:45.324044Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "`sched_setaffinity()` validates the mask, checks permissions, and calls `__sched_setaffinity()` which calls `set_cpus_allowed_ptr()`.",
      "source_hash": 16052597959608262251,
      "context_hash": 17580314931448719894,
      "translation": "`sched_setaffinity()`는 마스크를 검증하고 권한을 확인한 뒤 `__sched_setaffinity()`를 호출하며, 이 함수는 `set_cpus_allowed_ptr()`를 호출합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:45.324045Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "Affinity fields in task_struct",
      "source_hash": 15020430324660187711,
      "context_hash": 3360356209489998647,
      "translation": "task_struct의 어피니티 필드",
      "glossary_snapshot": {
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:06:45.324045Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "`cpus_ptr` is what the scheduler reads.",
      "source_hash": 10971576025339650888,
      "context_hash": 12351276129947279935,
      "translation": "`cpus_ptr`는 스케줄러가 읽는 필드입니다.",
      "glossary_snapshot": {
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T23:06:45.324045Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:1",
      "source": "It normally points to `cpus_mask`.",
      "source_hash": 7201956921609159793,
      "context_hash": 14763782195211755311,
      "translation": "일반적으로 `cpus_mask`를 가리킵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:45.324046Z",
      "issues": []
    },
    {
      "id": "section:3/block:7/seg:0",
      "source": "During temporary CPU restriction (e.g., migration helpers), `cpus_ptr` may point elsewhere.",
      "source_hash": 14802138279430292102,
      "context_hash": 1996388460490398750,
      "translation": "일시적으로 CPU가 제한되는 동안(예: 마이그레이션 헬퍼), `cpus_ptr`는 다른 곳을 가리킬 수 있습니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:06:45.324046Z",
      "issues": []
    },
    {
      "id": "section:3/block:8/seg:0",
      "source": "`user_cpus_ptr` tracks the user's requested mask, separate from any cpuset-imposed restrictions.",
      "source_hash": 17591728901832462406,
      "context_hash": 10833369675774124784,
      "translation": "`user_cpus_ptr`는 cpuset이 부과하는 제한과는 별도로 사용자가 요청한 마스크를 추적합니다.",
      "glossary_snapshot": {
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324046Z",
      "issues": []
    },
    {
      "id": "section:3/block:9/seg:0",
      "source": "Reading back affinity",
      "source_hash": 16521759416178004121,
      "context_hash": 5211039358763226591,
      "translation": "어피니티 다시 읽기",
      "glossary_snapshot": {
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:06:45.324046Z",
      "issues": []
    },
    {
      "id": "section:3/block:11/seg:0",
      "source": "The returned mask is always intersected with `cpu_active_mask` — offline CPUs are excluded even if they're in `cpus_mask`.",
      "source_hash": 836804043579132607,
      "context_hash": 18203469491834054850,
      "translation": "반환되는 마스크는 항상 `cpu_active_mask`와 교집합을 취한 것입니다. 오프라인 CPU는 `cpus_mask`에 포함되어 있더라도 제외됩니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:06:45.324046Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Affinity and cpuset intersection",
      "source_hash": 1652909297326662103,
      "context_hash": 17791334950356301757,
      "translation": "어피니티와 cpuset의 교집합",
      "glossary_snapshot": {
        "affinity": "어피니티",
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324047Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "When a task is in a cpuset, the effective affinity is:",
      "source_hash": 16397026397360305432,
      "context_hash": 5777347796089379068,
      "translation": "태스크가 cpuset에 속해 있을 때 유효 어피니티는 다음과 같습니다:",
      "glossary_snapshot": {
        "affinity": "어피니티",
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324047Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "If you call `sched_setaffinity()` with a mask that includes CPUs outside the cpuset, those CPUs are silently excluded.",
      "source_hash": 8585984178703913986,
      "context_hash": 813474943764272545,
      "translation": "cpuset 밖의 CPU가 포함된 마스크로 `sched_setaffinity()`를 호출하면, 해당 CPU는 아무런 알림 없이 제외됩니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324047Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:1",
      "source": "The task cannot escape its cpuset through affinity.",
      "source_hash": 14306016640263461963,
      "context_hash": 7995514822758757216,
      "translation": "태스크는 어피니티를 통해 자신의 cpuset을 벗어날 수 없습니다.",
      "glossary_snapshot": {
        "affinity": "어피니티",
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324047Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "The kernel stores both masks separately:",
      "source_hash": 168891990269458896,
      "context_hash": 1467600544493484932,
      "translation": "커널은 두 마스크를 별도로 저장합니다:",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:06:45.324047Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:0",
      "source": "`user_cpus_ptr`: what the user asked for",
      "source_hash": 9569284425067818000,
      "context_hash": 15011645532894242607,
      "translation": "`user_cpus_ptr`: 사용자가 요청한 것",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:45.324047Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:0",
      "source": "`cpus_mask`: the intersection with cpuset (what's actually enforced)",
      "source_hash": 15138070173200630997,
      "context_hash": 5909694165105246737,
      "translation": "`cpus_mask`: cpuset과의 교집합(실제로 적용되는 것)",
      "glossary_snapshot": {
        "cpuset": "cpuset"
      },
      "translated_at": "2026-11-14T23:06:45.324048Z",
      "issues": []
    },
    {
      "id": "section:4/block:8/seg:0",
      "source": "This separation lets the kernel recompute the effective mask if the cpuset changes, without losing the user's original intent.",
      "source_hash": 17359096823206315775,
      "context_hash": 13818303653287350134,
      "translation": "이렇게 분리되어 있으므로 커널은 cpuset이 변경되면 사용자의 원래 의도를 잃지 않고 유효 마스크를 다시 계산할 수 있습니다.",
      "glossary_snapshot": {
        "cpuset": "cpuset",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:06:45.324048Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Migration: what happens when affinity changes",
      "source_hash": 14430689765370281193,
      "context_hash": 785125008700300005,
      "translation": "마이그레이션: 어피니티가 변경되면 일어나는 일",
      "glossary_snapshot": {
        "affinity": "어피니티"
      },
      "translated_at": "2026-11-14T23:06:45.324048Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "When `set_cpus_allowed_ptr()` is called:",
      "source_hash": 14731249555676575320,
      "context_hash": 11025063370687857504,
      "translation": "`set_cpus_allowed_ptr()`가 호출되면:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:45.324048Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "If the task's current CPU is still in the new mask → nothing changes immediately",
      "source_hash": 17096969546113578395,
      "context_hash": 5240342838766424391,
      "translation": "태스크의 현재 CPU가 여전히 새 마스크에 포함되어 있으면 → 즉시 바뀌는 것은 없습니다",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:06:43.172619Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "If the current CPU is excluded → the task is migrated to an allowed CPU",
      "source_hash": 17881840239789426321,
      "context_hash": 11837844503675691178,
      "translation": "현재 CPU가 제외되면 → 태스크는 허용된 CPU로 마이그레이션됩니다",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:06:43.172620Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "Migration goes through `migration_cpu_stop()` — a stop-machine mechanism that runs on the target CPU to safely move the task",
      "source_hash": 14289452504022251768,
      "context_hash": 3820612324684616350,
      "translation": "마이그레이션은 `migration_cpu_stop()`을 거칩니다 — 대상 CPU에서 실행되어 태스크를 안전하게 옮기는 stop-machine 메커니즘입니다",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:06:43.172621Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Kernel threads and affinity",
      "source_hash": 4675015783056039486,
      "context_hash": 6021370791372536110,
      "translation": "커널 스레드와 어피니티",
      "glossary_snapshot": {
        "affinity": "어피니티",
        "kernel thread": "커널 스레드"
      },
      "translated_at": "2026-11-14T23:06:43.172622Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "Kernel threads start with affinity set to all online CPUs (`cpu_all_mask`).",
      "source_hash": 3952075029796340850,
      "context_hash": 8500243946718632041,
      "translation": "커널 스레드는 모든 온라인 CPU(`cpu_all_mask`)로 설정된 어피니티로 시작합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "affinity": "어피니티",
        "kernel thread": "커널 스레드"
      },
      "translated_at": "2026-11-14T23:06:43.172622Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:1",
      "source": "You can restrict them:",
      "source_hash": 2689198851716072192,
      "context_hash": 9222899451905356756,
      "translation": "다음과 같이 제한할 수 있습니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:43.172623Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "Some kernel threads explicitly set their own affinity (e.g., interrupt threads, per-CPU kthreads) and resist external changes.",
      "source_hash": 16230754142832744570,
      "context_hash": 7215848117690666219,
      "translation": "일부 커널 스레드(예: 인터럽트 스레드, per-CPU kthread)는 자신의 어피니티를 명시적으로 설정하며 외부에서의 변경을 거부합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "affinity": "어피니티",
        "interrupt": "인터럽트",
        "kernel thread": "커널 스레드"
      },
      "translated_at": "2026-11-14T23:06:43.172623Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:1",
      "source": "Check `/proc/PID/status` for `Cpus_allowed`.",
      "source_hash": 8381330617528641196,
      "context_hash": 5938259676854194768,
      "translation": "`/proc/PID/status`에서 `Cpus_allowed`를 확인하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:06:43.172624Z",
      "issues": []
    },
    {
