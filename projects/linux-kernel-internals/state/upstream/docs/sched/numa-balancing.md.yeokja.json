  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "NUMA Automatic Balancing",
      "source_hash": 9508199022707945592,
      "context_hash": 17559770999481892179,
      "translation": "NUMA 자동 밸런싱",
      "glossary_snapshot": {
        "NUMA": "NUMA"
      },
      "translated_at": "2026-11-14T22:12:34.403286Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "How the scheduler detects and fixes NUMA locality mismatches",
      "source_hash": 2540301964779722936,
      "context_hash": 14116232546753863084,
      "translation": "스케줄러가 NUMA 지역성 불일치를 감지하고 바로잡는 방법",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "locality": "지역성",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T22:12:34.403287Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The problem",
      "source_hash": 2326415031189538800,
      "context_hash": 3113031738866849913,
      "translation": "문제",
      "glossary_snapshot": {
        "The problem": "문제"
      },
      "translated_at": "2026-11-14T22:12:34.403287Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "On NUMA systems, memory access latency depends on which NUMA node holds the physical page:",
      "source_hash": 4757121939249373885,
      "context_hash": 1617587013927328836,
      "translation": "NUMA 시스템에서 메모리 접근 지연 시간은 어느 NUMA 노드가 물리 페이지를 보유하고 있는지에 따라 달라집니다:",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "NUMA node": "NUMA 노드",
        "latency": "지연 시간",
        "memory access": "메모리 접근",
        "physical page": "물리 페이지"
      },
      "translated_at": "2026-11-14T22:12:34.403287Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Automatic NUMA balancing** (CONFIG_NUMA_BALANCING) detects this situation and migrates pages to the node where they're being used.",
      "source_hash": 17093656236539217624,
      "context_hash": 5622156461794033428,
      "translation": "**자동 NUMA 밸런싱**(CONFIG_NUMA_BALANCING)은 이러한 상황을 감지하고 페이지를 그 페이지가 사용되는 노드로 마이그레이션합니다.",
      "glossary_snapshot": {
        "NUMA balancing": "NUMA 밸런싱",
        "node": "노드"
      },
      "translated_at": "2026-11-14T22:12:34.403287Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:1",
      "source": "Introduced in Linux 3.13 by Mel Gorman (SUSE) et al. — [`10fc05d0e551`](https://git.kernel.org/linus/10fc05d0e551146ad6feb0ab8902d28a2d3c5624).",
      "source_hash": 14724118162085244997,
      "context_hash": 16102779571919793839,
      "translation": "Linux 3.13에서 Mel Gorman(SUSE) 등이 도입했습니다 — [`10fc05d0e551`](https://git.kernel.org/linus/10fc05d0e551146ad6feb0ab8902d28a2d3c5624).",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:12:34.403287Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "How it works",
      "source_hash": 16935900381963222246,
      "context_hash": 13421146525822419473,
      "translation": "동작 방식",
      "glossary_snapshot": {
        "How it works": "동작 방식"
      },
      "translated_at": "2026-11-14T22:12:34.403288Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Phase 1: Mark pages as inaccessible (PROT_NONE)",
      "source_hash": 6161930226317545922,
      "context_hash": 2080094117972712685,
      "translation": "1단계: 페이지를 접근 불가로 표시(PROT_NONE)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:12:34.403288Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "The NUMA balancer periodically scans a process's page tables and changes the PTE of accessed pages to `PROT_NONE` (unmaps them without freeing):",
      "source_hash": 17835127094470295271,
      "context_hash": 17725505689413489146,
      "translation": "NUMA 밸런서는 주기적으로 프로세스의 페이지 테이블을 스캔하여 접근된 페이지의 PTE를 `PROT_NONE`으로 변경합니다(해제하지 않고 매핑만 해제합니다):",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "PTE": "PTE",
        "page table": "페이지 테이블"
      },
      "translated_at": "2026-11-14T22:12:34.403288Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "Phase 2: Catch NUMA page faults",
      "source_hash": 5429924983755362425,
      "context_hash": 16358042619072398570,
      "translation": "2단계: NUMA 페이지 폴트 포착",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "page fault": "페이지 폴트"
      },
      "translated_at": "2026-11-14T22:12:34.403288Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "When the task accesses the PROT_NONE page, a page fault fires:",
      "source_hash": 9082512202658626469,
      "context_hash": 7118199912887766806,
      "translation": "태스크가 PROT_NONE 페이지에 접근하면 페이지 폴트가 발생합니다:",
      "glossary_snapshot": {
        "page fault": "페이지 폴트"
      },
      "translated_at": "2026-11-14T22:12:34.403288Z",
      "issues": []
    },
    {
      "id": "section:2/block:7/seg:0",
      "source": "Phase 3: Task migration",
      "source_hash": 10709034365939671718,
      "context_hash": 4175086054750876333,
      "translation": "3단계: 태스크 마이그레이션",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:12:34.403288Z",
      "issues": []
    },
    {
      "id": "section:2/block:8/seg:0",
      "source": "If the task has most of its pages on Node 1 but runs on Node 0, the scheduler may migrate the **task** instead of (or in addition to) the pages:",
      "source_hash": 8585815943320148237,
      "context_hash": 12485116126444674603,
      "translation": "태스크의 페이지 대부분이 노드 1에 있지만 태스크는 노드 0에서 실행되는 경우, 스케줄러는 페이지 대신(또는 페이지와 함께) **태스크**를 마이그레이션할 수 있습니다:",
      "glossary_snapshot": {
        "node": "노드",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T23:32:57.598392Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "NUMA statistics per task",
      "source_hash": 5726408763278773835,
      "context_hash": 6402514261433881824,
      "translation": "태스크별 NUMA 통계",
      "glossary_snapshot": {
        "NUMA": "NUMA"
      },
      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "NUMA groups: shared memory balancing",
      "source_hash": 11453162122660944585,
      "context_hash": 1898219844016195840,
      "translation": "NUMA 그룹: 공유 메모리 밸런싱",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "shared memory": "공유 메모리"
      },
      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "When multiple tasks share memory (e.g., a multithreaded program), they form a **NUMA group**:",
      "source_hash": 4053772103361941460,
      "context_hash": 9403817266798857761,
      "translation": "여러 태스크가 메모리를 공유하면(예: 멀티스레드 프로그램) 이들은 **NUMA 그룹**을 형성합니다:",
      "glossary_snapshot": {
        "NUMA": "NUMA",
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Balancing scan rate",
      "source_hash": 13161252039699724246,
      "context_hash": 9704894240679364425,
      "translation": "밸런싱 스캔 속도",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The scan rate adapts based on how many NUMA faults are found:",
      "source_hash": 2199950977477049855,
      "context_hash": 12937515489282643619,
      "translation": "스캔 속도는 발견되는 NUMA 폴트의 수에 따라 조정됩니다:",
      "glossary_snapshot": {
        "NUMA": "NUMA"
      },
      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Configuration",
      "source_hash": 4935613502183038470,
      "context_hash": 13086359851486317421,
      "translation": "설정",
      "glossary_snapshot": {
        "Configuration": "설정"
      },
      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Observing NUMA balancing",
      "source_hash": 7332531529435759929,
      "context_hash": 9533636493042323374,
      "translation": "NUMA 밸런싱 관찰",
      "glossary_snapshot": {
