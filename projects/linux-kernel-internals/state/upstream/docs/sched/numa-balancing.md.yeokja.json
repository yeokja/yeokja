      "issues": []
    },
    {
      "id": "section:9/block:1/seg:0",
      "source": "For applications that want explicit NUMA control:",
      "source_hash": 11528195255404238486,
      "context_hash": 3196734314299450707,
      "translation": "명시적인 NUMA 제어가 필요한 애플리케이션의 경우:",
      "glossary_snapshot": {
        "NUMA": "NUMA"
      },
      "translated_at": "2026-11-14T22:12:34.403290Z",
      "issues": []
    },
