      "translated_at": "2026-11-14T22:12:34.403289Z",
      "issues": []
    },
    {
      "id": "section:8/block:0/seg:0",
      "source": "When to disable NUMA balancing",
      "source_hash": 2579990128650862932,
      "context_hash": 15106612330626275313,
      "translation": "NUMA 밸런싱을 비활성화해야 하는 경우",
      "glossary_snapshot": {
        "NUMA balancing": "NUMA 밸런싱"
      },
