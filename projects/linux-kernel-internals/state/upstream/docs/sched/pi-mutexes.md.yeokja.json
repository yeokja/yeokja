      "issues": []
    },
    {
      "id": "section:9/block:12/seg:0",
      "source": "Yes, if shared with non-RT tasks",
      "source_hash": 16727993005804027809,
      "context_hash": 86174439519620678,
      "translation": "예, 비 RT 태스크와 공유하는 경우",
      "glossary_snapshot": {
        "RT task": "RT 태스크"
      },
      "translated_at": "2026-11-14T22:46:24.448148Z",
      "issues": []
    },
    {
      "id": "section:9/block:13/seg:0",
      "source": "Kernel backing",
      "source_hash": 8981541055985841201,
      "context_hash": 5884145215993539230,
