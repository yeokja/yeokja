      "context_hash": 968328962985232060,
      "translation": "`perf sched`는 스케줄링 활동을 기록하고 지연 시간 보고서를 생성합니다:",
      "glossary_snapshot": {
        "latency": "지연 시간",
        "scheduling": "스케줄링"
