    {
      "id": "section:0/block:1/seg:0",
      "source": "ftrace, perf, and BPF tools for observing scheduler behavior in real time",
      "source_hash": 7376262439085255882,
      "context_hash": 14246322437991718805,
      "translation": "스케줄러 동작을 실시간으로 관찰하기 위한 ftrace, perf, BPF 도구",
      "glossary_snapshot": {
        "BPF": "BPF",
        "ftrace": "ftrace",
        "perf": "perf",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T22:55:18.534558Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Scheduler trace events",
      "source_hash": 16909579398035762395,
      "context_hash": 12065993481989603819,
      "translation": "스케줄러 트레이스 이벤트",
      "glossary_snapshot": {
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T22:55:18.534559Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "The kernel emits scheduler events through the tracepoint system (ftrace).",
      "source_hash": 6270282909698075343,
      "context_hash": 3421864153029238697,
      "translation": "커널은 트레이스포인트 시스템(ftrace)을 통해 스케줄러 이벤트를 내보냅니다.",
      "glossary_snapshot": {
        "ftrace": "ftrace",
        "kernel": "커널",
        "scheduler": "스케줄러",
        "tracepoint": "트레이스포인트"
      },
      "translated_at": "2026-11-14T22:55:18.534559Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "These are defined in `include/trace/events/sched.h` and cover every significant scheduling decision.",
      "source_hash": 377210015046260875,
      "context_hash": 847777060154071707,
      "translation": "이 이벤트들은 `include/trace/events/sched.h`에 정의되어 있으며 중요한 스케줄링 결정을 모두 다룹니다.",
      "glossary_snapshot": {
        "scheduling": "스케줄링"
      },
      "translated_at": "2026-11-14T22:55:18.534560Z",
      "issues": []
    },
