    {
      "id": "section:7/block:1/seg:0",
      "source": "`runqlat` (from the BCC toolkit) measures how long tasks wait in the runqueue before running:",
      "source_hash": 4250169304001338646,
      "context_hash": 18156838240929258625,
      "translation": "`runqlat`(BCC 툴킷에 포함)은 태스크가 실행되기 전에 런큐에서 얼마나 오래 기다리는지 측정합니다:",
      "glossary_snapshot": {
        "runqueue": "런큐"
      },
      "translated_at": "2026-11-14T22:13:31.620889Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
