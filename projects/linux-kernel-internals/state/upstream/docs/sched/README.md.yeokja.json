    {
      "id": "section:0/block:1/seg:0",
      "source": "How Linux decides which task runs next",
      "source_hash": 9895465870811019427,
      "context_hash": 4423754290663706540,
      "translation": "Linux가 다음에 실행할 태스크를 결정하는 방식",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T23:06:46.781745Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "The Linux scheduler is responsible for deciding which task runs on each CPU at any given moment.",
      "source_hash": 1634210202468043392,
      "context_hash": 11543526140157658544,
      "translation": "Linux 스케줄러는 매 순간 각 CPU에서 어떤 태스크를 실행할지 결정하는 역할을 맡습니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "Linux": "Linux",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T23:06:46.781746Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:1",
      "source": "It balances competing requirements: fairness between tasks, low latency for interactive work, high throughput for batch jobs, and determinism for real-time processes.",
      "source_hash": 13752739976274995033,
      "context_hash": 16612470215169828371,
      "translation": "스케줄러는 태스크 간 공정성, 대화형 작업의 낮은 지연 시간, 배치 작업의 높은 처리량, 실시간 프로세스의 결정성이라는 서로 상충하는 요구 사항 사이에서 균형을 잡습니다.",
      "glossary_snapshot": {
        "latency": "지연 시간",
        "processes": "프로세스",
        "throughput": "처리량"
      },
      "translated_at": "2026-11-14T23:06:46.781747Z",
      "issues": []
    },
