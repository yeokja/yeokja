    {
      "id": "section:1/block:5/seg:0",
      "source": "The relationship: `sched_latency_ns ≥ nr_runnable × sched_min_granularity_ns` ensures each runnable task gets at least one slice per latency period.",
      "source_hash": 612945680304341,
      "context_hash": 5363102671140008308,
      "translation": "관계식 `sched_latency_ns ≥ nr_runnable × sched_min_granularity_ns`는 실행 가능한 각 태스크가 지연 시간 주기마다 최소 한 번의 slice를 받도록 보장합니다.",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:35:17.980201Z",
      "issues": []
    },
