  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "CPU cgroup: v1 vs v2",
      "source_hash": 20645308187979609,
      "context_hash": 2396497004311449427,
      "translation": "CPU cgroup: v1과 v2 비교",
      "glossary_snapshot": {
        "CPU": "CPU",
        "cgroup": "cgroup"
      },
      "translated_at": "2026-11-14T22:32:48.480775Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Controlling CPU allocation with cgroups — shares, weights, and bandwidth",
      "source_hash": 17212090493304446322,
      "context_hash": 12373383567638556788,
      "translation": "cgroup으로 CPU 할당 제어하기 — share, weight, 대역폭",
      "glossary_snapshot": {
        "CPU": "CPU",
        "bandwidth": "대역폭",
        "cgroup": "cgroup"
      },
      "translated_at": "2026-11-14T23:32:20.486821Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What CPU cgroups control",
      "source_hash": 3449912860610187755,
      "context_hash": 6637018187454072218,
      "translation": "CPU cgroup이 제어하는 것",
      "glossary_snapshot": {
        "CPU": "CPU",
        "cgroup": "cgroup"
      },
      "translated_at": "2026-11-14T22:32:48.480779Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "CPU cgroups give you two independent controls:",
      "source_hash": 9969135538234731848,
      "context_hash": 7931453647548921432,
      "translation": "CPU cgroup은 서로 독립적인 두 가지 제어 수단을 제공합니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "cgroup": "cgroup"
      },
      "translated_at": "2026-11-14T22:32:48.480779Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Weight** (proportional share): \"This group gets 2x more CPU than that group when both are busy\"",
      "source_hash": 14783275816101075795,
      "context_hash": 8958170464025663034,
      "translation": "**Weight**(비례 배분): \"두 그룹이 모두 바쁠 때 이 그룹이 저 그룹보다 CPU를 2배 더 받습니다\"",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:32:48.480780Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Bandwidth** (hard limit): \"This group can use at most 50% of one CPU per period\"",
      "source_hash": 17192857261791682871,
      "context_hash": 14699611405568877388,
      "translation": "**대역폭**(하드 제한): \"이 그룹은 주기마다 CPU 하나의 최대 50%까지 사용할 수 있습니다\"",
      "glossary_snapshot": {
        "CPU": "CPU",
        "bandwidth": "대역폭"
      },
      "translated_at": "2026-11-14T23:32:20.486823Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "These are orthogonal.",
      "source_hash": 15072769666903939131,
      "context_hash": 110854915613527438,
      "translation": "이 둘은 서로 직교합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:48.480780Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:1",
      "source": "A group with high weight still gets throttled if it hits its bandwidth limit.",
      "source_hash": 3734847478935637727,
      "context_hash": 12552983501452941416,
      "translation": "weight가 높은 그룹이라도 대역폭 제한에 도달하면 스로틀링됩니다.",
      "glossary_snapshot": {
        "bandwidth": "대역폭"
      },
      "translated_at": "2026-11-14T23:32:20.486823Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "The interface difference",
      "source_hash": 7019066971156396030,
      "context_hash": 17996470871722588883,
      "translation": "인터페이스 차이",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:48.480780Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "cgroup v1 and v2 expose the same underlying mechanisms with different interfaces:",
      "source_hash": 3482294669436273832,
      "context_hash": 11006138818424383593,
      "translation": "cgroup v1과 v2는 동일한 기반 메커니즘을 서로 다른 인터페이스로 노출합니다:",
      "glossary_snapshot": {
        "cgroup": "cgroup"
      },
      "translated_at": "2026-11-14T22:32:48.480780Z",
      "issues": []
    },
    {
