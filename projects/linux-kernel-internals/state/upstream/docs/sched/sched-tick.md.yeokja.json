  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "The Scheduling Tick",
      "source_hash": 12100651782926703403,
      "context_hash": 4046121591737086233,
      "translation": "스케줄링 틱",
      "glossary_snapshot": {
        "scheduling": "스케줄링"
      },
      "translated_at": "2026-11-14T22:40:31.377142Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "How the kernel drives time-based scheduling: jiffies, HZ, and NOHZ",
      "source_hash": 14418966214985353171,
      "context_hash": 1993180563151420242,
      "translation": "커널이 시간 기반 스케줄링을 구동하는 방식: jiffies, HZ, NOHZ",
      "glossary_snapshot": {
        "jiffies": "jiffies",
        "kernel": "커널",
        "scheduling": "스케줄링"
      },
      "translated_at": "2026-11-14T22:40:31.377142Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The periodic tick",
      "source_hash": 13560586771253305513,
      "context_hash": 850345056239185149,
      "translation": "주기적 틱",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377142Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "The kernel runs a periodic timer interrupt (the \"tick\") at a rate of `HZ` times per second.",
      "source_hash": 13648043568258383890,
      "context_hash": 17552201491030325554,
      "translation": "커널은 초당 `HZ`회의 빈도로 주기적인 타이머 인터럽트(\"틱\")를 실행합니다.",
      "glossary_snapshot": {
        "interrupt": "인터럽트",
        "kernel": "커널",
        "timer": "타이머"
      },
      "translated_at": "2026-11-14T22:40:31.377143Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The tick drives:",
      "source_hash": 14857071666940148872,
      "context_hash": 11762672513227254449,
      "translation": "틱이 구동하는 작업은 다음과 같습니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377143Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Updating `jiffies` (coarse-grained time)",
      "source_hash": 12882584070390537810,
      "context_hash": 4904406477802150391,
      "translation": "`jiffies` 갱신(저해상도 시간)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377143Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "Updating process CPU time accounting",
      "source_hash": 923715130582066483,
      "context_hash": 17931856407711023707,
      "translation": "프로세스 CPU 시간 어카운팅 갱신",
      "glossary_snapshot": {
        "CPU time": "CPU 시간",
        "accounting": "어카운팅",
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:40:31.377143Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "Checking if the current task should be preempted (`scheduler_tick`)",
      "source_hash": 5631745692242158098,
      "context_hash": 17226927137269817834,
      "translation": "현재 태스크를 선점해야 하는지 확인(`scheduler_tick`)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377144Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Running expired timers (wheel timers)",
      "source_hash": 7563209337719299439,
      "context_hash": 10703238919059577808,
      "translation": "만료된 타이머 실행(wheel 타이머)",
      "glossary_snapshot": {
        "timers": "타이머"
      },
      "translated_at": "2026-11-14T22:40:31.377144Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "HZ: the tick rate",
      "source_hash": 16218897732444297172,
      "context_hash": 6793865743012983866,
      "translation": "HZ: 틱 빈도",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377144Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "`HZ` is a compile-time constant:",
      "source_hash": 11836260464448627054,
      "context_hash": 16289392165969768037,
      "translation": "`HZ`는 컴파일 타임 상수입니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377144Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "jiffies: coarse-grained time",
      "source_hash": 14966612221259023063,
      "context_hash": 14614536179392271418,
      "translation": "jiffies: 저해상도 시간",
      "glossary_snapshot": {
        "jiffies": "jiffies"
      },
      "translated_at": "2026-11-14T22:40:31.377144Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "`jiffies` is a 64-bit counter incremented every tick:",
      "source_hash": 17788730158010862552,
      "context_hash": 15251419559404193829,
      "translation": "`jiffies`는 틱마다 증가하는 64비트 카운터입니다:",
      "glossary_snapshot": {
        "bit": "비트"
      },
      "translated_at": "2026-11-14T22:40:31.377144Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "`jiffies` wraps around after `ULONG_MAX / HZ` seconds (~497 days on 32-bit, irrelevant on 64-bit).",
      "source_hash": 17942121428746646161,
      "context_hash": 9802773896212818508,
      "translation": "`jiffies`는 `ULONG_MAX / HZ`초가 지나면 랩어라운드됩니다(32비트에서는 약 497일이며, 64비트에서는 문제가 되지 않습니다).",
      "glossary_snapshot": {
        "bit": "비트"
      },
      "translated_at": "2026-11-14T22:40:31.377145Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:1",
      "source": "The `time_after`/`time_before` macros use subtraction to handle wraparound correctly.",
      "source_hash": 593778282145033702,
      "context_hash": 9611812144583755489,
      "translation": "`time_after`/`time_before` 매크로는 뺄셈을 사용하여 랩어라운드를 올바르게 처리합니다.",
      "glossary_snapshot": {
        "macros": "매크로"
      },
      "translated_at": "2026-11-14T22:40:31.377145Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "scheduler_tick: preemption check",
      "source_hash": 1710266161745518706,
      "context_hash": 4269076418465153694,
      "translation": "scheduler_tick: 선점 확인",
      "glossary_snapshot": {
        "preemption": "선점"
      },
      "translated_at": "2026-11-14T22:40:31.377145Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "NOHZ idle: stopping the tick when idle",
      "source_hash": 14047245245180775653,
      "context_hash": 3371561538585131133,
      "translation": "NOHZ idle: 유휴 상태에서 틱 중단",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377145Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "When a CPU is idle, there's no need to fire the tick interrupt. **NOHZ idle** (CONFIG_NO_HZ_IDLE, enabled by default) suppresses the tick when the CPU is idle:",
      "source_hash": 1262355525459084231,
      "context_hash": 9033626231490967181,
      "translation": "CPU가 유휴 상태일 때는 틱 인터럽트를 발생시킬 필요가 없습니다. **NOHZ idle**(CONFIG_NO_HZ_IDLE, 기본적으로 활성화됨)은 CPU가 유휴 상태일 때 틱을 억제합니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:40:31.377146Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "NOHZ full: tickless for running tasks",
      "source_hash": 13986260507825204963,
      "context_hash": 8009625358513300696,
      "translation": "NOHZ full: 실행 중인 태스크를 위한 tickless",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377146Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "**NOHZ full** (CONFIG_NO_HZ_FULL) goes further — it suppresses the tick even when a single task is running on a CPU:",
      "source_hash": 9873279782678317239,
      "context_hash": 14349573560237938646,
      "translation": "**NOHZ full**(CONFIG_NO_HZ_FULL)은 한 걸음 더 나아가, CPU에서 단일 태스크가 실행 중일 때에도 틱을 억제합니다:",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:40:31.377146Z",
      "issues": []
    },
    {
      "id": "section:6/block:4/seg:0",
      "source": "NOHZ full CPUs receive a tick \"kick\" from CPU 0 when:",
      "source_hash": 15651098861142985828,
      "context_hash": 3947769790889396256,
      "translation": "NOHZ full CPU는 다음과 같은 경우 CPU 0으로부터 틱 \"kick\"을 받습니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "CPUs": "CPU"
      },
      "translated_at": "2026-11-14T22:40:31.377146Z",
      "issues": []
    },
    {
      "id": "section:6/block:5/seg:0",
      "source": "Another task is added to the run queue",
      "source_hash": 10486786486168176681,
      "context_hash": 6867273777715068307,
      "translation": "다른 태스크가 런 큐에 추가될 때",
      "glossary_snapshot": {
        "queue": "큐"
      },
      "translated_at": "2026-11-14T22:40:31.377146Z",
      "issues": []
    },
    {
      "id": "section:6/block:6/seg:0",
      "source": "RCU needs a quiescent state",
      "source_hash": 4501599904281520562,
      "context_hash": 2043985900758809477,
      "translation": "RCU에 quiescent state가 필요할 때",
      "glossary_snapshot": {
        "RCU": "RCU"
      },
      "translated_at": "2026-11-14T22:40:31.377146Z",
      "issues": []
    },
    {
      "id": "section:6/block:7/seg:0",
      "source": "Timers expire",
      "source_hash": 4955945608015580267,
      "context_hash": 5849424225789561751,
      "translation": "타이머가 만료될 때",
      "glossary_snapshot": {
        "timers": "타이머"
      },
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Tick device and clockevents",
      "source_hash": 1843726664824521989,
      "context_hash": 2827148353306324037,
      "translation": "틱 디바이스와 clockevents",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "The tick is driven by a **clock event device** — a hardware timer that can be programmed to fire at a specific time:",
      "source_hash": 11580061638599207419,
      "context_hash": 2266740295868602418,
      "translation": "틱은 **클록 이벤트 디바이스**(특정 시각에 발생하도록 프로그래밍할 수 있는 하드웨어 타이머)에 의해 구동됩니다:",
      "glossary_snapshot": {
        "device": "디바이스",
        "hardware": "하드웨어",
        "timer": "타이머"
      },
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "On x86:",
      "source_hash": 14757031381943850409,
      "context_hash": 12738343531334975242,
      "translation": "x86의 경우:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
    {
      "id": "section:7/block:4/seg:0",
      "source": "BSP (boot CPU): uses TSC or HPET for the tick",
      "source_hash": 155396143365203622,
      "context_hash": 3905779123996947685,
      "translation": "BSP(부트 CPU): 틱에 TSC 또는 HPET 사용",
      "glossary_snapshot": {
        "CPU": "CPU",
        "TSC": "TSC"
      },
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
    {
      "id": "section:7/block:5/seg:0",
      "source": "Other CPUs: use the local APIC timer",
      "source_hash": 7058547106175688506,
      "context_hash": 17821943546931624657,
      "translation": "그 외 CPU: 로컬 APIC 타이머 사용",
      "glossary_snapshot": {
        "CPUs": "CPU",
        "timer": "타이머"
      },
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
    {
      "id": "section:7/block:6/seg:0",
      "source": "All CPUs: can switch to one-shot mode (for NOHZ)",
      "source_hash": 5819157239337225594,
      "context_hash": 17270504595056014965,
      "translation": "모든 CPU: one-shot 모드로 전환 가능(NOHZ용)",
      "glossary_snapshot": {
        "CPUs": "CPU"
      },
      "translated_at": "2026-11-14T22:40:31.377147Z",
      "issues": []
    },
