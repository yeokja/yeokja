      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Messages are ordered by priority (highest first).",
      "source_hash": 765142315457776470,
      "context_hash": 10076758254032824919,
      "translation": "메시지는 우선순위에 따라 정렬됩니다(가장 높은 것이 먼저).",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:14:20.435053Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "Same priority messages are FIFO:",
      "source_hash": 4013254269090285638,
      "context_hash": 7456596752969621381,
      "translation": "우선순위가 같은 메시지는 FIFO 순서를 따릅니다:",
      "glossary_snapshot": {
        "FIFO": "FIFO"
      },
      "translated_at": "2026-11-14T22:14:20.435053Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Priority range: 0 to `sysconf(_SC_MQ_PRIO_MAX) - 1` (at least 32, typically 32768).",
      "source_hash": 2390142644479116343,
      "context_hash": 12577004358729606041,
      "translation": "우선순위 범위: 0부터 `sysconf(_SC_MQ_PRIO_MAX) - 1`까지입니다(최소 32, 일반적으로 32768).",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:14:20.435054Z",
      "issues": []
    },
