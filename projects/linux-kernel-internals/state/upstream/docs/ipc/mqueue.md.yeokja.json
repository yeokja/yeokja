    {
      "id": "section:3/block:0/seg:0",
      "source": "Priority queue behavior",
      "source_hash": 8325924968724146003,
      "context_hash": 16172672946237284517,
      "translation": "우선순위 큐 동작",
      "glossary_snapshot": {
