    },
    {
      "id": "section:9/block:5/seg:0",
      "source": "Read-only open blocks until a writer opens (unless `O_NONBLOCK`)",
      "source_hash": 681106331834590697,
      "context_hash": 17386036678788356416,
      "translation": "읽기 전용 열기는 쓰는 쪽이 열 때까지 블록됨(`O_NONBLOCK`인 경우 제외)",
      "glossary_snapshot": {},
