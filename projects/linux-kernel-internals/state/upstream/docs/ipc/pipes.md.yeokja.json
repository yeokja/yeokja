      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Unidirectional byte stream IPC",
      "source_hash": 15641127881848355162,
      "context_hash": 12985907687226005408,
      "translation": "단방향 바이트 스트림 IPC",
      "glossary_snapshot": {
