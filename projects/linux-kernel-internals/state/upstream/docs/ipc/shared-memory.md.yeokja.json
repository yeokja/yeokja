      },
      "translated_at": "2026-11-14T22:14:29.245582Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The older but more widely available SHM API:",
      "source_hash": 7175581913097603802,
      "context_hash": 12684295987818026944,
      "translation": "더 오래되었지만 더 널리 사용할 수 있는 SHM API:",
      "glossary_snapshot": {
        "API": "API"
      },
      "translated_at": "2026-11-14T22:14:29.245583Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Synchronization: POSIX semaphores",
      "source_hash": 14855054674341341044,
      "context_hash": 4832718072917506766,
      "translation": "동기화: POSIX 세마포어",
      "glossary_snapshot": {
        "POSIX": "POSIX",
        "semaphore": "세마포어"
      },
      "translated_at": "2026-11-14T22:14:29.245583Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Shared memory requires external synchronization.",
      "source_hash": 12516150118365265589,
      "context_hash": 13433667248099643911,
      "translation": "공유 메모리에는 외부 동기화가 필요합니다.",
      "glossary_snapshot": {
        "shared memory": "공유 메모리"
      },
      "translated_at": "2026-11-14T22:14:29.245583Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "POSIX semaphores provide a counter that can be atomically incremented/decremented:",
      "source_hash": 15173038099327833723,
      "context_hash": 6677369871545197092,
      "translation": "POSIX 세마포어는 원자적으로 증가/감소시킬 수 있는 카운터를 제공합니다:",
      "glossary_snapshot": {
        "POSIX": "POSIX",
        "semaphore": "세마포어"
      },
      "translated_at": "2026-11-14T22:14:29.245583Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "Named semaphores (between unrelated processes)",
      "source_hash": 14819783335995627007,
      "context_hash": 429380368236828256,
      "translation": "이름 있는 세마포어(서로 관련 없는 프로세스 간)",
      "glossary_snapshot": {
        "semaphore": "세마포어"
      },
      "translated_at": "2026-11-14T22:14:29.245583Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "Unnamed semaphores (shared memory or threads)",
      "source_hash": 15510026573310268475,
      "context_hash": 6883346167141849058,
      "translation": "이름 없는 세마포어(공유 메모리 또는 스레드)",
      "glossary_snapshot": {
        "semaphore": "세마포어",
        "shared memory": "공유 메모리"
      },
      "translated_at": "2026-11-14T22:14:29.245583Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "Kernel implementation",
      "source_hash": 289839300155434675,
      "context_hash": 15205633442864801915,
