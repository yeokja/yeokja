    {
      "id": "section:1/block:0/seg:0",
      "source": "POSIX shared memory",
      "source_hash": 10159175548605925060,
      "context_hash": 2296051102680759843,
      "translation": "POSIX 공유 메모리",
      "glossary_snapshot": {
        "POSIX": "POSIX",
        "shared memory": "공유 메모리"
      },
      "translated_at": "2026-11-14T22:14:29.245581Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "POSIX shared memory creates a named object backed by tmpfs that multiple processes can `mmap` into their address spaces:",
      "source_hash": 10338934103544665715,
      "context_hash": 3196760087686092632,
      "translation": "POSIX 공유 메모리는 tmpfs를 기반으로 하는 이름 있는 객체를 생성하며, 여러 프로세스가 이를 자신의 주소 공간에 `mmap`할 수 있습니다:",
      "glossary_snapshot": {
        "POSIX": "POSIX",
        "address space": "주소 공간",
        "shared memory": "공유 메모리",
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T22:14:29.245581Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "`shm_open` is implemented as `open` on `/dev/shm/` (a tmpfs mount).",
      "source_hash": 6154489005276539633,
      "context_hash": 15129801057228166502,
      "translation": "`shm_open`은 `/dev/shm/`(tmpfs 마운트)에 대한 `open`으로 구현됩니다.",
      "glossary_snapshot": {
        "tmpfs": "tmpfs"
      },
      "translated_at": "2026-11-14T22:14:29.245581Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:1",
      "source": "The shared pages are in the page cache, mapped into both processes' page tables.",
      "source_hash": 13285484497359247638,
      "context_hash": 900299652099564861,
      "translation": "공유 페이지는 페이지 캐시에 있으며, 두 프로세스의 페이지 테이블 모두에 매핑됩니다.",
      "glossary_snapshot": {
        "page cache": "페이지 캐시",
        "page table": "페이지 테이블"
      },
      "translated_at": "2026-11-14T22:14:29.245582Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "System V shared memory",
