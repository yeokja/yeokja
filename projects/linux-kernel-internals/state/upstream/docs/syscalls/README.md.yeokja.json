      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "The contract between userspace and the kernel",
      "source_hash": 10045734604488768829,
      "context_hash": 11744778944494163182,
      "translation": "사용자 공간과 커널 사이의 계약",
      "glossary_snapshot": {
        "kernel": "커널",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:46:31.016120Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What system calls are",
      "source_hash": 6554183185526458561,
      "context_hash": 14247111125530796592,
      "translation": "시스템 콜이란 무엇인가",
      "glossary_snapshot": {
        "system call": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:46:31.016121Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "A system call is a controlled entry point into the kernel.",
      "source_hash": 1136255764050625464,
      "context_hash": 10666593859747535214,
      "translation": "시스템 콜은 커널로 들어가는 통제된 진입점입니다.",
      "glossary_snapshot": {
        "entry point": "진입점",
        "kernel": "커널",
        "system call": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:46:31.016122Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "It:",
      "source_hash": 2647418959242728900,
      "context_hash": 16883192883611497761,
      "translation": "시스템 콜은 다음을 수행합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:46:31.016122Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Saves CPU state** — registers, flags",
      "source_hash": 9510650205107311425,
      "context_hash": 1703304905690310398,
      "translation": "**CPU 상태 저장** — 레지스터, 플래그",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:46:31.016123Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Switches privilege** — user mode (ring 3) → kernel mode (ring 0)",
      "source_hash": 13801925310288042644,
      "context_hash": 2164400321893611937,
      "translation": "**권한 전환** — 사용자 모드(ring 3) → 커널 모드(ring 0)",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:46:31.016123Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Validates arguments** — checks pointers, copies data from userspace",
      "source_hash": 8086581302078806211,
      "context_hash": 9891196491506314880,
      "translation": "**인자 검증** — 포인터 검사, 사용자 공간에서 데이터 복사",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:46:31.016123Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Executes kernel code** — the actual operation",
      "source_hash": 15141582826657678744,
      "context_hash": 3252998280091381056,
      "translation": "**커널 코드 실행** — 실제 작업 수행",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:46:31.016124Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "**Returns to userspace** — restores registers, switches back to ring 3",
      "source_hash": 14024751005892344831,
      "context_hash": 4735158062392626367,
      "translation": "**사용자 공간으로 복귀** — 레지스터 복원, ring 3으로 다시 전환",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:46:31.016124Z",
      "issues": []
    },
    {
      "id": "section:1/block:7/seg:0",
      "source": "On x86-64, the `syscall` instruction triggers this transition.",
      "source_hash": 18442504919547505969,
      "context_hash": 1987569627159713540,
      "translation": "x86-64에서는 `syscall` 명령어가 이 전환을 일으킵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:46:31.016124Z",
      "issues": []
    },
    {
      "id": "section:1/block:7/seg:1",
      "source": "The kernel uses the value in `rax` as the syscall number to dispatch to the right handler.",
      "source_hash": 7176597713743057978,
      "context_hash": 538453348619523968,
      "translation": "커널은 `rax`에 담긴 값을 시스템 콜 번호로 사용하여 알맞은 핸들러로 디스패치합니다.",
      "glossary_snapshot": {
        "handler": "핸들러",
        "kernel": "커널",
        "syscall number": "시스템 콜 번호"
      },
      "translated_at": "2026-11-14T22:46:31.016125Z",
      "issues": []
    },
