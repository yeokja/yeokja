  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Adding a New System Call",
      "source_hash": 10255070730999925769,
      "context_hash": 17155234904312681198,
      "translation": "새 시스템 콜 추가하기",
      "glossary_snapshot": {
        "system call": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581318Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "A complete walkthrough for kernel contributors",
      "source_hash": 12674828584973015300,
      "context_hash": 14129835686504210335,
      "translation": "커널 기여자를 위한 전체 안내",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:32:56.581319Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "When to add a new syscall",
      "source_hash": 15880171854496836849,
      "context_hash": 14489312493379171622,
      "translation": "새 시스템 콜을 추가해야 하는 경우",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581319Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "A new syscall is the right approach when:",
      "source_hash": 1316566288179997688,
      "context_hash": 487233731919726567,
      "translation": "다음과 같은 경우에는 새 시스템 콜이 올바른 접근 방식입니다:",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581320Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Exposing a new kernel capability to userspace",
      "source_hash": 10270928407216691505,
      "context_hash": 13796090425061945596,
      "translation": "새로운 커널 기능을 사용자 공간에 노출하는 경우",
      "glossary_snapshot": {
        "kernel": "커널",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:32:56.581320Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "The operation requires privilege or atomic semantics unavailable in userspace",
      "source_hash": 12099068070153938215,
      "context_hash": 394869133383478343,
      "translation": "작업에 사용자 공간에서는 사용할 수 없는 권한이나 원자적 의미론이 필요한 경우",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:32:56.581321Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "It needs access to kernel-internal state",
      "source_hash": 13115038367791016311,
      "context_hash": 17682757076669877686,
      "translation": "커널 내부 상태에 접근해야 하는 경우",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:32:56.581321Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Avoid adding syscalls for things that can be done via:",
      "source_hash": 3392436674338568092,
      "context_hash": 5788237302158325999,
      "translation": "다음 방법으로 할 수 있는 일에는 시스템 콜을 추가하지 마십시오:",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581321Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "`ioctl` on an existing device/file (for device-specific operations)",
      "source_hash": 7668847380079500247,
      "context_hash": 17100397344237011781,
      "translation": "기존 디바이스/파일에 대한 `ioctl` (디바이스별 작업의 경우)",
      "glossary_snapshot": {
        "device": "디바이스"
      },
      "translated_at": "2026-11-14T23:34:29.357139Z",
      "issues": []
    },
    {
      "id": "section:1/block:7/seg:0",
      "source": "`sysfs`/`procfs` (for configuration and observation)",
      "source_hash": 8029268526884058662,
      "context_hash": 13279251787384141139,
      "translation": "`sysfs`/`procfs`(설정 및 관찰용)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581322Z",
      "issues": []
    },
    {
      "id": "section:1/block:8/seg:0",
      "source": "Netlink (for networking-related configuration)",
      "source_hash": 8697152614216736103,
      "context_hash": 336277790473806728,
      "translation": "Netlink(네트워킹 관련 설정용)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581322Z",
      "issues": []
    },
    {
      "id": "section:1/block:9/seg:0",
      "source": "An existing syscall extension (e.g., `fcntl` with a new `cmd`)",
      "source_hash": 1114316289969930379,
      "context_hash": 8619636447506077403,
      "translation": "기존 시스템 콜 확장(예: 새 `cmd`를 사용하는 `fcntl`)",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581322Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Step 1: Define the syscall",
      "source_hash": 15834882178175665639,
      "context_hash": 8261668699490959465,
      "translation": "1단계: 시스템 콜 정의",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581322Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Use the modern struct-based pattern for new syscalls:",
      "source_hash": 7778739369529156521,
      "context_hash": 15573394008928762405,
      "translation": "새 시스템 콜에는 최신 구조체 기반 패턴을 사용하십시오:",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581322Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Step 2: Define the UAPI struct",
      "source_hash": 7839497454120077529,
      "context_hash": 8160599534637654244,
      "translation": "2단계: UAPI 구조체 정의",
      "glossary_snapshot": {
        "struct": "구조체",
        "uapi": "uapi"
      },
      "translated_at": "2026-11-14T22:32:56.581323Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Put userspace-visible types in `include/uapi/linux/hello.h`:",
      "source_hash": 17743555768593184818,
      "context_hash": 4647469415963553407,
      "translation": "사용자 공간에 노출되는 타입은 `include/uapi/linux/hello.h`에 두십시오:",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:32:56.581323Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Key rules for UAPI structs:",
      "source_hash": 6839561002127588962,
      "context_hash": 12125728814551240893,
      "translation": "UAPI 구조체의 핵심 규칙:",
      "glossary_snapshot": {
        "structs": "구조체",
        "uapi": "uapi"
      },
      "translated_at": "2026-11-14T22:32:56.581323Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "Use `__u8`, `__u16`, `__u32`, `__u64` (not `int`, `long`, etc.)",
      "source_hash": 4162874450818183802,
      "context_hash": 333294982376698935,
      "translation": "`__u8`, `__u16`, `__u32`, `__u64`를 사용하십시오(`int`, `long` 등은 사용하지 마십시오).",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581323Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "Add explicit padding (`__u32 pad`) for alignment — never rely on implicit struct holes",
      "source_hash": 1774646818034335211,
      "context_hash": 4174397146702721491,
      "translation": "정렬을 위해 명시적 패딩(`__u32 pad`)을 추가하십시오. 암묵적인 구조체 구멍(hole)에 절대 의존하지 마십시오.",
      "glossary_snapshot": {
        "alignment": "정렬",
        "struct": "구조체"
      },
      "translated_at": "2026-11-14T22:32:56.581324Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "Use `__u64` for pointer-sized fields (enables compat with 32-bit userspace)",
      "source_hash": 14464373284042966826,
      "context_hash": 8264821109076107911,
      "translation": "포인터 크기의 필드에는 `__u64`를 사용하십시오(32비트 사용자 공간과의 compat이 가능해집니다).",
      "glossary_snapshot": {
        "bit": "비트",
        "compat": "compat",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:32:56.581324Z",
      "issues": []
    },
    {
      "id": "section:3/block:7/seg:0",
      "source": "The struct is an ABI — once merged it cannot be changed incompatibly",
      "source_hash": 16022039072488452299,
      "context_hash": 15762859266028653765,
      "translation": "구조체는 ABI입니다. 한 번 병합되면 호환되지 않는 방식으로 변경할 수 없습니다.",
      "glossary_snapshot": {
        "ABI": "ABI",
        "struct": "구조체"
      },
      "translated_at": "2026-11-14T22:32:56.581324Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Step 3: Add to the syscall table",
      "source_hash": 12027156836095684594,
      "context_hash": 6450193475328383327,
      "translation": "3단계: 시스템 콜 테이블에 추가",
      "glossary_snapshot": {
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581325Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "For x86-64: `arch/x86/entry/syscalls/syscall_64.tbl`",
      "source_hash": 16932053365250217511,
      "context_hash": 15525058702874829513,
      "translation": "x86-64의 경우: `arch/x86/entry/syscalls/syscall_64.tbl`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581325Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "For generic architectures: `include/uapi/asm-generic/unistd.h`",
      "source_hash": 8299911936887185427,
      "context_hash": 9548228423651590477,
      "translation": "범용 아키텍처의 경우: `include/uapi/asm-generic/unistd.h`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581325Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "For ARM64: `arch/arm64/include/asm/unistd.h`",
      "source_hash": 9467921759649432613,
      "context_hash": 4839717204669381047,
      "translation": "ARM64의 경우: `arch/arm64/include/asm/unistd.h`",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581325Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:0",
      "source": "ARM64 uses the generic table, so `include/uapi/asm-generic/unistd.h` covers it.",
      "source_hash": 3455884591971861316,
      "context_hash": 2803560054887372256,
      "translation": "ARM64는 범용 테이블을 사용하므로 `include/uapi/asm-generic/unistd.h`가 이를 포괄합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581325Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:0",
      "source": "For 32-bit compat",
      "source_hash": 16933923253327644793,
      "context_hash": 8197678030725860440,
      "translation": "32비트 compat의 경우",
      "glossary_snapshot": {
        "bit": "비트",
        "compat": "compat"
      },
      "translated_at": "2026-11-14T22:32:56.581325Z",
      "issues": []
    },
    {
      "id": "section:4/block:8/seg:0",
      "source": "If the syscall takes a struct with pointers (stored as `__u64`), it already works correctly for 32-bit processes — no compat version needed.",
      "source_hash": 16553214450243627180,
      "context_hash": 2425695807996237200,
      "translation": "시스템 콜이 포인터를 포함한 구조체(`__u64`로 저장)를 받는다면 32비트 프로세스에서도 이미 올바르게 동작하므로 compat 버전이 필요하지 않습니다.",
      "glossary_snapshot": {
        "bit": "비트",
        "compat": "compat",
        "processes": "프로세스",
        "struct": "구조체",
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:32:56.581326Z",
      "issues": []
    },
    {
      "id": "section:4/block:8/seg:1",
      "source": "If it uses architecture-specific types, add a compat version:",
      "source_hash": 16592578302345328703,
      "context_hash": 16286225685013150043,
      "translation": "아키텍처별 타입을 사용한다면 compat 버전을 추가하십시오:",
      "glossary_snapshot": {
        "compat": "compat"
      },
      "translated_at": "2026-11-14T22:32:56.581326Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Step 4: Add the kernel header",
      "source_hash": 15243708791356858273,
      "context_hash": 14945011849564572566,
      "translation": "4단계: 커널 헤더 추가",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:32:56.581326Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Step 5: Wire it up in the build",
      "source_hash": 17552052032157775686,
      "context_hash": 17704958925407979102,
      "translation": "5단계: 빌드에 연결",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581326Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "Add to the appropriate `Makefile`:",
      "source_hash": 10166526976893954579,
      "context_hash": 365794088343444779,
      "translation": "적절한 `Makefile`에 추가하십시오:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:56.581326Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "Or add it to an existing file if it's small enough.",
      "source_hash": 14324289984284715960,
      "context_hash": 3611485458917165066,
      "translation": "크기가 충분히 작다면 기존 파일에 추가해도 됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:33:00.541682Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Step 6: Add a man page stub",
      "source_hash": 5926667629996920916,
      "context_hash": 2342859419944587547,
      "translation": "6단계: man 페이지 초안 추가",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:33:00.541683Z",
      "issues": []
    },
    {
      "id": "section:7/block:2/seg:0",
      "source": "The man-pages project (not in the kernel tree) documents syscalls.",
      "source_hash": 10004280468971204542,
      "context_hash": 10936183708733456141,
      "translation": "시스템 콜은 man-pages 프로젝트(커널 트리에 포함되지 않음)에서 문서화합니다.",
      "glossary_snapshot": {
        "kernel tree": "커널 트리",
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:33:00.541683Z",
      "issues": []
    },
    {
      "id": "section:7/block:2/seg:1",
      "source": "Submit a patch there too.",
      "source_hash": 9009927824016592379,
      "context_hash": 2235485573472313816,
      "translation": "그쪽에도 패치를 제출하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:33:00.541683Z",
