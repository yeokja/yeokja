    {
      "id": "section:6/block:0/seg:0",
      "source": "QEMU live migration with userfaultfd",
      "source_hash": 2966114685294278562,
      "context_hash": 15962280454959001529,
      "translation": "userfaultfd를 이용한 QEMU 라이브 마이그레이션",
