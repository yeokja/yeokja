    {
      "id": "section:10/block:1/seg:0",
      "source": "[Timekeeping and Clocksources](../time/timekeeping.md) — how the kernel maintains time",
      "source_hash": 17152544972535663525,
      "context_hash": 3943251404569279226,
      "translation": "[Timekeeping and Clocksources](../time/timekeeping.md) — 커널이 시간을 유지하는 방법",
      "glossary_snapshot": {
        "clocksource": "clocksource",
        "timekeeping": "시간 관리"
      },
      "translated_at": "2026-11-14T22:03:43.869422Z",
      "issues": []
    },
