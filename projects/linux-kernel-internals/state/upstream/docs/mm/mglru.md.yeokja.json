  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "MGLRU: Multi-Generation LRU",
      "source_hash": 15841364783352208740,
      "context_hash": 12669329470749470459,
      "translation": "MGLRU: Multi-Generation LRU",
      "glossary_snapshot": {
        "LRU": "LRU",
        "MGLRU": "MGLRU"
      },
      "translated_at": "2026-11-14T22:31:59.846692Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "A generational page reclaim algorithm for better working set detection",
      "source_hash": 1712327656198241822,
      "context_hash": 6267371590768305215,
      "translation": "더 나은 워킹 셋 감지를 위한 세대 기반 페이지 회수 알고리즘",
      "glossary_snapshot": {
        "Page Reclaim": "페이지 회수",
        "working set": "워킹 셋"
      },
      "translated_at": "2026-11-14T23:31:56.649103Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The problem with classic LRU",
      "source_hash": 15163946281057776446,
      "context_hash": 4633438332235617944,
      "translation": "기존 LRU의 문제점",
      "glossary_snapshot": {
        "LRU": "LRU"
      },
      "translated_at": "2026-11-14T22:31:59.846693Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "The classic LRU (Least Recently Used) page reclaim uses two lists per memory zone: **active** and **inactive**.",
      "source_hash": 1714254917426256265,
      "context_hash": 15779618864926902330,
      "translation": "기존 LRU(Least Recently Used) 페이지 회수는 메모리 zone마다 **active**와 **inactive**라는 두 개의 리스트를 사용합니다.",
      "glossary_snapshot": {
        "LRU": "LRU",
        "Page Reclaim": "페이지 회수",
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:31:59.846693Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Pages migrate between them based on access.",
      "source_hash": 3088231010215696074,
      "context_hash": 13527827490800301586,
      "translation": "페이지는 접근 여부에 따라 두 리스트 사이를 이동합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846693Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "The fundamental problems:",
      "source_hash": 12783680569639490482,
      "context_hash": 14706894920868163373,
      "translation": "근본적인 문제점:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846693Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**The scan cost**: To find reclaimable pages, the reclaimer walks the inactive list.",
      "source_hash": 17631180851022790886,
      "context_hash": 919690515296993876,
      "translation": "**스캔 비용**: 회수 가능한 페이지를 찾기 위해 회수 코드는 inactive 리스트를 순회합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:1",
      "source": "If the inactive list is full of hot pages (false negatives), it wastes CPU time.",
      "source_hash": 2286837136937471174,
      "context_hash": 4829261552919988054,
      "translation": "inactive 리스트가 hot 페이지로 가득 차 있으면(false negative) CPU 시간을 낭비합니다.",
      "glossary_snapshot": {
        "CPU time": "CPU 시간"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**One-time access pollution**: A large `dd` or `tar` operation reads every file once, thrashing the active list with cold pages.",
      "source_hash": 1122611119967192557,
      "context_hash": 5844040106642246975,
      "translation": "**일회성 접근에 의한 오염**: 대규모 `dd`나 `tar` 작업은 모든 파일을 한 번씩 읽으므로 active 리스트가 cold 페이지로 뒤섞여 스래싱이 발생합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**No temporal locality**: Classic LRU treats a page accessed 1 second ago the same as one accessed 1 year ago.",
      "source_hash": 7210273379609648722,
      "context_hash": 13027234722507515293,
      "translation": "**시간적 지역성 부재**: 기존 LRU는 1초 전에 접근한 페이지와 1년 전에 접근한 페이지를 똑같이 취급합니다.",
      "glossary_snapshot": {
        "LRU": "LRU",
        "locality": "지역성"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "MGLRU's generational model",
      "source_hash": 10630420243939596948,
      "context_hash": 18371242954994300033,
      "translation": "MGLRU의 세대 모델",
      "glossary_snapshot": {
        "MGLRU": "MGLRU"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "MGLRU (Multi-Generation LRU, merged in 6.1) divides pages into **generations**.",
      "source_hash": 5499583687186878373,
      "context_hash": 8346500148847477280,
      "translation": "MGLRU(Multi-Generation LRU, 6.1에서 병합됨)는 페이지를 **세대**(generation)로 나눕니다.",
      "glossary_snapshot": {
        "LRU": "LRU",
        "MGLRU": "MGLRU"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "Each generation represents pages that became hot at roughly the same time.",
      "source_hash": 10446191618049424642,
      "context_hash": 13545782024062035756,
      "translation": "각 세대는 대략 같은 시기에 hot 상태가 된 페이지들을 나타냅니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:2",
      "source": "The oldest generation is evicted first:",
      "source_hash": 6398896616443265632,
      "context_hash": 2789844322045326035,
      "translation": "가장 오래된 세대가 먼저 축출됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Typical number of generations: 4.",
      "source_hash": 4063684768399208930,
      "context_hash": 10356076761989291828,
      "translation": "일반적인 세대 수: 4.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:1",
      "source": "Each generation is ~seconds to minutes of activity.",
      "source_hash": 8444343994673433895,
      "context_hash": 12137880871192898382,
      "translation": "각 세대는 약 수 초에서 수 분 동안의 활동에 해당합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Key data structures",
      "source_hash": 886646788032546680,
      "context_hash": 6113319331254476725,
      "translation": "주요 자료 구조",
      "glossary_snapshot": {
        "Key Data Structures": "주요 자료 구조",
        "data structures": "자료 구조"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Aging: scanning for hot pages",
      "source_hash": 16030655310423467669,
      "context_hash": 9339101764899046279,
      "translation": "에이징: hot 페이지 스캔",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "**Aging** walks page tables to find recently accessed pages and promote them to the newest generation:",
      "source_hash": 14757517493444631475,
      "context_hash": 7122181036099086653,
      "translation": "**에이징**(aging)은 페이지 테이블을 순회하여 최근에 접근된 페이지를 찾고 이를 가장 새로운 세대로 승격시킵니다:",
      "glossary_snapshot": {
        "page tables": "페이지 테이블"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "The accessed bit in PTEs tells the kernel which pages have been touched since the last aging pass.",
      "source_hash": 8339804523582820320,
      "context_hash": 13779001113127062542,
      "translation": "PTE의 accessed 비트는 마지막 에이징 패스 이후 어떤 페이지가 접근되었는지를 커널에 알려 줍니다.",
      "glossary_snapshot": {
        "PTEs": "PTE",
        "bit": "비트",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:31:59.846694Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:1",
      "source": "Pages with the accessed bit set are promoted to the newest generation; those without are left in their old generation (and will be evicted sooner).",
      "source_hash": 7994365678950132129,
      "context_hash": 10219527139807217693,
      "translation": "accessed 비트가 설정된 페이지는 가장 새로운 세대로 승격되고, 설정되지 않은 페이지는 기존 세대에 그대로 남습니다(그리고 더 빨리 축출됩니다).",
      "glossary_snapshot": {
        "bit": "비트"
      },
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Eviction: reclaiming old generations",
      "source_hash": 341117214894186044,
      "context_hash": 7776500170117003198,
      "translation": "축출: 오래된 세대 회수",
      "glossary_snapshot": {
        "eviction": "축출"
      },
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "**Eviction** reclaims pages from the oldest generation:",
      "source_hash": 6735890823069507969,
      "context_hash": 11439039829726536013,
      "translation": "**축출**(eviction)은 가장 오래된 세대에서 페이지를 회수합니다:",
      "glossary_snapshot": {
        "eviction": "축출"
      },
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Working set protection: refault detection",
      "source_hash": 4260037875964806005,
      "context_hash": 3210062879005112237,
      "translation": "워킹 셋 보호: refault 감지",
      "glossary_snapshot": {
        "working set": "워킹 셋"
      },
      "translated_at": "2026-11-14T23:31:56.649106Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "MGLRU detects when evicted pages are immediately faulted back in (**refaults**), indicating the working set was violated.",
      "source_hash": 7917726199722600931,
      "context_hash": 3786632135418843963,
      "translation": "MGLRU는 축출된 페이지가 곧바로 다시 폴트되어 들어오는 경우(**refault**)를 감지하며, 이는 워킹 셋이 침해되었음을 나타냅니다.",
      "glossary_snapshot": {
        "MGLRU": "MGLRU",
        "working set": "워킹 셋"
      },
      "translated_at": "2026-11-14T23:31:56.649107Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:1",
      "source": "It uses a Bloom filter:",
      "source_hash": 9865464569969263911,
      "context_hash": 1819523767007914139,
      "translation": "이를 위해 Bloom filter를 사용합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
      "id": "section:6/block:2/seg:0",
      "source": "When a page is evicted, its fingerprint is added to the Bloom filter",
      "source_hash": 9343558756383447789,
      "context_hash": 17728213811351292426,
      "translation": "페이지가 축출되면 해당 페이지의 지문이 Bloom filter에 추가됨",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
      "id": "section:6/block:3/seg:0",
      "source": "When a page is faulted in, MGLRU checks if it was recently evicted",
      "source_hash": 11261293496061217770,
      "context_hash": 5258597798211193943,
      "translation": "페이지가 fault되어 들어오면 MGLRU가 해당 페이지가 최근에 축출되었는지 확인함",
      "glossary_snapshot": {
        "MGLRU": "MGLRU"
      },
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
      "id": "section:6/block:4/seg:0",
      "source": "If yes: the page is placed in a **protected generation** — older than the newest but protected from immediate eviction",
      "source_hash": 2798123237410595122,
      "context_hash": 13914345871352688604,
      "translation": "그렇다면: 해당 페이지는 **보호 세대**(protected generation)에 배치됨 — 가장 새로운 세대보다는 오래되었지만 즉각적인 축출로부터 보호됨",
      "glossary_snapshot": {
        "eviction": "축출"
      },
      "translated_at": "2026-11-14T22:31:59.846695Z",
      "issues": []
    },
    {
