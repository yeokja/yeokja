      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Both dm-crypt (via cryptsetup) and fscrypt store key material in the kernel keyring:",
      "source_hash": 10662763247251051159,
      "context_hash": 9433173735522505325,
      "translation": "dm-crypt(cryptsetup을 통해)와 fscrypt는 모두 키 자료를 커널 키링에 저장합니다.",
      "glossary_snapshot": {
        "dm-crypt": "dm-crypt",
        "fscrypt": "fscrypt",
        "keyring": "키링"
      },
      "translated_at": "2026-11-14T23:26:44.505448Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
