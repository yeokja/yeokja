    {
      "id": "section:1/block:0/seg:0",
      "source": "Overview",
      "source_hash": 11777448466030057203,
      "context_hash": 18104338060064336401,
      "translation": "개요",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Modern SoCs and CPUs generate heat.",
      "source_hash": 6875328983503142962,
      "context_hash": 404851967857098695,
      "translation": "최신 SoC와 CPU는 열을 발생시킵니다.",
      "glossary_snapshot": {
        "CPUs": "CPU",
        "SoCs": "SoC"
      },
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Without thermal management, they would throttle or shut down unexpectedly.",
      "source_hash": 8495313076435670727,
      "context_hash": 15406036357992522618,
      "translation": "열 관리가 없으면 이들은 예기치 않게 스로틀링되거나 꺼질 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "The Linux thermal framework provides a structured way to:",
      "source_hash": 9727435230339492003,
      "context_hash": 1828729394845907147,
      "translation": "Linux thermal 프레임워크는 다음을 위한 구조화된 방법을 제공합니다:",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Monitor** temperatures via thermal zones",
      "source_hash": 5065283992835097241,
      "context_hash": 11886802769733513359,
      "translation": "thermal zone을 통한 온도 **모니터링**",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**Define** thermal policies via trip points and governors",
      "source_hash": 4562661892573627413,
      "context_hash": 17873907502326814828,
      "translation": "trip point와 governor를 통한 열 정책 **정의**",
      "glossary_snapshot": {
        "governors": "governor",
        "policies": "정책"
      },
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Enforce** cooling via cooling devices (CPU frequency scaling, fan control)",
      "source_hash": 18437816094409776156,
      "context_hash": 4960689328237663913,
      "translation": "냉각 디바이스(CPU 주파수 스케일링, 팬 제어)를 통해 냉각을 **강제**",
      "glossary_snapshot": {
        "CPU": "CPU",
        "devices": "디바이스"
      },
      "translated_at": "2026-11-14T23:32:50.496794Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Thermal zones",
      "source_hash": 13165940589787908753,
      "context_hash": 17267977376435299868,
      "translation": "thermal zone",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338391Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "A **thermal zone** represents a sensor and its associated policy:",
      "source_hash": 14490472724777523297,
      "context_hash": 2925926238263108461,
      "translation": "**thermal zone**은 센서와 그에 연관된 정책을 나타냅니다:",
      "glossary_snapshot": {
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:05:31.338392Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Kernel structures",
      "source_hash": 5377271510445877383,
      "context_hash": 12771907904367099922,
