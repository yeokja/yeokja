    {
      "id": "section:5/block:0/seg:0",
      "source": "Thermal governors",
      "source_hash": 8188218769828696911,
      "context_hash": 4162330689499328546,
      "translation": "thermal governor",
      "glossary_snapshot": {
        "governors": "governor"
      },
      "translated_at": "2026-11-14T23:05:31.338392Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The governor decides **when** to activate cooling and **how much**:",
      "source_hash": 15948369395250149051,
      "context_hash": 10051661571825672371,
      "translation": "governor는 냉각을 **언제** 활성화할지, 그리고 **얼마나** 활성화할지 결정합니다:",
      "glossary_snapshot": {
        "governor": "governor"
      },
      "translated_at": "2026-11-14T23:05:31.338392Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "step_wise (default on many platforms)",
      "source_hash": 526730401764640705,
      "context_hash": 6425440266675122930,
      "translation": "step_wise(많은 플랫폼에서 기본값)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338392Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "Raises cooling level by 1 when temperature exceeds a trip point, lowers by 1 when below:",
      "source_hash": 16564724279768985114,
      "context_hash": 3171440156509281617,
      "translation": "온도가 trip point를 넘으면 냉각 레벨을 1 올리고, 그 아래로 내려가면 1 낮춥니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338392Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
      "source": "power_allocator (IPA — Intelligent Power Allocation)",
      "source_hash": 127211169155361940,
      "context_hash": 4298025471112081035,
      "translation": "power_allocator(IPA — Intelligent Power Allocation)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:31.338392Z",
      "issues": []
    },
    {
      "id": "section:5/block:6/seg:0",
      "source": "A PID controller that distributes a power budget across cooling devices:",
      "source_hash": 168510688001804580,
      "context_hash": 15127338710897560685,
      "translation": "냉각 디바이스들에 전력 예산을 분배하는 PID 컨트롤러:",
      "glossary_snapshot": {
        "controller": "컨트롤러",
        "devices": "디바이스"
      },
      "translated_at": "2026-11-14T23:32:50.496795Z",
      "issues": []
    },
    {
      "id": "section:5/block:9/seg:0",
