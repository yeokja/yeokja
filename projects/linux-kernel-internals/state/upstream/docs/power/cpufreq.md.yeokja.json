  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "cpufreq: CPU Frequency Scaling",
      "source_hash": 16081052717262379788,
      "context_hash": 4409494275310289965,
      "translation": "cpufreq: CPU 주파수 스케일링",
      "glossary_snapshot": {
        "CPU": "CPU",
        "cpufreq": "cpufreq"
      },
      "translated_at": "2026-11-14T23:05:35.965257Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "P-states, governors, and hardware-coordinated frequency management",
      "source_hash": 11567272126286271704,
      "context_hash": 10707181470682322914,
      "translation": "P-state, governor, 하드웨어 협조형 주파수 관리",
      "glossary_snapshot": {
        "governors": "governor",
        "hardware": "하드웨어"
      },
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Why CPU frequency scaling?",
      "source_hash": 18151645855231730427,
      "context_hash": 3723142174957585901,
      "translation": "CPU 주파수 스케일링이 필요한 이유",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Modern CPUs can run at different voltage-frequency operating points called **P-states** (performance states).",
      "source_hash": 416834976666463516,
      "context_hash": 7949038333575788121,
      "translation": "최신 CPU는 **P-state**(performance state)라고 부르는 서로 다른 전압-주파수 동작점에서 실행될 수 있습니다.",
      "glossary_snapshot": {
        "CPUs": "CPU"
      },
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Lower frequency = lower voltage = less power.",
      "source_hash": 5412601374140138944,
      "context_hash": 6093935848637473537,
      "translation": "주파수가 낮을수록 전압이 낮아지고, 전압이 낮을수록 전력 소모가 줄어듭니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "The kernel's cpufreq subsystem selects the operating point based on current load.",
      "source_hash": 18379054494423588087,
      "context_hash": 8035642896896891756,
      "translation": "커널의 cpufreq 서브시스템은 현재 부하에 따라 동작점을 선택합니다.",
      "glossary_snapshot": {
        "cpufreq": "cpufreq",
        "kernel": "커널",
        "subsystem": "서브시스템"
      },
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Architecture",
      "source_hash": 3158869230334080673,
      "context_hash": 15039016331349208024,
      "translation": "아키텍처",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "struct cpufreq_policy",
      "source_hash": 16132387250768961753,
      "context_hash": 6456204325592851124,
      "translation": "struct cpufreq_policy",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Governors",
      "source_hash": 2455055309130962338,
      "context_hash": 15257459594809455994,
      "translation": "Governor",
      "glossary_snapshot": {
        "governors": "governor"
      },
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "A governor observes CPU utilization and selects a target frequency.",
      "source_hash": 15884867035861038672,
      "context_hash": 1978380417233962307,
      "translation": "governor는 CPU 사용률을 관찰하여 목표 주파수를 선택합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "governor": "governor"
      },
      "translated_at": "2026-11-14T23:05:35.965258Z",
      "issues": []
    },
    {
      "id": "section:4/block:2/seg:0",
      "source": "schedutil (recommended, 4.7+)",
      "source_hash": 10030592940807600836,
      "context_hash": 17571958790982802016,
      "translation": "schedutil (권장, 4.7+)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "schedutil integrates with the scheduler's per-CPU utilization tracking.",
      "source_hash": 6740334016228853633,
      "context_hash": 1448772522426031404,
      "translation": "schedutil은 스케줄러의 CPU별 사용률 추적과 통합됩니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:1",
      "source": "It's called directly from the scheduler path when utilization changes — no polling needed.",
      "source_hash": 11923431324329446315,
      "context_hash": 11047714894113013521,
      "translation": "사용률이 변할 때 스케줄러 경로에서 직접 호출되므로 폴링이 필요하지 않습니다.",
      "glossary_snapshot": {
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "ondemand",
      "source_hash": 1033984355798408273,
      "context_hash": 3245899930079002081,
      "translation": "ondemand",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:0",
      "source": "Polls CPU idle time periodically, scales frequency proportionally to non-idle fraction.",
      "source_hash": 7206626663513350386,
      "context_hash": 14247581563622182474,
      "translation": "CPU 유휴 시간을 주기적으로 폴링하고, 유휴가 아닌 시간의 비율에 비례하여 주파수를 조정합니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:1",
      "source": "The sampling interval is not a fixed 10ms: it defaults to `max(2 * tick_period, 1.5 * transition_latency)` (falling back to 1ms if the driver reports no transition latency) — see `cpufreq_policy_transition_delay_us()` in `drivers/cpufreq/cpufreq.c` and the default computed in `drivers/cpufreq/cpufreq_governor.c`.",
      "source_hash": 10171425105516434839,
      "context_hash": 8150815958940895841,
      "translation": "샘플링 간격은 고정된 10ms가 아닙니다. 기본값은 `max(2 * tick_period, 1.5 * transition_latency)`이며(드라이버가 전환 지연 시간을 보고하지 않으면 1ms로 대체됩니다), `drivers/cpufreq/cpufreq.c`의 `cpufreq_policy_transition_delay_us()`와 `drivers/cpufreq/cpufreq_governor.c`에서 계산되는 기본값을 참고하십시오.",
      "glossary_snapshot": {
        "driver": "드라이버",
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:2",
      "source": "It's tunable at runtime via the governor's `sampling_rate` sysfs file:",
      "source_hash": 13566897421762637703,
      "context_hash": 4913056376554614320,
      "translation": "governor의 `sampling_rate` sysfs 파일을 통해 런타임에 조정할 수 있습니다:",
      "glossary_snapshot": {
        "governor": "governor",
        "sysfs": "sysfs"
      },
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:8/seg:0",
      "source": "Slower to react than schedutil (polling vs event-driven), but simpler and still widely used.",
      "source_hash": 18062802681900689714,
      "context_hash": 10193900711492197166,
      "translation": "schedutil보다 반응이 느리지만(폴링 방식 대 이벤트 기반 방식), 더 단순하며 여전히 널리 사용됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:9/seg:0",
      "source": "performance / powersave",
      "source_hash": 12428765551789618773,
      "context_hash": 12389311064382545784,
      "translation": "performance / powersave",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965259Z",
      "issues": []
    },
    {
      "id": "section:4/block:10/seg:0",
      "source": "Static governors: always select the maximum (performance) or minimum (powersave) frequency in the policy range.",
      "source_hash": 8521143742989581945,
      "context_hash": 11222431122344159833,
      "translation": "정적 governor: 정책 범위 내에서 항상 최대(performance) 또는 최소(powersave) 주파수를 선택합니다.",
      "glossary_snapshot": {
        "governors": "governor",
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:4/block:10/seg:1",
      "source": "No utilization sampling at all.",
      "source_hash": 11374975805945604330,
      "context_hash": 2989164436765916397,
      "translation": "사용률 샘플링을 전혀 하지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "cpufreq drivers",
      "source_hash": 587438099274528246,
      "context_hash": 16010952973067974771,
      "translation": "cpufreq 드라이버",
      "glossary_snapshot": {
        "cpufreq": "cpufreq",
        "drivers": "드라이버"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "acpi-cpufreq",
      "source_hash": 15189927635045242126,
      "context_hash": 362606110232116782,
      "translation": "acpi-cpufreq",
      "glossary_snapshot": {
        "ACPI": "ACPI",
        "cpufreq": "cpufreq"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "Uses ACPI _PCT (Performance Control) and _PSS (Performance Supported States) objects to enumerate and switch P-states.",
      "source_hash": 3690059671441035697,
      "context_hash": 14079684862887840455,
      "translation": "ACPI _PCT(Performance Control) 및 _PSS(Performance Supported States) 객체를 사용하여 P-state를 열거하고 전환합니다.",
      "glossary_snapshot": {
        "ACPI": "ACPI"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:1",
      "source": "The OS writes to MSR_IA32_PERF_CTL:",
      "source_hash": 2322940448857188748,
      "context_hash": 223238080879256354,
      "translation": "OS는 MSR_IA32_PERF_CTL에 값을 씁니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "intel_pstate",
      "source_hash": 14657998022057109341,
      "context_hash": 1310858043315389582,
      "translation": "intel_pstate",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
      "source": "Intel's native driver for Sandy Bridge and later.",
      "source_hash": 15660946547061849520,
      "context_hash": 12525357921318226870,
      "translation": "Sandy Bridge 이후 프로세서를 위한 Intel의 네이티브 드라이버입니다.",
      "glossary_snapshot": {
        "Intel": "Intel",
        "driver": "드라이버"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:1",
      "source": "It bypasses the traditional governor hierarchy for CPUs with HWP (Hardware P-state control, Broadwell+):",
      "source_hash": 1514516350019559493,
      "context_hash": 8649458967360815971,
      "translation": "HWP(Hardware P-state control, Broadwell+)를 지원하는 CPU에서는 기존의 governor 계층 구조를 우회합니다:",
      "glossary_snapshot": {
        "CPUs": "CPU",
        "governor": "governor"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:8/seg:0",
      "source": "There's no `HWP_DESIRED_PERF` field set here: leaving the MSR's desired-performance bits at 0 tells the hardware to autonomously pick between `HWP_MIN_PERF` and `HWP_MAX_PERF`.",
      "source_hash": 12013636130234779937,
      "context_hash": 10935748685152278480,
      "translation": "여기서는 `HWP_DESIRED_PERF` 필드를 설정하지 않습니다. MSR의 desired-performance 비트를 0으로 두면 하드웨어가 `HWP_MIN_PERF`와 `HWP_MAX_PERF` 사이에서 자율적으로 선택합니다.",
      "glossary_snapshot": {
        "MSR": "MSR",
        "bits": "비트",
        "hardware": "하드웨어"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:9/seg:0",
      "source": "Energy Performance Preference (EPP)",
      "source_hash": 17216876113208770564,
      "context_hash": 9292428245593814272,
      "translation": "Energy Performance Preference (EPP)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:10/seg:0",
      "source": "EPP is a hint to the hardware about the performance/power tradeoff:",
      "source_hash": 7929528670987812659,
      "context_hash": 9534056769299692968,
      "translation": "EPP는 성능/전력 트레이드오프에 관해 하드웨어에 전달하는 힌트입니다:",
      "glossary_snapshot": {
        "hardware": "하드웨어",
        "tradeoff": "트레이드오프"
      },
      "translated_at": "2026-11-14T23:05:35.965260Z",
      "issues": []
    },
    {
      "id": "section:5/block:11/seg:0",
      "source": "EPP value",
