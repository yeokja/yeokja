      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:23.215196Z",
      "issues": []
    },
    {
      "id": "section:1/block:16/seg:1",
      "source": "Memory image written to swap/file, power completely off.",
      "source_hash": 2556922649233984968,
      "context_hash": 7893252636577025338,
      "translation": "메모리 이미지를 swap/파일에 기록하고 전원을 완전히 끕니다.",
      "glossary_snapshot": {
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:32:23.215196Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
