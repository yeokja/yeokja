      "issues": []
    },
    {
      "id": "section:1/block:7/seg:0",
      "source": "Freeze user processes, suspend devices.",
      "source_hash": 10913821485581515196,
      "context_hash": 17559847045360468036,
      "translation": "사용자 프로세스를 동결하고 디바이스를 서스펜드합니다.",
