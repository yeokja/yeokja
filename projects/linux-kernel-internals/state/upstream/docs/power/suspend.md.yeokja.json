      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Linux supports multiple system-level sleep states, described by ACPI S-states and the kernel's internal model:",
      "source_hash": 13798353332891054005,
      "context_hash": 15001969282561753960,
      "translation": "Linux는 ACPI S-state와 커널 내부 모델로 기술되는 여러 시스템 수준 슬립 상태를 지원합니다:",
      "glossary_snapshot": {
        "ACPI": "ACPI",
        "Linux": "Linux",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:32:23.215194Z",
      "issues": []
    },
    {
