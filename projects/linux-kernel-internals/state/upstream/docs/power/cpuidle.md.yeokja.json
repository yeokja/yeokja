  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "cpuidle: CPU C-states and Idle Power Management",
      "source_hash": 16249876711657243255,
      "context_hash": 4657585011490694603,
      "translation": "cpuidle: CPU C-state와 유휴 전력 관리",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:32:10.835488Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Hardware sleep states, latency/power tradeoffs, and the cpuidle governor framework",
      "source_hash": 8815656686599452799,
      "context_hash": 10165757501451477016,
      "translation": "하드웨어 절전 상태, 지연 시간/전력 트레이드오프, 그리고 cpuidle governor 프레임워크",
      "glossary_snapshot": {
        "governor": "governor",
        "latency": "지연 시간",
        "tradeoff": "트레이드오프"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "CPU C-states",
      "source_hash": 921072426846808309,
      "context_hash": 12561066692468696817,
      "translation": "CPU C-state",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "When a CPU has no work to do, it enters a **C-state** (idle state).",
      "source_hash": 8798154012681045333,
      "context_hash": 14296310631611613149,
      "translation": "CPU에 할 일이 없으면 CPU는 **C-state**(유휴 상태)에 진입합니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Each state trades deeper power savings for higher wake-up latency:",
      "source_hash": 7134807995988014161,
      "context_hash": 1023641344547344225,
      "translation": "각 상태는 더 높은 깨어남 지연 시간을 대가로 더 깊은 전력 절감을 얻습니다:",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "cpuidle framework",
      "source_hash": 11168305618046747585,
      "context_hash": 302292761136717633,
      "translation": "cpuidle 프레임워크",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The Linux cpuidle framework selects which C-state to enter when the CPU is idle:",
      "source_hash": 6477600710907506520,
      "context_hash": 14913284532429453977,
      "translation": "Linux cpuidle 프레임워크는 CPU가 유휴 상태일 때 진입할 C-state를 선택합니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "intel_idle driver",
      "source_hash": 3112764803767400033,
      "context_hash": 14959798547150966963,
      "translation": "intel_idle 드라이버",
      "glossary_snapshot": {
        "driver": "드라이버"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "The `intel_idle` driver provides Intel-specific C-states with known latencies:",
      "source_hash": 15805752705042147123,
      "context_hash": 998179006848572842,
      "translation": "`intel_idle` 드라이버는 지연 시간이 알려진 Intel 전용 C-state를 제공합니다:",
      "glossary_snapshot": {
        "Intel": "Intel",
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "cpuidle governors",
      "source_hash": 3888432438770803992,
      "context_hash": 9580640986752105802,
      "translation": "cpuidle governor",
      "glossary_snapshot": {
        "governor": "governor"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "The governor decides which C-state to enter based on expected idle duration:",
      "source_hash": 11517682242750971772,
      "context_hash": 17657653226502274968,
      "translation": "governor는 예상 유휴 시간을 바탕으로 진입할 C-state를 결정합니다:",
      "glossary_snapshot": {
        "governor": "governor"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "ladder governor",
      "source_hash": 10394445410631976431,
      "context_hash": 3495626563767620638,
      "translation": "ladder governor",
      "glossary_snapshot": {
        "governor": "governor"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Simple: tries to stay at or near the current state; moves up/down by comparing the *actual* residency in the last state entered against the neighboring states' exit latencies (`drivers/cpuidle/governors/ladder.c`):",
      "source_hash": 4779824720141076158,
      "context_hash": 15572958564843648844,
      "translation": "단순한 방식입니다. 현재 상태 또는 그 근처에 머무르려 하며, 마지막으로 진입한 상태에서의 *실제* 체류 시간(residency)을 인접 상태들의 종료 지연 시간(exit latency)과 비교하여 한 단계씩 위아래로 이동합니다(`drivers/cpuidle/governors/ladder.c`):",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "menu governor (default for tickless systems)",
      "source_hash": 18329224955620563633,
      "context_hash": 15355986145409490086,
      "translation": "menu governor(tickless 시스템의 기본값)",
      "glossary_snapshot": {
        "governor": "governor"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "Predicts idle duration using the next timer event and historical data.",
      "source_hash": 16300780538345691778,
      "context_hash": 9955910510277554570,
      "translation": "다음 타이머 이벤트와 과거 데이터를 사용하여 유휴 시간을 예측합니다.",
      "glossary_snapshot": {
        "timer": "타이머"
      },
      "translated_at": "2026-11-14T22:32:10.835489Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:1",
      "source": "As of current mainline, `menu_select()` no longer has an iowait-based correction input (an older iowaiters-aware `which_bucket()` variant was removed) -- the prediction is now purely timer- and history-driven:",
      "source_hash": 2276869132881173056,
      "context_hash": 355321080565352176,
      "translation": "현재 메인라인 기준으로 `menu_select()`에는 더 이상 iowait 기반 보정 입력이 없으며(iowaiter를 고려하던 예전 `which_bucket()` 변형은 제거되었습니다) -- 이제 예측은 순전히 타이머와 이력만으로 이루어집니다:",
      "glossary_snapshot": {
        "mainline": "메인라인",
        "timer": "타이머"
      },
      "translated_at": "2026-11-14T22:32:10.835490Z",
      "issues": []
    },
    {
      "id": "section:3/block:8/seg:0",
      "source": "TEO governor (Timer Events Oriented, Linux 5.1+)",
      "source_hash": 6891096584042581295,
      "context_hash": 13445782162730688241,
      "translation": "TEO governor(Timer Events Oriented, Linux 5.1+)",
      "glossary_snapshot": {
        "Linux": "Linux",
        "governor": "governor"
      },
      "translated_at": "2026-11-14T22:32:10.835490Z",
      "issues": []
    },
    {
      "id": "section:3/block:9/seg:0",
      "source": "More accurate for modern tickless systems:",
      "source_hash": 6743658222856664091,
      "context_hash": 12354218350004491074,
      "translation": "최신 tickless 시스템에서 더 정확합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:10.835490Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Disabling C-states",
      "source_hash": 3976595314145535055,
      "context_hash": 8593545275621462087,
      "translation": "C-state 비활성화",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:32:10.835490Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "For latency-sensitive workloads, disable deep C-states:",
      "source_hash": 5509205395986812484,
      "context_hash": 8827484242784018102,
      "translation": "지연 시간에 민감한 워크로드에서는 깊은 C-state를 비활성화하십시오:",
      "glossary_snapshot": {
        "latency": "지연 시간",
        "workload": "워크로드"
      },
      "translated_at": "2026-11-14T22:32:10.835490Z",
      "issues": []
    },
