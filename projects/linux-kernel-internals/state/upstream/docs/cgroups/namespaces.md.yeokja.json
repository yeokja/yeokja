      "issues": []
    },
    {
      "id": "section:9/block:2/seg:0",
      "source": "A process is in them, OR",
      "source_hash": 1906067549114589311,
      "context_hash": 3367374920898554959,
      "translation": "네임스페이스 안에 프로세스가 있는 경우, 또는",
