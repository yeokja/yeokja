      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "PID 1 in a PID namespace is the init — if it exits, all processes in the namespace are killed.",
      "source_hash": 17599875385423739305,
      "context_hash": 9528247514570439341,
      "translation": "PID 네임스페이스의 PID 1은 init이며, 이 프로세스가 종료되면 해당 네임스페이스의 모든 프로세스가 강제 종료됩니다.",
      "glossary_snapshot": {
        "namespace": "네임스페이스",
        "processes": "프로세스"
      },
      "translated_at": "2026-11-14T22:10:00.488547Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Mount namespace",
      "source_hash": 17736782203719310151,
      "context_hash": 13148398578815616493,
      "translation": "마운트 네임스페이스",
      "glossary_snapshot": {
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T22:10:00.488547Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Mount namespaces (Linux 2.4.19, 2002) were the first namespace type added to the kernel — which is why the flag is the generic `CLONE_NEWNS` rather than something like `CLONE_NEWMNT`.",
      "source_hash": 2608117857586552387,
      "context_hash": 647868261036572978,
      "translation": "마운트 네임스페이스(Linux 2.4.19, 2002년)는 커널에 가장 먼저 추가된 네임스페이스 유형이며, 이 때문에 플래그 이름이 `CLONE_NEWMNT`와 같은 이름이 아니라 일반적인 `CLONE_NEWNS`입니다.",
      "glossary_snapshot": {
        "Linux": "Linux",
        "kernel": "커널",
        "namespace": "네임스페이스",
        "namespaces": "네임스페이스"
      },
      "translated_at": "2026-11-14T22:10:00.488547Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "Each mount namespace has its own copy of the mount tree.",
      "source_hash": 13405431988228048680,
      "context_hash": 2229655457588027077,
      "translation": "각 마운트 네임스페이스는 마운트 트리의 자체 사본을 가집니다.",
      "glossary_snapshot": {
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T22:10:00.488548Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:2",
      "source": "Changes in one don't affect others.",
      "source_hash": 14429373508895040243,
      "context_hash": 15032064252612115857,
      "translation": "한 네임스페이스에서의 변경은 다른 네임스페이스에 영향을 주지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:10:00.488549Z",
      "issues": []
    },
