    {
      "id": "section:9/block:1/seg:0",
      "source": "Namespaces are persistent as long as:",
      "source_hash": 6078727515395843324,
      "context_hash": 2293843250606290765,
      "translation": "네임스페이스는 다음 조건 중 하나가 유지되는 한 계속 존재합니다.",
