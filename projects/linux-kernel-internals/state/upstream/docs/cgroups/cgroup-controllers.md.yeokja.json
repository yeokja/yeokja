      "context_hash": 5591246249285176033,
      "translation": "가중치가 200인 프로세스는 두 프로세스가 모두 실행 가능한 상태일 때 가중치가 100인 프로세스보다 두 배의 CPU 몫을 받습니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "process": "프로세스"
