      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "`io.latency` provides latency-based I/O protection.",
      "source_hash": 6084772800685354345,
      "context_hash": 13540929706241405729,
      "translation": "`io.latency`는 지연 시간 기반 I/O 보호를 제공합니다.",
