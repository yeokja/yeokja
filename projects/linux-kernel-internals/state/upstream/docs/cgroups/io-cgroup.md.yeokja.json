    {
      "id": "section:3/block:0/seg:0",
      "source": "io.weight: Proportional scheduling",
      "source_hash": 663743433343700805,
      "context_hash": 13404032218769707913,
      "translation": "io.weight: 비례 스케줄링",
      "glossary_snapshot": {
        "scheduling": "스케줄링"
      },
      "translated_at": "2026-11-14T21:55:04.542607Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Requires BFQ I/O scheduler (Kyber does not support weight; mq-deadline and none are also unsupported):",
      "source_hash": 10203670496935952417,
      "context_hash": 15373560002254309056,
      "translation": "BFQ I/O 스케줄러가 필요합니다(Kyber는 가중치를 지원하지 않으며, mq-deadline과 none도 지원하지 않습니다):",
      "glossary_snapshot": {
        "BFQ": "BFQ",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T21:55:04.542607Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "BFQ weight-based scheduling",
      "source_hash": 3597418231386381941,
      "context_hash": 475645192400104428,
      "translation": "BFQ 가중치 기반 스케줄링",
      "glossary_snapshot": {
        "BFQ": "BFQ",
        "scheduling": "스케줄링"
      },
      "translated_at": "2026-11-14T21:55:04.542607Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "BFQ (Budget Fair Queuing) is a proportional-share I/O scheduler that implements weight-based fairness:",
      "source_hash": 17709078079351857499,
      "context_hash": 6681488839336836683,
      "translation": "BFQ(Budget Fair Queuing)는 가중치 기반 공정성을 구현하는 비례 배분 I/O 스케줄러입니다:",
      "glossary_snapshot": {
        "BFQ": "BFQ",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T21:55:04.542607Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "io.latency: Latency SLA",
