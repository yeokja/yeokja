      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "SMEP and SMAP (Intel x86)",
      "source_hash": 13195112652446999326,
      "context_hash": 17837016831007718153,
      "translation": "SMEP와 SMAP(Intel x86)",
      "glossary_snapshot": {
        "Intel": "Intel"
      },
      "translated_at": "2026-11-14T22:56:09.341549Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "**SMEP** (Supervisor Mode Execution Prevention): prevents kernel from executing userspace code pages. **SMAP** (Supervisor Mode Access Prevention): prevents kernel from accessing userspace memory unexpectedly.",
      "source_hash": 1149541458465097230,
      "context_hash": 8965694215140266362,
      "translation": "**SMEP**(Supervisor Mode Execution Prevention): 커널이 사용자 공간 코드 페이지를 실행하지 못하게 막습니다. **SMAP**(Supervisor Mode Access Prevention): 커널이 사용자 공간 메모리에 의도치 않게 접근하지 못하게 막습니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "memory": "메모리",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:56:09.341549Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "HARDENED_USERCOPY",
