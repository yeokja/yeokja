    {
      "id": "section:3/block:1/seg:0",
      "source": "Compiler-inserted canaries detect stack buffer overflows before return:",
      "source_hash": 16615163581355310164,
      "context_hash": 15505759046671140147,
      "translation": "컴파일러가 삽입한 카나리는 함수가 반환하기 전에 스택 버퍼 오버플로를 탐지합니다:",
      "glossary_snapshot": {},
