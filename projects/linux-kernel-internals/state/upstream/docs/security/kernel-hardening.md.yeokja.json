      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "Prevents kernel bugs that could copy too much data to/from userspace:",
      "source_hash": 16655039803095398811,
      "context_hash": 5636783291949228028,
      "translation": "사용자 공간으로 또는 사용자 공간에서 너무 많은 데이터를 복사할 수 있는 커널 버그를 막습니다:",
      "glossary_snapshot": {
        "bugs": "버그",
        "kernel": "커널",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:56:09.341549Z",
      "issues": []
