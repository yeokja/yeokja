      "context_hash": 3583485201582539959,
      "translation": "`/proc`, 초기화되지 않은 읽기, 정보 노출 버그를 통한 커널 포인터 유출",
      "glossary_snapshot": {
        "bugs": "버그",
        "kernel": "커널"
