    {
      "id": "section:2/block:0/seg:0",
      "source": "KASLR: Kernel Address Space Layout Randomization",
      "source_hash": 4947163022549938129,
      "context_hash": 12518740088705422310,
      "translation": "KASLR: 커널 주소 공간 배치 무작위화",
      "glossary_snapshot": {
        "KASLR": "KASLR",
        "address space": "주소 공간",
        "kernel address": "커널 주소"
      },
      "translated_at": "2026-11-14T22:56:09.341548Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "KASLR randomizes where the kernel and its modules are loaded in memory, making it harder for an attacker to use known kernel addresses in exploits:",
      "source_hash": 11023260828272739769,
      "context_hash": 4827443767579698555,
      "translation": "KASLR은 커널과 모듈이 메모리에 적재되는 위치를 무작위화하여, 공격자가 익스플로잇에 알려진 커널 주소를 사용하기 어렵게 만듭니다:",
      "glossary_snapshot": {
        "KASLR": "KASLR",
        "kernel": "커널",
        "kernel addresses": "커널 주소",
        "memory": "메모리",
        "modules": "모듈"
      },
      "translated_at": "2026-11-14T22:56:09.341548Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "**Bypass**: KASLR is defeated by:",
      "source_hash": 15388562361894485318,
      "context_hash": 3275958646561667525,
      "translation": "**우회**: KASLR은 다음과 같은 방법으로 무력화됩니다:",
      "glossary_snapshot": {
        "KASLR": "KASLR"
      },
      "translated_at": "2026-11-14T22:56:09.341548Z",
      "issues": []
    },
    {
