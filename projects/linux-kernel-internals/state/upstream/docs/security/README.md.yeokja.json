    {
      "id": "section:1/block:1/seg:0",
      "source": "Linux uses a layered security model:",
      "source_hash": 4079810458600076981,
      "context_hash": 17892663561514445810,
      "translation": "Linux는 계층화된 보안 모델을 사용합니다:",
