  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Landlock: Unprivileged Sandboxing",
      "source_hash": 5910201869413577468,
      "context_hash": 11014850272492248058,
      "translation": "Landlock: 비특권 샌드박싱",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:56:07.997405Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Restrict a process's filesystem and network access without root — the new Linux sandbox LSM",
      "source_hash": 9041439849525521184,
      "context_hash": 12152031740773109730,
      "translation": "root 권한 없이 프로세스의 파일시스템 및 네트워크 접근을 제한하는 새로운 Linux 샌드박스 LSM",
      "glossary_snapshot": {
        "Linux": "Linux",
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:56:07.997405Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What is Landlock?",
      "source_hash": 9653582499106737776,
      "context_hash": 11253482137273350613,
      "translation": "Landlock이란?",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:56:07.997405Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Landlock (merged in Linux 5.13 by Mickaël Salaün — [`17ae69aba89d`](https://git.kernel.org/linus/17ae69aba89dbfa2139b7f8024b757ab3cc42f59), [LWN](https://lwn.net/Articles/859908/)) is a Linux Security Module that allows **unprivileged processes** to restrict their own access to the filesystem (since 5.13) and TCP network ports (since Linux 6.7, ABI v4).",
      "source_hash": 15595930753970687506,
      "context_hash": 1987639733547451174,
      "translation": "Landlock(Linux 5.13에서 Mickaël Salaün이 병합 — [`17ae69aba89d`](https://git.kernel.org/linus/17ae69aba89dbfa2139b7f8024b757ab3cc42f59), [LWN](https://lwn.net/Articles/859908/))은 **비특권 프로세스**가 파일시스템(5.13부터) 및 TCP 네트워크 포트(Linux 6.7, ABI v4부터)에 대한 자신의 접근을 스스로 제한할 수 있게 하는 Linux Security Module입니다.",
      "glossary_snapshot": {
        "ABI": "ABI",
        "LWN": "LWN",
        "Linux": "Linux",
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Unlike seccomp which filters syscalls, Landlock controls resource access at a semantic level.",
      "source_hash": 13593430470418436452,
      "context_hash": 12727109968156119003,
      "translation": "시스템 콜을 필터링하는 seccomp와 달리, Landlock은 의미(semantic) 수준에서 자원 접근을 제어합니다.",
      "glossary_snapshot": {
        "seccomp": "seccomp",
        "syscall": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Key properties:",
      "source_hash": 5409981686824485612,
      "context_hash": 15535341728591164648,
      "translation": "주요 특성:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**No root required**: any process can create a Landlock sandbox for itself",
      "source_hash": 2357509644141114013,
      "context_hash": 14882926183932127935,
      "translation": "**root 불필요**: 어떤 프로세스든 자기 자신을 위한 Landlock 샌드박스를 만들 수 있습니다",
      "glossary_snapshot": {
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Irreversible**: once rules are enforced, they cannot be loosened",
      "source_hash": 11514348532731916136,
      "context_hash": 17244719617889304727,
      "translation": "**되돌릴 수 없음**: 규칙이 한 번 적용되면 완화할 수 없습니다",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Inherited**: child processes inherit the restrictions",
      "source_hash": 15991712417417557168,
      "context_hash": 15065285470785643742,
      "translation": "**상속됨**: 자식 프로세스가 제한을 상속합니다",
      "glossary_snapshot": {
        "processes": "프로세스"
      },
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "**Stacked**: rules can only be restricted, never expanded",
      "source_hash": 16722092873496099601,
      "context_hash": 48069786329888638,
      "translation": "**중첩 적용**: 규칙은 더 제한될 수만 있으며 결코 확장되지 않습니다",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:56:07.997406Z",
      "issues": []
    },
