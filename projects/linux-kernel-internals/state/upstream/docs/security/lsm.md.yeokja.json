      "source_hash": 5802016212846836605,
      "context_hash": 1298544415363263908,
      "translation": "프로세스 생성 및 자격 증명(credential) 변경",
      "glossary_snapshot": {
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:56:15.419362Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
