      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "dm-crypt sits in the device mapper stack, transparently encrypting/decrypting all I/O between the filesystem and the block device:",
      "source_hash": 10589330947825546965,
      "context_hash": 16278331522037559095,
      "translation": "dm-crypt는 device mapper 스택에 위치하며, 파일시스템과 블록 디바이스 사이의 모든 I/O를 투명하게 암호화/복호화합니다:",
      "glossary_snapshot": {
        "block device": "블록 디바이스",
        "device": "디바이스",
        "dm-crypt": "dm-crypt"
      },
      "translated_at": "2026-11-14T22:15:34.264267Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "LUKS2 on-disk format",
      "source_hash": 1509723381171005900,
      "context_hash": 7805364467724053961,
      "translation": "LUKS2 온디스크 형식",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:34.264267Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "LUKS (**L**inux **U**nified **K**ey **S**etup) is the standard format for dm-crypt headers.",
      "source_hash": 9367985129388120786,
      "context_hash": 6992579659397243372,
      "translation": "LUKS(**L**inux **U**nified **K**ey **S**etup)는 dm-crypt 헤더의 표준 형식입니다.",
      "glossary_snapshot": {
        "dm-crypt": "dm-crypt"
      },
      "translated_at": "2026-11-14T22:15:34.264267Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "LUKS2 (since kernel 4.12 / cryptsetup 2.0):",
      "source_hash": 14932650898988096161,
      "context_hash": 11385551921411605605,
      "translation": "LUKS2(커널 4.12 / cryptsetup 2.0부터):",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:15:34.264267Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Key derivation (PBKDF2/Argon2)",
      "source_hash": 10283534164016086218,
      "context_hash": 14361758933943472494,
      "translation": "키 유도(PBKDF2/Argon2)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:34.264267Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "Argon2id (LUKS2 default) is memory-hard — defeating GPU brute-force attacks.",
      "source_hash": 7303947755594648659,
      "context_hash": 13719469144560654156,
      "translation": "Argon2id(LUKS2 기본값)는 메모리 하드(memory-hard) 방식이므로 GPU 무차별 대입 공격을 무력화합니다.",
      "glossary_snapshot": {
        "GPU": "GPU",
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:15:34.264267Z",
      "issues": []
    },
