    {
      "id": "section:0/block:1/seg:0",
      "source": "Device mapper encryption target, LUKS2 key management, and AES-XTS",
      "source_hash": 3811110660362170010,
      "context_hash": 8013130286590033769,
      "translation": "디바이스 매퍼 암호화 타깃, LUKS2 키 관리, AES-XTS",
