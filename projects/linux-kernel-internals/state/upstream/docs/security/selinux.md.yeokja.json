  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "SELinux: Mandatory Access Control",
      "source_hash": 7640139543959309137,
      "context_hash": 7228312499767271148,
      "translation": "SELinux: 강제적 접근 제어",
      "glossary_snapshot": {
        "SELinux": "SELinux"
      },
      "translated_at": "2026-11-14T23:04:48.244147Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Security contexts, AVC cache, type enforcement policy, and audit2allow",
      "source_hash": 6496633379833654332,
      "context_hash": 17818225521703635256,
      "translation": "보안 컨텍스트, AVC 캐시, 타입 강제 정책 및 audit2allow",
      "glossary_snapshot": {
        "cache": "캐시",
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:04:48.244148Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What is SELinux?",
      "source_hash": 10054082589001712552,
      "context_hash": 16658682402853927006,
      "translation": "SELinux란 무엇인가",
      "glossary_snapshot": {
        "SELinux": "SELinux"
      },
      "translated_at": "2026-11-14T23:04:48.244148Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "SELinux (Security-Enhanced Linux) implements **Mandatory Access Control (MAC)**: access decisions are made by a central security policy, not by object owners.",
      "source_hash": 12048737402166061842,
      "context_hash": 6595411862988190923,
      "translation": "SELinux(Security-Enhanced Linux)는 **강제적 접근 제어**(Mandatory Access Control, MAC)를 구현합니다. 접근 결정은 객체 소유자가 아니라 중앙 보안 정책이 내립니다.",
      "glossary_snapshot": {
        "Linux": "Linux",
        "SELinux": "SELinux",
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:04:48.244149Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Even root cannot override the policy without explicit permission.",
      "source_hash": 8750540451575627290,
      "context_hash": 7286496599244387399,
      "translation": "root조차도 명시적인 허가 없이는 정책을 무시할 수 없습니다.",
      "glossary_snapshot": {
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:04:48.244149Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "SELinux was developed by the NSA, open-sourced in December 2000, and merged into Linux 2.6.0-test3 (August 2003).",
      "source_hash": 267557333101505872,
      "context_hash": 4801829900919381310,
      "translation": "SELinux는 NSA가 개발하여 2000년 12월에 오픈 소스로 공개되었고, Linux 2.6.0-test3(2003년 8월)에 병합되었습니다.",
      "glossary_snapshot": {
        "Linux": "Linux",
        "SELinux": "SELinux"
      },
      "translated_at": "2026-11-14T23:04:48.244149Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:1",
      "source": "It is built on the **LSM (Linux Security Module)** framework.",
      "source_hash": 7154576030263815075,
      "context_hash": 7168148924603788983,
      "translation": "SELinux는 **LSM(Linux Security Module)** 프레임워크 위에 구축되어 있습니다.",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T23:04:48.244149Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:2",
      "source": "Every security-sensitive kernel operation calls an LSM hook which SELinux intercepts.",
      "source_hash": 4758888445288922312,
      "context_hash": 7407610283565913592,
      "translation": "보안에 민감한 모든 커널 연산은 LSM 훅을 호출하며, SELinux는 이 훅을 가로챕니다.",
      "glossary_snapshot": {
        "SELinux": "SELinux",
        "hook": "훅",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:04:48.244149Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Security contexts",
      "source_hash": 4653157308679237031,
      "context_hash": 9040279750991687308,
      "translation": "보안 컨텍스트",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Every process and file has a **security context** (also called label):",
      "source_hash": 9853961435925948743,
      "context_hash": 4991950262554081536,
      "translation": "모든 프로세스와 파일에는 **보안 컨텍스트**(레이블이라고도 함)가 있습니다.",
      "glossary_snapshot": {
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Access Vector Cache (AVC)",
      "source_hash": 10522308962532143235,
      "context_hash": 4509409841138811478,
      "translation": "Access Vector Cache(AVC)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Every access check goes through the **AVC** (Access Vector Cache).",
      "source_hash": 2773332030623149661,
      "context_hash": 3798358570220867067,
      "translation": "모든 접근 검사는 **AVC**(Access Vector Cache)를 거칩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "The AVC is a hash table that caches recent allow/deny decisions:",
      "source_hash": 15589551903277598692,
      "context_hash": 4145828471261964628,
      "translation": "AVC는 최근의 허용/거부 결정을 캐시하는 해시 테이블입니다.",
      "glossary_snapshot": {
        "caches": "캐시"
      },
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Type Enforcement (TE) policy",
      "source_hash": 9587516558011015361,
      "context_hash": 15969226803718911336,
      "translation": "타입 강제(Type Enforcement, TE) 정책",
      "glossary_snapshot": {
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "The most important policy mechanism.",
      "source_hash": 14457023870387806838,
      "context_hash": 11011610237567047723,
      "translation": "가장 중요한 정책 메커니즘입니다.",
      "glossary_snapshot": {
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "Rules grant access between types:",
      "source_hash": 9279392201527367510,
      "context_hash": 16159818409413510909,
      "translation": "규칙은 타입 간의 접근을 허가합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244150Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "Policy source files",
      "source_hash": 8784865776948553787,
      "context_hash": 7181593725582668643,
      "translation": "정책 소스 파일",
      "glossary_snapshot": {
        "source file": "소스 파일"
      },
      "translated_at": "2026-11-14T23:04:48.244151Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "File context labeling",
      "source_hash": 2955456364311582968,
      "context_hash": 10844017639055597540,
      "translation": "파일 컨텍스트 레이블링",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244151Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Audit and audit2allow",
      "source_hash": 10001491356523996827,
      "context_hash": 14686688928973772118,
      "translation": "감사와 audit2allow",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244151Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "When SELinux denies an access, it logs to the audit log:",
      "source_hash": 8284091433407838948,
      "context_hash": 12594402011009356944,
      "translation": "SELinux가 접근을 거부하면 감사 로그에 기록합니다.",
      "glossary_snapshot": {
        "SELinux": "SELinux"
      },
      "translated_at": "2026-11-14T23:04:48.244151Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Boolean switches",
      "source_hash": 9556987617277994975,
      "context_hash": 3341400596276320566,
      "translation": "불리언 스위치",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:04:48.244151Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "Booleans allow tunable policy without recompiling:",
      "source_hash": 14422225139022954728,
      "context_hash": 13051445733462957173,
      "translation": "불리언을 사용하면 재컴파일 없이 정책을 조정할 수 있습니다.",
      "glossary_snapshot": {
        "policy": "정책"
      },
      "translated_at": "2026-11-14T23:04:48.244151Z",
      "issues": []
    },
