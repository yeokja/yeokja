  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "User Namespaces and Credential Mapping",
      "source_hash": 2843322367942611401,
      "context_hash": 9260835985962821687,
      "translation": "사용자 네임스페이스와 자격 증명 매핑",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940169Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "uid/gid mapping, capability sets, and the privilege model for containers",
      "source_hash": 11232226572610243487,
      "context_hash": 15058239384600503439,
      "translation": "uid/gid 매핑, capability 집합, 컨테이너를 위한 권한 모델",
      "glossary_snapshot": {
        "GID": "GID",
        "UID": "UID",
        "mapping": "매핑"
      },
      "translated_at": "2026-11-14T22:40:37.940171Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What user namespaces provide",
      "source_hash": 7416477291820024403,
      "context_hash": 14170907306524716395,
      "translation": "사용자 네임스페이스가 제공하는 것",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940171Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "A user namespace maps user and group IDs between a process's view and the host system.",
      "source_hash": 7446905057830756326,
      "context_hash": 12137364641638346084,
      "translation": "사용자 네임스페이스는 프로세스가 보는 사용자 ID 및 그룹 ID와 호스트 시스템의 ID를 서로 매핑합니다.",
      "glossary_snapshot": {
        "host": "호스트",
        "process": "프로세스",
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940171Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Inside the namespace, a process can have uid 0 (root) while being mapped to an unprivileged uid on the host.",
      "source_hash": 13160850175862287952,
      "context_hash": 16304615807833273659,
      "translation": "네임스페이스 안에서 프로세스는 uid 0(root)을 가지면서도 호스트에서는 비특권 uid로 매핑될 수 있습니다.",
      "glossary_snapshot": {
        "UID": "UID",
        "host": "호스트",
        "namespace": "네임스페이스",
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:40:37.940171Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "This is the foundation for **rootless containers**: running containers without any host privileges.",
      "source_hash": 5456084934230106744,
      "context_hash": 13694599157908476589,
      "translation": "이것은 호스트 권한 없이 컨테이너를 실행하는 **rootless 컨테이너**의 기반입니다.",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:40:37.940171Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Creating a user namespace",
      "source_hash": 13520835234596343637,
      "context_hash": 4771598917788123423,
      "translation": "사용자 네임스페이스 생성",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940171Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "After `clone(CLONE_NEWUSER)`, the child process has a new user namespace but **no uid/gid mapping yet**.",
      "source_hash": 8847548456432529653,
      "context_hash": 9355263364808536264,
      "translation": "`clone(CLONE_NEWUSER)` 이후 자식 프로세스는 새 사용자 네임스페이스를 갖지만 **아직 uid/gid 매핑은 없습니다**.",
      "glossary_snapshot": {
        "GID": "GID",
        "UID": "UID",
        "mapping": "매핑",
        "process": "프로세스",
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:1",
      "source": "All operations requiring privileges fail until the parent writes the mapping.",
      "source_hash": 81221692270352463,
      "context_hash": 8321592949581080715,
      "translation": "부모가 매핑을 기록할 때까지 권한이 필요한 모든 작업은 실패합니다.",
      "glossary_snapshot": {
        "mapping": "매핑"
      },
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "uid_map and gid_map",
      "source_hash": 4172489237422394068,
      "context_hash": 1683586915179558612,
      "translation": "uid_map과 gid_map",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "newuidmap / newgidmap",
      "source_hash": 16814028725322355595,
      "context_hash": 12119886892972090770,
      "translation": "newuidmap / newgidmap",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "For unprivileged users to write mappings beyond the single-entry restriction, the `newuidmap` setuid helper is used:",
      "source_hash": 5140481301047457801,
      "context_hash": 9299608771082123662,
      "translation": "비특권 사용자가 단일 항목 제한을 넘어서는 매핑을 기록하려면 setuid 헬퍼인 `newuidmap`을 사용합니다:",
      "glossary_snapshot": {
        "mappings": "매핑"
      },
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "/etc/subuid and /etc/subgid",
      "source_hash": 7521470490035104129,
      "context_hash": 7665143078031617195,
      "translation": "/etc/subuid와 /etc/subgid",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Capabilities in user namespaces",
      "source_hash": 13975125612584539688,
      "context_hash": 14755222533732878440,
      "translation": "사용자 네임스페이스의 capability",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Within a new user namespace, a process starts with a **full set of capabilities** — but only within that namespace:",
      "source_hash": 8515157562292820686,
      "context_hash": 13273312338758785942,
      "translation": "새 사용자 네임스페이스 안에서 프로세스는 **전체 capability 집합**을 가지고 시작합니다. 단, 그 네임스페이스 안에서만 유효합니다:",
      "glossary_snapshot": {
        "namespace": "네임스페이스",
        "process": "프로세스",
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940172Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "struct cred",
      "source_hash": 15736275639342101367,
      "context_hash": 16976024600395322061,
      "translation": "struct cred",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "Capability sets",
      "source_hash": 4105065089167678392,
      "context_hash": 6881241199844569010,
      "translation": "Capability 집합",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:0",
      "source": "Checking capabilities",
      "source_hash": 18153934288215781237,
      "context_hash": 4717935251884814936,
      "translation": "Capability 검사",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:4/block:9/seg:0",
      "source": "When a process calls `capable(CAP_NET_ADMIN)`, the kernel checks the capability against `init_user_ns` — the system-wide root namespace.",
      "source_hash": 2176392243389977332,
      "context_hash": 6537292319658607039,
      "translation": "프로세스가 `capable(CAP_NET_ADMIN)`을 호출하면 커널은 시스템 전체의 루트 네임스페이스인 `init_user_ns`를 기준으로 capability를 검사합니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "namespace": "네임스페이스",
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:4/block:9/seg:1",
      "source": "This means `capable()` only returns true for processes with real host root capabilities.",
      "source_hash": 2360462424920946831,
      "context_hash": 9977320532047714561,
      "translation": "즉, `capable()`은 실제 호스트 root capability를 가진 프로세스에 대해서만 true를 반환합니다.",
      "glossary_snapshot": {
        "host": "호스트",
        "processes": "프로세스"
      },
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:4/block:9/seg:2",
      "source": "For namespace-scoped checks (e.g., does this process have CAP_NET_ADMIN in the namespace that owns a given network device?), the kernel uses `ns_capable(ns, cap)` instead.",
      "source_hash": 8317320143674118816,
      "context_hash": 7603466666473291414,
      "translation": "네임스페이스 범위의 검사(예: 이 프로세스가 특정 네트워크 디바이스를 소유한 네임스페이스에서 CAP_NET_ADMIN을 가지고 있는가?)에는 커널이 대신 `ns_capable(ns, cap)`를 사용합니다.",
      "glossary_snapshot": {
        "device": "디바이스",
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T23:33:49.255992Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "kuid_t and uid remapping in the kernel",
      "source_hash": 15143385051342661620,
      "context_hash": 10051015566416336334,
      "translation": "커널의 kuid_t와 uid 재매핑",
      "glossary_snapshot": {
        "UID": "UID",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The kernel uses `kuid_t` (kernel UID) throughout to avoid confusion between namespaced and host UIDs:",
      "source_hash": 14986068577797830715,
      "context_hash": 3092580008176568171,
      "translation": "커널은 네임스페이스의 UID와 호스트 UID 사이의 혼동을 피하기 위해 전반적으로 `kuid_t`(커널 UID)를 사용합니다:",
      "glossary_snapshot": {
        "UID": "UID",
        "UIDs": "UID",
        "host": "호스트",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:40:37.940173Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "User namespace security boundaries",
      "source_hash": 11452493335822819477,
      "context_hash": 10080782355682676223,
      "translation": "사용자 네임스페이스의 보안 경계",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940174Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "What a user namespace CANNOT do",
      "source_hash": 5375796044493728476,
      "context_hash": 3421779324758836495,
      "translation": "사용자 네임스페이스가 할 수 없는 것",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940174Z",
      "issues": []
    },
    {
      "id": "section:6/block:2/seg:0",
      "source": "Even with root inside a user namespace, a process cannot:",
      "source_hash": 15945779555441072265,
      "context_hash": 16052888377113932484,
      "translation": "사용자 네임스페이스 안에서 root라 하더라도 프로세스는 다음을 할 수 없습니다:",
      "glossary_snapshot": {
        "process": "프로세스",
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940174Z",
      "issues": []
    },
    {
      "id": "section:6/block:4/seg:0",
      "source": "Nested user namespaces",
      "source_hash": 1646986016988232914,
      "context_hash": 8346212143474907191,
      "translation": "중첩된 사용자 네임스페이스",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940174Z",
      "issues": []
    },
    {
      "id": "section:6/block:5/seg:0",
      "source": "User namespaces can be nested (up to 32 levels):",
      "source_hash": 1548516210115513092,
      "context_hash": 14676953545303347083,
      "translation": "사용자 네임스페이스는 최대 32단계까지 중첩할 수 있습니다:",
      "glossary_snapshot": {
        "user namespace": "사용자 네임스페이스"
      },
      "translated_at": "2026-11-14T22:40:37.940174Z",
      "issues": []
    },
