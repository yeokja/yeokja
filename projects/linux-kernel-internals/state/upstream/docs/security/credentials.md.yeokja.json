      "translated_at": "2026-11-14T22:15:29.938513Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "\"root\" inside a container without host root",
      "source_hash": 4206430778764597996,
      "context_hash": 8600447804663909801,
      "translation": "호스트 root 권한 없이 컨테이너 내부에서 \"root\"",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:15:29.938513Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "Capability isolation: root inside namespace ≠ root outside",
