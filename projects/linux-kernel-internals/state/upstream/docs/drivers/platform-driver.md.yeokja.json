      "id": "section:0/block:0/seg:0",
      "source": "Platform Drivers",
      "source_hash": 6623206023282323339,
      "context_hash": 15232304521727712468,
      "translation": "플랫폼 드라이버",
      "glossary_snapshot": {
        "drivers": "드라이버"
