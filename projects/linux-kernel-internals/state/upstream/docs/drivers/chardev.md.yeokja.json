    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "ioctl lets userspace send control commands to the driver:",
      "source_hash": 12672149573266308826,
      "context_hash": 9205203871279455304,
      "translation": "ioctl을 사용하면 사용자 공간에서 드라이버로 제어 명령을 보낼 수 있습니다:",
      "glossary_snapshot": {
        "driver": "드라이버",
        "ioctl": "ioctl",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:52:43.312877Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "ioctl numbers use a structured format to avoid conflicts:",
      "source_hash": 10177736802469128325,
      "context_hash": 1003808266102157683,
      "translation": "ioctl 번호는 충돌을 피하기 위해 구조화된 형식을 사용합니다:",
      "glossary_snapshot": {
        "ioctl": "ioctl"
      },
      "translated_at": "2026-11-14T21:52:43.312878Z",
      "issues": []
    },
    {
