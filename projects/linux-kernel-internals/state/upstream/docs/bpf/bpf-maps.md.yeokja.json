  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "BPF Maps",
      "source_hash": 18335584690457956765,
      "context_hash": 1742988535578351478,
      "translation": "BPF 맵",
      "glossary_snapshot": {
        "BPF": "BPF"
      },
      "translated_at": "2026-11-14T21:54:02.967455Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "The data structures that connect BPF programs to each other and to userspace",
      "source_hash": 9032552823416427570,
      "context_hash": 3504656095219826442,
      "translation": "BPF 프로그램끼리, 그리고 BPF 프로그램과 사용자 공간을 연결하는 자료 구조",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램",
        "data structure": "자료 구조",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967456Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What BPF maps are",
      "source_hash": 12407044674725037932,
      "context_hash": 7186203794570294321,
      "translation": "BPF 맵이란",
      "glossary_snapshot": {
        "BPF": "BPF"
      },
      "translated_at": "2026-11-14T21:54:02.967474Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "BPF maps are key-value stores accessible from both BPF programs (via helpers) and userspace (via the bpf() syscall).",
      "source_hash": 18351420390739080261,
      "context_hash": 11492216657256079032,
      "translation": "BPF 맵은 BPF 프로그램(helper를 통해)과 사용자 공간(bpf() 시스템 콜을 통해) 양쪽에서 모두 접근할 수 있는 키-값 저장소입니다.",
      "glossary_snapshot": {
        "BPF": "BPF",
        "BPF program": "BPF 프로그램",
        "syscall": "시스템 콜",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967474Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "They are the primary mechanism for:",
      "source_hash": 5070187600856240433,
      "context_hash": 3205908825512453688,
      "translation": "BPF 맵은 다음을 위한 주된 메커니즘입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Passing data from BPF programs to userspace (stats, events)",
      "source_hash": 15779604862460074419,
      "context_hash": 3254800492480666212,
      "translation": "BPF 프로그램에서 사용자 공간으로 데이터 전달(통계, 이벤트)",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "Passing configuration from userspace to BPF programs",
      "source_hash": 10494535810027517148,
      "context_hash": 8644799305059611713,
      "translation": "사용자 공간에서 BPF 프로그램으로 설정 전달",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "Sharing state between multiple BPF programs",
      "source_hash": 16021292782171525237,
      "context_hash": 4706872653803437367,
      "translation": "여러 BPF 프로그램 간의 상태 공유",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램"
      },
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Maintaining state across invocations of the same BPF program",
      "source_hash": 4020291016982342127,
      "context_hash": 2217269872917145832,
      "translation": "같은 BPF 프로그램의 여러 호출에 걸친 상태 유지",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램"
      },
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Creating a map",
      "source_hash": 16754575840358164282,
      "context_hash": 11683700518211107253,
      "translation": "맵 생성",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Map types",
      "source_hash": 16898812296030220435,
      "context_hash": 1009736516712257672,
      "translation": "맵 유형",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967475Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "BPF_MAP_TYPE_HASH",
      "source_hash": 16554758008052762245,
      "context_hash": 5503745225795046861,
      "translation": "BPF_MAP_TYPE_HASH",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "Generic hash map with arbitrary key/value sizes.",
      "source_hash": 15310790009402644395,
      "context_hash": 8419239771508872546,
      "translation": "임의 크기의 키/값을 지원하는 범용 해시 맵입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "Update flags:",
      "source_hash": 6170011033606530557,
      "context_hash": 17335932181930296398,
      "translation": "갱신 플래그:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "`BPF_ANY` — create or update",
      "source_hash": 7314262785520700596,
      "context_hash": 12994851173769899746,
      "translation": "`BPF_ANY` — 생성 또는 갱신",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "`BPF_NOEXIST` — create only (fail if key exists)",
      "source_hash": 8279840867105695892,
      "context_hash": 16211186564424248233,
      "translation": "`BPF_NOEXIST` — 생성만 수행(키가 이미 있으면 실패)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:7/seg:0",
      "source": "`BPF_EXIST` — update only (fail if key doesn't exist)",
      "source_hash": 14831999768499216500,
      "context_hash": 16052236864674764054,
      "translation": "`BPF_EXIST` — 갱신만 수행(키가 없으면 실패)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:8/seg:0",
      "source": "Internals: uses a lock-based hash table, `htab_elem` per entry.",
      "source_hash": 11071281003909987684,
      "context_hash": 10770041046849142347,
      "translation": "내부 구현: 락 기반 해시 테이블을 사용하며, 항목마다 `htab_elem` 하나를 둡니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:8/seg:1",
      "source": "Supports concurrent access from multiple CPUs.",
      "source_hash": 2500243061064066306,
      "context_hash": 17449681342019711766,
      "translation": "여러 CPU에서의 동시 접근을 지원합니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:9/seg:0",
      "source": "BPF_MAP_TYPE_ARRAY",
      "source_hash": 5903393575713585277,
      "context_hash": 9984514073288099049,
      "translation": "BPF_MAP_TYPE_ARRAY",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:10/seg:0",
      "source": "Fixed-size array indexed by u32.",
      "source_hash": 11956851117962319056,
      "context_hash": 16814304854822095211,
      "translation": "u32로 인덱싱되는 고정 크기 배열입니다.",
      "glossary_snapshot": {
        "array": "배열"
      },
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:10/seg:1",
      "source": "Pre-allocated, no dynamic memory during runtime.",
      "source_hash": 15611980921829110203,
      "context_hash": 6076527577294740808,
      "translation": "미리 할당되므로 실행 중에 동적 메모리를 사용하지 않습니다.",
      "glossary_snapshot": {
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:10/seg:2",
      "source": "Value must be zeroed (no deletion).",
      "source_hash": 10328117590110095149,
      "context_hash": 7299987921828315263,
      "translation": "값은 0으로 초기화해야 합니다(삭제 불가).",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967476Z",
      "issues": []
    },
    {
      "id": "section:3/block:12/seg:0",
      "source": "BPF_MAP_TYPE_PERCPU_HASH / BPF_MAP_TYPE_PERCPU_ARRAY",
      "source_hash": 15972720463317248689,
      "context_hash": 2118163609051501779,
      "translation": "BPF_MAP_TYPE_PERCPU_HASH / BPF_MAP_TYPE_PERCPU_ARRAY",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:13/seg:0",
      "source": "One value per CPU — eliminates atomic operations for per-CPU counters:",
      "source_hash": 12810539747293345427,
      "context_hash": 8807902886122006581,
      "translation": "CPU마다 값을 하나씩 두므로 per-CPU 카운터에서 원자적 연산이 필요 없습니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:15/seg:0",
      "source": "Userspace reads all CPU values and sums them:",
      "source_hash": 6208985332319890364,
      "context_hash": 8570696253369279014,
      "translation": "사용자 공간은 모든 CPU의 값을 읽어 합산합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:17/seg:0",
      "source": "BPF_MAP_TYPE_RINGBUF",
      "source_hash": 15672795672560997695,
      "context_hash": 6200406644514257220,
      "translation": "BPF_MAP_TYPE_RINGBUF",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:18/seg:0",
      "source": "The preferred mechanism for sending variable-length events from BPF to userspace (replaces perf_event_output for most use cases).",
      "source_hash": 7370955627785874433,
      "context_hash": 9467667233027652070,
      "translation": "BPF에서 사용자 공간으로 가변 길이 이벤트를 보낼 때 권장되는 메커니즘입니다(대부분의 용도에서 perf_event_output을 대체합니다).",
      "glossary_snapshot": {
        "BPF": "BPF",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:21/seg:0",
      "source": "Why ringbuf over perf_event output:",
      "source_hash": 17050227754374306330,
      "context_hash": 14157770481753543069,
      "translation": "perf_event 출력 대신 ringbuf를 쓰는 이유:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:22/seg:0",
      "source": "Single shared ring across all CPUs (no per-CPU waste)",
      "source_hash": 13105795395211895074,
      "context_hash": 3211725562553027433,
      "translation": "모든 CPU가 공유하는 단일 링(CPU별 낭비 없음)",
      "glossary_snapshot": {
        "CPU": "CPU",
        "CPUs": "CPU"
      },
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:23/seg:0",
      "source": "Events are ordered within the ring",
      "source_hash": 5430437767430512117,
      "context_hash": 2067240884406798872,
      "translation": "링 안에서 이벤트 순서 보장",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:24/seg:0",
      "source": "No copy — userspace reads directly from the ring memory",
      "source_hash": 11488663477940009022,
      "context_hash": 10964076142502487784,
      "translation": "복사 없음 — 사용자 공간이 링 메모리에서 직접 읽음",
      "glossary_snapshot": {
        "memory": "메모리",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:54:02.967477Z",
      "issues": []
    },
    {
      "id": "section:3/block:25/seg:0",
      "source": "Variable-size entries",
      "source_hash": 12781624697866194016,
      "context_hash": 6357556700903004555,
      "translation": "가변 크기 엔트리",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706699Z",
      "issues": []
    },
    {
      "id": "section:3/block:26/seg:0",
      "source": "BPF_MAP_TYPE_LRU_HASH",
      "source_hash": 10168130839925900559,
      "context_hash": 16805535096876193383,
      "translation": "BPF_MAP_TYPE_LRU_HASH",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706699Z",
      "issues": []
    },
    {
      "id": "section:3/block:27/seg:0",
      "source": "Hash map with LRU eviction when full.",
      "source_hash": 12984409940041644941,
      "context_hash": 13044948574565122037,
      "translation": "가득 차면 LRU 방식으로 엔트리를 축출하는 해시 맵입니다.",
      "glossary_snapshot": {
        "LRU": "LRU",
        "eviction": "축출"
      },
      "translated_at": "2026-11-14T21:54:29.706699Z",
      "issues": []
    },
    {
      "id": "section:3/block:27/seg:1",
      "source": "Useful for tracking connections without explicit cleanup:",
      "source_hash": 9001738258134025530,
      "context_hash": 7893196532054386113,
      "translation": "명시적인 정리 작업 없이 연결을 추적할 때 유용합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706700Z",
      "issues": []
    },
    {
      "id": "section:3/block:29/seg:0",
      "source": "BPF_MAP_TYPE_PROG_ARRAY",
      "source_hash": 16565172749487207432,
      "context_hash": 1577657990068795826,
      "translation": "BPF_MAP_TYPE_PROG_ARRAY",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706700Z",
      "issues": []
    },
    {
      "id": "section:3/block:30/seg:0",
      "source": "Array of BPF program file descriptors for tail calls.",
      "source_hash": 15353121986329530524,
      "context_hash": 4531719104163462245,
      "translation": "tail call에 사용하는 BPF 프로그램 파일 디스크립터의 배열입니다.",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램",
        "array": "배열",
        "file descriptor": "파일 디스크립터"
      },
      "translated_at": "2026-11-14T21:54:29.706700Z",
      "issues": []
    },
    {
      "id": "section:3/block:30/seg:1",
      "source": "Enables program chaining without growing the stack:",
      "source_hash": 5711949962583666448,
      "context_hash": 9295265802488078332,
      "translation": "스택을 늘리지 않고 프로그램을 연쇄적으로 실행할 수 있게 합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706701Z",
      "issues": []
    },
    {
      "id": "section:3/block:32/seg:0",
      "source": "Tail calls don't increase the call stack depth.",
      "source_hash": 17818090256358219785,
      "context_hash": 14000240956376046292,
      "translation": "tail call은 호출 스택 깊이를 늘리지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706701Z",
      "issues": []
    },
    {
      "id": "section:3/block:32/seg:1",
      "source": "They replace the current program.",
      "source_hash": 7684981134150121746,
      "context_hash": 16964612971732493619,
      "translation": "현재 프로그램을 대체합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706701Z",
      "issues": []
    },
    {
      "id": "section:3/block:32/seg:2",
      "source": "Max chain length: 33.",
      "source_hash": 5023357662771560151,
      "context_hash": 10307607191941813555,
      "translation": "최대 체인 길이: 33.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706701Z",
      "issues": []
    },
    {
      "id": "section:3/block:33/seg:0",
      "source": "BPF_MAP_TYPE_HASH_OF_MAPS / BPF_MAP_TYPE_ARRAY_OF_MAPS",
      "source_hash": 49336974303995879,
      "context_hash": 3111601956676038855,
      "translation": "BPF_MAP_TYPE_HASH_OF_MAPS / BPF_MAP_TYPE_ARRAY_OF_MAPS",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:54:29.706701Z",
      "issues": []
    },
    {
      "id": "section:3/block:34/seg:0",
      "source": "Map-in-map: values are other map file descriptors.",
      "source_hash": 10827427895022168338,
      "context_hash": 9644766160051637477,
      "translation": "맵 인 맵(map-in-map): 값이 다른 맵의 파일 디스크립터입니다.",
      "glossary_snapshot": {
        "file descriptor": "파일 디스크립터"
      },
      "translated_at": "2026-11-14T21:54:29.706701Z",
      "issues": []
    },
    {
      "id": "section:3/block:34/seg:1",
      "source": "Useful for per-CPU or per-namespace map isolation:",
      "source_hash": 17397143558008696082,
      "context_hash": 13679709855321045854,
      "translation": "CPU별 또는 네임스페이스별로 맵을 격리할 때 유용합니다:",
      "glossary_snapshot": {
        "CPU": "CPU",
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T21:54:29.706701Z",
