      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "Closing the link_fd automatically detaches (no dangling programs)",
      "source_hash": 8962345355464045309,
      "context_hash": 9057094347908007252,
      "translation": "link_fd를 닫으면 자동으로 detach됩니다(남겨진 프로그램이 없음)",
