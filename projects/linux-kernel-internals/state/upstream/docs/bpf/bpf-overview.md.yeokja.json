    {
      "id": "section:8/block:1/seg:0",
      "source": "BPF programs can't call arbitrary kernel functions — they use a whitelisted set of helpers:",
      "source_hash": 5606925168329939659,
      "context_hash": 7073367041983657902,
      "translation": "BPF 프로그램은 임의의 커널 함수를 호출할 수 없으며, 허용 목록에 있는 헬퍼 집합을 사용합니다:",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램"
      },
      "translated_at": "2026-11-14T21:52:30.183849Z",
      "issues": []
    },
    {
      "id": "section:8/block:3/seg:0",
      "source": "Each helper is assigned a stable number; new helpers get new numbers and never change existing ones for ABI stability.",
      "source_hash": 3927807973869167468,
      "context_hash": 14608361670947103723,
      "translation": "각 헬퍼에는 고정된 번호가 할당되며, ABI 안정성을 위해 새 헬퍼는 새 번호를 받고 기존 번호는 절대 바뀌지 않습니다.",
      "glossary_snapshot": {
        "ABI": "ABI"
      },
      "translated_at": "2026-11-14T21:52:30.183850Z",
      "issues": []
    },
