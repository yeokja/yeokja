    {
      "id": "section:0/block:1/seg:0",
      "source": "Safe, programmable hooks into the Linux kernel",
      "source_hash": 5673425060714226492,
      "context_hash": 11753928069568494475,
      "translation": "Linux 커널에 대한 안전하고 프로그래밍 가능한 훅",
      "glossary_snapshot": {
        "Linux": "Linux",
        "hooks": "훅"
      },
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What is eBPF?",
      "source_hash": 15407200516682252940,
      "context_hash": 2980518434543638162,
      "translation": "eBPF란 무엇입니까?",
      "glossary_snapshot": {
        "eBPF": "eBPF"
      },
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "eBPF (extended Berkeley Packet Filter) lets you run sandboxed programs in the kernel without writing kernel modules.",
      "source_hash": 3379731888987903772,
      "context_hash": 6868622252430402788,
      "translation": "eBPF(extended Berkeley Packet Filter)를 사용하면 커널 모듈을 작성하지 않고도 커널 안에서 샌드박스화된 프로그램을 실행할 수 있습니다.",
      "glossary_snapshot": {
        "Kernel Modules": "커널 모듈",
        "eBPF": "eBPF",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Programs are:",
      "source_hash": 14139140457721629845,
      "context_hash": 5632572292892231525,
      "translation": "프로그램의 특징은 다음과 같습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Verified** before loading — the kernel proves they terminate and never access invalid memory",
      "source_hash": 15260028727716324408,
      "context_hash": 14568452296222793704,
      "translation": "**검증됨** — 로드 전에 검증되며, 커널은 프로그램이 반드시 종료되고 잘못된 메모리에 절대 접근하지 않음을 증명합니다",
      "glossary_snapshot": {
        "kernel": "커널",
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**JIT-compiled** — native machine code performance after first load",
      "source_hash": 13892675493940260047,
      "context_hash": 217143962484847278,
      "translation": "**JIT 컴파일됨** — 최초 로드 이후 네이티브 머신 코드 수준의 성능을 냅니다",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Event-driven** — attached to hooks (syscalls, network, tracepoints, kprobes)",
      "source_hash": 1000896012887090962,
      "context_hash": 12936298353853791633,
      "translation": "**이벤트 기반** — 훅(시스템 콜, 네트워크, 트레이스포인트, kprobe)에 연결됩니다",
      "glossary_snapshot": {
        "hooks": "훅",
        "kprobes": "kprobe",
        "syscalls": "시스템 콜",
        "tracepoints": "트레이스포인트"
      },
      "translated_at": "2026-11-14T21:53:49.771955Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Observable** — share data with userspace via maps",
      "source_hash": 6143864549352362533,
      "context_hash": 5059017115413872570,
      "translation": "**관찰 가능** — 맵을 통해 사용자 공간과 데이터를 공유합니다",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T21:53:49.771956Z",
      "issues": []
    },
