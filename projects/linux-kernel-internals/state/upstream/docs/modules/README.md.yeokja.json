      },
      "translated_at": "2026-11-14T22:05:10.120366Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Dynamically loadable code that extends the kernel",
      "source_hash": 3711258748379593457,
      "context_hash": 15044316586732828027,
      "translation": "커널을 확장하는 동적 적재 가능 코드",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:05:10.120367Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What kernel modules are",
      "source_hash": 13035653963559771200,
      "context_hash": 3694078242111998400,
      "translation": "커널 모듈이란",
      "glossary_snapshot": {
        "kernel module": "커널 모듈"
      },
      "translated_at": "2026-11-14T22:05:10.120367Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "A kernel module is an ELF shared object loaded into the kernel at runtime.",
      "source_hash": 133378306772860565,
      "context_hash": 16001802221180559643,
      "translation": "커널 모듈은 런타임에 커널에 적재되는 ELF 공유 오브젝트입니다.",
      "glossary_snapshot": {
        "ELF": "ELF",
        "kernel": "커널",
        "kernel module": "커널 모듈"
      },
      "translated_at": "2026-11-14T22:05:10.120367Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Modules:",
      "source_hash": 3633051401331361409,
      "context_hash": 14881311408135026114,
      "translation": "모듈의 특징:",
      "glossary_snapshot": {
        "modules": "모듈"
      },
      "translated_at": "2026-11-14T22:05:10.120367Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "Share the kernel's address space and run at ring 0 (full privilege)",
      "source_hash": 7471664267653461398,
      "context_hash": 9021085969429980169,
      "translation": "커널의 주소 공간을 공유하며 ring 0(전체 권한)에서 실행됨",
      "glossary_snapshot": {
        "address space": "주소 공간",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:05:10.120367Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "Can export and use symbols from other modules or the core kernel",
      "source_hash": 6847215312021001618,
      "context_hash": 17786241680192014415,
      "translation": "다른 모듈이나 코어 커널의 심볼을 export하고 사용할 수 있음",
      "glossary_snapshot": {
        "kernel": "커널",
        "modules": "모듈"
      },
      "translated_at": "2026-11-14T22:05:10.120368Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "Are loaded by `insmod`/`modprobe` and removed by `rmmod`",
      "source_hash": 8553929003778738321,
      "context_hash": 3607525315401321521,
      "translation": "`insmod`/`modprobe`로 적재되고 `rmmod`로 제거됨",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:05:10.120368Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Have an init function called on load and an exit function called on unload",
      "source_hash": 3988479713001214635,
      "context_hash": 11487203394902553382,
      "translation": "적재 시 호출되는 init 함수와 언로드 시 호출되는 exit 함수를 가짐",
      "glossary_snapshot": {
        "function": "함수"
      },
      "translated_at": "2026-11-14T22:05:10.120368Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "Most device drivers, filesystems, and network protocols ship as modules.",
      "source_hash": 3915668382492524353,
      "context_hash": 15212513107820717367,
      "translation": "대부분의 디바이스 드라이버, 파일시스템, 네트워크 프로토콜은 모듈로 제공됩니다.",
      "glossary_snapshot": {
        "device driver": "디바이스 드라이버"
      },
      "translated_at": "2026-11-14T22:05:10.120368Z",
      "issues": []
    },
