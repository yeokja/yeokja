      "id": "section:1/block:2/seg:0",
      "source": "[OverlayFS: The Copy-Up That Trusted an Unmapped UID](war-stories/overlayfs-uid-confusion.md)",
      "source_hash": 11850003605284291144,
      "context_hash": 13355276930171262785,
      "translation": "[OverlayFS: 매핑되지 않은 UID를 믿은 copy-up](war-stories/overlayfs-uid-confusion.md)",
      "glossary_snapshot": {
        "UID": "UID",
        "copy-up": "copy-up"
      },
      "translated_at": "2026-11-14T22:54:50.262644Z",
      "issues": []
