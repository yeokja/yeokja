      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "The `write(2)` system call is documented in the Linux man pages [(man page)](https://man7.org/linux/man-pages/man2/write.2.html).",
      "source_hash": 16326700345986941600,
      "context_hash": 14902181758963476056,
      "translation": "`write(2)` 시스템 콜은 Linux man 페이지에 문서화되어 있습니다 [(man 페이지)](https://man7.org/linux/man-pages/man2/write.2.html).",
      "glossary_snapshot": {
        "Linux": "Linux",
        "system call": "시스템 콜"
      },
      "translated_at": "2026-11-14T22:55:19.677664Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "The VFS layer dispatches it through a chain of generic helpers before it reaches the filesystem-specific code.",
      "source_hash": 10643648747253099817,
      "context_hash": 15084226248576875965,
      "translation": "VFS 계층은 파일시스템별 코드에 도달하기 전에 일련의 범용 헬퍼 함수를 거쳐 이 호출을 전달합니다.",
      "glossary_snapshot": {
        "VFS": "VFS"
      },
      "translated_at": "2026-11-14T22:55:19.677664Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Phase 2: VFS checks",
      "source_hash": 17388531880586416573,
      "context_hash": 9090509367516947877,
      "translation": "2단계: VFS 검사",
      "glossary_snapshot": {
