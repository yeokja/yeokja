      "issues": []
    },
    {
      "id": "section:2/block:26/seg:0",
      "source": "Not supported on symlinks or device files (to prevent privilege escalation via root-owned devices)",
      "source_hash": 12535318760533292514,
      "context_hash": 5436617731690504294,
      "translation": "심볼릭 링크나 디바이스 파일에서는 지원되지 않음(root 소유 디바이스를 통한 권한 상승을 방지하기 위함)",
      "glossary_snapshot": {
        "device": "디바이스",
        "devices": "디바이스",
        "privilege escalation": "권한 상승"
      },
      "translated_at": "2026-11-14T23:07:52.494741Z",
      "issues": []
    },
    {
