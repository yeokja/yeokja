    {
      "id": "section:2/block:23/seg:0",
      "source": "Any process with write permission on the file can set `user.*` attributes:",
      "source_hash": 12953818106964253614,
      "context_hash": 1528871955337750881,
      "translation": "파일에 대한 쓰기 권한이 있는 모든 프로세스는 `user.*` 속성을 설정할 수 있습니다:",
      "glossary_snapshot": {
        "process": "프로세스"
      },
      "translated_at": "2026-11-14T23:07:43.912755Z",
      "issues": []
    },
    {
      "id": "section:2/block:25/seg:0",
      "source": "Restrictions:",
