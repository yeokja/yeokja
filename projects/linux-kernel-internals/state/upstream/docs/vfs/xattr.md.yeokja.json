  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Extended Attributes (xattr)",
      "source_hash": 13231891125835189219,
      "context_hash": 5628651465433392246,
      "translation": "확장 속성(xattr)",
      "glossary_snapshot": {
        "xattr": "xattr"
      },
      "translated_at": "2026-11-14T23:07:43.912751Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Attaching arbitrary metadata to files and directories",
      "source_hash": 13362832445424770532,
      "context_hash": 15073832536387748162,
      "translation": "파일과 디렉터리에 임의의 메타데이터 붙이기",
      "glossary_snapshot": {
        "metadata": "메타데이터"
      },
      "translated_at": "2026-11-14T23:07:43.912752Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What are extended attributes?",
      "source_hash": 8660637637241606609,
      "context_hash": 15302318084459709874,
      "translation": "확장 속성이란 무엇입니까?",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:07:43.912752Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Extended attributes (xattr) allow attaching name-value pairs to files and directories.",
      "source_hash": 9060354312341168706,
      "context_hash": 6817792970486477603,
      "translation": "확장 속성(xattr)을 사용하면 파일과 디렉터리에 이름-값 쌍을 붙일 수 있습니다.",
      "glossary_snapshot": {
        "xattr": "xattr"
      },
      "translated_at": "2026-11-14T23:07:43.912752Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "They extend the traditional POSIX metadata (owner, permissions, timestamps) with arbitrary key-value data.",
      "source_hash": 7287633160807696276,
      "context_hash": 8155552664226711739,
      "translation": "확장 속성은 전통적인 POSIX 메타데이터(소유자, 권한, 타임스탬프)를 임의의 키-값 데이터로 확장합니다.",
      "glossary_snapshot": {
        "POSIX": "POSIX",
        "metadata": "메타데이터",
        "timestamp": "타임스탬프"
      },
      "translated_at": "2026-11-14T23:07:43.912752Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "Xattr support was introduced in Linux 2.4 [(man page)](https://www.man7.org/linux/man-pages/man2/getxattr.2.html).",
      "source_hash": 9491616093927989401,
      "context_hash": 10481163820901325224,
      "translation": "xattr 지원은 Linux 2.4에서 도입되었습니다 [(man 페이지)](https://www.man7.org/linux/man-pages/man2/getxattr.2.html).",
      "glossary_snapshot": {
        "Linux": "Linux",
        "xattr": "xattr"
      },
      "translated_at": "2026-11-14T23:07:43.912752Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "There are also `l` variants (`lgetxattr`, `lsetxattr`) that don't follow symlinks, and `f` variants (`fgetxattr`, `fsetxattr`) that operate on open file descriptors.",
      "source_hash": 5890875619402010043,
      "context_hash": 5433610567990836000,
      "translation": "심볼릭 링크를 따라가지 않는 `l` 변형(`lgetxattr`, `lsetxattr`)과 열린 파일 디스크립터에 대해 동작하는 `f` 변형(`fgetxattr`, `fsetxattr`)도 있습니다.",
      "glossary_snapshot": {
        "file descriptor": "파일 디스크립터"
      },
      "translated_at": "2026-11-14T23:07:43.912752Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Namespace prefixes",
      "source_hash": 10728912120372344067,
      "context_hash": 4228723797734433110,
      "translation": "네임스페이스 접두사",
      "glossary_snapshot": {
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T23:07:43.912753Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "Every xattr name must begin with a recognized namespace prefix:",
      "source_hash": 10406564975086412264,
      "context_hash": 3731414718250038580,
      "translation": "모든 xattr 이름은 인식되는 네임스페이스 접두사로 시작해야 합니다:",
      "glossary_snapshot": {
        "namespace": "네임스페이스",
        "xattr": "xattr"
      },
      "translated_at": "2026-11-14T23:07:43.912753Z",
      "issues": []
    },
