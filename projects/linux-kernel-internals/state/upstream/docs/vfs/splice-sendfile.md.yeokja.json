  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "splice, sendfile, and copy_file_range",
      "source_hash": 13295063245593010877,
      "context_hash": 7571113396046187238,
      "translation": "splice, sendfile, copy_file_range",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781887Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Zero-copy data transfer between file descriptors",
      "source_hash": 14453804075609177609,
      "context_hash": 1672637564403859218,
      "translation": "파일 디스크립터 간 제로 카피 데이터 전송",
      "glossary_snapshot": {
        "file descriptor": "파일 디스크립터",
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:36:42.287669Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The problem: data movement overhead",
      "source_hash": 13420604319150508002,
      "context_hash": 8952756416963580387,
      "translation": "문제: 데이터 이동 오버헤드",
      "glossary_snapshot": {
        "overhead": "오버헤드"
      },
      "translated_at": "2026-11-14T23:01:06.781887Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Normal `read()` + `write()` copies data through userspace:",
      "source_hash": 7932433628744962771,
      "context_hash": 7256003042232822601,
      "translation": "일반적인 `read()` + `write()`는 데이터를 사용자 공간을 거쳐 복사합니다:",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T23:01:06.781887Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "For large data transfers (serving files over HTTP, piping data between processes), these copies are wasteful.",
      "source_hash": 792169112986736432,
      "context_hash": 17401448597407261996,
      "translation": "대용량 데이터 전송(HTTP로 파일 제공, 프로세스 간 데이터 파이핑)에서는 이러한 복사가 낭비입니다.",
      "glossary_snapshot": {
        "processes": "프로세스"
      },
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:1",
      "source": "Linux provides several zero-copy alternatives.",
      "source_hash": 5280902931745064409,
      "context_hash": 2163850776180047486,
      "translation": "Linux는 여러 가지 제로 카피 대안을 제공합니다.",
      "glossary_snapshot": {
        "Linux": "Linux",
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:36:42.287676Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "sendfile: file-to-socket zero-copy",
      "source_hash": 9886749489701984685,
      "context_hash": 11151209365832728934,
      "translation": "sendfile: 파일에서 소켓으로의 제로 카피",
      "glossary_snapshot": {
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:36:42.287676Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "`sendfile()` was introduced in Linux 2.2 [(man page)](https://www.man7.org/linux/man-pages/man2/sendfile.2.html) and sends a file directly to a socket without copying through userspace:",
      "source_hash": 7908008063530100444,
      "context_hash": 16538315677451119018,
      "translation": "`sendfile()`은 Linux 2.2에서 도입되었으며[(man page)](https://www.man7.org/linux/man-pages/man2/sendfile.2.html), 사용자 공간을 거쳐 복사하지 않고 파일을 소켓으로 직접 전송합니다:",
      "glossary_snapshot": {
        "Linux": "Linux",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Data path with sendfile:",
      "source_hash": 15695945817932707176,
      "context_hash": 6418666684240549503,
      "translation": "sendfile을 사용할 때의 데이터 경로:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "sendfile limitations",
      "source_hash": 14476949766066904035,
      "context_hash": 2534342198939791782,
      "translation": "sendfile의 제약 사항",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
      "source": "`out_fd` must be a socket (or pipe on some kernels)",
      "source_hash": 11362182026810236400,
      "context_hash": 12158583814337767029,
      "translation": "`out_fd`는 소켓이어야 함(일부 커널에서는 파이프도 가능)",
      "glossary_snapshot": {
        "kernels": "커널"
      },
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:2/block:7/seg:0",
      "source": "`in_fd` must support `mmap`-like operations (regular files, not sockets)",
      "source_hash": 5449729639783015316,
      "context_hash": 4306011079625706286,
      "translation": "`in_fd`는 `mmap`과 유사한 연산을 지원해야 함(소켓이 아닌 일반 파일)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:2/block:8/seg:0",
      "source": "Does not work for file-to-file copies",
      "source_hash": 4272136477937241988,
      "context_hash": 10567293793938105947,
      "translation": "파일 간 복사에는 동작하지 않음",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:2/block:9/seg:0",
      "source": "Requires NIC scatter-gather for true zero-copy; otherwise one kernel→kernel copy",
      "source_hash": 10060908016941539207,
      "context_hash": 17400704827134963421,
      "translation": "진정한 제로 카피를 위해서는 NIC의 scatter-gather 지원이 필요하며, 그렇지 않으면 커널→커널 복사가 한 번 발생함",
      "glossary_snapshot": {
        "NIC": "NIC",
        "scatter-gather": "scatter-gather",
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:36:42.287677Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "splice: pipe-based zero-copy",
      "source_hash": 10535649829172143571,
      "context_hash": 543691560567983933,
      "translation": "splice: 파이프 기반 제로 카피",
      "glossary_snapshot": {
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:36:42.287677Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "`splice()` was introduced in Linux 2.6.17 by Jens Axboe [(commit)](https://git.kernel.org/linus/5274f052e7b3dbd81935772eb551dfd0325dfa9d) [(LWN)](https://lwn.net/Articles/178199/), based on an earlier concept by Larry McVoy.",
      "source_hash": 14784960850812985628,
      "context_hash": 4182708730242259330,
      "translation": "`splice()`는 Larry McVoy의 초기 개념을 바탕으로 Jens Axboe가 Linux 2.6.17에서 도입했습니다[(commit)](https://git.kernel.org/linus/5274f052e7b3dbd81935772eb551dfd0325dfa9d) [(LWN)](https://lwn.net/Articles/178199/).",
      "glossary_snapshot": {
        "LWN": "LWN",
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T23:01:06.781888Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:1",
      "source": "It moves data between a pipe and a file descriptor using page references — no data copying:",
      "source_hash": 17026083098687090569,
      "context_hash": 2281717905663182356,
      "translation": "이는 페이지 참조를 사용하여 파이프와 파일 디스크립터 사이에서 데이터를 이동하며, 데이터 복사는 발생하지 않습니다:",
      "glossary_snapshot": {
        "file descriptor": "파일 디스크립터"
      },
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "At least one of `fd_in` or `fd_out` must be a pipe.",
      "source_hash": 14272438313134158783,
      "context_hash": 12330554516131642357,
      "translation": "`fd_in`과 `fd_out` 중 적어도 하나는 파이프여야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:1",
      "source": "The pipe acts as a staging buffer:",
      "source_hash": 6178154368098845616,
      "context_hash": 17047228443604107130,
      "translation": "파이프는 스테이징 버퍼 역할을 합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "tee: duplicate pipe data",
      "source_hash": 5750814424503298834,
      "context_hash": 5042067932698917474,
      "translation": "tee: 파이프 데이터 복제",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:3/block:6/seg:0",
      "source": "`tee()` duplicates data between two pipes without consuming from the source:",
      "source_hash": 372209657595821227,
      "context_hash": 1859373822357785545,
      "translation": "`tee()`는 원본의 데이터를 소비하지 않고 두 파이프 사이에서 데이터를 복제합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "copy_file_range: kernel-side file copy",
      "source_hash": 6596033024645167975,
      "context_hash": 17937976566191057194,
      "translation": "copy_file_range: 커널 측 파일 복사",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "`copy_file_range()` copies between two files without touching userspace.",
      "source_hash": 675416132937856827,
      "context_hash": 7429389985950463229,
      "translation": "`copy_file_range()`는 사용자 공간을 거치지 않고 두 파일 사이에서 복사를 수행합니다.",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "On modern filesystems it can use **server-side copy** (e.g., NFS, SMB, Btrfs reflinking):",
      "source_hash": 11663116595260831420,
      "context_hash": 3475401217517441246,
      "translation": "최신 파일시스템에서는 **서버 측 복사**(예: NFS, SMB, Btrfs reflink)를 사용할 수 있습니다:",
      "glossary_snapshot": {
        "btrfs": "btrfs"
      },
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "Btrfs reflink",
      "source_hash": 5937073359216530612,
      "context_hash": 8434655328492368448,
      "translation": "Btrfs reflink",
      "glossary_snapshot": {
        "btrfs": "btrfs"
      },
      "translated_at": "2026-11-14T23:01:06.781889Z",
      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "On Btrfs (and XFS with reflink), `copy_file_range` does a **reflink** — the destination shares the same extents as the source with copy-on-write semantics:",
      "source_hash": 16452062602186451905,
      "context_hash": 11660707873833332762,
      "translation": "Btrfs(및 reflink를 사용하는 XFS)에서 `copy_file_range`는 **reflink**를 수행합니다. 즉, 대상이 copy-on-write 시맨틱으로 원본과 동일한 extent를 공유합니다:",
      "glossary_snapshot": {
        "XFS": "XFS",
        "btrfs": "btrfs",
        "copy-on-write": "copy-on-write"
      },
      "translated_at": "2026-11-14T23:01:06.781890Z",
      "issues": []
    },
    {
