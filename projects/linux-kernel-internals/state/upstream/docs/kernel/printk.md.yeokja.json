    {
      "id": "section:3/block:0/seg:0",
      "source": "Circular log buffer",
      "source_hash": 15959278481160668576,
      "context_hash": 5430340640239714752,
      "translation": "순환 로그 버퍼",
      "glossary_snapshot": {},
