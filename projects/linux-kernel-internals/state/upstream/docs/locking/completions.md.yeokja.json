      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "`wait_queue_head_t` is the lower-level primitive that `completion` builds on.",
      "source_hash": 13165313152151694094,
      "context_hash": 16539199464342737006,
      "translation": "`wait_queue_head_t`는 `completion`의 기반이 되는 하위 수준 프리미티브입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:22.227773Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "It supports:",
      "source_hash": 9499769360279523593,
      "context_hash": 12041159242410471129,
      "translation": "다음을 지원합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:02:22.227773Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
