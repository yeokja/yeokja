  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "SRCU: Sleepable RCU",
      "source_hash": 3516368862055835487,
      "context_hash": 6879451109655153826,
      "translation": "SRCU: Sleepable RCU",
      "glossary_snapshot": {
        "RCU": "RCU",
        "SRCU": "SRCU"
      },
      "translated_at": "2026-11-14T22:16:06.212073Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "RCU for read-side critical sections that may block or sleep",
      "source_hash": 13983349841722020022,
      "context_hash": 11431784867362352039,
      "translation": "블록되거나 슬립할 수 있는 읽기 측 임계 구역을 위한 RCU",
      "glossary_snapshot": {
        "RCU": "RCU",
        "critical sections": "임계 구역"
      },
      "translated_at": "2026-11-14T22:16:06.212074Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The problem with classic RCU",
      "source_hash": 4077952921207072920,
      "context_hash": 1081958846081219188,
      "translation": "고전적 RCU의 문제점",
      "glossary_snapshot": {
        "RCU": "RCU"
      },
      "translated_at": "2026-11-14T22:16:06.212074Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Classic RCU (`rcu_read_lock`) has one key constraint: **no sleeping**.",
      "source_hash": 14150500705855724130,
      "context_hash": 3946941039167581544,
      "translation": "고전적 RCU(`rcu_read_lock`)에는 한 가지 핵심 제약이 있습니다. 바로 **슬립 금지**입니다.",
      "glossary_snapshot": {
        "RCU": "RCU"
      },
      "translated_at": "2026-11-14T22:16:06.212074Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The reader must stay in its critical section without blocking:",
      "source_hash": 11528190120341720002,
      "context_hash": 8510861206644912729,
      "translation": "리더는 블록되지 않은 채로 임계 구역 안에 머물러야 합니다.",
      "glossary_snapshot": {
        "critical section": "임계 구역"
      },
      "translated_at": "2026-11-14T22:16:06.212074Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "This rules out many use cases: VFS operations (may take a lock), I/O, memory allocation with GFP_KERNEL, or any operation that might schedule.",
      "source_hash": 13376600871590739396,
      "context_hash": 14076910607048137818,
      "translation": "이 때문에 VFS 연산(락을 잡을 수 있음), I/O, GFP_KERNEL을 사용한 메모리 할당, 또는 스케줄링이 일어날 수 있는 모든 연산 등 많은 사용 사례가 배제됩니다.",
      "glossary_snapshot": {
        "VFS": "VFS",
        "memory allocation": "메모리 할당"
      },
      "translated_at": "2026-11-14T22:16:06.212074Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**SRCU** (Sleepable RCU) allows sleeping inside the read-side critical section.",
      "source_hash": 9129233656386758251,
      "context_hash": 5958241284142084937,
      "translation": "**SRCU**(Sleepable RCU)는 읽기 측 임계 구역 안에서 슬립하는 것을 허용합니다.",
      "glossary_snapshot": {
        "RCU": "RCU",
        "SRCU": "SRCU",
        "critical section": "임계 구역"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:1",
      "source": "The trade-off: SRCU is more expensive than classic RCU (per-CPU counters instead of quiescent state detection).",
      "source_hash": 11076770362369961958,
      "context_hash": 12817935240777982881,
      "translation": "트레이드오프는 SRCU가 고전적 RCU보다 비용이 더 크다는 점입니다(quiescent state 감지 대신 per-CPU 카운터를 사용합니다).",
      "glossary_snapshot": {
        "CPU": "CPU",
        "RCU": "RCU",
        "SRCU": "SRCU",
        "trade-off": "트레이드오프"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "SRCU usage",
      "source_hash": 3866420739631938672,
      "context_hash": 13770285535584831242,
      "translation": "SRCU 사용법",
      "glossary_snapshot": {
        "SRCU": "SRCU"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "struct srcu_struct",
      "source_hash": 3070425953058005251,
      "context_hash": 4738222392999448726,
      "translation": "struct srcu_struct",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "Per-CPU counters: the key difference",
      "source_hash": 5620488753834413604,
      "context_hash": 13484789425585794412,
      "translation": "Per-CPU 카운터: 핵심적인 차이",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Classic RCU tracks quiescent states globally.",
      "source_hash": 4895476598304690333,
      "context_hash": 17659959851092214284,
      "translation": "고전적 RCU는 quiescent state를 전역적으로 추적합니다.",
      "glossary_snapshot": {
        "RCU": "RCU"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:1",
      "source": "SRCU uses per-CPU counters that readers increment/decrement:",
      "source_hash": 16248629753225899605,
      "context_hash": 8654190732029791441,
      "translation": "SRCU는 리더가 증가/감소시키는 per-CPU 카운터를 사용합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "SRCU": "SRCU"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "A grace period completes when `srcu_lock_count[old_idx] == srcu_unlock_count[old_idx]` across all CPUs — meaning all readers that started before the grace period have finished.",
      "source_hash": 17885528026470079812,
      "context_hash": 8085891402915296425,
      "translation": "모든 CPU에 걸쳐 `srcu_lock_count[old_idx] == srcu_unlock_count[old_idx]`이 성립하면 grace period가 완료됩니다. 이는 grace period 이전에 시작된 모든 리더가 끝났다는 의미입니다.",
      "glossary_snapshot": {
        "CPUs": "CPU",
        "grace period": "grace period"
      },
      "translated_at": "2026-11-14T22:16:06.212075Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Expedited SRCU",
      "source_hash": 3863597319991726152,
      "context_hash": 17469891980813565066,
      "translation": "Expedited SRCU",
      "glossary_snapshot": {
        "SRCU": "SRCU"
      },
      "translated_at": "2026-11-14T22:16:06.212076Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "`synchronize_srcu_expedited()` shortens the grace period by actively polling CPUs:",
      "source_hash": 320926900599173085,
      "context_hash": 12161540948708679413,
      "translation": "`synchronize_srcu_expedited()`는 CPU를 능동적으로 폴링하여 grace period를 단축합니다.",
      "glossary_snapshot": {
        "CPUs": "CPU",
        "grace period": "grace period"
      },
      "translated_at": "2026-11-14T22:16:06.212076Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "Use for infrequent, latency-critical updates where waiting is unacceptable.",
      "source_hash": 8248565206864973233,
      "context_hash": 14720424654857466106,
      "translation": "대기를 용납할 수 없고 지연 시간이 중요한, 드물게 일어나는 업데이트에 사용하십시오.",
      "glossary_snapshot": {
        "latency": "지연 시간"
      },
      "translated_at": "2026-11-14T22:16:06.212076Z",
      "issues": []
    },
