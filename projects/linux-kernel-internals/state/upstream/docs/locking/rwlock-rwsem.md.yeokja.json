      "source_hash": 187999444046978506,
      "context_hash": 18141004698570942786,
      "translation": "인터럽트 컨텍스트, 짧은 임계 구역",
      "glossary_snapshot": {
        "critical sections": "임계 구역",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:15:59.207586Z",
      "issues": []
    },
    {
