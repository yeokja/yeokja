  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "rwlock and rwsem",
      "source_hash": 11389104637753765688,
      "context_hash": 14722173357248763117,
      "translation": "rwlock과 rwsem",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207583Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Reader-writer locking — concurrent reads, exclusive writes",
      "source_hash": 13846711938404024741,
      "context_hash": 18109894338113932040,
      "translation": "읽기-쓰기 락 — 동시 읽기, 배타적 쓰기",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207584Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The reader-writer pattern",
      "source_hash": 833972265247327751,
      "context_hash": 10691466549843138255,
      "translation": "읽기-쓰기 패턴",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207584Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Many kernel data structures are read far more often than they are written.",
      "source_hash": 7152571036122301101,
      "context_hash": 12892329037557024783,
      "translation": "많은 커널 자료 구조는 쓰기보다 읽기가 훨씬 더 자주 일어납니다.",
      "glossary_snapshot": {
        "data structures": "자료 구조",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:15:59.207584Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "A plain spinlock or mutex serializes all access, even concurrent reads that don't conflict.",
      "source_hash": 3100513527207429009,
      "context_hash": 17355478183807514593,
      "translation": "일반 스핀락이나 뮤텍스는 서로 충돌하지 않는 동시 읽기까지 포함하여 모든 접근을 직렬화합니다.",
      "glossary_snapshot": {
        "mutex": "뮤텍스",
        "spinlock": "스핀락"
      },
      "translated_at": "2026-11-14T22:15:59.207584Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:2",
      "source": "Reader-writer locks allow multiple simultaneous readers while ensuring writers have exclusive access:",
      "source_hash": 3953709223984035019,
      "context_hash": 6322546145055074806,
      "translation": "읽기-쓰기 락(reader-writer lock)은 여러 reader가 동시에 접근할 수 있게 하면서 writer에게는 배타적 접근을 보장합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207585Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "The kernel provides two reader-writer primitives:",
      "source_hash": 1382699021460943262,
      "context_hash": 7958374052064761395,
      "translation": "커널은 두 가지 읽기-쓰기 프리미티브를 제공합니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:15:59.207585Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "Primitive",
      "source_hash": 14008683227949366466,
      "context_hash": 7562939081193486771,
      "translation": "프리미티브",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207585Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "Sleeps?",
      "source_hash": 7523458887825685794,
      "context_hash": 2518618609704441815,
      "translation": "슬립 여부",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207585Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "IRQ-safe?",
      "source_hash": 16442442994236987942,
      "context_hash": 8914146979486087063,
      "translation": "IRQ 안전 여부",
      "glossary_snapshot": {
        "IRQ": "IRQ"
      },
      "translated_at": "2026-11-14T22:15:59.207585Z",
      "issues": []
    },
    {
      "id": "section:1/block:7/seg:0",
      "source": "Use when",
      "source_hash": 17663801946021758225,
      "context_hash": 12384967342221367299,
      "translation": "사용 시점",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:15:59.207586Z",
      "issues": []
    },
    {
