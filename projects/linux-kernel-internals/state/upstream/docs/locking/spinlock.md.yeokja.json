      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "With `CONFIG_DEBUG_SPINLOCK` and `CONFIG_LOCKDEP`, the kernel detects:",
      "source_hash": 17670554373672492835,
      "context_hash": 5953923730151849583,
      "translation": "`CONFIG_DEBUG_SPINLOCK`과 `CONFIG_LOCKDEP`를 활성화하면 커널은 다음을 탐지합니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:16:12.856396Z",
      "issues": []
    },
    {
      "id": "section:7/block:2/seg:0",
      "source": "Double-locking (taking a lock you already hold)",
      "source_hash": 6482151864968938353,
      "context_hash": 16287344712628815582,
      "translation": "이중 락(이미 보유한 락을 다시 획득)",
