      "source_hash": 17326922434544471074,
      "context_hash": 8928619554038562135,
      "translation": "아니요 (reader가 재시도)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:49:13.758044Z",
      "issues": []
    },
    {
      "id": "section:6/block:10/seg:0",
      "source": "Reader starvation",
      "source_hash": 8421508750179912259,
      "context_hash": 7198772700301491078,
      "translation": "reader 기아(starvation)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T21:49:13.758044Z",
      "issues": []
    },
    {
      "id": "section:6/block:11/seg:0",
      "source": "No",
      "source_hash": 3846534607940335394,
      "context_hash": 17719042893470167238,
      "translation": "아니요",
      "glossary_snapshot": {
        "No": "아니요"
      },
      "translated_at": "2026-11-14T21:49:13.758045Z",
      "issues": []
    },
    {
      "id": "section:6/block:12/seg:0",
