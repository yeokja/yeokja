    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "The kernel provides `rculist.h` for linked lists:",
      "source_hash": 5746446095749972863,
      "context_hash": 1505790798132468574,
      "translation": "커널은 연결 리스트를 위해 `rculist.h`를 제공합니다:",
