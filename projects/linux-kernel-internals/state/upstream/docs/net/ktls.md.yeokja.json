      "translated_at": "2026-11-14T22:35:07.952745Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "The primary use case for kTLS is zero-copy file serving:",
      "source_hash": 7814877374766014860,
      "context_hash": 5935013624150326207,
      "translation": "kTLS의 주요 사용 사례는 제로 카피 파일 제공입니다.",
      "glossary_snapshot": {
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T22:35:07.952745Z",
      "issues": []
    },
