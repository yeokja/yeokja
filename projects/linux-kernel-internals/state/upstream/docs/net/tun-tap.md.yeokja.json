    {
      "id": "section:1/block:0/seg:0",
      "source": "What are TUN and TAP?",
      "source_hash": 5341744424428671413,
      "context_hash": 8018498658687589524,
      "translation": "TUN과 TAP이란 무엇인가",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:44.442743Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "TUN and TAP are virtual network devices implemented entirely in software.",
      "source_hash": 380429280234714188,
      "context_hash": 3368852246354272527,
      "translation": "TUN과 TAP은 전적으로 소프트웨어로 구현된 가상 네트워크 디바이스입니다.",
      "glossary_snapshot": {
        "devices": "디바이스"
      },
      "translated_at": "2026-11-14T22:25:44.442743Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "They let userspace programs **send and receive network traffic** by reading and writing to a file descriptor.",
      "source_hash": 12060124962674859897,
      "context_hash": 14204217893525930896,
      "translation": "이 디바이스를 사용하면 사용자 공간 프로그램이 파일 디스크립터를 읽고 쓰는 방식으로 **네트워크 트래픽을 송수신**할 수 있습니다.",
      "glossary_snapshot": {
        "file descriptor": "파일 디스크립터",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:25:44.442743Z",
      "issues": []
