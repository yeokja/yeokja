    {
      "id": "section:5/block:1/seg:0",
      "source": "WireGuard is implemented as a kernel module that registers its own netdev type (`wireguard`), **not** the generic TUN driver.",
      "source_hash": 16212231140388743805,
      "context_hash": 10693092618212665063,
      "translation": "WireGuard는 범용 TUN 드라이버가 **아니라** 자체 netdev 타입(`wireguard`)을 등록하는 커널 모듈로 구현되어 있습니다.",
      "glossary_snapshot": {
        "driver": "드라이버",
        "kernel module": "커널 모듈"
      },
      "translated_at": "2026-11-14T22:25:44.442744Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "It manages its own net_device directly, bypassing `/dev/net/tun` entirely.",
      "source_hash": 890431907214299654,
      "context_hash": 2721740698474691388,
      "translation": "WireGuard는 자체 net_device를 직접 관리하며, `/dev/net/tun`을 전혀 거치지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:44.442744Z",
      "issues": []
    },
