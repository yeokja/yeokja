    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Set-based matching",
      "source_hash": 1985586637056035364,
      "context_hash": 14583232588058806128,
      "translation": "집합 기반 매칭",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381374Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "This is where nftables shines — efficient matching against large sets:",
      "source_hash": 16491896765623052347,
      "context_hash": 14017630242572553556,
      "translation": "바로 이 부분에서 nftables가 빛을 발합니다 — 대규모 집합에 대한 효율적인 매칭입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381375Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
