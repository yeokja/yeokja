  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "nftables vs iptables",
      "source_hash": 12025191319305660732,
      "context_hash": 15484505782895338101,
      "translation": "nftables 대 iptables",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381368Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "The two Linux packet filtering frontends: differences, migration, and coexistence",
      "source_hash": 5013999974880738634,
      "context_hash": 7065548967842542296,
      "translation": "두 가지 Linux 패킷 필터링 프런트엔드: 차이점, 마이그레이션, 공존",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T23:01:56.381369Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The relationship to Netfilter",
      "source_hash": 5643244111441338876,
      "context_hash": 7174257435974592593,
      "translation": "Netfilter와의 관계",
      "glossary_snapshot": {
        "Netfilter": "Netfilter"
      },
      "translated_at": "2026-11-14T23:01:56.381370Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Both `iptables` and `nftables` are **userspace tools** that install rules into the kernel's Netfilter framework.",
      "source_hash": 16344275746385773055,
      "context_hash": 1273055211376779004,
      "translation": "`iptables`와 `nftables`는 모두 커널의 Netfilter 프레임워크에 규칙을 설치하는 **사용자 공간 도구**입니다.",
      "glossary_snapshot": {
        "Netfilter": "Netfilter",
        "kernel": "커널",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T23:01:56.381370Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The difference is in which kernel module processes those rules:",
      "source_hash": 2160118840124232856,
      "context_hash": 6247960611914722751,
      "translation": "차이점은 어떤 커널 모듈이 그 규칙을 처리하느냐에 있습니다.",
      "glossary_snapshot": {
        "kernel module": "커널 모듈"
      },
      "translated_at": "2026-11-14T23:01:56.381371Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**iptables** → `ip_tables` kernel module (legacy, per-table modules)",
      "source_hash": 8255762067781031491,
      "context_hash": 6344270205277477455,
      "translation": "**iptables** → `ip_tables` 커널 모듈 (레거시, 테이블별 모듈)",
      "glossary_snapshot": {
        "kernel module": "커널 모듈",
        "modules": "모듈"
      },
      "translated_at": "2026-11-14T23:01:56.381371Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**nftables** → `nf_tables` kernel module (unified, modern)",
      "source_hash": 4015826859366214410,
      "context_hash": 13588876764279103196,
      "translation": "**nftables** → `nf_tables` 커널 모듈 (통합형, 최신)",
      "glossary_snapshot": {
        "kernel module": "커널 모듈"
      },
      "translated_at": "2026-11-14T23:01:56.381372Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "The underlying hook mechanism is the same.",
      "source_hash": 14393862219211422841,
      "context_hash": 9696885770852075242,
      "translation": "하부의 훅 메커니즘은 동일합니다.",
      "glossary_snapshot": {
        "hook": "훅"
      },
      "translated_at": "2026-11-14T23:01:56.381372Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:1",
      "source": "What changes is how rules are represented, matched, and applied.",
      "source_hash": 7107213477867149539,
      "context_hash": 164760563748147026,
      "translation": "달라지는 것은 규칙을 표현하고, 매칭하고, 적용하는 방식입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381372Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Why nftables was created",
      "source_hash": 12814282425046293875,
      "context_hash": 14840764899084907918,
      "translation": "nftables가 만들어진 이유",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381372Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "iptables accumulated significant technical debt:",
      "source_hash": 8708637138341815002,
      "context_hash": 1648006385186803214,
      "translation": "iptables에는 상당한 기술 부채가 쌓여 있었습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381373Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "**Separate tools for each family**: `iptables` (IPv4), `ip6tables` (IPv6), `arptables`, `ebtables` — each with its own codebase",
      "source_hash": 2247503506437953692,
      "context_hash": 6626945044576486393,
      "translation": "**패밀리별로 분리된 도구**: `iptables` (IPv4), `ip6tables` (IPv6), `arptables`, `ebtables` — 각각 자체 코드베이스를 가짐",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381373Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "**Linear rule scanning**: Every packet scans every rule in a chain",
      "source_hash": 13996036036357450418,
      "context_hash": 9036685693176227139,
      "translation": "**선형 규칙 탐색**: 모든 패킷이 체인의 모든 규칙을 탐색함",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381373Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "**No atomic updates**: Adding a rule requires re-applying the entire ruleset via `iptables-restore`",
      "source_hash": 6560098228738244404,
      "context_hash": 12156815290848578089,
      "translation": "**원자적 업데이트 불가**: 규칙 하나를 추가하려 해도 `iptables-restore`로 전체 규칙 집합을 다시 적용해야 함",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381373Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "**Poor set support**: Matching against large IP lists requires thousands of rules or `ipset` extension",
      "source_hash": 8205808634620906950,
      "context_hash": 8170543237935330595,
      "translation": "**빈약한 집합(set) 지원**: 대규모 IP 목록과 매칭하려면 수천 개의 규칙이나 `ipset` 확장이 필요함",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T23:01:56.381374Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
      "source": "nftables (merged in Linux 3.13) solves all of these with a single unified framework.",
      "source_hash": 5354315269126903736,
      "context_hash": 9876297159307211189,
      "translation": "nftables(Linux 3.13에서 병합됨)는 하나의 통합 프레임워크로 이 모든 문제를 해결합니다.",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T23:01:56.381374Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Side-by-side comparison",
      "source_hash": 13550176203212627709,
