  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Life of a Packet (Transmit Path)",
      "source_hash": 650755633194850802,
      "context_hash": 13855729345130145235,
      "translation": "패킷의 일생 (송신 경로)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931925Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "From application write() to NIC DMA, step by step",
      "source_hash": 8302981189227022503,
      "context_hash": 4510227548690807596,
      "translation": "애플리케이션 write()부터 NIC DMA까지 단계별 설명",
      "glossary_snapshot": {
        "DMA": "DMA",
        "NIC": "NIC"
      },
      "translated_at": "2026-11-14T22:38:52.931925Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Overview",
      "source_hash": 11777448466030057203,
      "context_hash": 12457864879321575433,
      "translation": "개요",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931926Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "When an application writes data to a TCP socket, the kernel turns that data into one or more IP packets and transmits them.",
      "source_hash": 14708554488177745493,
      "context_hash": 6814109771354908219,
      "translation": "애플리케이션이 TCP 소켓에 데이터를 쓰면 커널은 그 데이터를 하나 이상의 IP 패킷으로 만들어 송신합니다.",
      "glossary_snapshot": {
        "TCP": "TCP",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:38:52.931926Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "The path from `write()` to wire:",
      "source_hash": 16876788738684701705,
      "context_hash": 15844195665689207806,
      "translation": "`write()`에서 회선까지의 경로는 다음과 같습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931926Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Phase 1: tcp_sendmsg() — data from userspace",
      "source_hash": 3125489655505161838,
      "context_hash": 269649554250924271,
      "translation": "1단계: tcp_sendmsg() — 사용자 공간에서 온 데이터",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:38:52.931926Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "Data is held in `sk->sk_write_queue` until TCP decides to send it.",
      "source_hash": 4093008902143650271,
      "context_hash": 17360799591009966818,
      "translation": "데이터는 TCP가 송신을 결정할 때까지 `sk->sk_write_queue`에 보관됩니다.",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:38:52.931927Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Phase 2: TCP write: tcp_write_xmit()",
      "source_hash": 14966592079642534595,
      "context_hash": 13397059264433873284,
      "translation": "2단계: TCP 쓰기: tcp_write_xmit()",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:38:52.931927Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "TCP decides *when* to send based on:",
      "source_hash": 13381266365922762724,
      "context_hash": 16611594546479841145,
      "translation": "TCP는 다음을 기준으로 *언제* 송신할지 결정합니다.",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:38:52.931927Z",
      "issues": []
    },
    {
      "id": "section:3/block:2/seg:0",
      "source": "Congestion window (`tp->snd_cwnd`)",
      "source_hash": 6205374087850902814,
      "context_hash": 14001589573064631627,
      "translation": "혼잡 윈도(`tp->snd_cwnd`)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931928Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Receive window advertised by peer (`tp->snd_wnd`)",
      "source_hash": 17508211359245023599,
      "context_hash": 9030027762241198973,
      "translation": "상대방이 알린 수신 윈도(`tp->snd_wnd`)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931928Z",
      "issues": []
    },
    {
      "id": "section:3/block:4/seg:0",
      "source": "Nagle algorithm (delay small packets)",
      "source_hash": 3986828911075022158,
      "context_hash": 1020312297107888080,
      "translation": "Nagle 알고리즘(작은 패킷 지연)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931928Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "Send buffer availability",
      "source_hash": 10128268927696295979,
      "context_hash": 7662417439286347244,
      "translation": "송신 버퍼 가용성",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931928Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "Phase 3: Build TCP header — tcp_transmit_skb()",
      "source_hash": 3365827542579896041,
      "context_hash": 12244640093667854483,
      "translation": "3단계: TCP 헤더 구성 — tcp_transmit_skb()",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:38:52.931928Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Phase 4: IP layer — ip_queue_xmit()",
      "source_hash": 5304466210136037831,
      "context_hash": 16439084400140163440,
      "translation": "4단계: IP 계층 — ip_queue_xmit()",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Phase 5: Netfilter OUTPUT and routing",
      "source_hash": 13234810305455518279,
      "context_hash": 5955630689416955429,
      "translation": "5단계: Netfilter OUTPUT과 라우팅",
      "glossary_snapshot": {
        "Netfilter": "Netfilter"
      },
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "`dst_output()` calls `ip_output()`:",
      "source_hash": 5194395204827650454,
      "context_hash": 9579095988561931896,
      "translation": "`dst_output()`은 `ip_output()`을 호출합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Phase 6: ARP and Ethernet — neigh_output()",
      "source_hash": 3906913888458222738,
      "context_hash": 113604283498336482,
      "translation": "6단계: ARP와 이더넷 — neigh_output()",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "`ip_finish_output2()` resolves the next-hop MAC address:",
      "source_hash": 7310062147228829406,
      "context_hash": 4956676326035369300,
      "translation": "`ip_finish_output2()`는 다음 홉의 MAC 주소를 확인합니다.",
      "glossary_snapshot": {
        "address": "주소"
      },
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "If the ARP entry doesn't exist, an ARP request is sent and the packet is queued until the reply arrives.",
      "source_hash": 4631179245663727330,
      "context_hash": 4912749078834485349,
      "translation": "ARP 항목이 없으면 ARP 요청을 보내고, 응답이 도착할 때까지 패킷을 큐에 넣어 둡니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:8/block:0/seg:0",
      "source": "Phase 7: Traffic control — dev_queue_xmit()",
      "source_hash": 11657594926200078518,
      "context_hash": 16333414585819627282,
      "translation": "7단계: 트래픽 제어 — dev_queue_xmit()",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931929Z",
      "issues": []
    },
    {
      "id": "section:8/block:2/seg:0",
      "source": "The qdisc can:",
      "source_hash": 17247492504036095565,
      "context_hash": 13546827648440098478,
      "translation": "qdisc는 다음을 할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:8/block:3/seg:0",
      "source": "Drop packets (rate limiting via TBF, policing)",
      "source_hash": 7076670932902249947,
      "context_hash": 14475861932095585450,
      "translation": "패킷 드롭(TBF를 통한 속도 제한, 폴리싱)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:8/block:4/seg:0",
      "source": "Reorder packets (FQ scheduling)",
      "source_hash": 1407720610067132175,
      "context_hash": 12455033670398546462,
      "translation": "패킷 재정렬(FQ 스케줄링)",
      "glossary_snapshot": {
        "scheduling": "스케줄링"
      },
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:8/block:5/seg:0",
      "source": "Delay packets (netem for testing)",
      "source_hash": 8285625887000102343,
      "context_hash": 10821680867616609522,
      "translation": "패킷 지연(테스트용 netem)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:8/block:6/seg:0",
      "source": "Shape traffic (HTB, TBF)",
      "source_hash": 11441448560293767031,
      "context_hash": 10246341271464218661,
      "translation": "트래픽 셰이핑(HTB, TBF)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:9/block:0/seg:0",
      "source": "Phase 8: Driver DMA — ndo_start_xmit()",
      "source_hash": 3048288387681795705,
      "context_hash": 10861150194839157608,
      "translation": "8단계: 드라이버 DMA — ndo_start_xmit()",
      "glossary_snapshot": {
        "DMA": "DMA",
        "driver": "드라이버"
      },
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:9/block:2/seg:0",
      "source": "After the NIC transmits the packet, it generates a TX completion interrupt.",
      "source_hash": 8137182123403007686,
      "context_hash": 3640873744648911270,
      "translation": "NIC는 패킷을 송신한 후 TX 완료 인터럽트를 발생시킵니다.",
      "glossary_snapshot": {
        "NIC": "NIC",
        "interrupt": "인터럽트"
      },
      "translated_at": "2026-11-14T22:38:52.931930Z",
      "issues": []
    },
    {
      "id": "section:9/block:2/seg:1",
      "source": "The driver then calls `dev_consume_skb_any(skb)` to free the `sk_buff`.",
      "source_hash": 7852901562947887590,
      "context_hash": 11724334974085097288,
      "translation": "그러면 드라이버는 `dev_consume_skb_any(skb)`를 호출하여 `sk_buff`를 해제합니다.",
      "glossary_snapshot": {
        "driver": "드라이버"
      },
      "translated_at": "2026-11-14T22:38:52.931931Z",
      "issues": []
    },
    {
      "id": "section:10/block:0/seg:0",
      "source": "TX completion and write space wakeup",
      "source_hash": 7644858447520324431,
      "context_hash": 866333889547200929,
      "translation": "TX 완료와 쓰기 공간 wakeup",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931931Z",
      "issues": []
    },
    {
      "id": "section:10/block:2/seg:0",
      "source": "`netif_wake_queue()` eventually calls `sk->sk_write_space(sk)`, waking any task blocked in `sendmsg()` waiting for send buffer space.",
      "source_hash": 17470865941520345631,
      "context_hash": 15857030656843208472,
      "translation": "`netif_wake_queue()`는 결국 `sk->sk_write_space(sk)`를 호출하여, 송신 버퍼 공간을 기다리며 `sendmsg()`에서 블록된 태스크를 깨웁니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931931Z",
      "issues": []
    },
    {
      "id": "section:11/block:0/seg:0",
      "source": "Send buffer and backpressure",
      "source_hash": 7448033669820772438,
      "context_hash": 1650438333649028304,
      "translation": "송신 버퍼와 백프레셔",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:52.931931Z",
      "issues": []
    },
    {
      "id": "section:11/block:1/seg:0",
      "source": "The kernel won't copy more data than the send buffer allows:",
      "source_hash": 12148343386517460540,
      "context_hash": 13324171821974269024,
      "translation": "커널은 송신 버퍼가 허용하는 양보다 많은 데이터를 복사하지 않습니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:08:23.110255Z",
      "issues": []
    },
    {
      "id": "section:11/block:3/seg:0",
      "source": "If `sk->sk_wmem_alloc >= sk->sk_sndbuf`, `tcp_sendmsg()` blocks until TX completions free up space.",
      "source_hash": 13444512752675826838,
      "context_hash": 18159392094195604998,
      "translation": "`sk->sk_wmem_alloc >= sk->sk_sndbuf`이면 `tcp_sendmsg()`는 TX 완료로 공간이 확보될 때까지 블록됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:08:23.110256Z",
      "issues": []
    },
    {
      "id": "section:12/block:0/seg:0",
      "source": "Further reading",
      "source_hash": 12384514314644059922,
      "context_hash": 14358192160231158977,
      "translation": "더 읽을거리",
      "glossary_snapshot": {
        "Further reading": "더 읽을거리"
      },
      "translated_at": "2026-11-14T22:08:23.110257Z",
      "issues": []
    },
