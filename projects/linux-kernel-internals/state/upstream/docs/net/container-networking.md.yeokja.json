{
  "version": 1,
  "source_hash": 5247742710673223176,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Container Networking",
      "source_hash": 3405302155436308084,
      "context_hash": 16068572590604904145,
      "translation": "컨테이너 네트워킹",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784670Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "How Docker, Kubernetes, and container runtimes implement network isolation",
      "source_hash": 16541782798539209312,
      "context_hash": 18331745080718117592,
      "translation": "Docker, Kubernetes 및 컨테이너 런타임이 네트워크 격리를 구현하는 방식",
      "glossary_snapshot": {
        "Kubernetes": "Kubernetes",
        "container runtime": "컨테이너 런타임"
      },
      "translated_at": "2026-11-14T22:54:43.784671Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "The building blocks",
      "source_hash": 16872620026335838813,
      "context_hash": 6136257777115848586,
      "translation": "구성 요소",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784671Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Container networking is built from three Linux primitives:",
      "source_hash": 1600408266476305791,
      "context_hash": 5768577110960165778,
      "translation": "컨테이너 네트워킹은 세 가지 Linux 기본 요소로 구성됩니다.",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:54:43.784671Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "**Network namespaces** — isolated network stacks (interfaces, routes, iptables)",
      "source_hash": 2458522488107303729,
      "context_hash": 13097843902333704354,
      "translation": "**네트워크 네임스페이스** — 격리된 네트워크 스택(인터페이스, 라우팅, iptables)",
      "glossary_snapshot": {
        "namespace": "네임스페이스",
        "network stack": "네트워크 스택"
      },
      "translated_at": "2026-11-14T22:54:43.784671Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "**veth pairs** — virtual Ethernet cable connecting two namespaces",
      "source_hash": 9424714887246293955,
      "context_hash": 17189122358942700933,
      "translation": "**veth 쌍** — 두 네임스페이스를 연결하는 가상 이더넷 케이블",
      "glossary_snapshot": {
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T22:54:43.784671Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**Linux bridge** — software switch connecting veth pairs",
      "source_hash": 11919094055949811404,
      "context_hash": 1053383055323177009,
      "translation": "**Linux 브리지** — veth 쌍을 연결하는 소프트웨어 스위치",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:54:43.784672Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "veth pairs",
      "source_hash": 14154358442117941858,
      "context_hash": 3762579214810532220,
      "translation": "veth 쌍",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784672Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "A veth pair is two virtual interfaces connected back-to-back.",
      "source_hash": 2584386877509863196,
      "context_hash": 16033831731682480952,
      "translation": "veth 쌍은 서로 맞물려 연결된 두 개의 가상 인터페이스입니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784672Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "Packets sent to one end emerge from the other:",
      "source_hash": 1970301949599580923,
      "context_hash": 9468016625190463120,
      "translation": "한쪽 끝으로 보낸 패킷은 다른 쪽 끝에서 나옵니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784672Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "veth in the kernel",
      "source_hash": 5762088783834755572,
      "context_hash": 8283893433289298134,
      "translation": "커널의 veth",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:54:43.784672Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "No actual hardware involved — packets cross from one namespace to another via `netif_rx()`.",
      "source_hash": 10896751355967359290,
      "context_hash": 10384122645990062976,
      "translation": "실제 하드웨어는 관여하지 않으며, 패킷은 `netif_rx()`를 통해 한 네임스페이스에서 다른 네임스페이스로 넘어갑니다.",
      "glossary_snapshot": {
        "hardware": "하드웨어",
        "namespace": "네임스페이스"
      },
      "translated_at": "2026-11-14T22:54:43.784672Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Linux bridge",
      "source_hash": 10054120971080400370,
      "context_hash": 9132783412038294036,
      "translation": "Linux 브리지",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "The bridge acts as a software L2 switch. veth host-side interfaces are attached as bridge ports:",
      "source_hash": 9884098789162875136,
      "context_hash": 14346353833194597294,
      "translation": "브리지는 소프트웨어 L2 스위치 역할을 합니다. 호스트 쪽 veth 인터페이스는 브리지 포트로 연결됩니다.",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Bridge forwarding",
      "source_hash": 14123960854334138320,
      "context_hash": 6605678023706433483,
      "translation": "브리지 포워딩",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:3/block:5/seg:0",
      "source": "The bridge maintains a MAC→port forwarding database (FDB), learning from incoming packets. `bridge fdb show` displays it.",
      "source_hash": 1645684736613327983,
      "context_hash": 4162358493940496298,
      "translation": "브리지는 들어오는 패킷으로부터 학습하여 MAC→포트 포워딩 데이터베이스(FDB)를 유지합니다. `bridge fdb show`로 이를 확인할 수 있습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "NAT / masquerade",
      "source_hash": 5683279856201334819,
      "context_hash": 1496903445092495155,
      "translation": "NAT / masquerade",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "Containers need to reach the internet.",
      "source_hash": 6651329688089342333,
      "context_hash": 11510387205517422218,
      "translation": "컨테이너는 인터넷에 접근할 수 있어야 합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "The host NATs outgoing traffic:",
      "source_hash": 13641434304682211240,
      "context_hash": 13013415511271894365,
      "translation": "호스트는 나가는 트래픽에 NAT를 적용합니다.",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "When container `172.17.0.2` sends to `8.8.8.8`:",
      "source_hash": 814092479504012950,
      "context_hash": 8001286442950242622,
      "translation": "컨테이너 `172.17.0.2`가 `8.8.8.8`로 패킷을 보내는 경우:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "Packet leaves container via `eth0` → veth → bridge → host routing",
      "source_hash": 18240686222516008079,
      "context_hash": 4660697550803120911,
      "translation": "패킷이 `eth0`을 통해 컨테이너를 떠남 → veth → 브리지 → 호스트 라우팅",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "Host sees source `172.17.0.2` → matches MASQUERADE rule",
      "source_hash": 5022707320322397330,
      "context_hash": 8092115749774074758,
      "translation": "호스트가 출발지 `172.17.0.2`를 확인 → MASQUERADE 규칙과 일치",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:0",
      "source": "Connection tracking records the mapping: `172.17.0.2:54321 → host_ip:RANDOM`",
      "source_hash": 17777614068504118340,
      "context_hash": 17602257427510524002,
      "translation": "연결 추적(connection tracking)이 매핑을 기록: `172.17.0.2:54321 → host_ip:RANDOM`",
      "glossary_snapshot": {
        "mapping": "매핑"
      },
      "translated_at": "2026-11-14T22:54:43.784673Z",
      "issues": []
    },
    {
      "id": "section:4/block:7/seg:0",
      "source": "Source IP rewritten to host IP",
      "source_hash": 10737025744854718067,
      "context_hash": 16439008352820651416,
      "translation": "출발지 IP를 호스트 IP로 재작성",
      "glossary_snapshot": {
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:4/block:8/seg:0",
      "source": "Reply comes back to host IP → conntrack → translated back → forwarded to container",
      "source_hash": 11584430665125876351,
      "context_hash": 7028539170703881222,
      "translation": "응답이 호스트 IP로 돌아옴 → conntrack → 역변환 → 컨테이너로 전달",
      "glossary_snapshot": {
        "conntrack": "conntrack",
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Port publishing",
      "source_hash": 8525850958249897490,
      "context_hash": 18092586984966215674,
      "translation": "포트 게시",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:6/block:0/seg:0",
      "source": "Overlay networks (VXLAN)",
      "source_hash": 6807380233005825770,
      "context_hash": 12378864143770199074,
      "translation": "오버레이 네트워크(VXLAN)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:6/block:1/seg:0",
      "source": "For multi-host container networking (Kubernetes, Docker Swarm), overlay networks encapsulate container traffic in UDP/VXLAN:",
      "source_hash": 15258531375065775369,
      "context_hash": 12791559622478900256,
      "translation": "다중 호스트 컨테이너 네트워킹(Kubernetes, Docker Swarm)에서는 오버레이 네트워크가 컨테이너 트래픽을 UDP/VXLAN으로 캡슐화합니다.",
      "glossary_snapshot": {
        "Kubernetes": "Kubernetes",
        "UDP": "UDP",
        "host": "호스트"
      },
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:6/block:4/seg:0",
      "source": "VXLAN in the kernel",
      "source_hash": 6752473018463376130,
      "context_hash": 2137435476945572926,
      "translation": "커널의 VXLAN",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:7/block:0/seg:0",
      "source": "Network policies (iptables vs eBPF)",
      "source_hash": 17376049240657473463,
      "context_hash": 6323187820668753127,
      "translation": "네트워크 정책(iptables 대 eBPF)",
      "glossary_snapshot": {
        "eBPF": "eBPF",
        "policies": "정책"
      },
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "Traditional container firewalling uses iptables rules inserted by the runtime.",
      "source_hash": 9165632859203969047,
      "context_hash": 9262812343819827464,
      "translation": "전통적인 컨테이너 방화벽은 런타임이 삽입한 iptables 규칙을 사용합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:7/block:1/seg:1",
      "source": "For thousands of pods, this becomes a bottleneck (O(n) rule traversal):",
      "source_hash": 6455302279997244134,
      "context_hash": 6877161291998908842,
      "translation": "Pod가 수천 개에 이르면 이것이 병목이 됩니다(O(n) 규칙 순회).",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:43.784674Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "Cilium and other eBPF-based CNI plugins (Calico with eBPF, Flannel with VXLAN-on-eBPF) replace iptables with BPF maps — constant-time lookups regardless of rule count.",
      "source_hash": 79676695123015087,
      "context_hash": 10866538027882041340,
      "translation": "Cilium을 비롯한 eBPF 기반 CNI 플러그인(eBPF를 사용하는 Calico, VXLAN-on-eBPF를 사용하는 Flannel)은 iptables를 BPF 맵으로 대체하여 규칙 수와 관계없이 상수 시간 조회를 제공합니다.",
      "glossary_snapshot": {
        "BPF": "BPF",
        "eBPF": "eBPF"
      },
      "translated_at": "2026-11-14T22:08:01.310583Z",
      "issues": []
    },
    {
      "id": "section:8/block:0/seg:0",
      "source": "Observing container networking",
      "source_hash": 4444128019447461970,
      "context_hash": 3172637606143433793,
      "translation": "컨테이너 네트워킹 관찰",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:08:01.310585Z",
      "issues": []
    },
    {
      "id": "section:9/block:0/seg:0",
      "source": "Further reading",
