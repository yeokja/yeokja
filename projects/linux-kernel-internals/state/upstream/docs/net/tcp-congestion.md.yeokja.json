  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "TCP Congestion Control",
      "source_hash": 5278844537645177090,
      "context_hash": 2571953272279139526,
      "translation": "TCP 혼잡 제어",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:25:38.810193Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "How the kernel decides how fast to send: CUBIC, BBR, and the cc_ops interface",
      "source_hash": 12249952257725535183,
      "context_hash": 9717609532319650158,
      "translation": "커널이 전송 속도를 결정하는 방식: CUBIC, BBR, 그리고 cc_ops 인터페이스",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:25:38.810193Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What congestion control does",
      "source_hash": 11761337203081254113,
      "context_hash": 11631300888332229439,
      "translation": "혼잡 제어의 역할",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810193Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "TCP congestion control governs the **congestion window (cwnd)** — the maximum number of unacknowledged bytes in flight:",
      "source_hash": 4521228185449541228,
      "context_hash": 8187727174660483639,
      "translation": "TCP 혼잡 제어는 전송 중이면서 아직 확인 응답을 받지 못한 바이트의 최대 개수인 **혼잡 윈도**(cwnd)를 관리합니다:",
      "glossary_snapshot": {
        "TCP": "TCP",
        "byte": "바이트"
      },
      "translated_at": "2026-11-14T22:25:38.810193Z",
      "issues": []
    },
    {
      "id": "section:1/block:3/seg:0",
      "source": "The congestion controller runs on the sender and responds to:",
      "source_hash": 1759100061832484112,
      "context_hash": 14942259675538135287,
      "translation": "혼잡 컨트롤러는 송신 측에서 실행되며 다음에 반응합니다:",
      "glossary_snapshot": {
        "controller": "컨트롤러"
      },
      "translated_at": "2026-11-14T23:31:26.776544Z",
      "issues": []
    },
    {
      "id": "section:1/block:4/seg:0",
      "source": "**ACK received**: increase cwnd (network has capacity)",
      "source_hash": 17215570107208160334,
      "context_hash": 17712852059464922572,
      "translation": "**ACK 수신**: cwnd 증가(네트워크에 여유 용량이 있음)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:1/block:5/seg:0",
      "source": "**Loss detected**: decrease cwnd (congestion)",
      "source_hash": 7963958684833711044,
      "context_hash": 14125186184267307236,
      "translation": "**손실 감지**: cwnd 감소(혼잡)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:1/block:6/seg:0",
      "source": "**ECN (Explicit Congestion Notification)**: decrease cwnd before loss",
      "source_hash": 13912728260230979976,
      "context_hash": 4931584333832416820,
      "translation": "**ECN(Explicit Congestion Notification)**: 손실 전에 cwnd 감소",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "struct tcp_congestion_ops: the cc interface",
      "source_hash": 15248249574678428646,
      "context_hash": 175125763940484850,
      "translation": "struct tcp_congestion_ops: cc 인터페이스",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "All congestion control algorithms implement this interface:",
      "source_hash": 9298187672009679378,
      "context_hash": 1296090671573009867,
      "translation": "모든 혼잡 제어 알고리즘은 이 인터페이스를 구현합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Registering an algorithm",
      "source_hash": 18332496678077193617,
      "context_hash": 11250969681482697691,
      "translation": "알고리즘 등록",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:2/block:5/seg:0",
      "source": "Per-socket congestion control data",
      "source_hash": 8893729814969795971,
      "context_hash": 15748161649620080575,
      "translation": "소켓별 혼잡 제어 데이터",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
      "source": "Each socket has `ICSK_CA_PRIV_SIZE` bytes (128 bytes = 16 × u64) for algorithm-specific state:",
      "source_hash": 2885714883932758359,
      "context_hash": 17005043437123051593,
      "translation": "각 소켓에는 알고리즘별 상태를 위한 `ICSK_CA_PRIV_SIZE` 바이트(128바이트 = 16 × u64)가 있습니다:",
      "glossary_snapshot": {
        "byte": "바이트"
      },
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "TCP Reno: the baseline",
      "source_hash": 6749124149362029516,
      "context_hash": 10815792039834598063,
      "translation": "TCP Reno: 기준선",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "Reno is the simplest correct algorithm, required by all TCP implementations:",
      "source_hash": 8397131918021363122,
      "context_hash": 11386860357514445180,
      "translation": "Reno는 모든 TCP 구현에 요구되는 가장 단순하면서도 올바른 알고리즘입니다:",
      "glossary_snapshot": {
        "TCP": "TCP"
      },
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:0/seg:0",
      "source": "CUBIC: the Linux default",
      "source_hash": 12331322340268801141,
      "context_hash": 12066753103450764419,
      "translation": "CUBIC: Linux 기본값",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "CUBIC replaces the linear increase of Reno with a **cubic function** of time since the last congestion event.",
      "source_hash": 10065640544991663832,
      "context_hash": 8602317823319994341,
      "translation": "CUBIC은 Reno의 선형 증가를 마지막 혼잡 이벤트 이후 경과한 시간의 **3차 함수**로 대체합니다.",
      "glossary_snapshot": {
        "function": "함수"
      },
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "This allows much faster window growth at high bandwidth-delay products.",
      "source_hash": 9498673474553886249,
      "context_hash": 266257142235083272,
      "translation": "이를 통해 대역폭-지연 곱이 큰 환경에서 윈도를 훨씬 빠르게 키울 수 있습니다.",
      "glossary_snapshot": {
        "bandwidth": "대역폭"
      },
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:3/seg:0",
      "source": "The cubic shape means CUBIC:",
      "source_hash": 6965375676851115746,
      "context_hash": 4770284353837636213,
      "translation": "3차 함수 형태로 인해 CUBIC은 다음과 같이 동작합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:4/seg:0",
      "source": "Grows quickly far below Wmax (catching up after loss)",
      "source_hash": 9763087556426384321,
      "context_hash": 16314546168676612920,
      "translation": "Wmax보다 훨씬 낮을 때 빠르게 증가(손실 이후 따라잡기)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:5/seg:0",
      "source": "Slows near Wmax (probing carefully)",
      "source_hash": 382213455403908024,
      "context_hash": 8593676252070721348,
      "translation": "Wmax 근처에서 감속(신중한 탐색)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810194Z",
      "issues": []
    },
    {
      "id": "section:4/block:6/seg:0",
      "source": "Overshoots if Wmax was limited by receiver",
      "source_hash": 7410704561723565575,
      "context_hash": 16480084289739517321,
      "translation": "Wmax가 수신 측에 의해 제한된 경우 초과",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:4/block:8/seg:0",
      "source": "HyStart++: safe slow start exit",
      "source_hash": 5516798050421160529,
      "context_hash": 15937796994656990167,
      "translation": "HyStart++: 안전한 slow start 종료",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:4/block:9/seg:0",
      "source": "CUBIC uses HyStart to exit slow start before actual loss:",
      "source_hash": 12088038560001321889,
      "context_hash": 13945878441463053266,
      "translation": "CUBIC은 실제 손실이 발생하기 전에 slow start를 종료하기 위해 HyStart를 사용합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:4/block:10/seg:0",
      "source": "**Delay increase**: exit when RTT increases by more than a threshold (ACK train delay)",
      "source_hash": 14751531816758300174,
      "context_hash": 6356831570171226999,
      "translation": "**지연 증가**: RTT가 임계값 이상 증가하면 종료(ACK train 지연)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:4/block:11/seg:0",
      "source": "**ACK train end**: exit when ACK spacing shows the pipe is full",
      "source_hash": 1774327168332282281,
      "context_hash": 17693405816305851256,
      "translation": "**ACK train 종료**: ACK 간격이 파이프가 가득 찼음을 보여 주면 종료",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "BBR: bandwidth-based congestion control",
      "source_hash": 12482600456648903672,
      "context_hash": 14334036895311464649,
      "translation": "BBR: 대역폭 기반 혼잡 제어",
      "glossary_snapshot": {
        "bandwidth": "대역폭"
      },
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "BBR (Bottleneck Bandwidth and Round-trip propagation time) takes a fundamentally different approach: instead of reacting to **loss**, it estimates **bandwidth** and **RTT** to set the sending rate directly.",
      "source_hash": 9280597083512064970,
      "context_hash": 5799656916671798635,
      "translation": "BBR(Bottleneck Bandwidth and Round-trip propagation time)은 근본적으로 다른 접근 방식을 취합니다. **손실**에 반응하는 대신 **대역폭**과 **RTT**를 추정하여 전송 속도를 직접 설정합니다.",
      "glossary_snapshot": {
        "bandwidth": "대역폭"
      },
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "BBR pacing",
      "source_hash": 3326651775096226974,
      "context_hash": 403520852113139641,
      "translation": "BBR 페이싱",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
      "source": "BBR uses **pacing** (spreading packets evenly over time) rather than bursting:",
      "source_hash": 6671462739902374246,
      "context_hash": 2276111648626252838,
      "translation": "BBR은 버스트 전송 대신 **페이싱**(패킷을 시간에 걸쳐 고르게 분산)을 사용합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
      "id": "section:5/block:7/seg:0",
      "source": "TCP pacing is implemented by the packet scheduler (FQ/fq_codel qdisc) or via hrtimers if no pacing qdisc is present.",
      "source_hash": 5603235806829320106,
      "context_hash": 8850112083121861004,
      "translation": "TCP 페이싱은 패킷 스케줄러(FQ/fq_codel qdisc)가 구현하며, 페이싱 qdisc가 없으면 hrtimer를 통해 구현됩니다.",
      "glossary_snapshot": {
        "TCP": "TCP",
        "hrtimer": "hrtimer",
        "scheduler": "스케줄러"
      },
      "translated_at": "2026-11-14T22:25:38.810195Z",
      "issues": []
    },
    {
