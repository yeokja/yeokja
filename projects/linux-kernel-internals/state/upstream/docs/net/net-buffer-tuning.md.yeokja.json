    },
    {
      "id": "section:4/block:1/seg:0",
      "source": "The kernel's per-CPU receive backlog (`sd->input_pkt_queue`) sits between NAPI and protocol processing.",
      "source_hash": 14489562985025019727,
      "context_hash": 12378233662926211378,
      "translation": "커널의 CPU별 수신 backlog(`sd->input_pkt_queue`)는 NAPI와 프로토콜 처리 사이에 위치합니다.",
      "glossary_snapshot": {
        "CPU": "CPU",
        "NAPI": "NAPI",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:25:33.448646Z",
      "issues": []
    },
    {
      "id": "section:4/block:1/seg:1",
      "source": "If it fills, packets are dropped:",
      "source_hash": 3412406460134912258,
      "context_hash": 17309229117832715231,
      "translation": "이 backlog가 가득 차면 패킷이 드롭됩니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:25:33.448646Z",
      "issues": []
    },
