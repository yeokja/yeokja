    {
      "id": "section:5/block:0/seg:0",
      "source": "Connection tracking (conntrack)",
      "source_hash": 7918063745817881323,
      "context_hash": 155930666906492678,
      "translation": "연결 추적(conntrack)",
      "glossary_snapshot": {
        "conntrack": "conntrack"
      },
      "translated_at": "2026-11-14T23:03:06.659756Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "**Conntrack** is the stateful packet inspection layer.",
      "source_hash": 3452659327334680857,
      "context_hash": 9618757621993089518,
      "translation": "**Conntrack**은 상태 기반 패킷 검사(stateful packet inspection) 계층입니다.",
      "glossary_snapshot": {
        "conntrack": "conntrack"
      },
      "translated_at": "2026-11-14T23:03:06.659756Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "It tracks every connection through the kernel, enabling:",
      "source_hash": 8302272974987305235,
      "context_hash": 5779827046743471549,
      "translation": "커널을 통과하는 모든 연결을 추적하며, 이를 통해 다음이 가능합니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T23:03:06.659756Z",
      "issues": []
    },
    {
      "id": "section:5/block:2/seg:0",
      "source": "Stateful firewall rules (`-m state --state ESTABLISHED,RELATED`)",
      "source_hash": 6568997175320270451,
      "context_hash": 31963443647897260,
      "translation": "상태 기반(stateful) 방화벽 규칙 (`-m state --state ESTABLISHED,RELATED`)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:09:17.591265Z",
      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "NAT (both DNAT and SNAT need to rewrite both directions)",
      "source_hash": 17743465264431815341,
      "context_hash": 11241511146451749405,
      "translation": "NAT (DNAT와 SNAT 모두 양방향을 다시 써야 함)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:09:17.591266Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "Connection-aware applications (via NFQUEUE or nf_conntrack events)",
      "source_hash": 8032678578862289617,
      "context_hash": 562265167757081957,
      "translation": "연결 인식(connection-aware) 애플리케이션 (NFQUEUE 또는 nf_conntrack 이벤트를 통해)",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:09:17.591266Z",
      "issues": []
    },
    {
      "id": "section:5/block:5/seg:0",
