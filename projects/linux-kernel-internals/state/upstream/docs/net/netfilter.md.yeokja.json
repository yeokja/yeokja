      "issues": []
    },
    {
      "id": "section:7/block:1/seg:0",
      "source": "At each hook point in the IP stack:",
      "source_hash": 1079252544794896295,
      "context_hash": 2788063565736285976,
      "translation": "IP 스택의 각 훅 지점에서:",
      "glossary_snapshot": {
        "hook": "훅"
      },
      "translated_at": "2026-11-14T23:31:28.216793Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:0",
      "source": "`NF_HOOK` calls each registered hook in priority order.",
      "source_hash": 309901936085258058,
      "context_hash": 16679701456682671128,
      "translation": "`NF_HOOK`은 등록된 각 훅을 우선순위 순서대로 호출합니다.",
      "glossary_snapshot": {
        "hook": "훅"
      },
      "translated_at": "2026-11-14T23:31:28.216793Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:1",
      "source": "If all return `NF_ACCEPT`, `ip_rcv_finish` is called.",
      "source_hash": 16045267362652610052,
      "context_hash": 6304642665679320270,
      "translation": "모든 hook이 `NF_ACCEPT`를 반환하면 `ip_rcv_finish`가 호출됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:09:17.591267Z",
      "issues": []
    },
    {
      "id": "section:7/block:3/seg:2",
      "source": "Any `NF_DROP` stops processing immediately.",
      "source_hash": 6623981441874783942,
      "context_hash": 11541477947574390370,
      "translation": "하나라도 `NF_DROP`을 반환하면 처리가 즉시 중단됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:09:17.591267Z",
      "issues": []
    },
