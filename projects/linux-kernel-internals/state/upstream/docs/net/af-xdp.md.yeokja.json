{
  "version": 1,
  "source_hash": 7047087463710527064,
  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "AF_XDP Sockets",
      "source_hash": 3672608846476377762,
      "context_hash": 8946086069715332705,
      "translation": "AF_XDP 소켓",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:32.051975Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Sending and receiving packets directly to/from userspace with zero copies",
      "source_hash": 7926647617967627020,
      "context_hash": 14266126337381136144,
      "translation": "사용자 공간과 제로 카피로 패킷을 직접 주고받기",
      "glossary_snapshot": {
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:54:32.051975Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "What AF_XDP is",
      "source_hash": 12765458477026248015,
      "context_hash": 4130069157207045609,
      "translation": "AF_XDP란 무엇인가",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "AF_XDP is a socket address family that allows a userspace application to receive packets directly from an XDP program — bypassing the kernel network stack entirely for those packets.",
      "source_hash": 276978020530045437,
      "context_hash": 1925869543314545731,
      "translation": "AF_XDP는 사용자 공간 애플리케이션이 XDP 프로그램으로부터 패킷을 직접 수신할 수 있게 하는 소켓 주소 패밀리로, 해당 패킷에 대해서는 커널 네트워크 스택을 완전히 우회합니다.",
      "glossary_snapshot": {
        "XDP": "XDP",
        "address": "주소",
        "kernel": "커널",
        "network stack": "네트워크 스택",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "A BPF program running in XDP redirects matched packets to an AF_XDP socket, and the application reads them from a shared-memory ring buffer.",
      "source_hash": 4540868447085112681,
      "context_hash": 8985232723447540104,
      "translation": "XDP에서 실행되는 BPF 프로그램이 일치하는 패킷을 AF_XDP 소켓으로 리다이렉트하고, 애플리케이션은 공유 메모리 링 버퍼에서 그 패킷을 읽습니다.",
      "glossary_snapshot": {
        "BPF program": "BPF 프로그램",
        "XDP": "XDP",
        "memory": "메모리",
        "ring buffer": "링 버퍼"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:1/block:2/seg:0",
      "source": "This achieves near-DPDK performance while staying within the kernel security model (no kernel bypass, kernel still owns the hardware).",
      "source_hash": 1363965998420472954,
      "context_hash": 18314204818706616982,
      "translation": "이를 통해 커널 보안 모델 안에 머무르면서도(커널 우회가 없으며, 하드웨어는 여전히 커널이 소유합니다) DPDK에 가까운 성능을 얻습니다.",
      "glossary_snapshot": {
        "hardware": "하드웨어",
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "The architecture",
      "source_hash": 17398127159256995800,
      "context_hash": 15280313228970733151,
      "translation": "아키텍처",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:0",
      "source": "No `sk_buff` is allocated.",
      "source_hash": 4184111110180682085,
      "context_hash": 11483027848239123221,
      "translation": "`sk_buff`는 할당되지 않습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:2/block:2/seg:1",
      "source": "The packet DMA buffer is the same memory that userspace reads.",
      "source_hash": 11096656537037175060,
      "context_hash": 17193070387280392080,
      "translation": "패킷 DMA 버퍼가 곧 사용자 공간이 읽는 메모리입니다.",
      "glossary_snapshot": {
        "DMA": "DMA",
        "memory": "메모리",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "UMEM: the shared memory region",
      "source_hash": 16522560731837165627,
      "context_hash": 7388289124196724169,
      "translation": "UMEM: 공유 메모리 영역",
      "glossary_snapshot": {
        "shared memory": "공유 메모리"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:3/block:1/seg:0",
      "source": "AF_XDP is built around **UMEM** — a userspace-allocated memory region divided into fixed-size frames that both the kernel and userspace share:",
      "source_hash": 12597441354782694660,
      "context_hash": 11230509551028918885,
      "translation": "AF_XDP는 **UMEM**을 중심으로 구성됩니다. UMEM은 사용자 공간이 할당한 메모리 영역으로, 고정 크기 프레임으로 나뉘며 커널과 사용자 공간이 함께 공유합니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "memory": "메모리",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
      "id": "section:3/block:3/seg:0",
      "source": "Four ring buffers mediate ownership of frames between kernel and userspace:",
      "source_hash": 18359833811280100252,
      "context_hash": 17661377422595416918,
      "translation": "네 개의 링 버퍼가 커널과 사용자 공간 사이에서 프레임의 소유권을 중개합니다.",
      "glossary_snapshot": {
        "ring buffer": "링 버퍼",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:54:32.051976Z",
      "issues": []
    },
    {
