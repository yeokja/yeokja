      "issues": []
    },
    {
      "id": "section:5/block:3/seg:0",
      "source": "UMEM frames pinned in memory",
      "source_hash": 7912630521194210371,
      "context_hash": 34132611941309846,
      "translation": "메모리에 고정(pin)된 UMEM 프레임",
      "glossary_snapshot": {
        "memory": "메모리"
      },
      "translated_at": "2026-11-14T22:06:24.623373Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:0",
      "source": "In **copy mode** (`XDP_COPY`), the kernel copies packet data from its internal buffers to UMEM.",
      "source_hash": 5853027379142737551,
      "context_hash": 13605607458445791533,
      "translation": "**copy 모드**(`XDP_COPY`)에서는 커널이 패킷 데이터를 내부 버퍼에서 UMEM으로 복사합니다.",
      "glossary_snapshot": {
        "kernel": "커널"
      },
      "translated_at": "2026-11-14T22:06:24.623374Z",
      "issues": []
    },
    {
      "id": "section:5/block:4/seg:1",
      "source": "Works on any NIC but adds a copy.",
      "source_hash": 5305856408336824691,
      "context_hash": 162169991396791510,
      "translation": "모든 NIC에서 동작하지만 복사가 한 번 추가됩니다.",
      "glossary_snapshot": {
        "NIC": "NIC"
      },
      "translated_at": "2026-11-14T22:06:24.623374Z",
      "issues": []
    },
