      "issues": []
    },
    {
      "id": "section:5/block:0/seg:0",
      "source": "Zero-copy mode",
      "source_hash": 1727385339252585478,
      "context_hash": 11807751061140483027,
      "translation": "제로 카피 모드",
      "glossary_snapshot": {
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:30:19.724830Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:0",
      "source": "In **zero-copy** mode (`XDP_ZEROCOPY`), the NIC DMA-writes packets directly into the UMEM frames.",
      "source_hash": 11749222527118861248,
      "context_hash": 17437916691717515296,
      "translation": "**제로 카피** 모드(`XDP_ZEROCOPY`)에서는 NIC가 패킷을 UMEM 프레임에 직접 DMA로 기록합니다.",
      "glossary_snapshot": {
        "DMA": "DMA",
        "NIC": "NIC",
        "zero-copy": "제로 카피"
      },
      "translated_at": "2026-11-14T23:30:19.724832Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:1",
      "source": "No data copying occurs between NIC, kernel, and userspace.",
      "source_hash": 16171205434658107323,
      "context_hash": 12707868555695689987,
      "translation": "NIC, 커널, 사용자 공간 사이에서 데이터 복사가 전혀 일어나지 않습니다.",
      "glossary_snapshot": {
        "NIC": "NIC",
        "kernel": "커널",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:06:24.623372Z",
      "issues": []
    },
    {
      "id": "section:5/block:1/seg:2",
