    {
      "id": "section:7/block:1/seg:0",
      "source": "AF_XDP (eXpress Data Path socket) moves packets directly to userspace memory without any kernel copying:",
      "source_hash": 18144933864325728325,
      "context_hash": 16110065897397058789,
      "translation": "AF_XDP(eXpress Data Path 소켓)는 커널 복사 없이 패킷을 사용자 공간 메모리로 직접 전달합니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "memory": "메모리",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T22:31:58.879435Z",
      "issues": []
