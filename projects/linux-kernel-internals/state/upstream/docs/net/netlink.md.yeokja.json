      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "Netlink is a socket-based IPC mechanism for communication between userspace and the kernel.",
      "source_hash": 6781783849745435246,
      "context_hash": 9884878153515070157,
      "translation": "Netlink는 사용자 공간과 커널 사이의 통신을 위한 소켓 기반 IPC 메커니즘입니다.",
      "glossary_snapshot": {
        "IPC": "IPC",
        "kernel": "커널",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T23:01:46.369344Z",
      "issues": []
    },
    {
