    {
      "id": "section:1/block:0/seg:0",
      "source": "What is AF_PACKET?",
      "source_hash": 10126026406269165371,
      "context_hash": 8240954479221592985,
      "translation": "AF_PACKET이란?",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:09:04.730163Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "`AF_PACKET` sockets give userspace direct access to the network device's frame layer (Layer 2).",
      "source_hash": 4582344788680851188,
      "context_hash": 2296350885669845795,
      "translation": "`AF_PACKET` 소켓은 사용자 공간에 네트워크 디바이스의 프레임 계층(Layer 2)에 대한 직접 접근을 제공합니다.",
      "glossary_snapshot": {
        "device": "디바이스",
        "userspace": "사용자 공간"
      },
      "translated_at": "2026-11-14T23:30:37.547822Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:1",
      "source": "Applications receive raw Ethernet frames (including headers) before the kernel's network stack processes them.",
      "source_hash": 10232059218455447133,
      "context_hash": 8678543939404177341,
      "translation": "애플리케이션은 커널의 네트워크 스택이 처리하기 전에 (헤더를 포함한) raw 이더넷 프레임을 수신합니다.",
      "glossary_snapshot": {
        "kernel": "커널",
        "network stack": "네트워크 스택"
      },
      "translated_at": "2026-11-14T22:09:04.730164Z",
      "issues": []
    },
