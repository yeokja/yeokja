    {
      "id": "section:0/block:1/seg:0",
      "source": "ftrace, perf, and BPF tools for packet-level network debugging",
      "source_hash": 12807452399074937111,
      "context_hash": 11937164378372127390,
      "translation": "패킷 수준 네트워크 디버깅을 위한 ftrace, perf, BPF 도구",
      "glossary_snapshot": {
        "BPF": "BPF",
        "ftrace": "ftrace",
        "perf": "perf"
      },
      "translated_at": "2026-11-14T22:38:55.989717Z",
      "issues": []
    },
    {
      "id": "section:1/block:0/seg:0",
      "source": "Network trace events",
      "source_hash": 7236680207163901864,
      "context_hash": 7384113653370954623,
      "translation": "네트워크 트레이스 이벤트",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:55.989717Z",
      "issues": []
    },
    {
      "id": "section:1/block:1/seg:0",
      "source": "The kernel emits tracepoints at key points in the network stack, accessible via ftrace and perf:",
      "source_hash": 1735578127246378901,
      "context_hash": 10731280809355641252,
      "translation": "커널은 네트워크 스택의 주요 지점에서 트레이스포인트를 발생시키며, 이는 ftrace와 perf를 통해 접근할 수 있습니다:",
      "glossary_snapshot": {
        "ftrace": "ftrace",
        "kernel": "커널",
        "network stack": "네트워크 스택",
        "perf": "perf",
        "tracepoints": "트레이스포인트"
      },
      "translated_at": "2026-11-14T22:38:55.989717Z",
      "issues": []
    },
    {
      "id": "section:2/block:0/seg:0",
      "source": "Tracing packet drops with kfree_skb",
      "source_hash": 15143900981222488707,
      "context_hash": 16093246692126450350,
      "translation": "kfree_skb를 이용한 패킷 드롭 트레이싱",
      "glossary_snapshot": {
        "tracing": "트레이싱"
      },
      "translated_at": "2026-11-14T23:31:09.587634Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:0",
      "source": "`skb:kfree_skb` fires whenever an sk_buff is dropped.",
      "source_hash": 18155221541559666263,
      "context_hash": 7891126503741170180,
      "translation": "`skb:kfree_skb`는 sk_buff가 드롭될 때마다 발생합니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:55.989718Z",
      "issues": []
    },
    {
      "id": "section:2/block:1/seg:1",
      "source": "The `reason` field identifies why:",
      "source_hash": 9326483005732833231,
      "context_hash": 2212387359701739172,
      "translation": "`reason` 필드는 드롭된 이유를 식별합니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:55.989718Z",
      "issues": []
    },
    {
      "id": "section:2/block:3/seg:0",
      "source": "Drop reason codes (Linux 5.17+)",
      "source_hash": 3307422517928113005,
      "context_hash": 8338996759427266003,
      "translation": "드롭 사유 코드(Linux 5.17+)",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-11-14T22:38:55.989718Z",
      "issues": []
    },
    {
      "id": "section:2/block:4/seg:0",
      "source": "The `reason` field was added to identify exact drop location:",
      "source_hash": 12677433995258713642,
      "context_hash": 18241953281232232086,
      "translation": "정확한 드롭 위치를 식별하기 위해 `reason` 필드가 추가되었습니다:",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:55.989718Z",
      "issues": []
    },
    {
      "id": "section:2/block:6/seg:0",
      "source": "Using dropwatch (BCC)",
      "source_hash": 12801510189947253677,
      "context_hash": 7281439229930408446,
      "translation": "dropwatch(BCC) 사용",
      "glossary_snapshot": {},
      "translated_at": "2026-11-14T22:38:55.989719Z",
      "issues": []
    },
    {
      "id": "section:3/block:0/seg:0",
      "source": "Tracing TCP events",
      "source_hash": 2152215950644004393,
      "context_hash": 1809231279505946845,
      "translation": "TCP 이벤트 트레이싱",
      "glossary_snapshot": {
