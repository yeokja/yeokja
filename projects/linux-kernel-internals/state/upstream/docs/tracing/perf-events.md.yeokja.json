    {
      "id": "section:5/block:9/seg:0",
      "source": "PMU: Hardware Performance Monitoring Unit",
      "source_hash": 16530816308201660643,
      "context_hash": 944693750062278341,
      "translation": "PMU: 하드웨어 성능 모니터링 유닛",
      "glossary_snapshot": {
        "hardware": "하드웨어"
      },
      "translated_at": "2026-11-14T22:19:51.840202Z",
      "issues": []
    },
    {
      "id": "section:5/block:10/seg:0",
      "source": "Each CPU architecture has a PMU with a limited number of programmable counters.",
      "source_hash": 4838491653446965665,
      "context_hash": 12316955090409427268,
      "translation": "각 CPU 아키텍처에는 프로그래밍 가능한 카운터의 수가 제한된 PMU가 있습니다.",
      "glossary_snapshot": {
        "CPU": "CPU"
      },
      "translated_at": "2026-11-14T22:19:51.840202Z",
      "issues": []
    },
    {
      "id": "section:5/block:10/seg:1",
      "source": "On Intel:",
      "source_hash": 6877363355081248744,
      "context_hash": 6656212753051818241,
      "translation": "Intel의 경우:",
      "glossary_snapshot": {
        "Intel": "Intel"
      },
      "translated_at": "2026-11-14T22:19:51.840202Z",
      "issues": []
    },
    {
      "id": "section:5/block:12/seg:0",
      "source": "The perf subsystem multiplexes software events onto the limited hardware counters using `context_switch` and `rotation`.",
      "source_hash": 3363253961721077200,
      "context_hash": 16414151242659418568,
      "translation": "perf 서브시스템은 `context_switch`와 `rotation`을 사용하여 소프트웨어 이벤트를 제한된 하드웨어 카운터에 멀티플렉싱합니다.",
      "glossary_snapshot": {
        "hardware": "하드웨어",
        "perf": "perf",
        "subsystem": "서브시스템"
      },
      "translated_at": "2026-11-14T22:19:51.840202Z",
      "issues": []
    },
