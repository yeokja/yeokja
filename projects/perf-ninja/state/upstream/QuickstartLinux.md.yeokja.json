  "segments": [
    {
      "id": "section:0/block:0/seg:0",
      "source": "Set up environment on Linux",
      "source_hash": 5856825351388344091,
      "context_hash": 1079990370371987095,
      "translation": "Linux에서 환경 설정하기",
      "glossary_snapshot": {
        "Linux": "Linux"
      },
      "translated_at": "2026-10-25T06:17:33.415925Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Run terminal.",
      "source_hash": 17360764307843886815,
      "context_hash": 17439419903281229633,
      "translation": "터미널을 실행하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:33.415926Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "Install clang-17 compiler using instructions from [here](https://apt.llvm.org/):",
      "source_hash": 6543426863553819123,
      "context_hash": 4607554469388407210,
      "translation": "[여기](https://apt.llvm.org/)의 안내에 따라 clang-17 컴파일러를 설치하십시오:",
      "glossary_snapshot": {
        "Clang": "Clang",
        "compiler": "컴파일러"
      },
      "translated_at": "2026-10-25T06:17:33.415926Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "Build release version of google [benchmark library](https://github.com/google/benchmark#installation).",
      "source_hash": 1673382453000849068,
      "context_hash": 3514448289027401624,
      "translation": "google [벤치마크 라이브러리](https://github.com/google/benchmark#installation)의 릴리스 버전을 빌드하십시오.",
      "glossary_snapshot": {
        "benchmark library": "벤치마크 라이브러리"
      },
      "translated_at": "2026-10-25T06:17:33.415926Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:1",
      "source": "It doesn't matter which compiler you use to build it.",
      "source_hash": 18351968480203970138,
      "context_hash": 8761235225738572864,
      "translation": "빌드에 어떤 컴파일러를 사용하든 상관없습니다.",
      "glossary_snapshot": {
        "compiler": "컴파일러"
      },
      "translated_at": "2026-10-25T06:17:33.415926Z",
      "issues": []
    },
    {
      "id": "section:0/block:4/seg:2",
      "source": "Install google benchmark library with:",
      "source_hash": 4935009703652577365,
      "context_hash": 12486281970835310094,
      "translation": "Google Benchmark 벤치마크 라이브러리를 다음 명령으로 설치하십시오:",
      "glossary_snapshot": {
        "Google Benchmark": "Google Benchmark",
        "benchmark library": "벤치마크 라이브러리"
      },
      "translated_at": "2026-10-25T06:25:39.350541Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:0",
      "source": "Enable clang-17 compiler for building labs.",
      "source_hash": 6186569071425039250,
      "context_hash": 14833141536560548960,
      "translation": "실습을 빌드할 때 clang-17 컴파일러를 사용하도록 설정하십시오.",
      "glossary_snapshot": {
        "Clang": "Clang",
        "compiler": "컴파일러"
      },
      "translated_at": "2026-10-25T06:17:33.415926Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:1",
      "source": "If you want to make clang-17 to be the default on a system do the following:",
      "source_hash": 7918836855263051489,
      "context_hash": 6529056040406581445,
      "translation": "clang-17을 시스템의 기본 컴파일러로 지정하려면 다음과 같이 하십시오:",
      "glossary_snapshot": {
        "Clang": "Clang",
        "default": "기본"
      },
      "translated_at": "2026-10-25T06:17:33.415926Z",
      "issues": []
    },
    {
      "id": "section:0/block:8/seg:0",
      "source": "If you don't want to make it a default, you can pass `-DCMAKE_C_COMPILER=clang-17 -DCMAKE_CXX_COMPILER=clang++-17` to the CMake.",
      "source_hash": 1275233645151285951,
      "context_hash": 925576802054995794,
      "translation": "기본 컴파일러로 지정하지 않으려면 CMake에 `-DCMAKE_C_COMPILER=clang-17 -DCMAKE_CXX_COMPILER=clang++-17`를 전달하면 됩니다.",
      "glossary_snapshot": {
        "CMake": "CMake",
        "default": "기본"
      },
      "translated_at": "2026-10-25T06:17:33.415927Z",
      "issues": []
    },
    {
      "id": "section:0/block:9/seg:0",
      "source": "Go to any lab and check if local lab builds are working.",
      "source_hash": 401005919009254094,
      "context_hash": 5234884603310136945,
      "translation": "아무 실습으로 이동하여 로컬에서 실습 빌드가 제대로 되는지 확인하십시오.",
      "glossary_snapshot": {
        "lab": "실습"
      },
      "translated_at": "2026-10-25T06:17:33.415927Z",
      "issues": []
    },
    {
      "id": "section:0/block:9/seg:1",
      "source": "You can find the CMake commands [here](GetStarted.md#how-to-build-lab-assignments).",
      "source_hash": 8484345686837977753,
      "context_hash": 10064611076833187440,
      "translation": "CMake 명령은 [여기](GetStarted.md#how-to-build-lab-assignments)에서 확인할 수 있습니다.",
      "glossary_snapshot": {
        "CMake": "CMake",
        "commands": "명령"
      },
      "translated_at": "2026-10-25T06:17:33.415927Z",
      "issues": []
    },
    {
      "id": "section:0/block:10/seg:0",
      "source": "Set the frequency scaling governor to `performance`.",
      "source_hash": 11498933199158295921,
      "context_hash": 14601287918609014978,
      "translation": "주파수 스케일링 거버너를 `performance`로 설정하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:33.415927Z",
      "issues": []
    },
    {
      "id": "section:0/block:12/seg:0",
      "source": "(Optional) Install [ninja](https://github.com/ninja-build).",
      "source_hash": 13914461345393832342,
      "context_hash": 2037848095746014695,
      "translation": "(선택 사항) [ninja](https://github.com/ninja-build)를 설치하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:33.415927Z",
      "issues": []
    },
    {
      "id": "section:0/block:14/seg:0",
      "source": "You can use it to build labs by passing `-G Ninja` to the CMake invocation.",
      "source_hash": 9954407835184041739,
      "context_hash": 7437170711698066064,
      "translation": "CMake를 호출할 때 `-G Ninja`를 전달하면 ninja로 실습을 빌드할 수 있습니다.",
      "glossary_snapshot": {
        "CMake": "CMake"
      },
      "translated_at": "2026-10-25T06:17:33.415927Z",
      "issues": []
    }
  ]
}