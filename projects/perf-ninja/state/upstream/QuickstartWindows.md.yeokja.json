    {
      "id": "section:0/block:0/seg:0",
      "source": "Set up environment on Windows",
      "source_hash": 8951473998726232462,
      "context_hash": 15877694540917808830,
      "translation": "Windows에서 환경 설정하기",
      "glossary_snapshot": {
        "Windows": "Windows"
      },
      "translated_at": "2026-10-25T06:17:14.981567Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:0",
      "source": "Run powershell.",
      "source_hash": 5299418261308186959,
      "context_hash": 16658647048365390830,
      "translation": "PowerShell을 실행하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:2/seg:0",
      "source": "Install [ninja](https://github.com/ninja-build/ninja/releases).",
      "source_hash": 3594371157251046250,
      "context_hash": 7333733858689981690,
      "translation": "[ninja](https://github.com/ninja-build/ninja/releases)를 설치하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:0",
      "source": "Add it to the PATH.",
      "source_hash": 13613207256649342402,
      "context_hash": 11036994072627715329,
      "translation": "PATH에 추가하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:3/seg:1",
      "source": "For example:",
      "source_hash": 4114854479619665730,
      "context_hash": 16191564246116732171,
      "translation": "예를 들면 다음과 같습니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:0",
      "source": "Download clang-17 compiler from [here](https://github.com/llvm/llvm-project/releases/tag/llvmorg-17.0.1) (LLVM-17.0.1-win64.exe) and install it.",
      "source_hash": 1237692862789546610,
      "context_hash": 14083588747131254423,
      "translation": "[여기](https://github.com/llvm/llvm-project/releases/tag/llvmorg-17.0.1)에서 clang-17 컴파일러(LLVM-17.0.1-win64.exe)를 내려받아 설치하십시오.",
      "glossary_snapshot": {
        "Clang": "Clang",
        "compiler": "컴파일러"
      },
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:5/seg:1",
      "source": "Select \"add LLVM to the PATH\" while installing.",
      "source_hash": 13124550511458611527,
      "context_hash": 6559704567428356307,
      "translation": "설치할 때 \"add LLVM to the PATH\"를 선택하십시오.",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:0",
      "source": "Build release version of google [benchmark library](https://github.com/google/benchmark#installation).",
      "source_hash": 1673382453000849068,
      "context_hash": 15164012738069515837,
      "translation": "google [벤치마크 라이브러리](https://github.com/google/benchmark#installation)의 릴리스 버전을 빌드하십시오.",
      "glossary_snapshot": {
        "benchmark library": "벤치마크 라이브러리"
      },
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:1",
      "source": "It doesn't matter which compiler you use to build it.",
      "source_hash": 18351968480203970138,
      "context_hash": 8761235225738572864,
      "translation": "빌드할 때 어떤 컴파일러를 사용하든 상관없습니다.",
      "glossary_snapshot": {
        "compiler": "컴파일러"
      },
      "translated_at": "2026-10-25T06:17:14.981568Z",
      "issues": []
    },
    {
      "id": "section:0/block:6/seg:2",
      "source": "Install google benchmark library with:",
      "source_hash": 4935009703652577365,
      "context_hash": 11949367851620518510,
      "translation": "다음 명령으로 Google Benchmark 벤치마크 라이브러리를 설치하십시오.",
      "glossary_snapshot": {
        "Google Benchmark": "Google Benchmark",
        "benchmark library": "벤치마크 라이브러리"
      },
      "translated_at": "2026-10-25T06:25:32.152842Z",
      "issues": []
    },
    {
      "id": "section:0/block:8/seg:0",
      "source": "Add google benchmark library to PATH",
      "source_hash": 7867444735825034954,
      "context_hash": 10866986559336052697,
      "translation": "Google Benchmark 벤치마크 라이브러리를 PATH에 추가하십시오.",
      "glossary_snapshot": {
        "Google Benchmark": "Google Benchmark",
        "benchmark library": "벤치마크 라이브러리"
      },
      "translated_at": "2026-10-25T06:25:32.152843Z",
      "issues": []
    },
    {
      "id": "section:0/block:10/seg:0",
      "source": "Go to any lab and check if local lab builds are working.",
      "source_hash": 401005919009254094,
      "context_hash": 16443635948432011901,
      "translation": "아무 실습 디렉터리로 이동해 로컬 실습 빌드가 제대로 되는지 확인하십시오.",
      "glossary_snapshot": {
        "lab": "실습"
      },
      "translated_at": "2026-10-25T06:17:14.981569Z",
      "issues": []
    },
    {
      "id": "section:0/block:10/seg:1",
      "source": "You can find the CMake commands [here](GetStarted.md#how-to-build-lab-assignments), but note that you need to add `-G Ninja` to the CMake invocation.",
      "source_hash": 15881939312756185239,
      "context_hash": 997536396235442619,
      "translation": "CMake 명령은 [여기](GetStarted.md#how-to-build-lab-assignments)에서 찾을 수 있습니다. 다만 CMake를 호출할 때 `-G Ninja`를 추가해야 한다는 점에 유의하십시오.",
      "glossary_snapshot": {
        "CMake": "CMake",
        "commands": "명령"
      },
      "translated_at": "2026-10-25T06:17:14.981569Z",
      "issues": []
    },
    {
      "id": "section:0/block:11/seg:0",
      "source": "If everything works as expected, you can set environment variables permanently (run as Administrator):",
      "source_hash": 7588051618246122396,
      "context_hash": 7355780204237863569,
      "translation": "모든 것이 예상대로 동작하면 환경 변수를 영구적으로 설정할 수 있습니다(관리자 권한으로 실행하십시오).",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:17:14.981569Z",
      "issues": []
    }
  ]
