      "issues": []
    },
    {
      "id": "section:0/block:4/seg:0",
      "source": "Processing denormal FP values is [slow](https://easyperf.net/blog/2018/11/08/Using-denormal-floats-is-slow-how-to-detect-it).",
      "source_hash": 6574268998787071101,
      "context_hash": 101363583235498279,
      "translation": "비정규(denormal) 부동소수점 값을 처리하는 작업은 [느립니다](https://easyperf.net/blog/2018/11/08/Using-denormal-floats-is-slow-how-to-detect-it).",
      "glossary_snapshot": {},
      "translated_at": "2026-10-25T06:16:47.700583Z",
      "issues": []
    },
    {
