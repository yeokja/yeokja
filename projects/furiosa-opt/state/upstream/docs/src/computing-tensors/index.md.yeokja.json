    {
      "id": "section:0/block:1/seg:0",
      "source": "Computing Tensors explains how a valid Tensor Unit stream reaches the Vector or Contraction Engine.",
      "source_hash": 8238505004487015820,
      "context_hash": 15290225929635897216,
      "translation": "텐서 계산에서는 유효한 Tensor Unit 스트림이 Vector Engine 또는 Contraction Engine에 도달하는 방식을 설명합니다.",
      "glossary_snapshot": {
        "Tensor Unit": "Tensor Unit",
        "Contraction Engine": "Contraction Engine",
        "Computing Tensors": "텐서 계산"
      },
      "translated_at": "2026-09-24T11:54:30.558190Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:1",
      "source": "A stationary operand stays in a register file while the other operand streams through the engine.",
      "source_hash": 11513614249999353016,
      "context_hash": 10906836471464095053,
      "translation": "한 피연산자는 Register File에 고정되어 머무르고, 다른 피연산자는 엔진을 통해 스트리밍됩니다.",
      "glossary_snapshot": {
        "Register File": "Register File"
      },
      "translated_at": "2026-09-24T11:54:30.558191Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:2",
      "source": "The Tensor Register File (TRF) stores contraction operands, and the Vector Register File (VRF) stores vector operands.",
      "source_hash": 4550538438174365819,
      "context_hash": 12843569259552549499,
      "translation": "Tensor Register File(TRF)은 축약 피연산자를 저장하고, Vector Register File(VRF)은 벡터 피연산자를 저장합니다.",
      "glossary_snapshot": {
        "Register File": "Register File"
      },
      "translated_at": "2026-09-24T11:54:30.558191Z",
      "issues": []
    },
    {
      "id": "section:0/block:1/seg:3",
      "source": "This chapter explains the engine behavior that places operands and preserves stream dimensions.",
      "source_hash": 5106915102392732395,
      "context_hash": 8459603456967109050,
      "translation": "이 장에서는 피연산자를 배치하고 스트림 차원을 보존하는 엔진 동작을 설명합니다.",
      "glossary_snapshot": {
        "dimensions": "차원"
      },
      "translated_at": "2026-09-24T11:54:30.558191Z",
      "issues": []
    },
