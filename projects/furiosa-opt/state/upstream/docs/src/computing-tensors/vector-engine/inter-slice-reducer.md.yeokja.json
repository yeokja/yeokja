    },
    {
      "id": "section:3/block:7/seg:0",
      "source": "This pass reduces `R` and broadcasts the result over a fresh dimension `X`.",
      "source_hash": 12158834388781826200,
      "context_hash": 2620705990195341092,
      "translation": "이 pass는 `R`을 리덕션하고 그 결과를 새로운 차원 `X`에 브로드캐스트합니다.",
      "glossary_snapshot": {
        "dimension": "차원",
        "broadcasts": "브로드캐스트"
      },
      "translated_at": "2026-09-19T18:40:21.562577Z",
      "issues": []
    },
    {
      "id": "section:3/block:7/seg:1",
      "source": "The einsum form is `PRW -> PWX`, with the fresh `X` on the output side broadcasting.",
      "source_hash": 2187361360489231263,
      "context_hash": 4868285857733184436,
      "translation": "einsum 형태는 `PRW -> PWX`이며, 출력 쪽의 새로운 `X`가 브로드캐스트됩니다.",
      "glossary_snapshot": {},
      "translated_at": "2026-09-19T18:40:21.562577Z",
      "issues": []
    },
    {
      "id": "section:3/block:10/seg:0",
      "source": "Promotion from `Time` into `OutSlice`",
      "source_hash": 6373038924390259582,
      "context_hash": 11715790057828899193,
      "translation": "`Time`에서 `OutSlice`로의 승격",
      "glossary_snapshot": {},
      "translated_at": "2026-09-19T18:40:21.562578Z",
      "issues": []
    },
    {
      "id": "section:3/block:11/seg:0",
      "source": "This pass reduces `R` and promotes the `Time` dimension `V` into OutSlice.",
      "source_hash": 4235924348368988538,
      "context_hash": 17410100815498877506,
      "translation": "이 pass는 `R`을 리덕션하고 `Time` 차원 `V`를 OutSlice로 승격합니다.",
      "glossary_snapshot": {
        "dimension": "차원"
      },
      "translated_at": "2026-09-19T18:40:21.562578Z",
      "issues": []
    },
    {
      "id": "section:3/block:11/seg:1",
      "source": "The einsum form is `PRSUVW -> PSUVW`.",
      "source_hash": 15719808411917636639,
      "context_hash": 13995269884696678306,
      "translation": "einsum 형태는 `PRSUVW -> PSUVW`입니다.",
