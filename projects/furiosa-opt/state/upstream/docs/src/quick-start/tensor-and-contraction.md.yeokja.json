    {
      "id": "section:0/block:22/seg:0",
      "source": "Tensor contraction multiplies two inputs elementwise and reduces every shared axis that is absent from the output.",
      "source_hash": 1226006534557181460,
      "context_hash": 16387510798694621842,
      "translation": "텐서 축약은 두 입력을 요소별로 곱한 뒤, 출력에 없는 모든 공유 축에 대해 리덕션을 수행합니다.",
      "glossary_snapshot": {
        "axis": "축"
      },
      "translated_at": "2026-09-19T18:41:36.410304Z",
      "issues": []
    },
    {
      "id": "section:0/block:22/seg:1",
      "source": "Every contraction consists of broadcast, multiply, and reduce steps.",
      "source_hash": 8276809776514216739,
      "context_hash": 318420084328088194,
      "translation": "모든 축약은 브로드캐스트, 곱셈, 리덕션 단계로 구성됩니다.",
      "glossary_snapshot": {
        "broadcast": "브로드캐스트"
      },
      "translated_at": "2026-09-19T18:41:36.410305Z",
      "issues": []
    },
